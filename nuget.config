<?xml version="1.0" encoding="utf-8"?>
<!-- Hold recognition (Blocwerk.Recognition.Abstractions, Blocwerk.HoldDetection) comes from zannagh/blocwerk-recognition
     on GitHub Packages, everything else from nuget.org. GitHub Packages needs a token even to read: NuGet takes it from
     the environment, never from this file:
       export NuGetPackageSourceCredentials_zannagh="Username=<github user>;Password=<token with read:packages>"
     CI passes GITHUB_TOKEN that way (.github/workflows/main.yml), the image build as a BuildKit secret (docker/Dockerfile). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="zannagh" value="https://nuget.pkg.github.com/zannagh/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="zannagh">
      <package pattern="Blocwerk.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
