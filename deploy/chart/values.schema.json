{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Blocwerk chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "replicas": {
      "description": "0 or 1: every component keeps state or a job queue in its process.",
      "type": "integer",
      "enum": [0, 1]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "env": {
      "description": "Plain environment variables; values are strings (quote \"true\", \"0\"); \"\" = not rendered.",
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object", "required": ["memory"]},
        "limits": {"type": "object", "required": ["memory"]}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {"type": "string"},
        "size": {"type": "string"},
        "storageClass": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicas", "image", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"$ref": "#/definitions/replicas"},
        "image": {"$ref": "#/definitions/image"},
        "env": {"$ref": "#/definitions/env"},
        "tmpSizeLimit": {"type": "string"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    }
  },
  "properties": {
    "imagePullSecrets": {"type": "array", "items": {"type": "object", "required": ["name"]}},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array"},
    "secrets": {
      "description": "Names of existing Secrets; never values.",
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "postgres", "compute"],
      "properties": {
        "app": {"type": "string", "minLength": 1},
        "postgres": {"type": "string", "minLength": 1},
        "appsettings": {"type": "string"},
        "compute": {"type": "string", "minLength": 1},
        "deploy": {"type": "string"}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxVideoMb": {"type": "string"},
        "maxPhotoMb": {"type": "string"},
        "maxPhotos": {"type": "string"},
        "maxVideoFrames": {"type": "string"}
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "image", "resources"],
      "properties": {
        "replicas": {"$ref": "#/definitions/replicas"},
        "image": {"$ref": "#/definitions/image"},
        "env": {
          "allOf": [{"$ref": "#/definitions/env"}],
          "propertyNames": {
            "description": "Set by the chart: POSTGRES__*, GEOMETRYSERVICE__*, SPLATSERVICE__*, CAPTURE__MAX* (use capture.*).",
            "not": {"pattern": "^(POSTGRES__|GEOMETRYSERVICE__|SPLATSERVICE__|CAPTURE__MAX)"}
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"port": {"type": "integer"}}
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "className": {"type": "string"},
            "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
            "host": {"type": "string"},
            "tlsSecretName": {"type": "string"}
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "data": {"$ref": "#/definitions/claim"},
            "tmpSizeLimit": {"type": "string"}
          }
        },
        "resources": {"$ref": "#/definitions/resources"},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "startupFailureThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"$ref": "#/definitions/replicas"},
        "image": {"$ref": "#/definitions/image"},
        "database": {"type": "string", "minLength": 1},
        "username": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string"}},
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"host": {"type": "string"}, "port": {"type": "integer"}}
        },
        "persistence": {"$ref": "#/definitions/claim"},
        "resources": {"$ref": "#/definitions/resources"},
        "statsReset": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "schedule": {"type": "string"},
            "timeZone": {"type": "string"}
          }
        }
      }
    },
    "geometry": {"$ref": "#/definitions/worker"},
    "splatCpu": {"$ref": "#/definitions/worker"},
    "aspire": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"$ref": "#/definitions/replicas"},
        "image": {"$ref": "#/definitions/image"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "deployGate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "pollSeconds": {"type": "integer", "minimum": 1},
        "maxDefer": {"type": "integer", "minimum": 0},
        "etaMaxDefer": {"type": "integer", "minimum": 0},
        "announceEtaSeconds": {"type": "integer", "minimum": 0},
        "announceGraceSeconds": {"type": "integer", "minimum": 0},
        "flushTimeoutSeconds": {"type": "integer", "minimum": 1},
        "computeMaxDefer": {"type": "integer", "minimum": 0}
      }
    }
  }
}
