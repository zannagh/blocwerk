@using Blocwerk.Core.Helpers
@* A boulder's effective hold type as a badge; an inferred one says so ("Crimp · from holds"). Nothing when it has none. *@
@if (Value is { } effective)
{
    <span class="style-badge hold-type-badge" data-hold-type="@BoulderHoldTypes.Slug(effective.Type)" data-inferred="@(effective.Inferred ? "true" : "false")">
        <BrowseIcon Markup="@BoulderHoldTypes.Icon(effective.Type)" Size="13" />
        <span>@BoulderHoldTypes.Label(effective.Type)@(effective.Inferred ? " · from holds" : string.Empty)</span>
    </span>
}

@code {
    /// <summary>Gets or sets the effective hold type, or null.</summary>
    [Parameter] public EffectiveHoldType? Value { get; set; }
}
