@using Blocwerk.Core.Enums
@using Blocwerk.Core.Helpers
@* Picking a boulder's prominent hold types: any of the grips and hooks, toggled like the styles; none leaves it to the
   holds. The grip the holds suggest (Inferred), while nothing is chosen, is outlined so people see what the browser
   files the boulder under. *@
<div class="style-picker" role="group" aria-label="Hold types">
    @foreach (var def in BoulderHoldTypes.Definitions)
    {
        var on = Value.HasFlag(def.Value);
        var hint = Value == BoulderHoldType.None && Inferred == def.Value;
        <button type="button" class="@("style-pick" + (on ? " on" : string.Empty) + (hint ? " inferred" : string.Empty))"
                aria-pressed="@(on ? "true" : "false")" data-hold-type="@def.Slug" title="@def.Description" disabled="@Disabled"
                @onclick="() => ValueChanged.InvokeAsync(Value ^ def.Value)">
            <BrowseIcon Markup="@def.Icon" Size="15" /><span>@def.Label</span>
        </button>
    }
</div>

@code {
    /// <summary>Gets or sets the types set on the boulder.</summary>
    [Parameter] public BoulderHoldType Value { get; set; }

    /// <summary>Gets or sets the callback with the new set.</summary>
    [Parameter] public EventCallback<BoulderHoldType> ValueChanged { get; set; }

    /// <summary>Gets or sets the grip the boulder's holds suggest, outlined while nothing is set.</summary>
    [Parameter] public BoulderHoldType? Inferred { get; set; }

    /// <summary>Gets or sets a value indicating whether the chips are inert (a save is running).</summary>
    [Parameter] public bool Disabled { get; set; }
}
