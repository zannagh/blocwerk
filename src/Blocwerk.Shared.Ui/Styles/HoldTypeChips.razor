@using Blocwerk.Core.Enums
@using Blocwerk.Core.Helpers
@* Picking a boulder's dominant hold type: one of five, or none. Tapping the chosen one again clears it. The type the
   holds suggest (Inferred), when nothing is chosen, is outlined so people see what the browser files it under. *@
<div class="style-picker" role="group" aria-label="Dominant hold type">
    @foreach (var def in BoulderHoldTypes.Definitions)
    {
        var on = Value == def.Value;
        var hint = Value is null && Inferred == def.Value;
        <button type="button" class="@("style-pick" + (on ? " on" : string.Empty) + (hint ? " inferred" : string.Empty))"
                aria-pressed="@(on ? "true" : "false")" data-hold-type="@def.Slug" disabled="@Disabled"
                @onclick="() => ValueChanged.InvokeAsync(on ? null : def.Value)">
            <BrowseIcon Markup="@def.Icon" Size="15" /><span>@def.Label</span>
        </button>
    }
</div>

@code {
    /// <summary>Gets or sets the type set on the boulder, or null.</summary>
    [Parameter] public HoldHandType? Value { get; set; }

    /// <summary>Gets or sets the callback with the new type (null when cleared).</summary>
    [Parameter] public EventCallback<HoldHandType?> ValueChanged { get; set; }

    /// <summary>Gets or sets the type the boulder's holds suggest, outlined while nothing is set.</summary>
    [Parameter] public HoldHandType? Inferred { get; set; }

    /// <summary>Gets or sets a value indicating whether the chips are inert (a save is running).</summary>
    [Parameter] public bool Disabled { get; set; }
}
