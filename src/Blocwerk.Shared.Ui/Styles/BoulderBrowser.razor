@using Blocwerk.Core.Enums
@using Blocwerk.Core.Helpers
@* The boulder browser's card screens, the same on the Server and offline: the landing (All, By Hold Type, By Style and,
   signed in, the viewer's own lists) and the two card pages. Plain links, so every choice is a history entry and its
   level is in the URL (BoulderBrowse). A card counts families, as the list shows them; one with none is greyed out and
   not a link. The landing is All across the grid, then two portrait cards, then the own lists, all on one phone screen;
   a card page is two columns (seven hold types, nine styles). *@
@if (Browse.Level != BoulderBrowseLevel.Landing)
{
    var (label, icon) = BrowseIcons.Describe(Browse);
    <BrowseBar BackHref="@HrefFor(Browse.Up)" BackLabel="@Browse.UpLabel" Label="@label" Icon="@icon" />
}
<nav class="style-cards@(Browse.Level == BoulderBrowseLevel.Landing ? " browse-landing" : string.Empty)"
     aria-label="@BrowseIcons.Describe(Browse).Label" data-browse-level="@Browse.Level.ToString().ToLowerInvariant()">
    @foreach (var card in cards)
    {
        // An empty card is the same element without its href: greyed out, no link, not in the tab order.
        var empty = card.Count == 0 && card.Key != "all";
        var size = card.Shape is BrowseCardShape.Hero or BrowseCardShape.Tall ? 30 : 24;
        <a class="style-card @(card.Shape switch { BrowseCardShape.Hero => "browse-hero", BrowseCardShape.Tall => "browse-tall", BrowseCardShape.Mine => "browse-mine", _ => "" }) @(empty ? "is-empty" : "is-link")"
           href="@(empty ? null : card.Href)" aria-disabled="@(empty ? "true" : null)" data-card="@card.Key" title="@card.Tooltip">
            <span class="style-card-icon"><BrowseIcon Markup="@card.Icon" Size="size" /></span>
            <span class="style-card-label">@card.Label</span>
            <span class="style-card-count">@(empty ? "None yet" : card.Count.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
        </a>
    }
</nav>

@code {
    private IReadOnlyList<BrowseCard> cards = [];

    /// <summary>Gets or sets the screen (the landing or a card page).</summary>
    [Parameter, EditorRequired] public BoulderBrowse Browse { get; set; } = BoulderBrowse.Landing;

    /// <summary>Gets or sets the list's rows (families), as the list shows them before any filter.</summary>
    [Parameter, EditorRequired] public IReadOnlyCollection<BoulderFamilyRow> Rows { get; set; } = [];

    /// <summary>Gets or sets the link of a level.</summary>
    [Parameter, EditorRequired] public Func<BoulderBrowse, string> HrefFor { get; set; } = _ => "#";

    /// <summary>
    /// Gets or sets the families on each of the viewer's own lists; a list without an entry has no card (a share link, a
    /// kiosk nobody is picked on and an anonymous viewer have no marks, so they see none).
    /// </summary>
    [Parameter] public IReadOnlyDictionary<BoulderMine, int>? MineCounts { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet() => cards = Browse.Level switch
    {
        BoulderBrowseLevel.HoldTypes => HoldTypeCards(),
        BoulderBrowseLevel.Styles => StyleCards(),
        _ => LandingCards(),
    };

    private List<BrowseCard> LandingCards()
    {
        List<BrowseCard> landing =
        [
            new("all", "All boulders", BrowseIcons.All, Rows.Count, HrefFor(BoulderBrowse.All), BrowseCardShape.Hero),
            new("holds", "By Hold Type", BrowseIcons.HoldTypes, Rows.Count(r => r.HoldTypes != BoulderHoldType.None),
                HrefFor(new BoulderBrowse(BoulderBrowseLevel.HoldTypes)), BrowseCardShape.Tall),
            new("styles", "By Style", BrowseIcons.Styles, Rows.Count(r => r.Styles != BoulderStyle.None),
                HrefFor(new BoulderBrowse(BoulderBrowseLevel.Styles)), BrowseCardShape.Tall),
        ];
        if (MineCounts?.TryGetValue(BoulderMine.Projects, out var projects) == true)
        {
            landing.Add(new("projects", "My projects", BrowseIcons.Projects, projects,
                HrefFor(new BoulderBrowse(BoulderBrowseLevel.List, Mine: BoulderMine.Projects)), BrowseCardShape.Mine));
        }

        if (MineCounts?.TryGetValue(BoulderMine.Favorites, out var favorites) == true)
        {
            landing.Add(new("favorites", "Favorites", BrowseIcons.Favorites, favorites,
                HrefFor(new BoulderBrowse(BoulderBrowseLevel.List, Mine: BoulderMine.Favorites)), BrowseCardShape.Mine));
        }

        return landing;
    }

    private List<BrowseCard> HoldTypeCards()
    {
        var counts = BoulderHoldTypes.CountBy(Rows.Select(r => r.HoldTypes));
        return BoulderHoldTypes.Definitions
            .Select(d => new BrowseCard(d.Slug, d.Label, d.Icon, counts[d.Value], HrefFor(new BoulderBrowse(BoulderBrowseLevel.List, HoldType: d.Value)), Description: d.Description))
            .ToList();
    }

    private List<BrowseCard> StyleCards()
    {
        var counts = BoulderStyles.CountBy(Rows.Select(r => r.Styles));
        return BoulderStyles.Definitions
            .Select(d => new BrowseCard(d.Slug, d.Label, d.Icon, counts[d.Value], HrefFor(new BoulderBrowse(BoulderBrowseLevel.List, d.Value)), Description: d.Description))
            .ToList();
    }
}
