<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YoloDotNet" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <!-- OpenCvSharp: the osx_arm64 native runtime only ships at 4.8.1, so the mac build
       pins the managed assembly to the matching 4.8.x. The Docker build runs inside a
       linux container and picks a linux runtime at the current 4.13 line.
       Code only touches the 4.8.1 API surface so it runs on both. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="OpenCvSharp4" VersionOverride="4.8.0.20230708" />
    <PackageReference Include="OpenCvSharp4.runtime.osx_arm64" />
  </ItemGroup>

  <!-- Non-mac (i.e. container) builds must pick the native runtime matching the *target*
       architecture, not the build host's: docker/Dockerfile cross-builds both linux/amd64
       and linux/arm64 from a single amd64 builder via `dotnet restore/publish -a $TARGETARCH`.
       `-a` sets RuntimeIdentifier as an evaluation-time global property (host OS + given
       arch), so it is readable here; NETCoreSdkRuntimeIdentifier is the fallback for a plain
       `dotnet build` with no `-a`, where RuntimeIdentifier is empty. -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('OSX'))">
    <BlocwerkNativeRuntimeId>$(RuntimeIdentifier)</BlocwerkNativeRuntimeId>
    <BlocwerkNativeRuntimeId Condition="'$(BlocwerkNativeRuntimeId)' == ''">$(NETCoreSdkRuntimeIdentifier)</BlocwerkNativeRuntimeId>
  </PropertyGroup>
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.runtime.linux-arm64"
                     Condition="$(BlocwerkNativeRuntimeId.EndsWith('arm64'))" />
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64"
                     Condition="!$(BlocwerkNativeRuntimeId.EndsWith('arm64'))" />
  </ItemGroup>

  <!-- Exclude GPU-only ONNX packages that YoloDotNet pulls in — they lack arm64 runtimes -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="models\**\*.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blocwerk.Core\Blocwerk.Core.csproj" />
  </ItemGroup>

</Project>
