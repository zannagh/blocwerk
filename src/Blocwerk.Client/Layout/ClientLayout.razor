@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@* The offline shell's frame: the read-only notice, and the page behind the store's gate (StoreGate: a locked, updating
   or empty device shows only its notice and "Clear offline data", never the page). Links out of it are plain anchors
   outside the /v/ base, so the browser makes a full navigation to the Server page. The pill is client-handback.js's
   (PR 3.14): an element Blazor never fills, so its nodes survive re-renders. Back online, the next navigation goes to
   the Server page instead (HandBackAsync). *@
<div class="bw-client">
    <header class="bw-client-bar">
        <a class="bw-client-brand" href="/">Blocwerk</a>
        <span id="bw-client-pill" class="bw-client-pill-slot" role="status"></span>
    </header>
    <main class="bw-client-main">
        <StoreGate><ViewErrorBoundary>@Body</ViewErrorBoundary></StoreGate>
        <SyncDriver />
    </main>
</div>

@code {
    /// <summary>The performance mark of the client's first render; the budget gate measures start time to it.</summary>
    public const string ReadyMark = "bw-client-ready";

    private IDisposable? handBack;

    /// <inheritdoc />
    public void Dispose() => handBack?.Dispose();

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("performance.mark", ReadyMark);
            handBack = Navigation.RegisterLocationChangingHandler(HandBackAsync);
            try
            {
                await JS.InvokeVoidAsync("bwClientHandback.start");
            }
            catch (JSException)
            {
                // No hand-back script: no pill and no probe, and every navigation stays in the client.
            }
        }
    }

    // Online, client-handback.js navigates to the Server twin of the target itself, and the client's own navigation stops.
    private async ValueTask HandBackAsync(LocationChangingContext context)
    {
        try
        {
            if (await JS.InvokeAsync<bool>("bwClientHandback.take", context.CancellationToken, context.TargetLocation))
            {
                context.PreventNavigation();
            }
        }
        catch (JSException)
        {
            // No hand-back script: the client navigates as before.
        }
    }
}
