@* A store state with nothing to show: its title, a line of text, the way online and "Clear offline data". *@
<section class="bw-client-empty">
    <h1>@Title</h1>
    <p>@Text</p>
    <a class="bw-client-online" href="/">Open Blocwerk online</a>
    <ClearOfflineData />
</section>

@code {
    /// <summary>Gets or sets the notice's heading.</summary>
    [Parameter]
    [EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Gets or sets the line under it.</summary>
    [Parameter]
    [EditorRequired]
    public string Text { get; set; } = string.Empty;
}
