@inject NavigationManager Navigation
@* A wall or boulder the device holds nothing of: says so, with the Server page of the same path. *@
<section class="bw-client-empty" data-bw-not-saved>
    <h1>@Title</h1>
    <p>It was not saved on this device.</p>
    <a class="bw-client-online" href="@ClientRoutes.ServerPath(Navigation.ToBaseRelativePath(Navigation.Uri))">Open it online</a>
</section>

@code {
    /// <summary>Gets or sets the heading.</summary>
    [Parameter]
    public string Title { get; set; } = "Not available offline";
}
