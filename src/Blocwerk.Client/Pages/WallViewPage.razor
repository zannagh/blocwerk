@page "/walls/{WallId:guid}"
@page "/walls/{WallId:guid}/shared/{ShareToken}"
@inherits CachedWallPage
@using Blocwerk.Contracts.Documents
@using Blocwerk.Core.Enums
@using Blocwerk.Core.Helpers
@using Blocwerk.Shared.Ui.Styles
@inject NavigationManager Navigation
@* A wall's view from the device (the Server's WallDetail, read-only): its photos with the hold overlay, the counts,
   and the boulder list with search, sort, grade range and (signed in) the viewer's own filters and marks. No edit
   mode, no settings, no members, no "+ New". A kind of data the device does not hold (holds, boulders) says so. Slots
   for PR 3.13: WallActions, WallStage (wraps the panel viewer) and WallBelow. *@
<PageTitle>@(Wall?.Wall?.Name ?? "Wall") - Blocwerk</PageTitle>

@if (!Loaded)
{
    <p class="loading">Loading...</p>
}
else if (Wall?.Wall is not { } doc || grid is null)
{
    <NotSaved Title="This wall is not available offline" />
}
else
{
    var slot = new ViewSlotContext(Wall, null, ShareToken);
    <div class="wall-detail bw-client-wall" data-bw-wall="@WallId">
        <div class="page-header">
            @if (string.IsNullOrEmpty(ShareToken))
            {
                <a href="@ClientRoutes.WallList" class="back-link"><span aria-hidden="true">&larr;</span><span class="back-link-text"> My Walls</span></a>
            }
            <div class="title-row">
                <h1 title="@doc.Name">@doc.Name</h1>
                <div class="title-actions"><ViewSlot Name="ViewSlotName.WallActions" Context="slot" /></div>
            </div>
        </div>

        @* The photo (or the 3D stage its switch puts there) and the counts show on the landing and with a list. On the two
           card pages the cards are the screen, so all of them fit a phone without scrolling. *@
        @if (Browsing.Level is not (BoulderBrowseLevel.HoldTypes or BoulderBrowseLevel.Styles))
        {
        <div class="wall-main">
            <div class="wall-detail-card">
                @if (!string.IsNullOrEmpty(doc.Description))
                {
                    <p class="description">@doc.Description</p>
                }
                <div class="wall-photo-container">
                    <ViewSlot Name="ViewSlotName.WallStage" Context="slot">
                        <DefaultContent>
                            <PanelViewer WallId="WallId" ShareToken="@ShareToken" Grid="grid" FitWidth="Facts.FitWidth" OutlinesOnDemand="true" />
                        </DefaultContent>
                    </ViewSlot>
                </div>
            </div>
            <div class="wall-side">
                <div class="stats-bar">
                    <div class="stat">
                        <span class="stat-value">@(Wall.Holds is null ? "–" : holdCount.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
                        <span class="stat-label">Holds</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">@(Wall.Boulders is null ? "–" : BoulderList.ActiveCount(boulders).ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
                        <span class="stat-label">Boulders</span>
                    </div>
                </div>
            </div>
        </div>
        }

        @* .boulders-page: the Server's list page (one sticky head: title, count and the filter chip). *@
        <div class="boulders-page">
            <div class="boulder-section">
                @if (ShowBrowseCards)
                {
                    @* The browser's card screens, as on the Server: the level is in the URL (BoulderBrowse). *@
                    <div class="boulder-list-head">
                        <div class="section-header">
                            <h2>Boulders<span class="list-count">@browseRows.Count</span></h2>
                        </div>
                    </div>
                    <BoulderBrowser Browse="Browsing" Rows="browseRows" HrefFor="BrowseHref" MineCounts="MineCounts" />
                }
                @if (Browsing.Level is BoulderBrowseLevel.List or BoulderBrowseLevel.Landing)
                {
                var atLanding = Browsing.Level == BoulderBrowseLevel.Landing;
                @* Under the landing's cards the whole list is a block only the desktop tier shows, as on the Server. *@
                <div class="boulder-list-block@(atLanding ? " browse-landing-list" : string.Empty)" data-browse-list="@(atLanding ? "landing" : "level")">
                @if (atLanding)
                {
                    <div class="browse-list-divider" role="separator"><span>All boulders</span></div>
                }
                <div class="boulder-list-head">
                    @if (!atLanding)
                    {
                        <div class="section-header">
                            <h2>Boulders<span class="list-count">@active.Count</span></h2>
                        </div>
                        var (browseLabel, browseIcon) = BrowseIcons.Describe(Browsing);
                        <BrowseBar BackHref="@BrowseHref(Browsing.Up)" BackLabel="@Browsing.UpLabel" Label="@browseLabel" Icon="@browseIcon" />
                    }
                    @if (boulders.Count > 0)
                    {
                        <BoulderFilters Filter="filter" FilterChanged="OnFilterChanged" ShowMine="ShowsMine" />
                    }
                </div>

                @if (Wall.Boulders is null)
                {
                    <NotSavedNote Text="Boulders are not saved on this device." />
                }
                else if (boulders.Count == 0)
                {
                    <div class="empty-boulders"><p>No boulders yet.</p></div>
                }
                else if (active.Count == 0 && archived.Count == 0)
                {
                    <div class="empty-boulders"><p>No boulders match your filters.</p></div>
                }
                else
                {
                    @foreach (var boulder in active)
                    {
                        <BoulderRow @key="boulder.Id" Boulder="boulder" Family="families.GetValueOrDefault(boulder.Id)" WallId="WallId" ShareToken="@ShareToken" Mine="Wall.Mine" ListQuery="@Browsing.ListQuery" />
                    }
                    @if (archived.Count > 0)
                    {
                        <details class="archive-section">
                            <summary class="archive-summary">Archive (@archived.Count)</summary>
                            @foreach (var boulder in archived)
                            {
                                <BoulderRow @key="boulder.Id" Boulder="boulder" Family="families.GetValueOrDefault(boulder.Id)" WallId="WallId" ShareToken="@ShareToken" Mine="Wall.Mine" ListQuery="@Browsing.ListQuery" />
                            }
                        </details>
                    }
                }
                </div>
                }
            </div>
        </div>

        <ViewSlot Name="ViewSlotName.WallBelow" Context="slot" />
    </div>
}

@code {
    private WallPanelGrid? grid;
    private BoulderFilter filter = new();
    private IReadOnlyList<BouldersDocumentBoulder> boulders = [];
    private IReadOnlyDictionary<Guid, Blocwerk.Core.Helpers.BoulderFamilyRow> families = new Dictionary<Guid, Blocwerk.Core.Helpers.BoulderFamilyRow>();
    private IReadOnlyList<BouldersDocumentBoulder> active = [];
    private IReadOnlyList<BouldersDocumentBoulder> archived = [];
    private int holdCount;
    private CachedWall? derivedFrom;
    private IReadOnlyList<BoulderFamilyRow> browseRows = [];

    /// <summary>Gets or sets the <c>?browse=</c> value: <c>holds</c> or <c>styles</c> for a card page.</summary>
    [SupplyParameterFromQuery(Name = BoulderBrowse.BrowseKey)]
    public string? Browse { get; set; }

    /// <summary>Gets or sets the <c>?style=</c> value: a style's name or <c>all</c>.</summary>
    [SupplyParameterFromQuery(Name = BoulderBrowse.StyleKey)]
    public string? Style { get; set; }

    /// <summary>Gets or sets the <c>?hold=</c> value: a hold type's name.</summary>
    [SupplyParameterFromQuery(Name = BoulderBrowse.HoldKey)]
    public string? Hold { get; set; }

    /// <summary>Gets or sets the <c>?mine=</c> value: one of the viewer's own lists (<c>favorites</c>).</summary>
    [SupplyParameterFromQuery(Name = BoulderBrowse.MineKey)]
    public string? Mine { get; set; }

    private BoulderBrowse Browsing => BoulderBrowse.From(Browse, Style, Hold, Mine);

    // The viewer's own lists on the landing: only a signed-in device holds marks.
    private IReadOnlyDictionary<BoulderMine, int>? MineCounts => !ShowsMine || Wall is null ? null : new Dictionary<BoulderMine, int>
    {
        [BoulderMine.Favorites] = BoulderList.MineCount(boulders, Wall.Mine, BoulderMine.Favorites),
    };

    private bool ShowBrowseCards => Browsing.Level != BoulderBrowseLevel.List;

    private string BrowseHref(BoulderBrowse level) => Navigation.GetUriWithQueryParameters(level.Query());

    // A share link or a kiosk holds no marks, so a list of the viewer's own (?mine=) is empty there.
    private BoulderFilter ListFilter => filter with { Style = Browsing.Style, HoldType = Browsing.HoldType, Mine = Browsing.Mine };

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Wall is not null)
        {
            (active, archived) = BoulderList.Apply(boulders, Wall.Mine, ListFilter, Wall.Holds);
        }
    }

    // The viewer's own filters need marks: a signed-in device's (a share link and a kiosk hold none).
    private bool ShowsMine => Store.Partition?.StartsWith("u-", StringComparison.Ordinal) == true;

    /// <inheritdoc />
    protected override void OnWallChanged()
    {
        filter = new BoulderFilter();
        (grid, derivedFrom, boulders, active, archived) = (null, null, [], [], []);
        browseRows = [];
    }

    /// <inheritdoc />
    protected override void OnWallRead()
    {
        if (Wall is null)
        {
            OnWallChanged();
            return;
        }

        if (!ReferenceEquals(derivedFrom, Wall))
        {
            // A new instance is a new read (a replaced document, a feed event): a new grid, so the viewer re-reads it.
            derivedFrom = Wall;
            grid = new WallPanelGrid(Wall.Wall!, Wall.Holds);
            holdCount = Wall.Holds?.Holds.Count(h => !h.Kept) ?? 0;
            boulders = ClassBoulders.Of(Wall);
            families = BoulderList.Families(boulders, Wall.Holds);
            browseRows = BoulderList.Visible(boulders).Select(b => families[b.Id]).ToList();
        }

        (active, archived) = BoulderList.Apply(boulders, Wall.Mine, ListFilter, Wall.Holds);
    }

    private void OnFilterChanged(BoulderFilter next)
    {
        filter = next;
        OnWallRead();
    }
}
