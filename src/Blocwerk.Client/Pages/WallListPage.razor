@page "/"
@page "/walls"
@implements IDisposable
@inject ClientStore Store
@* The wall list (the Server's /walls, "My Walls"): every wall the device holds for its partition, read-only — no
   "New Wall" and no join box. A card opens the wall's view in the client. /v/ itself shows it too, though the worker
   never hands "/" over (a declared route starts with a literal segment). *@
<PageTitle>My Walls - Blocwerk</PageTitle>

<div class="wall-list">
    <div class="list-header">
        <h1>My Walls</h1>
    </div>

    @if (cards is null)
    {
        <p class="loading">Loading...</p>
    }
    else if (cards.Count == 0)
    {
        <div class="empty-state">
            <p>No walls saved on this device yet. Open a wall online and it is saved for the next time you are offline.</p>
        </div>
    }
    else
    {
        <div class="wall-cards">
            @foreach (var wall in cards)
            {
                <a href="@ClientRoutes.WallLink(wall.WallId, null)" class="wall-card" data-bw-wall="@wall.WallId">
                    <div class="wall-card-photo">
                        @if (PhotoUrls.Thumbnail(wall.WallId, CardSha(wall.Wall!), null) is { } url)
                        {
                            <PanelPhoto Urls="[url]" Alt="@wall.Wall!.Name" />
                        }
                        else
                        {
                            <div class="no-photo">No Photo</div>
                        }
                    </div>
                    <div class="wall-card-info">
                        <h3>@wall.Wall!.Name</h3>
                        <span class="member-count">@BoulderCount(wall) boulder@(BoulderCount(wall) != 1 ? "s" : string.Empty)</span>
                    </div>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<CachedWall>? cards;

    /// <inheritdoc />
    public void Dispose() => Store.Changed -= OnChanged;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnChanged;
        await LoadAsync();
    }

    // The card's photo: the wall's own, else its origin panel's, as the Server's card shows the centre photo.
    private static string? CardSha(Blocwerk.Contracts.Documents.WallDocument wall) =>
        wall.PhotoSha ?? wall.Panels.OrderBy(p => p.Row).ThenBy(p => p.Col).FirstOrDefault(p => p.Sha is not null)?.Sha;

    private static int BoulderCount(CachedWall wall) => wall.VisibleBoulders.Count(b => !b.IsArchived);

    private async Task LoadAsync()
    {
        var read = new List<CachedWall>();
        foreach (var row in Store.Walls)
        {
            if (await Store.GetWallAsync(row.WallId) is { Wall: not null } wall)
            {
                read.Add(wall);
            }
        }

        cards = read.OrderBy(w => w.Wall!.Name, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });
}
