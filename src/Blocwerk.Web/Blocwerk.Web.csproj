<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- blazor.web.js ships in the Microsoft.AspNetCore.App.Internal.Assets package, which the SDK only adds to the
         restore when the project has .razor Content. docker/Dockerfile restores from the csproj files alone (no .razor
         yet) and publishes with no restore of its own, so without this the image ships no _framework/blazor.web.js
         and every page stays at "Loading..." (0.5.0). -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <!-- Routes all Serilog output (incl. ILogger routed through Serilog) to the OTLP collector. -->
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
    <!-- Serves a Prometheus /metrics scrape endpoint so metrics are readable over HTTP. -->
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <!-- Renders the kiosk pairing QR code. Already in the solution for the TOTP enrolment code
         (Blocwerk.Authentication); this project walks its module matrix into inline SVG. -->
    <PackageReference Include="QRCoder" />
    <!-- Hold recognition (in-process mode), from zannagh/blocwerk-recognition. -->
    <PackageReference Include="Blocwerk.HoldDetection" />
    <!-- YoloDotNet (inside Blocwerk.HoldDetection) pulls in the GPU ONNX runtime, which has no arm64 build and
         would put a second libonnxruntime next to the CPU one: excluded in every project that references the package. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blocwerk.Core.Tests" />
  </ItemGroup>

  <!-- Dev-only page for wall3d.js screenshots. Its harness scripts serve wwwroot straight from disk, so
       it only has to stay out of Release: removing it from Content drops it from the static web assets
       manifest and the publish output, so production never serves it. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Remove="wwwroot\js\wall3d-harness.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blocwerk.Core\Blocwerk.Core.csproj" />
    <ProjectReference Include="..\Blocwerk.Authentication\Blocwerk.Authentication.csproj" />
    <ProjectReference Include="..\Blocwerk.Shared.Ui\Blocwerk.Shared.Ui.csproj" />
    <!-- The offline gym client (standalone WASM, Phase 3): its static web assets are served under /v/ (Program.cs). -->
    <ProjectReference Include="..\Blocwerk.Client\Blocwerk.Client.csproj" />
  </ItemGroup>
</Project>
