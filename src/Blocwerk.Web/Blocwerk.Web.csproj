<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <!-- Routes all Serilog output (incl. ILogger routed through Serilog) to the OTLP collector. -->
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
    <!-- Serves a Prometheus /metrics scrape endpoint so metrics are readable over HTTP. -->
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <!-- Renders the kiosk pairing QR code. Already in the solution for the TOTP enrolment code
         (Blocwerk.Authentication); this project walks its module matrix into inline SVG. -->
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blocwerk.Core.Tests" />
  </ItemGroup>

  <!-- Dev-only page for wall3d.js screenshots. Its harness scripts serve wwwroot straight from disk, so
       it only has to stay out of Release: removing it from Content drops it from the static web assets
       manifest and the publish output, so production never serves it. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Remove="wwwroot\js\wall3d-harness.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blocwerk.Core\Blocwerk.Core.csproj" />
    <ProjectReference Include="..\Blocwerk.Authentication\Blocwerk.Authentication.csproj" />
    <ProjectReference Include="..\Blocwerk.HoldDetection\Blocwerk.HoldDetection.csproj" />
  </ItemGroup>
</Project>
