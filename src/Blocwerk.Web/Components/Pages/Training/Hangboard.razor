@page "/training/hangboard"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ITrainingService TrainingService
@inject NavigationManager Navigation

<PageTitle>Hangboard - Blocwerk</PageTitle>

<div class="training-page">
    <div class="page-header">
        <a href="/activity" class="back-link">&larr; Activity</a>
        <h1>Hangboard</h1>
    </div>

    @if (_finished)
    {
        <div class="finish-card">
            <h2>Session Complete</h2>
            <div class="finish-stats">
                <div class="finish-stat">
                    <span class="finish-value">@_sets.Count</span>
                    <span class="finish-label">Sets</span>
                </div>
                <div class="finish-stat">
                    <span class="finish-value">@FormatTotal(_sets.Sum(s => s.TotalSeconds))</span>
                    <span class="finish-label">Total Time</span>
                </div>
            </div>
            <p class="finish-detail">@_edgeSize mm edge @(_weight > 0 ? $"+ {_weight} kg" : "")</p>
            <a href="/activity" class="btn-done">Back to Activity</a>
        </div>
    }
    else
    {
        <div class="setup-section">
            <div class="form-group">
                <label>Edge Size (mm)</label>
                <div class="stepper">
                    <button class="step-btn" @onclick="() => _edgeSize = Math.Max(6, _edgeSize - 2)">&minus;</button>
                    <span class="step-value">@_edgeSize</span>
                    <button class="step-btn" @onclick="() => _edgeSize += 2">+</button>
                </div>
            </div>
            <div class="form-group">
                <label>Additional Weight (kg)</label>
                <div class="stepper">
                    <button class="step-btn" @onclick="() => _weight = Math.Max(0, _weight - 2.5)">&minus;</button>
                    <span class="step-value">@_weight.ToString("F1")</span>
                    <button class="step-btn" @onclick="() => _weight += 2.5">+</button>
                </div>
            </div>
        </div>

        <div class="timer-section">
            @if (_sets.Count > 0)
            {
                <div class="sets-done">
                    @foreach (var (s, idx) in _sets.Select((s, i) => (s, i)))
                    {
                        <span class="set-chip">Set @(idx + 1): @s.TotalSeconds.ToString("F1")s</span>
                    }
                </div>
            }

            <div class="timer-display">
                @if (_isRunning)
                {
                    <span class="timer-value">@FormatTimer(_elapsed)</span>
                }
                else if (_sets.Count > 0)
                {
                    <span class="timer-value rest">Rest</span>
                }
                else
                {
                    <span class="timer-value idle">Ready</span>
                }
            </div>

            @if (_isRunning)
            {
                <button class="btn-stop" @onclick="StopTimer">Stop</button>
            }
            else
            {
                <button class="btn-start" @onclick="StartTimer">Start</button>
            }
        </div>

        @if (_sets.Count > 0 && !_isRunning)
        {
            <button class="btn-finish" @onclick="FinishSession" disabled="@_isSaving">
                @(_isSaving ? "Saving..." : $"Finish ({_sets.Count} set{(_sets.Count != 1 ? "s" : "")})")
            </button>
            <button class="btn-discard" @onclick="DiscardSession">Discard</button>
        }
    }
</div>

@code {
    private int _edgeSize = 20;
    private double _weight;
    private bool _isRunning;
    private bool _finished;
    private bool _isSaving;
    private List<TimeSpan> _sets = [];
    private DateTimeOffset _startTime;
    private TimeSpan _elapsed;
    private Timer? _timer;

    private void StartTimer()
    {
        _startTime = DateTimeOffset.UtcNow;
        _elapsed = TimeSpan.Zero;
        _isRunning = true;
        _timer = new Timer(Tick, null, 0, 100);
    }

    private void Tick(object? state)
    {
        _elapsed = DateTimeOffset.UtcNow - _startTime;
        InvokeAsync(StateHasChanged);
    }

    private void StopTimer()
    {
        _timer?.Dispose();
        _timer = null;
        _isRunning = false;
        _sets.Add(_elapsed);
    }

    private async Task FinishSession()
    {
        if (_sets.Count == 0) return;
        _isSaving = true;

        var totalDuration = TimeSpan.FromSeconds(_sets.Sum(s => s.TotalSeconds));
        await TrainingService.SaveHangboardSessionAsync(_edgeSize, _weight, totalDuration, _sets.Count);

        _finished = true;
        _isSaving = false;
    }

    private void DiscardSession()
    {
        _sets.Clear();
        _elapsed = TimeSpan.Zero;
    }

    private static string FormatTimer(TimeSpan ts) =>
        ts.TotalMinutes >= 1 ? $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}.{ts.Milliseconds / 100}" : $"{ts.Seconds}.{ts.Milliseconds / 100}s";

    private static string FormatTotal(double totalSeconds) =>
        totalSeconds >= 60 ? $"{(int)(totalSeconds / 60)}m {(int)(totalSeconds % 60)}s" : $"{totalSeconds:F0}s";

    public void Dispose()
    {
        _timer?.Dispose();
    }
}

