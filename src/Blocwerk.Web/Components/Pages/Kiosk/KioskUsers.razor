@page "/kiosk/users"
@page "/kiosk/users/{UserId:guid}"
@inject IKioskContext KioskContext
@inject IKioskService KioskService
@inject ICurrentUserService CurrentUserService
@inject IBoulderService BoulderService
@inject ILogger<KioskUsers> Logger

@* Static SSR by design, exactly like OAuthSelect: no @rendermode, no @onclick anywhere. Picking a
   user changes the auth COOKIE, and CookieAuthenticationStateProvider never raises a change
   notification — so the switch has to be a real navigation (form POST -> 302), not an in-circuit
   state flip. It also means the picker keeps working on a tablet whose websocket never comes up. *@

<PageTitle>Who's climbing? - Blocwerk</PageTitle>

<div class="kiosk-picker">
    @if (!KioskContext.IsKiosk)
    {
        @* Not a registered tablet. Nothing here is meaningful, and there is no wall id to fall back
           on — the only one we would ever trust comes from the kiosk context itself. *@
        <div class="kiosk-picker-head">
            <h1>Not a kiosk</h1>
            <p>This device isn't registered as a wall kiosk.</p>
        </div>
        <a href="/" class="kiosk-row kiosk-row-secondary">Back to Blocwerk</a>
    }
    else
    {
        @* No error banner here: MainLayout already renders one for ?kiosk_pin_error=1 on every kiosk
           page, and act-as now redirects failures back to this route — two banners on one screen. *@
        @if (_current is not null)
        {
            <div class="kiosk-picker-head">
                <h1>You're climbing as</h1>
            </div>
            <div class="kiosk-current">
                <UserAvatar UserId="_current.Id" Name="@_current.Name" HasAvatar="_current.HasAvatar"
                            CssClass="kiosk-avatar" />
                <span class="kiosk-current-name">@_current.Name</span>
            </div>
            <form method="post" action="/kiosk/release" data-enhance-nav="false">
                <AntiforgeryToken />
                <button type="submit" class="kiosk-row kiosk-row-danger">Log out</button>
            </form>
            <p class="kiosk-note">
                This session also ends by itself after 30 minutes without anyone touching the tablet.
            </p>
        }
        else if (_pinTarget is not null)
        {
            @* Second step: one user, one PIN, entered on the on-screen numpad. A per-row inline PIN
               input would put a keypad-sized target next to every name on a list that can run long;
               a dedicated step keeps the rows finger-sized.

               The tablet is touch-only, so nothing here may summon the OS keyboard: the field that
               actually posts is readonly + inputmode="none" and visually hidden, and the numpad
               below drives it from wwwroot/js/kiosk-numpad.js. Same contract as kiosk-idle.js and
               kiosk-pair.js — the form, its antiforgery token and its hidden userId are all
               SERVER-rendered, and the script only ever appends digits and calls submit(). It never
               reads, moves or reconstructs the token, and there is no fetch anywhere near it. *@
            <div class="kiosk-picker-head">
                <h1>Enter PIN</h1>
            </div>
            <div class="kiosk-current kiosk-current-compact">
                <UserAvatar UserId="_pinTarget.UserId" Name="@_pinTarget.Name"
                            HasAvatar="_pinTarget.HasAvatar" CssClass="kiosk-avatar" />
                <span class="kiosk-current-name">@_pinTarget.Name</span>
            </div>
            <KioskPendingBanner Type="_pendingType" BoulderName="@_pendingBoulderName" />
            <form method="post" action="/kiosk/act-as" data-enhance-nav="false" class="kiosk-pin-form"
                  id="bw-kiosk-pin-form" data-pin-length="@_pinTarget.PinLength">
                <AntiforgeryToken />
                <input type="hidden" name="userId" value="@_pinTarget.UserId" />
                @* A pending ascent tapped on a boulder page, carried through the sign-in so it can be
                   logged. It is BOUND to the member who was picked when it was tapped: ActAs drops
                   it unless pendingUserId matches whoever actually signs in, so a mistyped PIN
                   followed by somebody else picking themselves cannot credit them. The boulder is
                   re-checked against the device cookie's wall before anything is written. *@
                @if (HasPendingAction)
                {
                    <input type="hidden" name="pendingBoulderId" value="@PendingBoulderId" />
                    <input type="hidden" name="pendingType" value="@PendingType" />
                    <input type="hidden" name="pendingUserId" value="@PendingUserId" />
                }

                @* The real field. Off-screen rather than display:none so it still counts as a form
                   control; readonly and inputmode="none" together keep every mobile browser from
                   raising a soft keyboard if it is somehow focused. *@
                <input id="kiosk-pin" class="kiosk-pin-value" type="password" name="pin"
                       inputmode="none" autocomplete="off" maxlength="8" readonly required
                       tabindex="-1" aria-hidden="true" />

                @* Masked read-out: one dot per entered digit, so a bystander sees the count and
                   nothing else. Pre-rendered at the known length when we have one. *@
                <div class="kiosk-pin-display" id="bw-kiosk-pin-display" aria-hidden="true">
                    @for (var i = 0; i < DotCount; i++)
                    {
                        <span class="kiosk-pin-dot"></span>
                    }
                </div>
                <p class="kiosk-pin-count" id="bw-kiosk-pin-count" role="status" aria-live="polite">
                    @(_pinTarget.PinLength > 0 ? $"0 of {_pinTarget.PinLength} digits" : "No digits yet")
                </p>

                <div class="kiosk-numpad">
                    @for (var digit = 1; digit <= 9; digit++)
                    {
                        var value = digit.ToString();
                        <button type="button" class="kiosk-numpad-key" data-bw-pin-key="@value"
                                aria-label="@value">@value</button>
                    }
                    <span class="kiosk-numpad-gap" aria-hidden="true"></span>
                    <button type="button" class="kiosk-numpad-key" data-bw-pin-key="0" aria-label="0">0</button>
                    <button type="button" class="kiosk-numpad-key kiosk-numpad-back"
                            data-bw-pin-key="back" aria-label="Delete last digit">⌫</button>
                </div>

                @if (_pinTarget.PinLength <= 0)
                {
                    @* Fallback for members who set their PIN before the length was recorded: without
                       a length there is nothing to auto-submit on, so they get the old button back
                       rather than a numpad that never finishes. It disappears the next time they
                       re-set their PIN from their own device. *@
                    <button type="submit" class="kiosk-row kiosk-row-primary kiosk-pin-submit">Start climbing</button>
                }
            </form>
            @* Deliberately small: a mistap must not strand somebody on this screen until the idle
               timer fires, but it is not a second primary action competing with the pad. *@
            <a href="@ListUrl" class="kiosk-pin-back">Not you? Pick someone else</a>
        }
        else if (_confirmTarget is not null)
        {
            @* Deep-linked at a member who has no PIN. Falling through to the full list here would
               make them tap their own name a second time, on a list they were already routed past.
               One confirmation instead: who it is, what is about to be logged, one button. The form
               is the same real POST the no-PIN rows below use — same action, same antiforgery
               token, same hidden fields — so nothing about the identity switch changes. *@
            <div class="kiosk-picker-head">
                <h1>Ready?</h1>
            </div>
            <div class="kiosk-current kiosk-current-compact">
                <UserAvatar UserId="_confirmTarget.UserId" Name="@_confirmTarget.Name"
                            HasAvatar="_confirmTarget.HasAvatar" CssClass="kiosk-avatar" />
                <span class="kiosk-current-name">@_confirmTarget.Name</span>
            </div>
            <KioskPendingBanner Type="_pendingType" BoulderName="@_pendingBoulderName" />
            <form method="post" action="/kiosk/act-as" data-enhance-nav="false">
                <AntiforgeryToken />
                <input type="hidden" name="userId" value="@_confirmTarget.UserId" />
                @if (HasPendingAction)
                {
                    <input type="hidden" name="pendingBoulderId" value="@PendingBoulderId" />
                    <input type="hidden" name="pendingType" value="@PendingType" />
                    <input type="hidden" name="pendingUserId" value="@PendingUserId" />
                }
                <button type="submit" class="kiosk-row kiosk-row-primary">Start climbing</button>
            </form>
            <a href="@ListUrl" class="kiosk-pin-back">Not you? Pick someone else</a>
        }
        else
        {
            <div class="kiosk-picker-head">
                <h1>Who's climbing?</h1>
                <p>Pick yourself to log attempts on this wall. Browsing works without picking anyone.</p>
            </div>

            <KioskPendingBanner Type="_pendingType" BoulderName="@_pendingBoulderName" />

            @if (_users.Count == 0)
            {
                <p class="kiosk-empty">
                    Nobody on this wall has turned on kiosk sign-in yet. Members can enable it from the
                    wall's page on their own phone.
                </p>
            }
            else
            {
                <ul class="kiosk-user-list">
                    @foreach (var user in _users)
                    {
                        <li>
                            @if (user.RequiresPin)
                            {
                                @* PIN users go to the second step; the id in that URL is only ever
                                   re-checked against this same consenting list. *@
                                <a href="@PinStepUrl(user.UserId)" class="kiosk-row">
                                    <UserAvatar UserId="user.UserId" Name="@user.Name"
                                                HasAvatar="user.HasAvatar" CssClass="kiosk-avatar" />
                                    <span class="kiosk-row-name">@user.Name</span>
                                    <span class="kiosk-row-hint">PIN</span>
                                </a>
                            }
                            else
                            {
                                @* No PIN: one small form per row, posting straight to act-as. The wall
                                   is taken from the device cookie server-side, never from here. *@
                                <form method="post" action="/kiosk/act-as" data-enhance-nav="false">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    @if (HasPendingAction)
                                    {
                                        <input type="hidden" name="pendingBoulderId" value="@PendingBoulderId" />
                                        <input type="hidden" name="pendingType" value="@PendingType" />
                                        <input type="hidden" name="pendingUserId" value="@PendingUserId" />
                                    }
                                    <button type="submit" class="kiosk-row">
                                        <UserAvatar UserId="user.UserId" Name="@user.Name"
                                                    HasAvatar="user.HasAvatar" CssClass="kiosk-avatar" />
                                        <span class="kiosk-row-name">@user.Name</span>
                                    </button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }

            <p class="kiosk-note">
                A session ends by itself after 30 minutes without anyone touching the tablet.
            </p>
        }
    }
</div>

@code {
    /// <summary>The user to collect a PIN for, when the second-step route was hit.</summary>
    [Parameter]
    public Guid? UserId { get; set; }

    /// <summary>
    /// A boulder whose ascent was tapped anonymously on the tablet before anybody was picked. It is
    /// only ever passed through to <c>/kiosk/act-as</c>, which re-checks it against the wall in the
    /// device cookie — nothing here treats it as authority for anything.
    /// </summary>
    [SupplyParameterFromQuery(Name = "pendingBoulderId")]
    public Guid? PendingBoulderId { get; set; }

    /// <summary>The ascent type that goes with <see cref="PendingBoulderId"/>; parsed server-side.</summary>
    [SupplyParameterFromQuery(Name = "pendingType")]
    public string? PendingType { get; set; }

    /// <summary>
    /// The member the ascent was picked FOR. <c>/kiosk/act-as</c> drops the pending action unless
    /// this matches whoever actually signs in, so a pending ascent can never be re-attributed by
    /// somebody else reaching this screen. Passed straight through; never trusted here.
    /// </summary>
    [SupplyParameterFromQuery(Name = "pendingUserId")]
    public Guid? PendingUserId { get; set; }

    private bool HasPendingAction => PendingBoulderId is not null && !string.IsNullOrWhiteSpace(PendingType);

    /// <summary>The pending query tail, shared by every link that has to keep the ascent alive.</summary>
    private string PendingQuery
    {
        get
        {
            if (!HasPendingAction)
            {
                return string.Empty;
            }

            var query = $"pendingBoulderId={PendingBoulderId}&pendingType={Uri.EscapeDataString(PendingType!)}";
            return PendingUserId is { } pendingUserId ? $"{query}&pendingUserId={pendingUserId}" : query;
        }
    }

    /// <summary>The plain user list, keeping any pending ascent alive across the "pick someone else" link.</summary>
    private string ListUrl => HasPendingAction ? $"/kiosk/users?{PendingQuery}" : "/kiosk/users";

    private string PinStepUrl(Guid userId) => HasPendingAction
        ? $"/kiosk/users/{userId}?{PendingQuery}"
        : $"/kiosk/users/{userId}";

    /// <summary>
    /// How many masked slots the PIN read-out starts with: one per expected digit when the length is
    /// known, otherwise none — the script appends them as digits are tapped.
    /// </summary>
    private int DotCount => _pinTarget is { PinLength: > 0 } target ? target.PinLength : 0;

    private IReadOnlyList<KioskUserInfo> _users = [];
    private KioskUserInfo? _pinTarget;
    private KioskUserInfo? _confirmTarget;
    private User? _current;
    private AttemptType? _pendingType;
    private string? _pendingBoulderName;

    protected override async Task OnParametersSetAsync()
    {
        _users = [];
        _pinTarget = null;
        _confirmTarget = null;
        _current = null;
        _pendingType = null;
        _pendingBoulderName = null;

        if (!KioskContext.IsKiosk || KioskContext.KioskWallId is not { } wallId)
        {
            return;
        }

        // Somebody is already acting as a member: the page becomes "you're climbing as X / log out"
        // rather than a picker, so a second pick can't be stacked on top of a live session.
        try
        {
            _current = await CurrentUserService.GetCurrentUserAsync();
            return;
        }
        catch (UnauthorizedAccessException)
        {
            // Anonymous tablet — the normal state while the picker is on screen.
        }

        // GetConsentingUsersAsync does NO authorisation: the wall id must come from the validated
        // kiosk context and nowhere else.
        _users = await KioskService.GetConsentingUsersAsync(wallId);

        if (UserId is { } targetId)
        {
            // Re-resolve the routed id against the consenting list, so neither second step can ever
            // be shown for someone who is not actually pickable on this wall.
            var target = _users.FirstOrDefault(u => u.UserId == targetId);
            _pinTarget = target is { RequiresPin: true } ? target : null;
            _confirmTarget = target is { RequiresPin: false } ? target : null;
        }

        await ResolvePendingAsync(wallId);
    }

    /// <summary>
    /// Works out what the banner should say. Best-effort throughout: an unresolvable boulder or an
    /// unparsable type costs the name or the whole banner, never the picker.
    /// </summary>
    private async Task ResolvePendingAsync(Guid wallId)
    {
        if (!HasPendingAction
            || !Enum.TryParse<AttemptType>(PendingType, ignoreCase: true, out var type)
            || !Enum.IsDefined(type))
        {
            return;
        }

        _pendingType = type;

        if (PendingBoulderId is not { } boulderId)
        {
            return;
        }

        try
        {
            // GetBoulderAsync reads as the anonymous kiosk, which is already confined to this
            // tablet's own wall; the explicit comparison is the second lock, so a guessed id from
            // another wall cannot turn this banner into a name oracle.
            var boulder = await BoulderService.GetBoulderAsync(boulderId);
            if (boulder is not null && boulder.WallId == wallId)
            {
                _pendingBoulderName = boulder.Name;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(
                ex, "Could not resolve the pending kiosk boulder {BoulderId} for the banner", boulderId);
        }
    }
}
