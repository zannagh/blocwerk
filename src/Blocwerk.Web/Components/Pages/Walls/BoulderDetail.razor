@page "/walls/{WallId:guid}/boulders/{BoulderId:guid}"
@page "/walls/{WallId:guid}/boulders/{BoulderId:guid}/shared/{ShareToken}"
@rendermode InteractiveServer
@inject IBoulderService BoulderService
@inject IBoulderFeedbackService FeedbackService
@inject IAttemptService AttemptService
@inject IWallService WallService
@inject IWallPanelService WallPanelService
@inject WallCacheState Cache
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject CircuitEditActivity EditActivity
@using Blocwerk.Web.Components.Shared
@using Blocwerk.Web.State
@implements IAsyncDisposable

<PageTitle>@(_boulder?.Name ?? "Boulder") - Blocwerk</PageTitle>

@if (_boulder == null)
{
    <p class="loading">Loading...</p>
}
else
{
    <div class="boulder-detail">
        <div class="page-header">
            @{ var backUrl = !string.IsNullOrEmpty(ShareToken) ? $"/walls/{WallId}/shared/{ShareToken}?view=boulders" : $"/walls/{WallId}?view=boulders"; }
            <a href="@backUrl" class="back-link">&larr; Back to boulder list</a>
            <div class="title-row">
                <h1>@_boulder.Name</h1>
                @if (!string.IsNullOrEmpty(_boulder.Grade))
                {
                    <span class="grade-badge">@_boulder.Grade</span>
                }
                @if (_boulder.IsDraft)
                {
                    <span class="draft-badge">draft</span>
                }
                @if (_boulder.IsHistoric)
                {
                    <span class="historic-badge">historic</span>
                }
                @if (_boulder.IsArchived)
                {
                    <span class="archived-badge">archived</span>
                }
                <div class="title-actions">
                    @if (!_isAnonymous)
                    {
                        <BoulderFavoriteToggle BoulderId="_boulder.Id" IsFavorite="_isFavorite" />
                    }
                    @if ((_isCreator || _isAdmin || _isSetter) && !_isAnonymous && !_editMeta)
                    {
                        <button class="btn-icon boulder-edit-btn" @onclick="StartEditMeta" title="Rename or change grade">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                                <path d="M12 20h9" />
                                <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                            </svg>
                        </button>
                    }
                    @if (CanFullRevise)
                    {
                        <a href="/walls/@WallId/boulders/@BoulderId/revise" class="btn-revise">Revise</a>
                    }
                </div>
            </div>

            @if (_editMeta)
            {
                <div class="boulder-meta-edit">
                    <input class="boulder-name-input" maxlength="128" placeholder="Boulder name"
                           @bind="_editName" @bind:event="oninput" />
                    <GradePicker @bind-Value="_editGrade" />
                    <div class="meta-edit-actions">
                        <button class="proposal-btn accept" @onclick="SaveMeta"
                                disabled="@string.IsNullOrWhiteSpace(_editName)">Save</button>
                        <button class="proposal-btn reject" @onclick="CancelEditMeta">Cancel</button>
                    </div>
                </div>
            }

            @if (_boulder.Setters.Count > 0)
            {
                <p class="meta">Set by @SettersDisplay &middot; added by @_boulder.CreatedBy.Name &middot; <LocalTime Value="@_boulder.CreatedAt" Format="LocalTimeFormat.Date" /></p>
            }
            else
            {
                <p class="meta">by @_boulder.CreatedBy.Name &middot; <LocalTime Value="@_boulder.CreatedAt" Format="LocalTimeFormat.Date" /></p>
            }

        </div>

        @if (_boulder.IsDraft)
        {
            <div class="bw-draft-notice">
                @* Drafts are visible to every wall member now, but can't be climbed until published.
                   Only the creator sees the edit/publish actions. *@
                <p>This is a draft — it can't be climbed until it is published.</p>
                @if (_isCreator || _isAdmin || _isSetter)
                {
                    <div class="draft-actions">
                        <a href="/walls/@WallId/boulders/@BoulderId/revise" class="btn-revise">Edit</a>
                        <button class="btn-publish" @onclick="PublishDraft"
                                disabled="@(_boulder.BoulderHolds.Count == 0)">
                            Publish
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_publishError))
                    {
                        <div class="error-msg">@_publishError</div>
                    }
                }
            </div>
        }

        @if (_boulder.IsHistoric && (_isCreator || _isAdmin || _isSetter))
        {
            <div class="bw-revision-notice">
                <p>
                    @(CanViewHistoric
                        ? "The wall was rebuilt since this boulder was set. Use \"Then\" to see it on the old wall, then remap it onto the new holds."
                        : "The wall has changed since this boulder was created. Some holds may no longer exist.")
                </p>
                <div class="revision-actions">
                    <a href="/walls/@WallId/boulders/@BoulderId/revise" class="btn-revise">Revise Boulder</a>
                    @* Archiving stays a creator-only action; only the revise entry point is opened to admins. *@
                    @if (_isCreator)
                    {
                        @if (_boulder.IsArchived)
                        {
                            <button class="btn-archive" @onclick="UnarchiveBoulder">Restore from archive</button>
                        }
                        else
                        {
                            <button class="btn-archive" @onclick="ArchiveBoulder">Archive</button>
                        }
                    }
                </div>
            </div>
        }

        @if (_activeProposal != null && _isCreator)
        {
            <div class="bw-grade-proposal-notice creator">
                <p><strong>@_activeProposal.ProposedBy.Name</strong> proposed changing the grade to <strong>@_activeProposal.ProposedGrade</strong></p>
                <div class="proposal-actions">
                    <button class="proposal-btn accept" @onclick="AcceptProposal">Accept</button>
                    <button class="proposal-btn reject" @onclick="RejectProposal">Reject</button>
                </div>
            </div>
        }
        else if (_activeProposal != null)
        {
            <div class="bw-grade-proposal-notice viewer">
                <p>A grade change to <strong>@_activeProposal.ProposedGrade</strong> has been proposed by @_activeProposal.ProposedBy.Name</p>
            </div>
        }

        @* The Photo/Schematic switch was removed; _viewMode stays in code (defaults to Photo) so the
           boulder photo renders as before and the schematic view remains reachable programmatically.
           The historic Then/Now toggle is a separate feature and keeps its own view-toggle. *@
        @if (CanViewHistoric)
        {
            <div class="view-toggle">
                <button class="toggle-btn @(_showHistoric ? "active" : "")" @onclick="ToggleHistoric"
                        title="@(_showHistoric ? "Showing the wall as it was when this boulder was set" : "Showing the current wall")">
                    @(_showHistoric ? "Then" : "Now")
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_boulder.FootColorOnly) || _boulder.NoMatch)
        {
            <div class="boulder-info-banners">
                @if (!string.IsNullOrEmpty(_boulder.FootColorOnly))
                {
                    <div class="boulder-info-banner">
                        All @HoldPalette.DisplayName(_boulder.FootColorOnly).ToLowerInvariant() holds may be used as footholds.
                        @if (ColorRuleHolds.Count == 0)
                        {
                            <span class="rule-warn">— no such holds on this wall</span>
                        }
                    </div>
                }
                @if (_boulder.NoMatch)
                {
                    <div class="boulder-info-banner">
                        No matching — you may not use two hands, or a hand and a foot, on the same hold.
                    </div>
                }
            </div>
        }

        @if (_viewMode == ViewMode.Photo)
        {
            <WallDimControl />
            @if (UsingMultiPanel)
            {
                @* Big wall: show the panel holding most of the boulder's holds and let the user
                   step to the neighbouring panels that carry its other holds. *@
                <MultiPanelViewer WallId="WallId" Panels="_livePanels"
                                  StartCol="_startPanelCol" StartRow="_startPanelRow"
                                  ArrowMode="MultiPanelViewer.ArrowDisplayMode.HoldsOnly"
                                  HoldsByPanel="_holdsByPanel"
                                  HighlightedHoldIds="_highlightedHoldIds"
                                  FootHoldIds="FootHoldIds"
                                  HoldColor="BoulderHoldColorOf"
                                  HighlightedPanelIds="_highlightedPanelIds"
                                  EnableSwipe="true"
                                  LensOverlay="true" />
            }
            else
            {
                @* Zoom geometry is owned by JS via `--zoom` (wwwroot/js/viewport.js). *@
                <div class="photo-viewport photo-section@(_frame != null ? " bw-framed" : "")" @ref="_photoViewportRef">
                    @* data-lens-overlay marks this editor so the long-press magnifier bakes the marked-hold
                       overlay into the lens — boulder detail only; the wall view's editor is never marked. *@
                    <div class="photo-editor" data-lens-overlay="true">
                        <img src="@PhotoUrl" alt="Wall" class="wall-photo" />
                        <svg class="hold-overlay" viewBox="0 0 100 100" preserveAspectRatio="none">
                            @* The "feet of one colour only" rule is shown as an info banner above the
                               image, not by painting every wall hold of that colour. Only the boulder's
                               own holds (including dedicated orange footholds) are drawn here. *@
                            @foreach (var bh in _boulder.BoulderHolds)
                            {
                                @if (bh.Hold.ShapePoints is { Count: >= 3 })
                                {
                                    <polygon @key="bh.HoldId" points="@ShapePolygon(bh.Hold)"
                                             fill="@BoulderHoldColors.FillFor(bh.Type, bh.Usage)"
                                             stroke="@BoulderHoldColors.Stroke(bh.Type)" stroke-width="0.5" />
                                }
                                else
                                {
                                    <circle @key="bh.HoldId" cx="@F(bh.Hold.X * 100)" cy="@F(bh.Hold.Y * 100)"
                                            r="@F(bh.Hold.Radius * 100)"
                                            fill="@BoulderHoldColors.FillFor(bh.Type, bh.Usage)"
                                            stroke="@BoulderHoldColors.Stroke(bh.Type)" stroke-width="0.5" />
                                }
                            }
                        </svg>
                    </div>
                </div>
            }
        }
        else if (_wallHolds != null)
        {
            <WallSchematicView Holds="_wallHolds" Angle="_boulder.Wall.Angle"
                               HighlightedHoldIds="_boulderHoldIds" FootHoldIds="FootHoldIds" />
        }

        <BoulderRulesSummary Boulder="_boulder" />

        @if (!_isAnonymous)
        {
            @* A draft can't be logged (the server rejects it, the offline queue drops it as
               permanent); don't offer the ascent buttons until it's published. *@
            @if (!_boulder.IsDraft)
            {
                <BoulderAttemptBar BoulderId="_boulder.Id" Summary="_summary" />
            }

            <div class="rating-section">
                <div class="rating-summary">
                    @if (_rating.Count > 0)
                    {
                        <StarRating Value="@(_rating.Average ?? 0)" ReadOnly="true" />
                        <span class="rating-avg">@_rating.Average?.ToString("0.0")</span>
                        <span class="rating-count">(@_rating.Count rating@(_rating.Count != 1 ? "s" : ""))</span>
                    }
                    else
                    {
                        <span class="rating-empty">No ratings yet</span>
                    }
                </div>
                <div class="rating-mine">
                    <span class="rating-mine-label">Your rating</span>
                    <StarRating Value="@(_rating.MyRating ?? 0)" ActionBoulderId="_boulder.Id"
                                ContainerId="bw-my-rating" />
                    @if (_rating.MyRating.HasValue)
                    {
                        @* Server-only: there is no "remove rating" action in the offline
                           queue, so this needs a live circuit. Re-rating works offline. *@
                        <button class="rating-clear" @onclick="ClearRating" title="Clear your rating">clear</button>
                    }
                </div>
            </div>

            @if (!_boulder.IsDraft)
            {
                <details class="backdate-card">
                    <summary>Log at a specific time</summary>
                    <div class="backdate-body">
                        <label class="backdate-label" for="bw-backdate">When did you climb it?</label>
                        <input id="bw-backdate" type="datetime-local" class="backdate-input" @bind="_backdateTime" />
                        <div class="attempt-buttons">
                            <button type="button" class="attempt-btn try" @onclick="() => LogBackdated(AttemptType.Attempt)">Attempt</button>
                            <button type="button" class="attempt-btn send" @onclick="() => LogBackdated(AttemptType.Send)">Send</button>
                            <button type="button" class="attempt-btn flash" @onclick="() => LogBackdated(AttemptType.Flash)">Flash</button>
                        </div>
                    </div>
                </details>
            }

            @if (!_isCreator)
            {
                @if (_showGradeForm)
                {
                    <div class="grade-propose-form">
                        <GradePicker @bind-Value="_proposedGrade" />
                        <div class="grade-propose-actions">
                            <button class="proposal-btn accept" @onclick="SubmitGradeProposal"
                                    disabled="@(string.IsNullOrEmpty(_proposedGrade))">Propose</button>
                            <button class="proposal-btn reject" @onclick="CancelGradeForm">Cancel</button>
                        </div>
                    </div>
                }
                else
                {
                    <button class="btn-propose-grade" @onclick="ShowGradeForm">Propose different grade</button>
                }
            }
        }
        else
        {
            <div class="bw-anon-notice">
                <a href="/account/login">Log in</a> to log attempts and comment.
            </div>
        }

        <BoulderBetaVideos @ref="_betaVideos" BoulderId="BoulderId" CurrentUserId="_currentUserId"
                           IsAnonymous="_isAnonymous" ShareToken="@ShareToken"
                           Uploaded="OnBetaVideoUploaded" />

        <BoulderActivityFeed @ref="_activityFeed" BoulderId="BoulderId" />

        <BoulderComments @ref="_commentList" BoulderId="BoulderId"
                         CurrentUserId="_currentUserId" IsAnonymous="_isAnonymous" />

        @if (!_isAnonymous && _attempts.Count > 0)
        {
            <div class="history-section">
                <h2>History</h2>
                @foreach (var attempt in _attempts)
                {
                    <div class="attempt-row">
                        <div class="attempt-info">
                            <span class="attempt-type @attempt.Type.ToString().ToLower()">@attempt.Type</span>
                            <span class="attempt-user">@attempt.User.Name</span>
                        </div>
                        <span class="attempt-time"><LocalTime Value="@attempt.Timestamp" Format="LocalTimeFormat.DateTime" /></span>
                        @if (attempt.UserId == _currentUserId)
                        {
                            <button class="delete-btn" @onclick="() => DeleteAttempt(attempt.Id)">x</button>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(_toast))
{
    <div class="toast-msg">@_toast</div>
}

@code {
    [Parameter] public Guid WallId { get; set; }
    [Parameter] public Guid BoulderId { get; set; }
    [Parameter] public string? ShareToken { get; set; }

    private Boulder? _boulder;
    private List<Attempt> _attempts = [];
    private AttemptSummary _summary = new(0, false, false);
    private Guid _currentUserId;
    private bool _isAnonymous;
    private bool _isCreator;
    private bool _isAdmin;
    private bool _isSetter;
    private bool _showHistoric;
    private string? _publishError;
    private string? _toast;

    private BoulderActivityFeed? _activityFeed;
    private BoulderComments? _commentList;
    private BoulderBetaVideos? _betaVideos;
    private ViewMode _viewMode = ViewMode.Photo;
    private List<Hold>? _wallHolds;

    // Normalized wall-region rectangle the photo view is framed to (null = show the whole photo).
    private double[]? _frame;
    private List<Hold> _colorRuleHolds = [];
    private HashSet<Guid> _boulderHoldIds = [];

    // Big-wall multi-image viewing: the wall's live panels, the highlighted holds grouped per panel
    // (drawn directly so they show even to viewers who can't enumerate panel holds), the panels that
    // carry a highlighted hold (arrow targets), and the start panel (the one with the most holds).
    // A hold linked across two overlapping panels is one physical hold: when a boulder uses it we
    // also light its twin(s) on the other panel(s), so the highlighted set is EXPANDED over the
    // boulder's own holds. _highlightedHoldTypes carries the boulder Type/Usage (colour) for every
    // highlighted id — the boulder's own holds and their linked twins alike.
    private List<WallPanelInfo> _livePanels = [];
    private Dictionary<Guid, IReadOnlyList<PanelHold>> _holdsByPanel = new();
    private HashSet<Guid> _highlightedPanelIds = [];
    private HashSet<Guid> _highlightedHoldIds = [];
    private Dictionary<Guid, (HoldType Type, HoldUsage Usage)> _highlightedHoldTypes = new();
    private int _startPanelCol;
    private int _startPanelRow;

    private bool UsingMultiPanel => _boulder is { Wall.UsesMultipleImages: true } && _livePanels.Count > 0;

    private GradeProposal? _activeProposal;
    private bool _showGradeForm;
    private string? _proposedGrade;
    private bool _isFavorite;
    private RatingInfo _rating = new(null, 0, null);

    private bool _editMeta;
    private string _editName = "";
    private string? _editGrade;
    private DateTime _backdateTime = DateTime.Now;

    // A single busy lease held whenever any inline editor (name/grade or grade proposal) is open, so a
    // deploy can't recreate the container while that unsaved edit is on screen. Kept in lock-step with
    // the edit flags via SyncBoulderEditLease(), released there when both close and in DisposeAsync.
    private IDisposable? _editLease;

    private ElementReference _photoViewportRef;
    private string? _fitBoxForUrl;
    private DotNetObjectReference<BoulderDetail>? _selfRef;

    private enum ViewMode { Photo, Schematic }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Attempts, ratings, favourites and comments are written by the DOM handler in
            // offline-actions.js, never by this component. This is how the page learns that
            // the queue reached the server and pulls the real state back down.
            _selfRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("blocwerkOfflineActions.registerRefresh", _selfRef);
            }
            catch (Exception)
            {
                // Never let a missing/failed interop take the page down: without the callback
                // the queue still delivers, the page just needs a manual reload to catch up.
            }
        }

        if (_viewMode == ViewMode.Photo && _boulder != null && !UsingMultiPanel)
        {
            try
            {
                // Re-attach every render, unconditionally. setupScroll is idempotent in JS (it
                // bails when the engine is already bound to this exact node), so the common case
                // is a cheap no-op — but after a reconnect or a re-render that rebuilds the photo
                // viewport, the fresh node has no engine and this is what re-binds it. A one-shot
                // gate here would leave that fresh DOM with no gesture handlers and zoom silently
                // dead. No .NET callback: this page shows no zoom read-out.
                await JS.InvokeVoidAsync("bwViewport.setupScroll", _photoViewportRef, null);

                // Pin the box to the framed wall region (or the whole photo when there is nothing to
                // frame) so zooming scrolls inside a fixed box instead of growing the card. Re-run only
                // when the image or the frame changes — the Then/Now toggle swaps PhotoUrl and holds, and
                // the box (plus its one-time framing scroll) must track the new region.
                var fitKey = PhotoUrl + "|" + (_frame == null ? string.Empty : string.Join(",", _frame));
                if (_fitBoxForUrl != fitKey)
                {
                    _fitBoxForUrl = fitKey;
                    await JS.InvokeVoidAsync("bwViewport.fitBox", _photoViewportRef, true, _frame);
                }
            }
            catch (JSException)
            {
                // Stale element reference after a re-render/reconnect: allow a retry on the next
                // render instead of taking the circuit down with an unhandled exception.
                _fitBoxForUrl = null;
            }
            catch (JSDisconnectedException)
            {
                _fitBoxForUrl = null;
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        Cache.Changed -= OnCacheChanged;
        _editLease?.Dispose();

        if (_selfRef != null)
        {
            try
            {
                await JS.InvokeVoidAsync("blocwerkOfflineActions.unregisterRefresh", _selfRef);
            }
            catch (Exception)
            {
                // The circuit is usually already gone by the time a component is disposed —
                // precisely the case this whole feature exists for — and JS.InvokeVoidAsync
                // then throws JSDisconnected/ObjectDisposed/TaskCanceled depending on how it
                // died. A dispose path must swallow all of them; the JS side drops the stale
                // reference on its own when invoking it fails.
            }

            _selfRef.Dispose();
            _selfRef = null;
        }
    }

    /// <summary>
    /// Called by offline-actions.js after the queue actually delivered something (and after a
    /// circuit reconnect). Everything the four queued actions can touch is re-read here, so the
    /// optimistic <c>bw-opt-*</c> classes are replaced by a normal server render.
    /// </summary>
    [JSInvokable]
    public async Task OnOfflineQueueFlushed()
    {
        try
        {
            await LoadBoulder();
            if (!_isAnonymous)
            {
                _isFavorite = await FeedbackService.IsFavoritedAsync(BoulderId);
                _rating = await FeedbackService.GetRatingAsync(BoulderId);
            }

            if (_activityFeed != null)
            {
                await _activityFeed.ReloadAsync();
            }

            if (_commentList != null)
            {
                await _commentList.ReloadAsync();
            }

            if (_betaVideos != null)
            {
                await _betaVideos.ReloadAsync();
            }
        }
        catch (UnauthorizedAccessException)
        {
            // Session expired while the queue was draining. The queue pauses itself and the
            // status pill prompts a re-login; there is nothing useful to render here.
            return;
        }
        catch (Exception ex)
        {
            // The action itself is already saved server-side; only the read-back failed.
            // Say so instead of leaving a stale page that looks like nothing happened.
            await InvokeAsync(() => ShowToast($"Synced, but the page could not refresh: {ex.Message}"));
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The generation the boulder's own holds live at. Gating on this rather than
    /// Boulder.Generation is exact: the latter is only stamped on create/revise, so a
    /// boulder carried through an alignment would otherwise look stale when it isn't.
    /// </summary>
    private int? BoulderHoldGeneration => _boulder is { BoulderHolds.Count: > 0 }
        ? _boulder.BoulderHolds.Max(bh => bh.Hold.Generation)
        : null;

    private bool CanViewHistoric =>
        _boulder != null && BoulderHoldGeneration is { } g && g < _boulder.Wall.CurrentGeneration;

    /// <summary>
    /// A live/published boulder the creator, a setter, OR a wall admin may still fully re-edit (holds
    /// and rules) — now allowed even after another climber has sent it: the holds are edited in place
    /// and the existing ascents stay attached (the server enforces the same rule). Drafts and historic
    /// boulders have their own revise links elsewhere.
    /// </summary>
    private bool CanFullRevise =>
        (_isCreator || _isAdmin || _isSetter) && !_isAnonymous
        && _boulder is { IsDraft: false, IsHistoric: false };

    /// <summary>
    /// The boulder's setters as a human list: "A", "A &amp; B", or "A, B &amp; C". Empty when the
    /// boulder has no explicit setter (the creator line is shown instead).
    /// </summary>
    private string SettersDisplay
    {
        get
        {
            var names = _boulder?.Setters
                .Select(s => s.User.Name)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .ToList() ?? [];

            if (names.Count == 0)
            {
                return string.Empty;
            }

            if (names.Count == 1)
            {
                return names[0];
            }

            return string.Join(", ", names.Take(names.Count - 1)) + " & " + names[^1];
        }
    }

    private string PhotoUrl
    {
        get
        {
            var gen = _showHistoric && BoulderHoldGeneration is { } g ? $"/{g}" : string.Empty;
            return !string.IsNullOrEmpty(ShareToken)
                ? $"/api/walls/{WallId}/photo{gen}?token={ShareToken}"
                : $"/api/walls/{WallId}/photo{gen}";
        }
    }

    private async Task ToggleHistoric()
    {
        _showHistoric = !_showHistoric;
        await LoadWallHolds();
    }

    private async Task PublishDraft()
    {
        try
        {
            await BoulderService.PublishBoulderAsync(BoulderId);
            await LoadBoulder();
        }
        catch (Exception ex)
        {
            _publishError = ex.Message;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Cache.Changed += OnCacheChanged;

        if (!string.IsNullOrEmpty(ShareToken))
        {
            _isAnonymous = true;
            try
            {
                var user = await CurrentUserService.GetCurrentUserAsync();
                _currentUserId = user.Id;
                _isAnonymous = false;
            }
            catch (UnauthorizedAccessException) { }

            _boulder = await BoulderService.GetBoulderByShareTokenAsync(BoulderId, ShareToken);
        }
        else
        {
            try
            {
                var user = await CurrentUserService.GetCurrentUserAsync();
                _currentUserId = user.Id;
                await LoadBoulder();
            }
            catch (UnauthorizedAccessException)
            {
                Navigation.NavigateTo("/account/login", replace: true);
                return;
            }
        }

        // Drafts are visible to every wall member now (they just can't be logged until published),
        // so a non-creator is no longer redirected away from a draft.

        if (_boulder != null)
        {
            _isCreator = _boulder.CreatedByUserId == _currentUserId;

            // A setter (or co-setter) of this boulder may edit/revise/publish it just like the
            // creator — the server enforces the same rule. Meaningless for an anonymous viewer.
            _isSetter = !_isAnonymous && _boulder.Setters.Any(s => s.UserId == _currentUserId);

            // A wall admin (a WallRole.Admin member of this wall) may revise ANY boulder on the
            // wall, not only the ones they created — same membership-role check used across the
            // wall UI. Only meaningful for a signed-in viewer on the normal (non-share) path; the
            // boulder's own Wall include carries no Members, so read the wall from the cache.
            if (!_isAnonymous && string.IsNullOrEmpty(ShareToken))
            {
                var wall = await Cache.GetWallAsync(WallId);
                var membership = wall?.Members.FirstOrDefault(m => m.UserId == _currentUserId);
                // The wall owner counts as an admin even without an explicit Admin member row, matching
                // WallAdminGuard on the server — otherwise an owner would be offered no revise entry
                // point yet the server would accept the revise.
                _isAdmin = membership?.Role == WallRole.Admin || wall?.OwnerId == _currentUserId;
            }

            _boulderHoldIds = _boulder.BoulderHolds.Select(bh => bh.HoldId).ToHashSet();

            // A live boulder may now be fully re-edited by the creator or a wall admin even after
            // others have sent it, so there is no longer a "sent by others" gate to pre-compute here.

            // A stale boulder only makes sense against the wall it was set on.
            _showHistoric = CanViewHistoric;
            await LoadWallHolds();
            await LoadPanelData();
            _activeProposal = await BoulderService.GetActiveProposalAsync(BoulderId);

            if (!_isAnonymous)
            {
                _isFavorite = await FeedbackService.IsFavoritedAsync(BoulderId);
                _rating = await FeedbackService.GetRatingAsync(BoulderId);
            }
        }

    }

    /// <summary>
    /// Live-refresh when this boulder (or its wall) changes on any circuit — so a co-owner's revise
    /// or grade change appears without a reload. Skipped for anonymous share viewers (their reads go
    /// through the uncached share path) and while the name/grade form is open, so a background reload
    /// never discards an in-progress edit.
    /// </summary>
    private void OnCacheChanged(DomainChange change)
    {
        if (change.Scope == DomainChangeScope.WallList || _isAnonymous || _editMeta)
        {
            return;
        }

        if (change.BoulderId != BoulderId && change.WallId != WallId)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadBoulder();
                if (_boulder != null)
                {
                    _boulderHoldIds = _boulder.BoulderHolds.Select(bh => bh.HoldId).ToHashSet();
                    await LoadWallHolds();
                    await LoadPanelData();
                }

                StateHasChanged();
            }
            catch (Exception)
            {
                // A transient reload failure should leave the current view in place, not crash it.
            }
        });
    }

    /// <summary>
    /// Wall holds that count as footholds only because of the boulder's
    /// "feet of one colour only" rule, i.e. excluding the boulder's own holds.
    /// </summary>
    private List<Hold> ColorRuleHolds => _colorRuleHolds;

    /// <summary>
    /// The boulder's own dedicated footholds (<see cref="HoldUsage.FootOnly"/>), drawn orange in the
    /// schematic. The "feet of one colour only" rule is no longer painted onto every matching wall
    /// hold; it is communicated by the info banner above the image instead.
    /// </summary>
    private HashSet<Guid> FootHoldIds => _boulder == null
        ? []
        : _boulder.BoulderHolds
            .Where(bh => bh.Usage == HoldUsage.FootOnly)
            .Select(bh => bh.HoldId)
            .ToHashSet();

    private async Task LoadWallHolds()
    {
        _wallHolds = await FetchWallHoldsAsync();
        _colorRuleHolds = _boulder is { FootColorOnly: { Length: > 0 } color } && _wallHolds != null
            ? _wallHolds.Where(h => h.Color == color && !_boulderHoldIds.Contains(h.Id)).ToList()
            : [];

        // Frame the photo view to the wall region (border if present, else the wall holds' bbox)
        // so the boulder isn't drowned in floor/ceiling. Null when there's nothing usable to frame.
        _frame = WallFraming.TryComputeFrame(_boulder?.Wall.BorderPoints, _wallHolds);
    }

    /// <summary>
    /// Builds the data the multi-image viewer needs: the wall's live panels, the boulder's holds
    /// grouped per panel (so they render regardless of who can enumerate panel holds), the panels
    /// that carry a boulder hold (the only ones an arrow points to), and the start panel — the one
    /// holding the most of the boulder's holds. A single-image wall (or a failed panel read) leaves
    /// everything empty, so <see cref="UsingMultiPanel"/> is false and nothing here is used.
    /// </summary>
    private async Task LoadPanelData()
    {
        _livePanels = [];
        _holdsByPanel = new();
        _highlightedPanelIds = [];
        _highlightedHoldIds = [];
        _highlightedHoldTypes = new();

        if (_boulder is not { Wall.UsesMultipleImages: true })
        {
            return;
        }

        try
        {
            var panels = await WallPanelService.GetPanelsAsync(WallId);
            _livePanels = panels.Where(p => p.IsLive).ToList();
        }
        catch (Exception)
        {
            _livePanels = [];
            return;
        }

        var livePanelIds = _livePanels.Select(p => p.Id).ToHashSet();
        var onPanels = _boulder.BoulderHolds
            .Where(bh => bh.Hold.WallPanelId is { } pid && livePanelIds.Contains(pid))
            .ToList();

        // Start from the boulder's own holds on their home panels — the pre-expansion baseline that
        // renders exactly as before. Twins linked across overlaps are added on top below.
        var holdsByPanel = onPanels
            .GroupBy(bh => bh.Hold.WallPanelId!.Value)
            .ToDictionary(
                g => g.Key,
                g => g.Select(bh => new PanelHold(bh.HoldId, bh.Hold.X, bh.Hold.Y, bh.Hold.Radius, bh.Hold.Color, bh.Hold.ShapePoints)).ToList());
        foreach (var bh in onPanels)
        {
            _highlightedHoldIds.Add(bh.HoldId);
            _highlightedHoldTypes[bh.HoldId] = (bh.Type, bh.Usage);
        }

        await ExpandLinkedTwinsAsync(onPanels, holdsByPanel);

        // Every entry in holdsByPanel is a highlighted hold (the boulder's own or a linked twin), so
        // the panels that carry one — the arrow targets — are exactly its keys, and the start panel
        // is the one holding the most highlighted holds (twins counted).
        _holdsByPanel = holdsByPanel.ToDictionary(kv => kv.Key, kv => (IReadOnlyList<PanelHold>)kv.Value);
        _highlightedPanelIds = holdsByPanel.Keys.ToHashSet();

        var startPanelId = holdsByPanel
            .OrderByDescending(kv => kv.Value.Count)
            .Select(kv => (Guid?)kv.Key)
            .FirstOrDefault();
        if (startPanelId is { } spid && _livePanels.FirstOrDefault(p => p.Id == spid) is { } start)
        {
            _startPanelCol = start.Col;
            _startPanelRow = start.Row;
        }
    }

    /// <summary>
    /// A hold linked across an overlap is one physical hold. For every boulder hold, light every
    /// hold in its link component that sits on a LIVE panel, carrying the same boulder Type/Usage.
    /// When two boulder holds land in the same component the type is resolved by prominence
    /// Top &gt; Start &gt; Normal (the higher <see cref="HoldType"/> value wins). Mutates
    /// <paramref name="holdsByPanel"/> plus <see cref="_highlightedHoldIds"/> and
    /// <see cref="_highlightedHoldTypes"/>. A no-op when the wall has no links or the boulder uses
    /// no linked hold, so single-panel boulders keep their exact former behaviour.
    /// </summary>
    private async Task ExpandLinkedTwinsAsync(
        List<BoulderHold> onPanels,
        Dictionary<Guid, List<PanelHold>> holdsByPanel)
    {
        List<HoldLinkPair> links;
        try
        {
            links = [.. await WallPanelService.GetHoldLinksAsync(WallId)];
        }
        catch (Exception)
        {
            return;
        }

        if (links.Count == 0)
        {
            return;
        }

        var adjacency = new Dictionary<Guid, List<Guid>>();
        void Link(Guid a, Guid b)
        {
            if (!adjacency.TryGetValue(a, out var list))
            {
                list = [];
                adjacency[a] = list;
            }

            list.Add(b);
        }

        foreach (var pair in links)
        {
            Link(pair.HoldAId, pair.HoldBId);
            Link(pair.HoldBId, pair.HoldAId);
        }

        // Resolve each twin (a component member that is not itself one of the boulder's own holds)
        // to the boulder Type/Usage of the most prominent source hold reaching it.
        var sourceIds = onPanels.Select(bh => bh.HoldId).ToHashSet();
        var twinTypes = new Dictionary<Guid, (HoldType Type, HoldUsage Usage)>();
        foreach (var bh in onPanels)
        {
            foreach (var member in ConnectedComponent(adjacency, bh.HoldId))
            {
                if (sourceIds.Contains(member))
                {
                    continue;
                }

                if (!twinTypes.TryGetValue(member, out var existing) || (int)bh.Type > (int)existing.Type)
                {
                    twinTypes[member] = (bh.Type, bh.Usage);
                }
            }
        }

        if (twinTypes.Count == 0)
        {
            return;
        }

        // Twins are separate Hold rows on other panels; read live-panel holds to find their
        // positions. Stop once every twin is located so we never read more panels than needed.
        var located = new Dictionary<Guid, (Guid PanelId, PanelHold Hold)>();
        foreach (var panel in _livePanels)
        {
            IReadOnlyList<PanelHold> panelHolds;
            try
            {
                panelHolds = await WallPanelService.GetPanelHoldsAsync(WallId, panel.Id, false);
            }
            catch (Exception)
            {
                continue;
            }

            foreach (var hold in panelHolds)
            {
                if (twinTypes.ContainsKey(hold.Id) && !located.ContainsKey(hold.Id))
                {
                    located[hold.Id] = (panel.Id, hold);
                }
            }

            if (located.Count == twinTypes.Count)
            {
                break;
            }
        }

        foreach (var (twinId, type) in twinTypes)
        {
            if (!located.TryGetValue(twinId, out var loc))
            {
                // Linked to a hold that no longer sits on a live panel (removed or off-generation).
                continue;
            }

            if (!holdsByPanel.TryGetValue(loc.PanelId, out var list))
            {
                list = [];
                holdsByPanel[loc.PanelId] = list;
            }

            if (list.All(h => h.Id != twinId))
            {
                list.Add(loc.Hold);
            }

            _highlightedHoldIds.Add(twinId);
            _highlightedHoldTypes[twinId] = type;
        }
    }

    /// <summary>All hold ids reachable from <paramref name="start"/> through the link graph
    /// (including the start), so a hold and every twin across a chain of panels share a component.</summary>
    private static IEnumerable<Guid> ConnectedComponent(Dictionary<Guid, List<Guid>> adjacency, Guid start)
    {
        var seen = new HashSet<Guid> { start };
        var queue = new Queue<Guid>();
        queue.Enqueue(start);
        while (queue.Count > 0)
        {
            var current = queue.Dequeue();
            if (!adjacency.TryGetValue(current, out var neighbours))
            {
                continue;
            }

            foreach (var neighbour in neighbours)
            {
                if (seen.Add(neighbour))
                {
                    queue.Enqueue(neighbour);
                }
            }
        }

        return seen;
    }

    /// <summary>The fill/stroke a highlighted hold is drawn in (a boulder hold or a linked twin),
    /// matching the single-image photo view. Twin ids resolve to the source hold's boulder colour.</summary>
    private (string Fill, string Stroke) BoulderHoldColorOf(Guid holdId) =>
        _highlightedHoldTypes.TryGetValue(holdId, out var t)
            ? (BoulderHoldColors.FillFor(t.Type, t.Usage), BoulderHoldColors.Stroke(t.Type))
            : (BoulderHoldColors.Fill(HoldType.Normal), BoulderHoldColors.Normal);

    private async Task<List<Hold>> FetchWallHoldsAsync()
    {
        // In the historic view the schematic must draw the generation the boulder's
        // holds belong to, or none of the highlighted ids would be in the list.
        if (_showHistoric && BoulderHoldGeneration is { } gen && string.IsNullOrEmpty(ShareToken))
        {
            return await Cache.GetHoldsForGenerationAsync(WallId, gen);
        }

        if (_showHistoric && BoulderHoldGeneration.HasValue && _boulder != null)
        {
            // Anonymous share viewers can't query generations; the boulder's own
            // holds are enough to render its schematic.
            return _boulder.BoulderHolds.Select(bh => bh.Hold).ToList();
        }

        Wall? wall;
        if (!string.IsNullOrEmpty(ShareToken))
        {
            wall = await WallService.GetWallByShareTokenAsync(ShareToken);
        }
        else
        {
            wall = await Cache.GetWallAsync(WallId);
        }

        return wall?.Holds.ToList() ?? [];
    }

    private async Task LoadBoulder()
    {
        _boulder = await Cache.GetBoulderAsync(BoulderId);
        if (!_isAnonymous)
        {
            _attempts = await AttemptService.GetAttemptsForBoulderAsync(BoulderId);
            _summary = await AttemptService.GetBoulderSummaryForUserAsync(BoulderId);
        }
    }

    // Logging an attempt, rating, favouriting and commenting are NOT handled here any more.
    // They are written by the delegated DOM handler in wwwroot/js/offline-actions.js, which
    // keeps them working with the circuit down and — being the only writer — makes a
    // double-application impossible. The page catches up via OnOfflineQueueFlushed.
    //
    // Everything below still needs a live circuit (delete, archive, grade proposals). Each
    // runs through Guard so a throw can never strand a flag or vanish silently.

    /// <summary>
    /// Runs a server round-trip, always re-rendering afterwards and always telling the user when
    /// it failed. The pattern this replaces set an "in flight" flag, awaited, then cleared the
    /// flag on the happy path only: a throw (or a circuit dropping mid-await) left the buttons
    /// disabled forever with no message, which is exactly the "cannot log ascents" symptom.
    /// Any busy flag added later belongs in the <c>finally</c>, never after the <c>await</c>.
    /// </summary>
    private async Task Guard(Func<Task> action, string failureLabel)
    {
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            await ShowToast($"{failureLabel}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void StartEditMeta()
    {
        _editName = _boulder?.Name ?? "";
        _editGrade = _boulder?.Grade;
        _editMeta = true;
        SyncBoulderEditLease();
    }

    private void CancelEditMeta()
    {
        _editMeta = false;
        SyncBoulderEditLease();
    }

    private void ShowGradeForm()
    {
        _showGradeForm = true;
        SyncBoulderEditLease();
    }

    private void CancelGradeForm()
    {
        _showGradeForm = false;
        SyncBoulderEditLease();
    }

    // Single source of truth for the busy lease: acquire when an inline editor opens (and one isn't
    // already held, so re-opening never double-acquires), release when both editors are closed.
    // Called after every edit-flag change and from DisposeAsync.
    private void SyncBoulderEditLease()
    {
        if (_editMeta || _showGradeForm)
        {
            _editLease ??= EditActivity.BeginBoulderEdit(WallId, _currentUserId == Guid.Empty ? null : _currentUserId);
        }
        else
        {
            _editLease?.Dispose();
            _editLease = null;
        }
    }

    private Task SaveMeta() => Guard(async () =>
    {
        if (_boulder == null || string.IsNullOrWhiteSpace(_editName))
        {
            return;
        }

        var updated = await BoulderService.RenameBoulderAsync(BoulderId, _editName, _editGrade);
        _boulder.Name = updated.Name;
        _boulder.Grade = updated.Grade;
        _editMeta = false;
        SyncBoulderEditLease();
        await ShowToast("Boulder updated");
    }, "Could not update the boulder");

    // A backdated log runs the server path directly (not the offline queue), so it needs a live
    // circuit — acceptable for a deliberate "log an old ascent" action. The picked wall-clock time
    // is stored verbatim (offset zero) so the history shows exactly what was chosen.
    private Task LogBackdated(AttemptType type) => Guard(async () =>
    {
        var when = new DateTimeOffset(DateTime.SpecifyKind(_backdateTime, DateTimeKind.Unspecified), TimeSpan.Zero);
        await AttemptService.LogAttemptAsync(BoulderId, type, timestamp: when);
        await LoadBoulder();
        if (_activityFeed != null)
        {
            await _activityFeed.ReloadAsync();
        }

        await ShowToast($"Logged {type} at {_backdateTime:MMM d, HH:mm}");
    }, "Could not log that attempt");

    private Task DeleteAttempt(Guid attemptId) => Guard(async () =>
    {
        await AttemptService.DeleteAttemptAsync(attemptId);
        await LoadBoulder();
    }, "Could not delete that attempt");

    private Task ClearRating() => Guard(async () =>
    {
        await FeedbackService.RemoveRatingAsync(BoulderId);
        _rating = await FeedbackService.GetRatingAsync(BoulderId);
    }, "Could not clear your rating");

    private Task ArchiveBoulder() => Guard(async () =>
    {
        await BoulderService.ArchiveBoulderAsync(BoulderId);
        await LoadBoulder();
        await ShowToast("Boulder archived");
    }, "Archive failed");

    private Task UnarchiveBoulder() => Guard(async () =>
    {
        await BoulderService.UnarchiveBoulderAsync(BoulderId);
        await LoadBoulder();
        await ShowToast("Boulder restored");
    }, "Restore failed");

    private Task SubmitGradeProposal() => Guard(async () =>
    {
        if (string.IsNullOrEmpty(_proposedGrade))
        {
            return;
        }

        _activeProposal = await BoulderService.ProposeGradeAsync(BoulderId, _proposedGrade);
        _showGradeForm = false;
        SyncBoulderEditLease();
        await ShowToast("Grade proposal submitted");
    }, "Could not submit that proposal");

    private Task AcceptProposal() => Guard(async () =>
    {
        if (_activeProposal == null)
        {
            return;
        }

        await BoulderService.AcceptGradeProposalAsync(_activeProposal.Id);
        if (_boulder != null)
        {
            _boulder.Grade = _activeProposal.ProposedGrade;
        }

        _activeProposal = null;
        await ShowToast("Grade updated");
    }, "Could not accept that proposal");

    private Task RejectProposal() => Guard(async () =>
    {
        if (_activeProposal == null)
        {
            return;
        }

        await BoulderService.RejectGradeProposalAsync(_activeProposal.Id);
        _activeProposal = null;
        await ShowToast("Proposal rejected");
    }, "Could not reject that proposal");

    private static string F(double v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    // A hold's custom shape as SVG polygon points (0-100 space), so a boulder's shaped holds render as
    // their real shape instead of a plain circle.
    private static string ShapePolygon(Blocwerk.Core.Entities.Hold h) =>
        string.Join(" ", h.ShapePoints!.Select(sp => F((h.X + sp.Dx) * 100) + "," + F((h.Y + sp.Dy) * 100)));

    /// <summary>
    /// An upload writes an activity entry, so the feed below the strip is stale until it re-reads.
    /// The strip refreshes itself.
    /// </summary>
    private async Task OnBetaVideoUploaded()
    {
        if (_activityFeed != null)
        {
            await _activityFeed.ReloadAsync();
        }
    }

    private async Task ShowToast(string message)
    {
        _toast = message;
        StateHasChanged();
        await Task.Delay(2000);
        _toast = null;
        StateHasChanged();
    }
}

