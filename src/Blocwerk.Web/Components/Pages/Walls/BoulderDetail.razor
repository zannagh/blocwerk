@page "/walls/{WallId:guid}/boulders/{BoulderId:guid}"
@page "/walls/{WallId:guid}/boulders/{BoulderId:guid}/shared/{ShareToken}"
@rendermode InteractiveServer
@inject IBoulderService BoulderService
@inject IBoulderFeedbackService FeedbackService
@inject IAttemptService AttemptService
@inject IWallService WallService
@inject IWallPanelService WallPanelService
@inject WallCacheState Cache
@inject ICurrentUserService CurrentUserService
@inject IKioskContext KioskContext
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject CircuitEditActivity EditActivity
@inject ILogger<BoulderDetail> Logger
@using Blocwerk.Web.Components.Shared
@using Blocwerk.Web.State
@implements IAsyncDisposable

<PageTitle>@(_boulder?.Name ?? "Boulder") - Blocwerk</PageTitle>

@if (_boulder == null)
{
    <p class="loading">Loading...</p>
}
else
{
    <div class="boulder-detail">
        @* Left column on the desktop tier: everything that describes THIS boulder on the wall —
           header, notices, view toggle, banners and the photo itself. Both column wrappers are
           display:contents on the phone tier, so they are absent from the layout there and the
           page stays the single stack it has always been. *@
        <div class="boulder-photo-col">
        <div class="page-header">
            @{ var backUrl = !string.IsNullOrEmpty(ShareToken) ? $"/walls/{WallId}/shared/{ShareToken}?view=boulders" : $"/walls/{WallId}?view=boulders"; }
            <a href="@backUrl" class="back-link">&larr; Back to boulder list</a>
            <div class="title-row">
                <h1>@_boulder.Name</h1>
                @if (!string.IsNullOrEmpty(_boulder.Grade))
                {
                    <span class="grade-badge">@_boulder.Grade</span>
                }
                @if (_boulder.IsDraft)
                {
                    <span class="draft-badge">draft</span>
                }
                @if (_boulder.IsHistoric)
                {
                    <span class="historic-badge">historic</span>
                }
                @if (_boulder.IsArchived)
                {
                    <span class="archived-badge">archived</span>
                }
                <div class="title-actions">
                    @if (!_isAnonymous)
                    {
                        <BoulderFavoriteToggle BoulderId="_boulder.Id" IsFavorite="_isFavorite" />
                    }
                    @if ((_isCreator || _isAdmin || _isSetter) && !_isAnonymous && !_editMeta)
                    {
                        <button class="btn-icon boulder-edit-btn" @onclick="StartEditMeta" title="Rename or change grade">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                                <path d="M12 20h9" />
                                <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                            </svg>
                        </button>
                    }
                    @* Only when the wall has a measured 3D model; opens it with this boulder's holds highlighted. *@
                    <Wall3DLink WallId="WallId" BoulderId="BoulderId" ShareToken="@ShareToken" CssClass="btn-view3d">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 2 3 7v10l9 5 9-5V7z" />
                            <path d="M3 7l9 5 9-5" />
                            <path d="M12 12v10" />
                        </svg>
                        3D
                    </Wall3DLink>
                    @if (CanFullRevise)
                    {
                        <a href="/walls/@WallId/boulders/@BoulderId/revise" class="btn-revise">Revise</a>
                    }
                </div>
            </div>

            @if (_editMeta)
            {
                <div class="boulder-meta-edit">
                    <input class="boulder-name-input" maxlength="128" placeholder="Boulder name"
                           @bind="_editName" @bind:event="oninput" />
                    <GradePicker @bind-Value="_editGrade" />
                    <div class="meta-edit-actions">
                        <button class="proposal-btn accept" @onclick="SaveMeta"
                                disabled="@string.IsNullOrWhiteSpace(_editName)">Save</button>
                        <button class="proposal-btn reject" @onclick="CancelEditMeta">Cancel</button>
                    </div>
                </div>
            }

            @if (_boulder.Setters.Count > 0)
            {
                <p class="meta">Set by @SettersDisplay &middot; added by @CreatorDisplay &middot; <LocalTime Value="@_boulder.CreatedAt" Format="LocalTimeFormat.Date" /></p>
            }
            else
            {
                <p class="meta">by @CreatorDisplay &middot; <LocalTime Value="@_boulder.CreatedAt" Format="LocalTimeFormat.Date" /></p>
            }

        </div>

        @if (_boulder.IsDraft)
        {
            <div class="bw-draft-notice">
                @* Drafts are visible to every wall member now, but can't be climbed until published.
                   Only the creator sees the edit/publish actions. *@
                <p>This is a draft — it can't be climbed until it is published.</p>
                @if (_isCreator || _isAdmin || _isSetter)
                {
                    <div class="draft-actions">
                        <a href="/walls/@WallId/boulders/@BoulderId/revise" class="btn-revise">Edit</a>
                        <button class="btn-publish" @onclick="PublishDraft"
                                disabled="@(_boulder.BoulderHolds.Count == 0)">
                            Publish
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_publishError))
                    {
                        <div class="error-msg">@_publishError</div>
                    }
                }
            </div>
        }

        @if (_boulder.IsHistoric && (_isCreator || _isAdmin || _isSetter))
        {
            <div class="bw-revision-notice">
                <p>
                    @(CanViewHistoric
                        ? "The wall was rebuilt since this boulder was set. Use \"Then\" to see it on the old wall, then remap it onto the new holds."
                        : "The wall has changed since this boulder was created. Some holds may no longer exist.")
                </p>
                <div class="revision-actions">
                    <a href="/walls/@WallId/boulders/@BoulderId/revise" class="btn-revise">Revise Boulder</a>
                    @* Archive follows the same rule as revise and publish: creator, any setter, or a
                       wall admin. Creator-only left a kiosk-set boulder — whose creator is the Ghost
                       system row, i.e. nobody — impossible to archive when the gym reset the wall. *@
                    @if (CanManageBoulder)
                    {
                        @if (_boulder.IsArchived)
                        {
                            <button class="btn-archive" @onclick="UnarchiveBoulder">Restore from archive</button>
                        }
                        else
                        {
                            <button class="btn-archive" @onclick="ArchiveBoulder">Archive</button>
                        }
                    }
                </div>
            </div>
        }

        @* Same rule again. On a Ghost boulder a creator-only accept/reject meant an open proposal
           nobody in the installation could ever resolve. *@
        @if (_activeProposal != null && CanManageBoulder)
        {
            <div class="bw-grade-proposal-notice creator">
                <p><strong>@_activeProposal.ProposedBy.Name</strong> proposed changing the grade to <strong>@_activeProposal.ProposedGrade</strong></p>
                <div class="proposal-actions">
                    <button class="proposal-btn accept" @onclick="AcceptProposal">Accept</button>
                    <button class="proposal-btn reject" @onclick="RejectProposal">Reject</button>
                </div>
            </div>
        }
        else if (_activeProposal != null)
        {
            <div class="bw-grade-proposal-notice viewer">
                <p>A grade change to <strong>@_activeProposal.ProposedGrade</strong> has been proposed by @_activeProposal.ProposedBy.Name</p>
            </div>
        }

        @* The historic Then/Now toggle is the page's only view switch. *@
        @if (CanViewHistoric)
        {
            @* Both states are rendered, with the active one marked. A single button labelled with the
               CURRENT state reads as a status label, so nobody could tell whether "Then" meant "you
               are in Then" or "go to Then" — the two-button form is unambiguous either way round. *@
            <div class="view-toggle">
                <button class="toggle-btn @(!_showHistoric ? "active" : "")" aria-pressed="@(!_showHistoric)"
                        @onclick="() => ShowGenerationAsync(historic: false)"
                        title="Show the wall as it is today">
                    Now
                </button>
                <button class="toggle-btn @(_showHistoric ? "active" : "")" aria-pressed="@_showHistoric"
                        @onclick="() => ShowGenerationAsync(historic: true)"
                        title="Show the wall as it was when this boulder was set">
                    Then
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_boulder.FootColorOnly) || _boulder.NoMatch)
        {
            <div class="boulder-info-banners">
                @if (!string.IsNullOrEmpty(_boulder.FootColorOnly))
                {
                    <div class="boulder-info-banner">
                        All @HoldPalette.DisplayName(_boulder.FootColorOnly).ToLowerInvariant() holds may be used as footholds.
                        @if (ColorRuleHolds.Count == 0)
                        {
                            <span class="rule-warn">— no such holds on this wall</span>
                        }
                    </div>
                }
                @if (_boulder.NoMatch)
                {
                    <div class="boulder-info-banner">
                        No matching — you may not use two hands, or a hand and a foot, on the same hold.
                    </div>
                }
            </div>
        }

        <WallDimControl />
        @if (HistoricHoldsMissing > 0)
        {
            @* Fix: a partial translation used to be silent. Some of the boulder's holds have no
               row at the generation on screen (they were added later, or their lineage was never
               recorded), so the overlay is genuinely incomplete — say so rather than letting a
               climber read a start or top that isn't drawn as "not part of the boulder". *@
            @* The first number is BoulderHolds.Count - HistoricHoldsMissing, NOT _renderHolds.Count:
               several of the boulder's holds can converge on one older row, so the rendered list is
               SHORTER than the holds it accounts for and "3 of 8 ... the other 1" read as broken
               arithmetic. Subtracting the genuine misses makes the two numbers always sum to M.
               No "switch to Now" advice here either: for a boulder whose holds are spread over
               several generations "Now" can draw FEWER holds — sometimes none — so the tip made
               the very situation it was offered for worse. *@
            <p class="boulder-outdated-note" role="status">
                Only @(_boulder.BoulderHolds.Count - HistoricHoldsMissing) of this boulder's
                @_boulder.BoulderHolds.Count holds can be shown on the wall as it was then — the other
                @HistoricHoldsMissing were set on holds that aren't on these photos.
            </p>
        }
        @if (UsingMultiPanel)
        {
            @if (BoulderOnOutdatedPanel)
            {
                <p class="boulder-outdated-note" role="status">
                    Some of this boulder's holds are on a panel awaiting update.
                </p>
            }
            @* Big wall: show the panel holding most of the boulder's holds and let the user
               step to the neighbouring panels that carry its other holds. *@
            @* @key on a DATA EPOCH, never on the user's intent. MultiPanelViewer loads its panel
               and its holds in OnInitializedAsync and in its own GoToAsync ONLY — it has no
               OnParametersSetAsync — and `UsingMultiPanel` stays true across a Then/Now toggle, so
               Blazor would otherwise RETAIN the instance and keep today's photo while
               HighlightedHoldIds switched to the other generation's ids: zero overlap, boulder
               invisible. A changed key forces a fresh instance that reloads from the StartCol/
               StartRow LoadPanelData just recomputed.
               Keyed on _viewEpoch and NOT on (_showHistoric, _historicGeneration) because
               ShowGenerationAsync sets _showHistoric SYNCHRONOUSLY and then awaits: ComponentBase's
               IHandleEvent renders at that first yield, so an intent-based key changed while
               _livePanels/_startPanelCol/_holdsByPanel were still the OLD ones. The viewer was then
               re-created TOO EARLY, cached the old panel and old holds, and — the key being
               unchanged once the load finished — was retained for good. That is the same outage the
               key was added to prevent, one render earlier. _viewEpoch moves only as the LAST
               statement of LoadPanelData, so the key means "new data is in place", not "the user
               intends a change". Deliberately a key rather than an OnParametersSetAsync inside the
               viewer: that would re-fetch on every unrelated parameter change and fight GoToAsync's
               panel position, and it would reach WallDetail's usage too. BoulderId stays in the key
               for the same reason as before: this page is retained across a navigation between two
               boulders on the same route template. *@
            <MultiPanelViewer @key="(BoulderId, _viewEpoch)"
                              WallId="WallId" ShareToken="@ShareToken" Panels="_livePanels"
                              StartCol="_startPanelCol" StartRow="_startPanelRow"
                              ArrowMode="MultiPanelViewer.ArrowDisplayMode.HoldsOnly"
                              HoldsByPanel="_holdsByPanel"
                              HoldsProvider="LoadPanelHoldsAsync"
                              HighlightedHoldIds="_highlightedHoldIds"
                              FootHoldIds="FootHoldIds"
                              HoldColor="BoulderHoldColorOf"
                              HighlightedPanelIds="_highlightedPanelIds"
                              EnableSwipe="true"
                              HistoricMode="_showHistoric"
                              LensOverlay="true"
                              Fullscreen="true" />
        }
        else
        {
            @* bw-stage-anchor is the positioning context the floating full-screen button needs:
               .boulder-photo-col is static below the desktop tier. *@
            <div class="bw-stage-anchor">
                @* Zoom geometry is owned by JS via `--zoom` (wwwroot/js/viewport.js). *@
                <div class="photo-viewport photo-section@(_frame != null ? " bw-framed" : "")" @ref="_photoViewportRef">
                    @* data-lens-overlay marks this editor so the long-press magnifier bakes the marked-hold
                       overlay into the lens — boulder detail only; the wall view's editor is never marked. *@
                    <div class="photo-editor" data-lens-overlay="true">
                        @PhotoLayers
                    </div>
                </div>
                <StageOpenButton OnOpen="() => _stageOpen = true" />
                @if (_stageOpen)
                {
                    @* The SAME layers again inside the takeover. Deliberately a second render of one
                       fragment rather than moving the live nodes: the inline viewport keeps its
                       @ref and its own zoom engine, so closing the overlay leaves it exactly as it
                       was. The world layer is not a `.photo-editor`, so the magnifier lens — which
                       reads the image rect directly and cannot survive a rotated stage — never arms
                       in there. *@
                    <StageOverlay OnClose="() => _stageOpen = false" Label="Boulder in full screen"
                                  ContentKey="@PhotoUrl">
                        @PhotoLayers
                    </StageOverlay>
                }
            </div>
        }
        </div>

        @* Right column on the desktop tier: everything you DO with the boulder. *@
        <div class="boulder-side-col">
        <BoulderRulesSummary Boulder="_boulder" />

        @if (!_isAnonymous)
        {
            @* A draft can't be logged (the server rejects it, the offline queue drops it as
               permanent); don't offer the ascent buttons until it's published. *@
            @if (!_boulder.IsDraft)
            {
                <BoulderAttemptBar BoulderId="_boulder.Id" Summary="_summary" />
            }

            <div class="rating-section">
                <div class="rating-summary">
                    @if (_rating.Count > 0)
                    {
                        <StarRating Value="@(_rating.Average ?? 0)" ReadOnly="true" />
                        <span class="rating-avg">@_rating.Average?.ToString("0.0")</span>
                        <span class="rating-count">(@_rating.Count rating@(_rating.Count != 1 ? "s" : ""))</span>
                    }
                    else
                    {
                        <span class="rating-empty">No ratings yet</span>
                    }
                </div>
                <div class="rating-mine">
                    <span class="rating-mine-label">Your rating</span>
                    <StarRating Value="@(_rating.MyRating ?? 0)" ActionBoulderId="_boulder.Id"
                                ContainerId="bw-my-rating" />
                    @if (_rating.MyRating.HasValue)
                    {
                        @* Server-only: there is no "remove rating" action in the offline
                           queue, so this needs a live circuit. Re-rating works offline. *@
                        <button class="rating-clear" @onclick="ClearRating" title="Clear your rating">clear</button>
                    }
                </div>
            </div>

            @if (!_boulder.IsDraft)
            {
                <details class="backdate-card">
                    <summary>Log at a specific time</summary>
                    <div class="backdate-body">
                        <label class="backdate-label" for="bw-backdate">When did you climb it?</label>
                        <input id="bw-backdate" type="datetime-local" class="backdate-input" @bind="_backdateTime" />
                        <div class="attempt-buttons">
                            <button type="button" class="attempt-btn try" @onclick="() => LogBackdated(AttemptType.Attempt)">Attempt</button>
                            <button type="button" class="attempt-btn send" @onclick="() => LogBackdated(AttemptType.Send)">Send</button>
                            <button type="button" class="attempt-btn flash" @onclick="() => LogBackdated(AttemptType.Flash)">Flash</button>
                        </div>
                    </div>
                </details>
            }

            @* Proposing stays exactly as the server has it (ProposeGradeAsync refuses only your OWN
               boulder), so a setter or wall admin who did not create it can still propose. *@
            @if (!_isCreator)
            {
                @if (_showGradeForm)
                {
                    <div class="grade-propose-form">
                        <GradePicker @bind-Value="_proposedGrade" />
                        <div class="grade-propose-actions">
                            <button class="proposal-btn accept" @onclick="SubmitGradeProposal"
                                    disabled="@(string.IsNullOrEmpty(_proposedGrade))">Propose</button>
                            <button class="proposal-btn reject" @onclick="CancelGradeForm">Cancel</button>
                        </div>
                    </div>
                }
                else
                {
                    <button class="btn-propose-grade" @onclick="ShowGradeForm">Propose different grade</button>
                }
            }
        }
        else
        {
            @* Two different anonymous viewers, two different next steps. On a tablet nobody logs IN;
               they tap their own name on the kiosk picker, and pointing them at a login page they are
               not meant to complete is what this whole fix is about. *@
            @if (KioskContext.IsKiosk)
            {
                @* A draft can't be logged, so don't offer the buttons for one — same rule as the
                   signed-in bar above. *@
                @if (!_boulder.IsDraft)
                {
                    <KioskAttemptPicker BoulderId="_boulder.Id" />
                }

                <div class="bw-anon-notice">
                    <a href="/kiosk/users">Pick yourself</a> to log attempts and comment.
                </div>
            }
            else
            {
                <div class="bw-anon-notice">
                    <a href="/account/login">Log in</a> to log attempts and comment.
                </div>
            }
        }

        <BoulderBetaVideos @ref="_betaVideos" BoulderId="BoulderId" CurrentUserId="_currentUserId"
                           IsAnonymous="_isAnonymous" ShareToken="@ShareToken"
                           Uploaded="OnBetaVideoUploaded" />
        </div>

        @* Full-width row under both columns on the desktop tier: the three sections whose content
           has no natural length — activity, comments, history. In a 360px rail they were a thin
           stack of wrapped text next to half a screen of empty space beside the photo; here they
           fill the width the photo column leaves and flow into as many readable columns as fit.
           Same display:contents trick as the two columns above, so the phone tier is untouched and
           the DOM order stays exactly the order the phone stack has always rendered. *@
        <div class="boulder-wide-col">
        <BoulderActivityFeed @ref="_activityFeed" BoulderId="BoulderId" ShareToken="@ShareToken" />

        <BoulderComments @ref="_commentList" BoulderId="BoulderId"
                         CurrentUserId="_currentUserId" IsAnonymous="_isAnonymous" />

        @if (!_isAnonymous && _attempts.Count > 0)
        {
            <div class="history-section">
                <h2>History</h2>
                @foreach (var attempt in _attempts)
                {
                    <div class="attempt-row">
                        <div class="attempt-info">
                            <span class="attempt-type @attempt.Type.ToString().ToLower()">@attempt.Type</span>
                            <span class="attempt-user">@attempt.User.Name</span>
                        </div>
                        <span class="attempt-time"><LocalTime Value="@attempt.Timestamp" Format="LocalTimeFormat.DateTime" /></span>
                        @if (attempt.UserId == _currentUserId)
                        {
                            <button class="delete-btn" @onclick="() => DeleteAttempt(attempt.Id)">x</button>
                        }
                    </div>
                }
            </div>
        }
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_toast))
{
    <div class="toast-msg">@_toast</div>
}

@code {
    /// <summary>Whether the full-screen landscape takeover is up over the legacy single image.</summary>
    private bool _stageOpen;

    /// <summary>
    /// The photo and its hold overlay, as one fragment, so the inline viewport and the full-screen
    /// takeover draw exactly the same thing without the markup existing twice. Deliberately just the
    /// two layers: the wrapper differs between the two (only the inline one is a `.photo-editor`
    /// carrying data-lens-overlay, which is what arms the magnifier).
    /// </summary>
    private RenderFragment PhotoLayers => @<text>
        <img src="@ResponsiveImage.Initial(PhotoUrl)" data-bw-res alt="Wall" class="wall-photo" />
        <svg class="hold-overlay" viewBox="0 0 100 100" preserveAspectRatio="none">
            @* The "feet of one colour only" rule is shown as an info banner above the image, not by
               painting every wall hold of that colour. Only the boulder's own holds (including
               dedicated orange footholds) are drawn here. *@
            @* _renderHolds, not the boulder's raw holds: in the historic view they are the SAME
               holds translated to the generation on screen. *@
            @foreach (var bh in _renderHolds)
            {
                @* A virtual hold isn't visible on the photo: dash its outline, as the pickers and
                   MultiPanelViewer do, so it doesn't read as a real hold. *@
                var dash = bh.Hold.IsVirtual ? "0.6 0.4" : null;
                @* Through HoldShape like every other overlay in the app. Foot is deliberately NOT
                   set: this legacy single-image branch has always drawn every hold as a plain
                   circle and keeps doing so, so the move is visually a no-op. *@
                <HoldShape @key="bh.HoldId" X="bh.Hold.X" Y="bh.Hold.Y" Radius="bh.Hold.Radius"
                           ShapePoints="bh.Hold.ShapePoints" ShapeHoles="bh.Hold.ShapeHoles"
                           Fill="@BoulderHoldColors.FillFor(bh.Type, bh.Usage)"
                           Stroke="@BoulderHoldColors.Stroke(bh.Type)" StrokeWidth="0.5"
                           Dash="@dash" />
            }
        </svg>
    </text>;

    [Parameter] public Guid WallId { get; set; }
    [Parameter] public Guid BoulderId { get; set; }
    [Parameter] public string? ShareToken { get; set; }

    // Route params of the boulder currently loaded. Under enhanced navigation, boulder→boulder
    // navigation keeps this component alive (same route template, new parameters), so these guard a
    // reload against unchanged params — see OnParametersSetAsync, mirroring WallDetail.
    private Guid _loadedWallId;
    private Guid _loadedBoulderId;
    private string? _loadedShareToken;

    private Boulder? _boulder;
    private List<Attempt> _attempts = [];
    private AttemptSummary _summary = new(0, false, false);
    private Guid _currentUserId;
    private bool _isAnonymous;
    private bool _isCreator;

    /// <summary>
    /// The one client-side mirror of the server's "may act on this boulder" rule
    /// (<c>BoulderService.CanManageBoulderAsync</c>): creator, any setter, or a wall admin. Anonymous
    /// kiosk viewers are never any of those.
    /// </summary>
    private bool CanManageBoulder => !_isAnonymous && (_isCreator || _isSetter || _isAdmin);
    private bool _isAdmin;
    private bool _isSetter;
    private bool _showHistoric;

    /// <summary>The generation the "Then" view renders, or null when there is nothing older to show.
    /// Resolved once per boulder load; see <see cref="ResolveHistoricGenerationAsync"/>.</summary>
    private int? _historicGeneration;
    private string? _publishError;
    private string? _toast;

    private BoulderActivityFeed? _activityFeed;
    private BoulderComments? _commentList;
    private BoulderBetaVideos? _betaVideos;
    private List<Hold>? _wallHolds;

    // Normalized wall-region rectangle the photo view is framed to (null = show the whole photo).
    private double[]? _frame;
    private List<Hold> _colorRuleHolds = [];
    private HashSet<Guid> _boulderHoldIds = [];

    // The boulder's holds AS THE CURRENT VIEW DRAWS THEM: its own rows in "Now", and the same holds
    // translated to the historic generation in "Then". Everything the overlay needs (ids, colours,
    // panel ids) is derived from this one set so the two views can never disagree.
    // See ResolveRenderHoldsAsync.
    private List<BoulderHoldAtGeneration> _renderHolds = [];

    // How many of the boulder's holds the historic view could NOT translate onto the generation on
    // screen (0 in "Now", and 0 whenever the translation was complete). Surfaced as a note: dropping
    // a start or a top silently makes the boulder unclimbable as drawn.
    private int _untranslatedHoldCount;

    // Big-wall multi-image viewing: the wall's live panels, the highlighted holds grouped per panel
    // (drawn directly so they show even to viewers who can't enumerate panel holds), the panels that
    // carry a highlighted hold (arrow targets), and the start panel (the one with the most holds).
    // A hold linked across two overlapping panels is one physical hold: when a boulder uses it we
    // also light its twin(s) on the other panel(s), so the highlighted set is EXPANDED over the
    // boulder's own holds. _highlightedHoldTypes carries the boulder Type/Usage (colour) for every
    // highlighted id — the boulder's own holds and their linked twins alike.
    // Bumped once per completed LoadPanelData — see the @key on MultiPanelViewer. It is the only
    // thing that key may depend on: it changes when the panel data on screen has ALREADY changed,
    // whereas intent state (_showHistoric) changes one render too early.
    private int _viewEpoch;

    private List<WallPanelInfo> _livePanels = [];

    // INVARIANT: _holdsByPanel is NULL whenever it would otherwise be EMPTY — never an empty
    // dictionary. MultiPanelViewer treats a non-null HoldsByPanel as the whole truth and short-
    // circuits its HoldsProvider, so an empty-but-not-null one renders the photo with NO holds on it:
    // the blank boulder page, twice now. Null instead lets the viewer fall back to LoadPanelHoldsAsync
    // and draw the panel's own holds, so no failure, ordering bug or empty translation can blank the
    // overlay. Every assignment below holds this up; keep it that way.
    private Dictionary<Guid, IReadOnlyList<PanelHold>>? _holdsByPanel;
    private HashSet<Guid> _highlightedPanelIds = [];
    private HashSet<Guid> _highlightedHoldIds = [];
    private Dictionary<Guid, (HoldType Type, HoldUsage Usage)> _highlightedHoldTypes = new();
    private int _startPanelCol;
    private int _startPanelRow;

    // Every wall is a big wall now; the panel viewer is used whenever live panels are present. A
    // failed panel read leaves _livePanels empty, and the single-image arm below is kept as the
    // fallback renderer for that case (the centre-panel photo is still served by /photo).
    private bool UsingMultiPanel => _boulder is not null && _livePanels.Count > 0;

    private GradeProposal? _activeProposal;
    private bool _showGradeForm;
    private string? _proposedGrade;
    private bool _isFavorite;
    private RatingInfo _rating = new(null, 0, null);

    private bool _editMeta;
    private string _editName = "";
    private string? _editGrade;
    private DateTime _backdateTime = DateTime.Now;

    // A single busy lease held whenever any inline editor (name/grade or grade proposal) is open, so a
    // deploy can't recreate the container while that unsaved edit is on screen. Kept in lock-step with
    // the edit flags via SyncBoulderEditLease(), released there when both close and in DisposeAsync.
    private IDisposable? _editLease;

    // Mirrors _editLease onto the browser bwEditGuard so the maintenance watchdog holds back an
    // auto-reload while an inline meta/grade editor is open with unsaved changes. Synced every render
    // (the lease toggles on open/close) via EditGuardInterop.
    private bool _editGuardActive;

    private async Task SyncEditGuardAsync()
    {
        _editGuardActive = await EditGuardInterop.SyncAsync(JS, "boulder-edit", _editLease is not null, _editGuardActive);
    }

    private ElementReference _photoViewportRef;
    private string? _fitBoxForUrl;
    private DotNetObjectReference<BoulderDetail>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Attempts, ratings, favourites and comments are written by the DOM handler in
            // offline-actions.js, never by this component. This is how the page learns that
            // the queue reached the server and pulls the real state back down.
            _selfRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("blocwerkOfflineActions.registerRefresh", _selfRef);
            }
            catch (Exception)
            {
                // Never let a missing/failed interop take the page down: without the callback
                // the queue still delivers, the page just needs a manual reload to catch up.
            }
        }

        if (_boulder != null && !UsingMultiPanel)
        {
            try
            {
                // Re-attach every render, unconditionally. setupScroll is idempotent in JS (it
                // bails when the engine is already bound to this exact node), so the common case
                // is a cheap no-op — but after a reconnect or a re-render that rebuilds the photo
                // viewport, the fresh node has no engine and this is what re-binds it. A one-shot
                // gate here would leave that fresh DOM with no gesture handlers and zoom silently
                // dead. No .NET callback: this page shows no zoom read-out.
                await JS.InvokeVoidAsync("bwViewport.setupScroll", _photoViewportRef, null);

                // Pin the box to the framed wall region (or the whole photo when there is nothing to
                // frame) so zooming scrolls inside a fixed box instead of growing the card. Re-run only
                // when the image or the frame changes — the Then/Now toggle swaps PhotoUrl and holds, and
                // the box (plus its one-time framing scroll) must track the new region.
                var fitKey = PhotoUrl + "|" + (_frame == null ? string.Empty : string.Join(",", _frame));
                if (_fitBoxForUrl != fitKey)
                {
                    _fitBoxForUrl = fitKey;
                    await JS.InvokeVoidAsync("bwViewport.fitBox", _photoViewportRef, true, _frame);
                }
            }
            catch (JSException)
            {
                // Stale element reference after a re-render/reconnect: allow a retry on the next
                // render instead of taking the circuit down with an unhandled exception.
                _fitBoxForUrl = null;
            }
            catch (JSDisconnectedException)
            {
                _fitBoxForUrl = null;
            }
        }

        // Every render, not just the first: the lease toggles when an inline editor opens or closes.
        await SyncEditGuardAsync();
    }

    public async ValueTask DisposeAsync()
    {
        Cache.Changed -= OnCacheChanged;
        _editLease?.Dispose();

        if (_editGuardActive)
        {
            // Best-effort clear on navigate-away; a torn-down circuit no-ops (the safe failure).
            _ = EditGuardInterop.SyncAsync(JS, "boulder-edit", editing: false, active: _editGuardActive);
        }

        if (_selfRef != null)
        {
            try
            {
                await JS.InvokeVoidAsync("blocwerkOfflineActions.unregisterRefresh", _selfRef);
            }
            catch (Exception)
            {
                // The circuit is usually already gone by the time a component is disposed —
                // precisely the case this whole feature exists for — and JS.InvokeVoidAsync
                // then throws JSDisconnected/ObjectDisposed/TaskCanceled depending on how it
                // died. A dispose path must swallow all of them; the JS side drops the stale
                // reference on its own when invoking it fails.
            }

            _selfRef.Dispose();
            _selfRef = null;
        }
    }

    /// <summary>
    /// Called by offline-actions.js after the queue actually delivered something (and after a
    /// circuit reconnect). Everything the four queued actions can touch is re-read here, so the
    /// optimistic <c>bw-opt-*</c> classes are replaced by a normal server render.
    /// </summary>
    [JSInvokable]
    public async Task OnOfflineQueueFlushed()
    {
        // Each read-back is independent: the four queued actions land in four different places, and
        // one of them failing says nothing about the other three. Running them under a single
        // try/catch meant a failed favourite read skipped the comment and activity reloads
        // entirely, so a comment that HAD reached the server never appeared until the next
        // navigation.
        Func<Task>? activity = _activityFeed is { } feed ? feed.ReloadAsync : null;
        Func<Task>? comments = _commentList is { } list ? list.ReloadAsync : null;
        Func<Task>? videos = _betaVideos is { } clips ? clips.ReloadAsync : null;

        var failure = await ReloadSequence.RunAsync(
            async () =>
            {
                await LoadBoulder();
                if (!_isAnonymous)
                {
                    _isFavorite = await FeedbackService.IsFavoritedAsync(BoulderId);
                    _rating = await FeedbackService.GetRatingAsync(BoulderId);
                }
            },
            activity,
            comments,
            videos);

        if (failure != null)
        {
            // The action itself is already saved server-side; only the read-back failed.
            // Say so instead of leaving a stale page that looks like nothing happened.
            await InvokeAsync(() => ShowToast($"Synced, but the page could not refresh: {failure}"));
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The generation the boulder's own holds live at. FALLBACK ONLY now — the "Then" view uses
    /// <see cref="_historicGeneration"/>, which also follows each hold's ancestor. This still beats
    /// Boulder.Generation (only stamped on create/revise) when the server cannot answer.
    /// </summary>
    private int? BoulderHoldGeneration => _boulder is { BoulderHolds.Count: > 0 }
        ? _boulder.BoulderHolds.Max(bh => bh.Hold.Generation)
        : null;

    /// <summary>
    /// The "Then" toggle is offered whenever the boulder has an older state to show, and it renders
    /// THAT generation. Resolved once per load into <see cref="_historicGeneration"/> — this gate
    /// MUST stay a pure field read: any query or permission call at render time runs through the
    /// viewer resolution, which throws for an anonymous share-link viewer and returns nothing for a
    /// signed-in non-member, so gating on one hid the toggle from exactly the viewers who can use it.
    /// </summary>
    private bool CanViewHistoric => _boulder != null && _historicGeneration.HasValue;

    /// <summary>
    /// Resolves the generation the "Then" view shows, through the server rule that follows each
    /// hold's cross-generation ancestor. Needed because a hold CARRIED through a wall update is a new
    /// row stamped at the CURRENT generation: the boulder's own hold generations therefore do not
    /// reveal that it changed, and the old max-hold-generation gate hid the toggle on precisely the
    /// boulders flagged because a hold changed. Share-link viewers resolve it by token.
    /// <para>
    /// If the server cannot answer, fall back to the OLD max-hold-generation rule rather than hiding
    /// the toggle: a slightly wrong "Then" beats no "Then" at all.
    /// </para>
    /// </summary>
    private async Task ResolveHistoricGenerationAsync()
    {
        try
        {
            _historicGeneration = await BoulderService.GetHistoricGenerationAsync(BoulderId, ShareToken);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not resolve the historic generation of boulder {BoulderId}", BoulderId);
            _historicGeneration = _boulder != null && BoulderHoldGeneration is { } g
                && g < _boulder.Wall.CurrentGeneration
                    ? g
                    : null;
        }
    }

    /// <summary>
    /// Resolves <see cref="_renderHolds"/> for the view that is about to be drawn: the boulder's own
    /// holds in "Now", and the same holds TRANSLATED to the historic generation in "Then".
    /// <para>
    /// The translation is what makes a carried boulder visible at all. A hold carried through a wall
    /// update is a fresh row at today's generation pointing at today's panel; the historic view draws
    /// the OLD generation's panels, so the raw holds match none of them and every one is dropped.
    /// </para>
    /// <para>
    /// If the translation comes back empty (or fails) there is no hold set for that generation, so
    /// "Then" cannot be drawn at all and the method exits in "Now" with the boulder's own holds —
    /// which really are current-generation rows. A frozen boulder never takes that path: its holds
    /// already sit at the historic generation and translate to themselves.
    /// </para>
    /// <para>
    /// INVARIANT: <see cref="_showHistoric"/>, <see cref="_renderHolds"/> and
    /// <see cref="_boulderHoldIds"/> describe ONE generation on every exit path. The half-updated
    /// pair is what made the overlay and the photo disagree, and it is structurally unreachable now:
    /// the single non-translated exit sets all three together.
    /// </para>
    /// </summary>
    private async Task ResolveRenderHoldsAsync()
    {
        _untranslatedHoldCount = 0;
        if (_boulder is null)
        {
            _renderHolds = [];
            _boulderHoldIds = [];
            return;
        }

        var own = _boulder.BoulderHolds
            .Select(bh => new BoulderHoldAtGeneration(bh.Hold, bh.Type, bh.Usage))
            .ToList();

        if (_showHistoric && _historicGeneration is { } gen)
        {
            List<BoulderHoldAtGeneration>? translated = null;
            try
            {
                var rows = await BoulderService.GetBoulderHoldsAtGenerationAsync(BoulderId, gen, ShareToken);
                translated = rows is { Count: > 0 } ? [.. rows] : null;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(
                    ex, "Could not map boulder {BoulderId} onto generation {Generation}", BoulderId, gen);
            }

            if (translated is not null)
            {
                _renderHolds = translated;

                // Counted from the holds that came back with no match, never as a difference of set
                // sizes: two of the boulder's holds descending from ONE older row is a convergence,
                // and subtracting sizes reported it as a hold the view could not draw.
                _untranslatedHoldCount = BoulderGenerationView.UntranslatedHoldCount(
                    _boulder.BoulderHolds.Select(bh => bh.HoldId), translated);
                _boulderHoldIds = translated.Select(bh => bh.HoldId).ToHashSet();
                return;
            }

            // The translation produced nothing at all (empty, or it threw). There is no hold set for
            // that generation, so "Then" cannot be drawn honestly however sympathetically we word it
            // — and the boulder's own rows are CURRENT-generation rows. Falling through with them
            // while leaving _showHistoric true is what put historic photos under current holds, with
            // every hold dropped and no note. The only truthful exit is "Now" with the current holds,
            // which the shared exit below takes.
        }

        // THE ONLY EXIT that is not a completed translation, and it forces "Now". _showHistoric,
        // _renderHolds and _boulderHoldIds therefore describe ONE generation on every path out of
        // this method — the invariant the doc comment promises. The earlier half-updated pair
        // (historic mode, current holds) is now unrepresentable rather than merely unlikely.
        _showHistoric = false;
        _renderHolds = own;
        _boulderHoldIds = own.Select(bh => bh.HoldId).ToHashSet();
    }

    /// <summary>
    /// Whether today's wall could actually DRAW this boulder: true when at least one of its own holds
    /// resolves onto a live panel (its home panel is live, or it carries no panel id and there is a
    /// live centre panel to put it on), false when none does, and null when the panels could not be
    /// read at all. This is the gate on every fallback out of "Then" — switching blindly to "Now" is
    /// what blanked the page for frozen boulders, whose every hold sits on a superseded panel.
    /// </summary>
    private async Task<bool?> RendersOnCurrentPanelsAsync()
    {
        if (_boulder is null)
        {
            return false;
        }

        try
        {
            var live = (await WallPanelService.GetPanelsAsync(WallId)).Where(p => p.IsLive).ToList();
            if (live.Count == 0)
            {
                // No panel viewer at all: the single-image arm draws the boulder's own holds over the
                // wall photo, which always renders.
                return true;
            }

            // BoulderGenerationView.RendersOnPanels, NOT RenderPanelId: the centre-panel fallback
            // must not count as "renders here" for a hold that is OLDER than the centre panel it
            // would land on. Evening Wood's holds are generation 0 with no panel id on a generation-3
            // wall; RenderPanelId happily drops them onto today's re-photographed centre panel, this
            // said "yes, Now works", and the page opened in "Now" painting generation-0 coordinates
            // over features that no longer exist. RenderPanelId keeps its own contract for the two
            // drawing call sites in LoadPanelData — narrowing it there would silently drop
            // never-stamped virtual holds from the current view, which is the hole it exists to
            // close.
            var placements = _boulder.BoulderHolds
                .Select(bh => new HoldPlacement(bh.Hold.WallPanelId, bh.Hold.Generation));
            return BoulderGenerationView.RendersOnPanels(live, placements);
        }
        catch (Exception)
        {
            // Unknown, and deliberately not "yes": staying put keeps whatever is on screen on screen.
            return null;
        }
    }

    /// <summary>
    /// The panel holds the multi-image viewer falls back to when <c>_holdsByPanel</c> is null (see
    /// the invariant on that field). Context only — none of these are highlighted — but a photo with
    /// the wall's holds on it beats the bare photo that the empty-dictionary short-circuit produced.
    /// Returns nothing rather than throwing for a viewer who may not enumerate panel holds.
    /// </summary>
    private async Task<IReadOnlyList<PanelHold>> LoadPanelHoldsAsync(Guid panelId)
    {
        try
        {
            return await WallPanelService.GetPanelHoldsAsync(WallId, panelId, includeStaged: false);
        }
        catch (Exception)
        {
            return [];
        }
    }

    /// <summary>
    /// How many of the boulder's holds the view on screen cannot draw because the generation shown
    /// has no row for them. Zero in "Now" and whenever the translation was complete.
    /// </summary>
    private int HistoricHoldsMissing => _showHistoric ? _untranslatedHoldCount : 0;

    /// <summary>
    /// Whether the page should OPEN in "Then". Only for a boulder that is genuinely frozen on an old
    /// generation — none of its holds live on a panel of today's wall, so "Now" would have nothing to
    /// draw. A carried boulder's holds ARE on today's panels, so it opens in "Now" and the toggle is
    /// there for whoever wants the old state. Decided from the panel ids on the holds, not from a
    /// flag: IsHistoric/NeedsReview say a review is due, not which image is the useful one.
    /// </summary>
    private async Task<bool> ShouldOpenHistoricAsync()
    {
        if (_boulder is null || !CanViewHistoric)
        {
            return false;
        }

        // Exactly the inverse of the gate every fallback uses, so the page can never open in a view
        // the fallback would immediately bounce it out of (or worse, bounce it into a blank one).
        // A hold with no panel id renders on whichever generation's centre panel is shown, so it is
        // present in "Now" too and must not push the page into the historic view; RenderPanelId is
        // what encodes that, and RendersOnCurrentPanelsAsync asks it directly.
        var renders = await RendersOnCurrentPanelsAsync();
        if (renders is null)
        {
            // The panels could not be read: fall back to the boulder's own hold generation, the rule
            // that predates the panel comparison.
            return BoulderHoldGeneration is { } g && g < _boulder.Wall.CurrentGeneration;
        }

        return !renders.Value;
    }

    /// <summary>
    /// True when one of the panels carrying this boulder's holds lags the wall's current generation
    /// (a sibling panel was updated ahead of it). Derived from the same per-panel outdated flag the
    /// wall view badges; drives a subtle "awaiting update" note on the boulder's photo.
    /// Suppressed in the historic view: there every returned row is older than the wall's current
    /// generation BY CONSTRUCTION, so the note would fire unconditionally. It is a nudge about a
    /// panel lagging TODAY's wall, which says nothing while an old generation is shown on purpose.
    /// </summary>
    private bool BoulderOnOutdatedPanel =>
        !_showHistoric && _livePanels.Any(p => p.IsOutdated && _highlightedPanelIds.Contains(p.Id));

    /// <summary>
    /// A live/published boulder the creator, a setter, OR a wall admin may still fully re-edit (holds
    /// and rules) — now allowed even after another climber has sent it: the holds are edited in place
    /// and the existing ascents stay attached (the server enforces the same rule). Drafts and historic
    /// boulders have their own revise links elsewhere.
    /// </summary>
    private bool CanFullRevise =>
        (_isCreator || _isAdmin || _isSetter) && !_isAnonymous
        && _boulder is { IsDraft: false, IsHistoric: false };

    /// <summary>
    /// The boulder's setters as a human list: "A", "A &amp; B", or "A, B &amp; C". Empty when the
    /// boulder has no explicit setter (the creator line is shown instead).
    /// </summary>
    private string SettersDisplay =>
        BoulderSetterNames.Format(_boulder?.Setters.Select(s => s.User.Name));

    /// <summary>
    /// Who added the boulder, through the SAME formatter the wall list's byline uses, so the two
    /// pages can never disagree. It reads "Ghost" for a boulder set at an unattended kiosk (the
    /// Ghost system row) and for one whose creator has since deleted their account — never the raw
    /// name of a system row. Also null-safe, which the direct <c>CreatedBy.Name</c> deref was not.
    /// </summary>
    private string CreatorDisplay => BoulderSetterNames.Describe(null, _boulder?.CreatedBy);

    private string PhotoUrl
    {
        get
        {
            var gen = _showHistoric && _historicGeneration is { } g ? $"/{g}" : string.Empty;
            return !string.IsNullOrEmpty(ShareToken)
                ? $"/api/walls/{WallId}/photo{gen}?token={ShareToken}"
                : $"/api/walls/{WallId}/photo{gen}";
        }
    }

    /// <summary>
    /// Switches the view between today's wall and the historic one. Explicit state rather than a
    /// flip, so the two toggle buttons each say where they GO and pressing the active one is a no-op
    /// reload rather than a surprise switch.
    /// </summary>
    private async Task ShowGenerationAsync(bool historic)
    {
        _showHistoric = historic;

        // All three have to move together: the holds are re-resolved onto the generation being shown,
        // LoadWallHolds swaps the schematic hold data, and the photos underneath come from the panel
        // rows — without re-fetching them "Then" would show old holds on today's images.
        await ResolveRenderHoldsAsync();
        await LoadWallHolds();
        await LoadPanelData();
    }

    private async Task PublishDraft()
    {
        try
        {
            await BoulderService.PublishBoulderAsync(BoulderId);
            await LoadBoulder();
        }
        catch (Exception ex)
        {
            _publishError = ex.Message;
        }
    }

    // Only the once-per-instance cache subscription lives here. The route-dependent boulder load runs
    // in OnParametersSetAsync so boulder→boulder navigation, which keeps this component alive under
    // enhanced navigation, actually reloads instead of showing the first boulder. See WallDetail.
    protected override void OnInitialized()
    {
        Cache.Changed += OnCacheChanged;
    }

    // Reloads whenever the route names a different boulder (or wall, or share token). On a retained
    // component the parameters change without OnInitialized re-running, so without this the page would
    // keep showing the boulder it first loaded — the "wrong boulder after sort/click" bug.
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedWallId == WallId && _loadedBoulderId == BoulderId && _loadedShareToken == ShareToken)
        {
            return;
        }

        _loadedWallId = WallId;
        _loadedBoulderId = BoulderId;
        _loadedShareToken = ShareToken;

        // Blank the previous boulder (and everything derived from it) before the new load so a
        // retained component can never flash the wrong boulder, and stale permissions/holds can't
        // survive a load that ends not-found.
        _boulder = null;
        _isAnonymous = false;
        _currentUserId = Guid.Empty;
        _isCreator = false;
        _isSetter = false;
        _isAdmin = false;
        _showHistoric = false;
        _historicGeneration = null;
        _boulderHoldIds = [];
        _renderHolds = [];
        _activeProposal = null;
        _isFavorite = false;
        _rating = new(null, 0, null);
        _publishError = null;
        StateHasChanged();

        await LoadForCurrentRouteAsync();
    }

    private async Task LoadForCurrentRouteAsync()
    {
        if (!string.IsNullOrEmpty(ShareToken))
        {
            _isAnonymous = true;
            try
            {
                var user = await CurrentUserService.GetCurrentUserAsync();
                _currentUserId = user.Id;
                _isAnonymous = false;
            }
            catch (UnauthorizedAccessException ex)
            {
                // No signed-in user behind the share link; the viewer stays anonymous.
                Logger.LogDebug(ex, "Share-token viewer of boulder {BoulderId} is not signed in", BoulderId);
            }

            _boulder = await BoulderService.GetBoulderByShareTokenAsync(BoulderId, ShareToken);
        }
        else
        {
            try
            {
                var user = await CurrentUserService.GetCurrentUserAsync();
                _currentUserId = user.Id;
                await LoadBoulder();
            }
            catch (UnauthorizedAccessException)
            {
                // Same rule as the wall page, and for the same reason: a registered tablet with
                // nobody picked reads its own wall's boulders read-only rather than being sent to a
                // login it cannot complete. Opening a boulder IS what the tablet is for. Everyone
                // else anonymous — and a kiosk aimed at another wall — still goes to sign in.
                if (!KioskViewing.AllowsAnonymousViewOf(KioskContext, WallId))
                {
                    Navigation.NavigateTo("/account/login", replace: true);
                    return;
                }

                _isAnonymous = true;
                _currentUserId = Guid.Empty;
                await LoadBoulder();
            }
        }

        // The route names a wall AND a boulder, and nothing tied the two together: a boulder from
        // another wall loaded happily under this wall's id, and everything below (holds, panels,
        // photo urls, the activity feed) would then be resolved against the WRONG wall. Treat the
        // mismatch as not-found — the same answer as a boulder that does not exist.
        if (_boulder != null && _boulder.WallId != WallId)
        {
            _boulder = null;
        }

        // Drafts are visible to every wall member now (they just can't be logged until published),
        // so a non-creator is no longer redirected away from a draft.

        if (_boulder != null)
        {
            await LoadBoulderContextAsync();
        }
    }

    private async Task LoadBoulderContextAsync()
    {
        _isCreator = _boulder!.CreatedByUserId == _currentUserId;

        // A setter (or co-setter) of this boulder may edit/revise/publish it just like the
        // creator — the server enforces the same rule. Meaningless for an anonymous viewer.
        _isSetter = !_isAnonymous && _boulder.Setters.Any(s => s.UserId == _currentUserId);

        // A wall admin (a WallRole.Admin member of this wall) may revise ANY boulder on the
        // wall, not only the ones they created — same membership-role check used across the
        // wall UI. Only meaningful for a signed-in viewer on the normal (non-share) path; the
        // boulder's own Wall include carries no Members, so read the wall from the cache.
        if (!_isAnonymous && string.IsNullOrEmpty(ShareToken))
        {
            var wall = await Cache.GetWallAsync(WallId);
            var membership = wall?.Members.FirstOrDefault(m => m.UserId == _currentUserId);
            // The wall owner counts as an admin even without an explicit Admin member row, matching
            // WallAdminGuard on the server — otherwise an owner would be offered no revise entry
            // point yet the server would accept the revise.
            _isAdmin = membership?.Role == WallRole.Admin || wall?.OwnerId == _currentUserId;
        }

        _boulderHoldIds = _boulder.BoulderHolds.Select(bh => bh.HoldId).ToHashSet();

        // A live boulder may now be fully re-edited by the creator or a wall admin even after
        // others have sent it, so there is no longer a "sent by others" gate to pre-compute here.

        // A boulder whose holds are all gone from today's panels can only be read on the old wall, so
        // open THAT one; a carried boulder still renders on today's wall and opens there.
        await ResolveHistoricGenerationAsync();
        _showHistoric = await ShouldOpenHistoricAsync();
        await ResolveRenderHoldsAsync();
        await LoadWallHolds();
        await LoadPanelData();
        _activeProposal = await BoulderService.GetActiveProposalAsync(BoulderId);

        if (!_isAnonymous)
        {
            _isFavorite = await FeedbackService.IsFavoritedAsync(BoulderId);
            _rating = await FeedbackService.GetRatingAsync(BoulderId);
        }
    }

    /// <summary>
    /// Live-refresh when this boulder (or its wall) changes on any circuit — so a co-owner's revise
    /// or grade change appears without a reload. Skipped for anonymous share viewers (their reads go
    /// through the uncached share path) and while the name/grade form is open, so a background reload
    /// never discards an in-progress edit.
    /// </summary>
    private void OnCacheChanged(DomainChange change)
    {
        // Share viewers are skipped by TOKEN, not only by _isAnonymous: a signed-in viewer following
        // a share link has _isAnonymous == false even with no membership on this wall, and their
        // reads go through the uncached share path that this cache signal says nothing about.
        if (change.Scope == DomainChangeScope.WallList || _isAnonymous || !string.IsNullOrEmpty(ShareToken) || _editMeta)
        {
            return;
        }

        if (change.BoulderId != BoulderId && change.WallId != WallId)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadBoulder();
                if (_boulder != null)
                {
                    // _boulderHoldIds is NOT set from the raw holds here: ResolveRenderHoldsAsync
                    // below owns it, and seeding it from the current generation first is how the ids
                    // and the holds on screen came to describe different generations.

                    // A promote on another circuit moves the wall's generation and the boulder's
                    // lineage under us, so the cached answer would be stale exactly when it matters.
                    await ResolveHistoricGenerationAsync();
                    if (!CanViewHistoric)
                    {
                        // Nothing older left to show: drop out of "Then" rather than labelling
                        // today's wall as the old one.
                        _showHistoric = false;
                    }

                    await ResolveRenderHoldsAsync();
                    await LoadWallHolds();
                    await LoadPanelData();
                }

                StateHasChanged();
            }
            catch (Exception)
            {
                // A transient reload failure should leave the current view in place, not crash it.
            }
        });
    }

    /// <summary>
    /// Wall holds that count as footholds only because of the boulder's
    /// "feet of one colour only" rule, i.e. excluding the boulder's own holds.
    /// </summary>
    private List<Hold> ColorRuleHolds => _colorRuleHolds;

    /// <summary>
    /// The boulder's own dedicated footholds (<see cref="HoldUsage.FootOnly"/>), drawn orange in the
    /// schematic. The "feet of one colour only" rule is no longer painted onto every matching wall
    /// hold; it is communicated by the info banner above the image instead.
    /// </summary>
    /// <remarks>Read off <see cref="_renderHolds"/> so the ids match the generation on screen.</remarks>
    private HashSet<Guid> FootHoldIds => _renderHolds
        .Where(bh => bh.Usage == HoldUsage.FootOnly)
        .Select(bh => bh.HoldId)
        .ToHashSet();

    private async Task LoadWallHolds()
    {
        _wallHolds = await FetchWallHoldsAsync();
        _colorRuleHolds = _boulder is { FootColorOnly: { Length: > 0 } color } && _wallHolds != null
            ? _wallHolds.Where(h => h.Color == color && !_boulderHoldIds.Contains(h.Id)).ToList()
            : [];

        // Frame the photo view to the wall region (border if present, else the wall holds' bbox)
        // so the boulder isn't drowned in floor/ceiling. Null when there's nothing usable to frame.
        _frame = WallFraming.TryComputeFrame(_boulder?.Wall.BorderPoints, _wallHolds);
    }

    /// <summary>
    /// Builds the data the multi-image viewer needs: the wall's live panels, the boulder's holds
    /// grouped per panel (so they render regardless of who can enumerate panel holds), the panels
    /// that carry a boulder hold (the only ones an arrow points to), and the start panel — the one
    /// holding the most of the boulder's holds. A failed panel read leaves everything empty, so
    /// <see cref="UsingMultiPanel"/> is false and the single-image fallback arm renders instead.
    /// </summary>
    private async Task LoadPanelData()
    {
        // Every exit of the core — the null-boulder return, the failed-read fallback, the historic
        // re-entry and the normal path — lands here, so the epoch can never be skipped by an early
        // return that left new (or newly cleared) data behind. The re-entry path bumps twice; only
        // the final value is ever rendered, and it has moved, which is all the key asks.
        await LoadPanelDataCore();
        _viewEpoch++;
    }

    private async Task LoadPanelDataCore()
    {
        _livePanels = [];

        // Null, not an empty dictionary — see the invariant on the field.
        _holdsByPanel = null;
        _highlightedPanelIds = [];
        _highlightedHoldIds = [];
        _highlightedHoldTypes = new();

        if (_boulder is null)
        {
            return;
        }

        try
        {
            // In the historic ("Then") view the boulder must be drawn on the panels of ITS OWN
            // generation — the photos its holds were placed on — not today's re-photographed ones.
            // Its holds carry the superseded panel rows' ids, so those rows are also what makes
            // RenderPanelId resolve them instead of dropping them onto the centre panel.
            var panels = _showHistoric && _historicGeneration is { } gen
                ? await WallPanelService.GetPanelsAsync(WallId, gen)
                : await WallPanelService.GetPanelsAsync(WallId);
            _livePanels = panels.Where(p => p.IsLive).ToList();
        }
        catch (Exception)
        {
            _livePanels = [];
            return;
        }

        var livePanelIds = _livePanels.Select(p => p.Id).ToHashSet();

        // Explicitly tie-broken (newest generation, then smallest id): a panel list can carry more
        // than one row at (0,0), and FirstOrDefault picked between them in provider order — so the
        // photo a hold with no panel id was drawn on could change between two identical loads.
        var centrePanelId = BoulderGenerationView.CentrePanel(_livePanels)?.Id;
        // _renderHolds, not the boulder's raw holds: in "Then" these are the boulder's holds
        // translated onto the historic generation, so their panel ids are that generation's and
        // RenderPanelId resolves them against the historic _livePanels instead of dropping them all.
        var onPanels = _renderHolds
            .Where(bh => RenderPanelId(bh.Hold, livePanelIds, centrePanelId) is not null)
            .ToList();

        if (onPanels.Count == 0 && _showHistoric && await RendersOnCurrentPanelsAsync() == true)
        {
            // Nothing of the boulder lands on the historic panels after all (holds without a panel id
            // and no centre panel, say), and today's wall has been CONFIRMED able to draw it — only
            // then is switching an improvement. For a frozen boulder it is not: "Now" resolves none of
            // its holds either, so the old blind switch just moved the blank page to the other view.
            // When we do switch, _renderHolds moves with _showHistoric (ResolveRenderHoldsAsync), so
            // the two never disagree. Re-entered once only — _showHistoric is false on the way back in.
            _showHistoric = false;
            await ResolveRenderHoldsAsync();

            // LoadWallHolds too, not just the holds and the panels: _wallHolds, _frame and
            // _colorRuleHolds are ALL read off the generation on screen, and flipping without it left
            // the page framed to the other generation with a "feet of one colour" set built from it.
            await LoadWallHolds();
            await LoadPanelData();
            return;
        }

        // Falling through with onPanels empty is now possible (nothing renders either way). That is
        // fine and no longer a blank page: _holdsByPanel stays null, so the viewer asks
        // LoadPanelHoldsAsync for the panel's own holds instead of drawing an empty overlay.

        // Start from the boulder's own holds on their home panels — the pre-expansion baseline that
        // renders exactly as before. Twins linked across overlaps are added on top below.
        var holdsByPanel = onPanels
            .GroupBy(bh => RenderPanelId(bh.Hold, livePanelIds, centrePanelId)!.Value)
            .ToDictionary(
                g => g.Key,
                g => g.Select(bh => new PanelHold(
                    bh.HoldId, bh.Hold.X, bh.Hold.Y, bh.Hold.Radius, bh.Hold.Color, bh.Hold.Category, bh.Hold.ShapePoints, bh.Hold.IsVirtual, bh.Hold.ShapeHoles)).ToList());
        foreach (var bh in onPanels)
        {
            _highlightedHoldIds.Add(bh.HoldId);
            _highlightedHoldTypes[bh.HoldId] = (bh.Type, bh.Usage);
        }

        await ExpandLinkedTwinsAsync(onPanels, holdsByPanel);

        // Every entry in holdsByPanel is a highlighted hold (the boulder's own or a linked twin), so
        // the panels that carry one — the arrow targets — are exactly its keys, and the start panel
        // is the one holding the most highlighted holds (twins counted).
        // Null when nothing was grouped — see the invariant on the field. ExpandLinkedTwinsAsync can
        // only ADD, so this is the last word on the dictionary and the only place it becomes non-null.
        _holdsByPanel = holdsByPanel.Count == 0
            ? null
            : holdsByPanel.ToDictionary(kv => kv.Key, kv => (IReadOnlyList<PanelHold>)kv.Value);
        _highlightedPanelIds = holdsByPanel.Keys.ToHashSet();

        var startPanelId = holdsByPanel
            .OrderByDescending(kv => kv.Value.Count)
            .Select(kv => (Guid?)kv.Key)
            .FirstOrDefault();
        if (startPanelId is { } spid && _livePanels.FirstOrDefault(p => p.Id == spid) is { } start)
        {
            _startPanelCol = start.Col;
            _startPanelRow = start.Row;
        }
    }

    /// <summary>
    /// The live panel a boulder hold renders on: its own home panel when that panel is live, or —
    /// for a hold with no panel id at all — the live CENTRE panel (Col 0, Row 0). Virtual holds are
    /// created through <c>WallService.AddHoldAsync</c>, which historically never stamped a panel, so
    /// without this fallback an existing virtual TOP silently vanishes from a multi-panel wall. Mirrors the editors'
    /// rule in BoulderCreate/BoulderRevise (<c>RefreshPickerHolds</c>) so viewer and editor agree.
    /// Null when the home panel isn't live and there is no centre panel — the hold is dropped, as before.
    /// </summary>
    private static Guid? RenderPanelId(Hold hold, HashSet<Guid> livePanelIds, Guid? centrePanelId)
    {
        if (hold.WallPanelId is { } pid)
        {
            return livePanelIds.Contains(pid) ? pid : null;
        }

        return centrePanelId;
    }

    /// <summary>
    /// A hold linked across an overlap is one physical hold. For every boulder hold, light every
    /// hold in its link component that sits on a LIVE panel, carrying the same boulder Type/Usage.
    /// When two boulder holds land in the same component the type is resolved by prominence
    /// Top &gt; Start &gt; Normal (the higher <see cref="HoldType"/> value wins). Mutates
    /// <paramref name="holdsByPanel"/> plus <see cref="_highlightedHoldIds"/> and
    /// <see cref="_highlightedHoldTypes"/>. A no-op when the wall has no links or the boulder uses
    /// no linked hold, so single-panel boulders keep their exact former behaviour.
    /// </summary>
    private async Task ExpandLinkedTwinsAsync(
        List<BoulderHoldAtGeneration> onPanels,
        Dictionary<Guid, List<PanelHold>> holdsByPanel)
    {
        List<HoldLinkPair> links;
        try
        {
            links = [.. await WallPanelService.GetHoldLinksAsync(WallId)];
        }
        catch (Exception)
        {
            return;
        }

        if (links.Count == 0)
        {
            return;
        }

        var adjacency = new Dictionary<Guid, List<Guid>>();
        void Link(Guid a, Guid b)
        {
            if (!adjacency.TryGetValue(a, out var list))
            {
                list = [];
                adjacency[a] = list;
            }

            list.Add(b);
        }

        foreach (var pair in links)
        {
            Link(pair.HoldAId, pair.HoldBId);
            Link(pair.HoldBId, pair.HoldAId);
        }

        // Resolve each twin (a component member that is not itself one of the boulder's own holds)
        // to the boulder Type/Usage of the most prominent source hold reaching it.
        var sourceIds = onPanels.Select(bh => bh.HoldId).ToHashSet();
        var twinTypes = new Dictionary<Guid, (HoldType Type, HoldUsage Usage)>();
        foreach (var bh in onPanels)
        {
            foreach (var member in ConnectedComponent(adjacency, bh.HoldId))
            {
                if (sourceIds.Contains(member))
                {
                    continue;
                }

                if (!twinTypes.TryGetValue(member, out var existing) || (int)bh.Type > (int)existing.Type)
                {
                    twinTypes[member] = (bh.Type, bh.Usage);
                }
            }
        }

        if (twinTypes.Count == 0)
        {
            return;
        }

        // Twins are separate Hold rows on other panels; read live-panel holds to find their
        // positions. Stop once every twin is located so we never read more panels than needed.
        var located = new Dictionary<Guid, (Guid PanelId, PanelHold Hold)>();
        foreach (var panel in _livePanels)
        {
            IReadOnlyList<PanelHold> panelHolds;
            try
            {
                panelHolds = await WallPanelService.GetPanelHoldsAsync(WallId, panel.Id, false);
            }
            catch (Exception)
            {
                continue;
            }

            foreach (var hold in panelHolds)
            {
                if (twinTypes.ContainsKey(hold.Id) && !located.ContainsKey(hold.Id))
                {
                    located[hold.Id] = (panel.Id, hold);
                }
            }

            if (located.Count == twinTypes.Count)
            {
                break;
            }
        }

        foreach (var (twinId, type) in twinTypes)
        {
            if (!located.TryGetValue(twinId, out var loc))
            {
                // Linked to a hold that no longer sits on a live panel (removed or off-generation).
                continue;
            }

            if (!holdsByPanel.TryGetValue(loc.PanelId, out var list))
            {
                list = [];
                holdsByPanel[loc.PanelId] = list;
            }

            if (list.All(h => h.Id != twinId))
            {
                list.Add(loc.Hold);
            }

            _highlightedHoldIds.Add(twinId);
            _highlightedHoldTypes[twinId] = type;
        }
    }

    /// <summary>All hold ids reachable from <paramref name="start"/> through the link graph
    /// (including the start), so a hold and every twin across a chain of panels share a component.</summary>
    private static IEnumerable<Guid> ConnectedComponent(Dictionary<Guid, List<Guid>> adjacency, Guid start)
    {
        var seen = new HashSet<Guid> { start };
        var queue = new Queue<Guid>();
        queue.Enqueue(start);
        while (queue.Count > 0)
        {
            var current = queue.Dequeue();
            if (!adjacency.TryGetValue(current, out var neighbours))
            {
                continue;
            }

            foreach (var neighbour in neighbours)
            {
                if (seen.Add(neighbour))
                {
                    queue.Enqueue(neighbour);
                }
            }
        }

        return seen;
    }

    /// <summary>The fill/stroke a highlighted hold is drawn in (a boulder hold or a linked twin),
    /// matching the single-image photo view. Twin ids resolve to the source hold's boulder colour.</summary>
    private (string Fill, string Stroke) BoulderHoldColorOf(Guid holdId) =>
        _highlightedHoldTypes.TryGetValue(holdId, out var t)
            ? (BoulderHoldColors.FillFor(t.Type, t.Usage), BoulderHoldColors.Stroke(t.Type))
            : (BoulderHoldColors.Fill(HoldType.Normal), BoulderHoldColors.Normal);

    private async Task<List<Hold>> FetchWallHoldsAsync()
    {
        // In the historic view the schematic must draw the generation the boulder's
        // holds belong to, or none of the highlighted ids would be in the list.
        if (_showHistoric && _historicGeneration is { } gen && string.IsNullOrEmpty(ShareToken))
        {
            return await Cache.GetHoldsForGenerationAsync(WallId, gen);
        }

        if (_showHistoric && _historicGeneration.HasValue && _boulder != null)
        {
            // Anonymous share viewers can't query generations, so the boulder's own holds are the
            // whole schematic. They must be the TRANSLATED ones: _boulderHoldIds and FootHoldIds are
            // read off _renderHolds, so returning the raw current-generation rows here left the two
            // sets with no id in common and the share viewer's "Then" highlighted nothing at all.
            return _renderHolds.Select(bh => bh.Hold).ToList();
        }

        var wall = !string.IsNullOrEmpty(ShareToken)
            ? await WallService.GetWallByShareTokenAsync(ShareToken)
            : await Cache.GetWallAsync(WallId);

        return wall?.Holds.ToList() ?? [];
    }

    /// <summary>
    /// Re-reads the boulder through the SAME path the initial load used. The share path must stay on
    /// <c>GetBoulderByShareTokenAsync</c>: the cached read is filtered by wall membership, so for a
    /// signed-in viewer who is NOT a member of this wall it returns null and a reload would blank the
    /// page they were legitimately shown. Anonymous viewers hit the same wall by a different route
    /// (no user at all), so the branch is on the token, not on <c>_isAnonymous</c>.
    /// </summary>
    private async Task LoadBoulder()
    {
        if (!string.IsNullOrEmpty(ShareToken))
        {
            _boulder = await BoulderService.GetBoulderByShareTokenAsync(BoulderId, ShareToken);
            return;
        }

        _boulder = await Cache.GetBoulderAsync(BoulderId);
        if (!_isAnonymous)
        {
            _attempts = await AttemptService.GetAttemptsForBoulderAsync(BoulderId);
            _summary = await AttemptService.GetBoulderSummaryForUserAsync(BoulderId);
        }
    }

    // Logging an attempt, rating, favouriting and commenting are NOT handled here any more.
    // They are written by the delegated DOM handler in wwwroot/js/offline-actions.js, which
    // keeps them working with the circuit down and — being the only writer — makes a
    // double-application impossible. The page catches up via OnOfflineQueueFlushed.
    //
    // Everything below still needs a live circuit (delete, archive, grade proposals). Each
    // runs through Guard so a throw can never strand a flag or vanish silently.

    /// <summary>
    /// Runs a server round-trip, always re-rendering afterwards and always telling the user when
    /// it failed. The pattern this replaces set an "in flight" flag, awaited, then cleared the
    /// flag on the happy path only: a throw (or a circuit dropping mid-await) left the buttons
    /// disabled forever with no message, which is exactly the "cannot log ascents" symptom.
    /// Any busy flag added later belongs in the <c>finally</c>, never after the <c>await</c>.
    /// </summary>
    private async Task Guard(Func<Task> action, string failureLabel)
    {
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            await ShowToast($"{failureLabel}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void StartEditMeta()
    {
        _editName = _boulder?.Name ?? "";
        _editGrade = _boulder?.Grade;
        _editMeta = true;
        SyncBoulderEditLease();
    }

    private void CancelEditMeta()
    {
        _editMeta = false;
        SyncBoulderEditLease();
    }

    private void ShowGradeForm()
    {
        _showGradeForm = true;
        SyncBoulderEditLease();
    }

    private void CancelGradeForm()
    {
        _showGradeForm = false;
        SyncBoulderEditLease();
    }

    // Single source of truth for the busy lease: acquire when an inline editor opens (and one isn't
    // already held, so re-opening never double-acquires), release when both editors are closed.
    // Called after every edit-flag change and from DisposeAsync.
    private void SyncBoulderEditLease()
    {
        if (_editMeta || _showGradeForm)
        {
            _editLease ??= EditActivity.BeginBoulderEdit(WallId, _currentUserId == Guid.Empty ? null : _currentUserId);
        }
        else
        {
            _editLease?.Dispose();
            _editLease = null;
        }
    }

    private Task SaveMeta() => Guard(async () =>
    {
        if (_boulder == null || string.IsNullOrWhiteSpace(_editName))
        {
            return;
        }

        var updated = await BoulderService.RenameBoulderAsync(BoulderId, _editName, _editGrade);
        _boulder.Name = updated.Name;
        _boulder.Grade = updated.Grade;
        _editMeta = false;
        SyncBoulderEditLease();
        await ShowToast("Boulder updated");
    }, "Could not update the boulder");

    // A backdated log runs the server path directly (not the offline queue), so it needs a live
    // circuit — acceptable for a deliberate "log an old ascent" action. The picked wall-clock time
    // is stored verbatim (offset zero) so the history shows exactly what was chosen.
    private Task LogBackdated(AttemptType type) => Guard(async () =>
    {
        var when = new DateTimeOffset(DateTime.SpecifyKind(_backdateTime, DateTimeKind.Unspecified), TimeSpan.Zero);
        await AttemptService.LogAttemptAsync(BoulderId, type, timestamp: when);
        await LoadBoulder();
        if (_activityFeed != null)
        {
            await _activityFeed.ReloadAsync();
        }

        await ShowToast($"Logged {type} at {_backdateTime:MMM d, HH:mm}");
    }, "Could not log that attempt");

    private Task DeleteAttempt(Guid attemptId) => Guard(async () =>
    {
        await AttemptService.DeleteAttemptAsync(attemptId);
        await LoadBoulder();
    }, "Could not delete that attempt");

    private Task ClearRating() => Guard(async () =>
    {
        await FeedbackService.RemoveRatingAsync(BoulderId);
        _rating = await FeedbackService.GetRatingAsync(BoulderId);
    }, "Could not clear your rating");

    private Task ArchiveBoulder() => Guard(async () =>
    {
        await BoulderService.ArchiveBoulderAsync(BoulderId);
        await LoadBoulder();
        await ShowToast("Boulder archived");
    }, "Archive failed");

    private Task UnarchiveBoulder() => Guard(async () =>
    {
        await BoulderService.UnarchiveBoulderAsync(BoulderId);
        await LoadBoulder();
        await ShowToast("Boulder restored");
    }, "Restore failed");

    private Task SubmitGradeProposal() => Guard(async () =>
    {
        if (string.IsNullOrEmpty(_proposedGrade))
        {
            return;
        }

        _activeProposal = await BoulderService.ProposeGradeAsync(BoulderId, _proposedGrade);
        _showGradeForm = false;
        SyncBoulderEditLease();
        await ShowToast("Grade proposal submitted");
    }, "Could not submit that proposal");

    private Task AcceptProposal() => Guard(async () =>
    {
        if (_activeProposal == null)
        {
            return;
        }

        await BoulderService.AcceptGradeProposalAsync(_activeProposal.Id);
        if (_boulder != null)
        {
            _boulder.Grade = _activeProposal.ProposedGrade;
        }

        _activeProposal = null;
        await ShowToast("Grade updated");
    }, "Could not accept that proposal");

    private Task RejectProposal() => Guard(async () =>
    {
        if (_activeProposal == null)
        {
            return;
        }

        await BoulderService.RejectGradeProposalAsync(_activeProposal.Id);
        _activeProposal = null;
        await ShowToast("Proposal rejected");
    }, "Could not reject that proposal");

    /// <summary>
    /// An upload writes an activity entry, so the feed below the strip is stale until it re-reads.
    /// The strip refreshes itself.
    /// </summary>
    private async Task OnBetaVideoUploaded()
    {
        if (_activityFeed != null)
        {
            await _activityFeed.ReloadAsync();
        }
    }

    private async Task ShowToast(string message)
    {
        _toast = message;
        StateHasChanged();
        await Task.Delay(2000);
        _toast = null;
        StateHasChanged();
    }
}

