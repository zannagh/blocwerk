@page "/walls"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IWallService WallService
@inject WallCacheState Cache
@inject IAssetHashReader AssetHashes
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>My Walls - Blocwerk</PageTitle>

<div class="wall-list">
    <div class="list-header">
        <h1>My Walls</h1>
        <a href="/walls/create" class="btn-create">+ New Wall</a>
    </div>

    <div class="join-section">
        <input @bind="_shareToken" placeholder="Paste invite link or token..." class="join-input" />
        <button @onclick="JoinWall" class="btn-join" disabled="@string.IsNullOrWhiteSpace(_shareToken)">Join</button>
    </div>

    @if (_walls == null)
    {
        <p class="loading">Loading...</p>
    }
    else if (_walls.Count == 0)
    {
        <div class="empty-state">
            <p>No walls yet. Create your first wall or join one with an invite link!</p>
        </div>
    }
    else
    {
        <div class="wall-cards">
            @foreach (var wall in _walls)
            {
                <a href="/walls/@wall.Id" class="wall-card">
                    <div class="wall-card-photo">
                        @if (wall.PhotoContentType != null)
                        {
                            @* Card thumbnail on the PWA start page: a modest rendition, lazily
                               loaded. Never the stored camera original, which a width-less request
                               would serve. *@
                            <img src="@ResponsiveImage.AtWidth(AssetUrls.WallPhoto(wall.Id, _photoShas.GetValueOrDefault(wall.Id)), 640)"
                                 loading="lazy" decoding="async" alt="@wall.Name" />
                        }
                        else
                        {
                            <div class="no-photo">No Photo</div>
                        }
                    </div>
                    <div class="wall-card-info">
                        <h3>@wall.Name</h3>
                        <span class="member-count">@wall.Members.Count member@(wall.Members.Count != 1 ? "s" : string.Empty)</span>
                    </div>
                </a>
            }
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="error-toast">@_error</div>
}

@code {
    private List<Wall>? _walls;
    private string _shareToken = string.Empty;
    private string? _error;

    // The card photos' hashes, read from the database: the cached walls can hold pre-backfill nulls, and a wall
    // update moves the centre panel's hash without changing the wall list.
    private IReadOnlyDictionary<Guid, string> _photoShas = new Dictionary<Guid, string>();

    protected override async Task OnInitializedAsync()
    {
        Cache.Changed += OnCacheChanged;
        _walls = await Cache.GetMyWallsAsync();
        await LoadPhotoShasAsync();
    }

    // Live-refresh when the set of walls changes (created/deleted/joined) on any circuit, and re-read the card
    // photos' hashes when one of the listed walls changed (its centre panel may have been replaced).
    private void OnCacheChanged(DomainChange change)
    {
        var listed = change.Scope == DomainChangeScope.Wall && _walls?.Any(w => w.Id == change.WallId) == true;
        if (change.Scope != DomainChangeScope.WallList && !listed)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (change.Scope == DomainChangeScope.WallList)
            {
                _walls = await Cache.GetMyWallsAsync();
            }

            await LoadPhotoShasAsync();
            StateHasChanged();
        });
    }

    private async Task LoadPhotoShasAsync()
    {
        try
        {
            _photoShas = await AssetHashes.WallPhotosAsync(_walls?.Select(w => w.Id).ToList() ?? []);
        }
        catch (Exception)
        {
            // The legacy /photo urls still work without them.
            _photoShas = new Dictionary<Guid, string>();
        }
    }

    public void Dispose()
    {
        Cache.Changed -= OnCacheChanged;
    }

    private async Task JoinWall()
    {
        try
        {
            var token = _shareToken.Trim();
            if (token.Contains('/'))
            {
                token = token.Split('/').Last();
            }

            var wall = await WallService.JoinWallAsync(token);
            Navigation.NavigateTo($"/walls/{wall.Id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            StateHasChanged();
            await Task.Delay(3000);
            _error = null;
            StateHasChanged();
        }
    }
}
