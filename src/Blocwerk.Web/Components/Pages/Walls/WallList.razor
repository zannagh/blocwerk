@page "/walls"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IWallService WallService
@inject NavigationManager Navigation

<PageTitle>My Walls - Blocwerk</PageTitle>

<div class="wall-list">
    <div class="list-header">
        <h1>My Walls</h1>
        <a href="/walls/create" class="btn-create">+ New Wall</a>
    </div>

    <div class="join-section">
        <input @bind="_shareToken" placeholder="Paste invite link or token..." class="join-input" />
        <button @onclick="JoinWall" class="btn-join" disabled="@string.IsNullOrWhiteSpace(_shareToken)">Join</button>
    </div>

    @if (_walls == null)
    {
        <p class="loading">Loading...</p>
    }
    else if (_walls.Count == 0)
    {
        <div class="empty-state">
            <p>No walls yet. Create your first wall or join one with an invite link!</p>
        </div>
    }
    else
    {
        <div class="wall-cards">
            @foreach (var wall in _walls)
            {
                <a href="/walls/@wall.Id" class="wall-card">
                    <div class="wall-card-photo">
                        @if (wall.PhotoContentType != null)
                        {
                            <img src="/api/walls/@wall.Id/photo" alt="@wall.Name" />
                        }
                        else
                        {
                            <div class="no-photo">No Photo</div>
                        }
                    </div>
                    <div class="wall-card-info">
                        <h3>@wall.Name</h3>
                        <span class="member-count">@wall.Members.Count member@(wall.Members.Count != 1 ? "s" : "")</span>
                    </div>
                </a>
            }
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="error-toast">@_error</div>
}

@code {
    private List<Wall>? _walls;
    private string _shareToken = string.Empty;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _walls = await WallService.GetMyWallsAsync();
    }

    private async Task JoinWall()
    {
        try
        {
            var token = _shareToken.Trim();
            if (token.Contains('/'))
            {
                token = token.Split('/').Last();
            }

            var wall = await WallService.JoinWallAsync(token);
            Navigation.NavigateTo($"/walls/{wall.Id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            StateHasChanged();
            await Task.Delay(3000);
            _error = null;
            StateHasChanged();
        }
    }
}

<style>
    .wall-list { padding: 16px; max-width: 600px; margin: 0 auto; }

    .list-header {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 16px;
    }
    .list-header h1 { font-size: 1.5rem; font-weight: 700; color: #1a1a2e; }

    .btn-create {
        padding: 10px 20px; background: #e94560; color: white;
        text-decoration: none; border-radius: 8px; font-weight: 600;
        font-size: 0.9rem;
    }

    .join-section {
        display: flex; gap: 8px; margin-bottom: 20px;
    }
    .join-input {
        flex: 1; padding: 10px 14px; border: 2px solid #e0e0e0;
        border-radius: 8px; font-size: 0.9rem; outline: none;
    }
    .join-input:focus { border-color: #0f3460; }
    .btn-join {
        padding: 10px 20px; background: #0f3460; color: white;
        border: none; border-radius: 8px; font-weight: 600; cursor: pointer;
    }
    .btn-join:disabled { opacity: 0.5; cursor: not-allowed; }

    .wall-cards { display: flex; flex-direction: column; gap: 12px; }

    .wall-card {
        display: flex; gap: 12px; padding: 12px; background: white;
        border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        text-decoration: none; color: inherit; transition: transform 0.15s;
    }
    .wall-card:hover { transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,0.12); }

    .wall-card-photo {
        width: 80px; height: 80px; border-radius: 8px; overflow: hidden;
        background: #f0f0f0; flex-shrink: 0;
    }
    .wall-card-photo img { width: 100%; height: 100%; object-fit: cover; }
    .no-photo {
        width: 100%; height: 100%; display: flex; align-items: center;
        justify-content: center; color: #999; font-size: 0.75rem;
    }

    .wall-card-info { display: flex; flex-direction: column; justify-content: center; }
    .wall-card-info h3 { font-size: 1.1rem; font-weight: 600; color: #1a1a2e; margin: 0; }
    .member-count { font-size: 0.85rem; color: #888; margin-top: 4px; }

    .empty-state {
        text-align: center; padding: 48px 20px; color: #888;
        background: white; border-radius: 12px;
    }

    .loading { text-align: center; color: #888; padding: 24px; }

    .error-toast {
        position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%);
        background: #e94560; color: white; padding: 12px 24px;
        border-radius: 8px; font-size: 0.9rem; z-index: 100;
    }
</style>
