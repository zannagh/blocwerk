@page "/walls/{WallId:guid}/update"
@rendermode InteractiveServer
@attribute [Authorize]
@using Blocwerk.Core.Entities
@using Blocwerk.Core.Refresh
@using Blocwerk.Web.Components.Shared.Refresh
@using Blocwerk.Web.Components.Shared.Refresh.Review
@* "Update panels + 3D": one header with the steps of the update (photos, check, apply, look over), one line about
   what is being worked on, and one screen per step: the drop of a visit's photos and videos, the photo per panel
   with the two ways to start, then the check with Apply. The timeline and "Discard this update" are behind
   "Details". The check step is one screen that does not scroll. *@

<PageTitle>Update wall - Blocwerk</PageTitle>

<SectionContent SectionName="TopBarTitle">Update wall</SectionContent>

<div class="refresh-page @(OneScreen ? "is-one-screen" : null)">
    @if (blocked is not null)
    {
        <a href="/walls/@WallId" class="back-link">&larr; Back to the wall</a>
        <p class="empty-msg">@blocked</p>
    }
    else if (loading)
    {
        <p class="loading">Loading...</p>
    }
    else
    {
        <header class="refresh-header">
            <UpdateSteps WallId="WallId" Current="RefreshFlow.StepOf(view?.Status)" LookOverOpen="view?.LookOver is not null">
                @if (view is { Status: WallRefreshStatus.ReadyToApply } && !StartsOver)
                {
                    <button type="button" class="refresh-tool @(listView ? "is-on" : null)" aria-pressed="@(listView ? "true" : "false")" @onclick="() => listView = !listView">List</button>
                }
                @if (view is not null)
                {
                    <button type="button" class="refresh-tool" aria-expanded="@(detailsOpen ? "true" : "false")" @onclick="() => detailsOpen = !detailsOpen">Details</button>
                }
            </UpdateSteps>
            @if (detailsOpen && view is not null)
            {
                @* The timeline, as it always was, and what ends the run: out of the way until asked for. *@
                <div class="refresh-details">
                    @if (view.Status != WallRefreshStatus.Uploading)
                    {
                        <RefreshTimelineView View="view" />
                    }
                    <div class="refresh-actions">
                        @if (CanDiscard && confirmDiscard)
                        {
                            <span class="refresh-discard-question" role="alert">@DiscardQuestion</span>
                            <button class="btn-danger" @ref="discardButton" @onclick="DiscardAsync" disabled="@busy">Discard</button>
                            <button class="btn-secondary" @onclick="() => confirmDiscard = false" disabled="@busy">Keep</button>
                        }
                        else if (CanDiscard)
                        {
                            <button class="btn-secondary" @onclick="AskDiscard" disabled="@busy">Discard this update</button>
                        }
                        @if (view is { Status: WallRefreshStatus.Done or WallRefreshStatus.Failed })
                        {
                            <button class="btn-secondary" @onclick="StartOverAsync" disabled="@busy">Start another update</button>
                        }
                    </div>
                </div>
            }
        </header>

        @if (error is not null)
        {
            <p class="field-error" role="alert">@error</p>
        }
        else if (view?.Error is { } failure)
        {
            <p class="field-error" role="alert">@failure</p>
        }

        @if (view is not null && RefreshFlow.StatusLine(view) is { } status)
        {
            <p class="refresh-status" role="status"><span class="refresh-status-mark" aria-hidden="true"></span>@status</p>
        }

        @if (view is null || view.Status == WallRefreshStatus.Uploading)
        {
            <RefreshDropZone View="view" EnsureRefreshAsync="EnsureRefreshAsync" OnFilesChanged="ReloadAsync" OnContinue="SortAsync" />
        }
        else if (view.Status == WallRefreshStatus.ReadyToStart)
        {
            <RefreshSortScreen View="view" @bind-Quality="splatQuality" OnStart="StartAsync" OnStartPanelsOnly="StartPanelsOnlyAsync"
                               OnStartOver="StartFullRevisionAsync" OnStartOverPanelsOnly="StartFullRevisionPanelsOnlyAsync" />
        }
        else if (view.Status == WallRefreshStatus.ReadyToApply && StartsOver)
        {
            <RefreshConfirm View="view" ListView="true" OnApply="ApplyAsync" OnAnswered="ReloadAfterAnswerAsync" />
        }
        else if (view.Status == WallRefreshStatus.ReadyToApply)
        {
            @* The one review: every hold to check, by panel and group, answers that never wait, Apply beside it. *@
            <UpdateReviewScreen View="view" ListView="listView" OnApply="ApplyAsync" OnAnswered="ReloadAfterAnswerAsync" />
        }
        else if (view.Status == WallRefreshStatus.Done)
        {
            <div class="refresh-working">
                <p class="refresh-done" role="status">
                    Done. @(view.Capture is { IsRunning: true } ? "The 3D model keeps building in the background; you can leave this page." : string.Empty)
                </p>
                @if (view.LookOver is { } lookOver)
                {
                    <p class="refresh-3d-note" role="status">
                        @(lookOver.OpenFindings == 1 ? "1 finding is" : $"{lookOver.OpenFindings} findings are") left for the wall look-over:
                        holds the update was unsure about and nobody checked.
                    </p>
                    <a class="btn-primary" href="/walls/@WallId/look-over">Look over the wall</a>
                }
                else
                {
                    <a class="btn-secondary" href="/walls/@WallId">Back to the wall</a>
                }
                <button class="btn-secondary" @onclick="StartOverAsync" disabled="@busy">Start another update</button>
            </div>
        }
        else
        {
            <div class="refresh-working">
                @if (view.Status == WallRefreshStatus.Failed)
                {
                    <p class="hint">This update did not work. "Details" shows the step that failed; you can start another update.</p>
                    <button class="btn-secondary" @onclick="StartOverAsync" disabled="@busy">Start another update</button>
                }
                else
                {
                    <p class="hint">This runs on the server: you can leave this page and come back. "Details" shows every step.</p>
                }
            </div>
        }
    }
</div>
