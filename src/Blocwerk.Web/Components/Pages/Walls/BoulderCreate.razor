@page "/walls/{WallId:guid}/boulders/create"
@rendermode InteractiveServer
@* No [Authorize], deliberately, and for the same reason BoulderDetail carries none: a registered
   kiosk tablet spends most of its day with NOBODY picked, and on a wall that opted in, setting a
   boulder is exactly what somebody walks up to it to do. The attribute would bounce that session to
   a login it cannot complete. Every OTHER anonymous visitor is still sent to sign in, explicitly, in
   OnInitializedAsync — and the real gate is not here at all: BoulderService.CreateBoulderAsync
   re-validates the kiosk key against the database and refuses the write. *@
@inject IWallService WallService
@inject IWallPanelService WallPanelService
@inject IBoulderService BoulderService
@inject ICurrentUserService CurrentUserService
@inject IKioskContext KioskContext
@inject IKioskService KioskService
@inject NavigationManager Navigation
@inject CircuitEditActivity EditActivity
@implements IDisposable
@using Blocwerk.Core.Helpers
@using Blocwerk.Web.Components.Shared
@using Blocwerk.Web.State

<PageTitle>Create Boulder - Blocwerk</PageTitle>

<div class="boulder-create">
    <div class="page-header">
        <a href="/walls/@WallId" class="back-link">&larr; Back</a>
        <h1>Create Boulder</h1>
    </div>

    @if (_wall == null)
    {
        <p class="loading">Loading...</p>
    }
    else if (_anonymousSettingNotAllowed)
    {
        @* The wall's opt-in is OFF (the default), so the server would refuse Publish. Say so here
           rather than handing a walk-up user the whole form and a raw UnauthorizedAccessException
           at the end of it. The gate itself is still the service's — this only decides the screen. *@
        <div class="empty-msg">
            <p>Setting from this tablet is turned off for this wall.</p>
            <p class="hint">
                A wall admin can allow it in the wall's kiosk settings. Until then, sign in on your
                own device to add a boulder.
            </p>
        </div>
    }
    else
    {
        <div class="form-section">
            @* The name is pre-filled with a generated, wall-unique name so a kiosk tablet with no
               keyboard can publish straight away. The shuffle button re-rolls it. *@
            <div class="form-group">
                <label for="bw-boulder-name">Name</label>
                <div class="name-row">
                    <button type="button" class="btn-secondary name-shuffle" @onclick="ShuffleName"
                            title="Suggest another name">
                        <span class="name-shuffle-icon" aria-hidden="true">&#x21bb;</span> Random
                    </button>
                    <input id="bw-boulder-name" @bind="_name" class="form-input" placeholder="e.g. Crimpy Traverse" />
                </div>
            </div>

            <div class="form-group">
                <label>Proposed Grade</label>
                <GradePicker @bind-Value="_grade" DefaultUseFont="_preferFont" />
            </div>
        </div>

        @if (_wall.UsesMultipleImages && _currentPanel is not null)
        {
            <BoulderPanelSwitcher Panels="_panels" Current="_currentPanel" CurrentChanged="OnPanelChanged" />
        }

        <HoldPicker WallId="WallId"
                    PhotoUrl="@PickerPhotoUrl"
                    AllHolds="_pickerHolds"
                    WallAngle="_wall.Angle"
                    HandsFollowFeet="_handsFollowFeet"
                    FootColorOnly="_footColorOnly"
                    HoldTwins="_holdTwins"
                    @bind-SelectedHolds="_selectedHolds" />

        <BoulderNewRules @bind-AllKickboardOn="_allKickboardOn"
                         @bind-FootColorOnly="_footColorOnly"
                         @bind-NoMatch="_noMatch"
                         WallHolds="_holds" />

        @if (_setterOptions.Count > 0)
        {
            <details class="settings-panel settings-card" open="@_isAnonymous">
                <summary class="settings-card-summary"><h2>Setter(s)</h2></summary>
                <div class="settings-card-body">
                    @if (_isAnonymous)
                    {
                        <p class="hint">
                            Nobody is signed in, so this is credited to @PlaceholderIdentity.DisplayName
                            unless you tick whoever set it. Only people who set up kiosk access on this
                            wall are listed.
                        </p>
                    }
                    else
                    {
                        <p class="hint">You're added as a setter by default. Add anyone else who set this boulder with you.</p>
                    }
                    <div class="setter-select">
                        @foreach (var option in _setterOptions)
                        {
                            var uid = option.UserId;
                            <label class="checkbox-label">
                                <input type="checkbox" checked="@_selectedSetters.Contains(uid)"
                                       @onchange="e => ToggleSetter(uid, e.Value is true)" />
                                @option.Name
                            </label>
                        }
                    </div>
                </div>
            </details>
        }

        @* Live form snapshot, recomputed every render so the offline submit path (offline-boulder.js)
           always reads the last state that reached the browser. Hidden from view and a11y. *@
        <div id="bw-boulder-form" hidden aria-hidden="true" data-bw-boulder-snapshot="@SnapshotJson"></div>

        <div class="submit-row">
            <button class="btn-secondary" @onclick="SaveDraft" @attributes="SubmitAttributes(isDraft: true)"
                    disabled="@(string.IsNullOrWhiteSpace(_name) || _isSubmitting)">
                @(_isSubmitting ? "Saving..." : "Save as Draft")
            </button>
            <button class="btn-submit" @onclick="Publish" @attributes="SubmitAttributes(isDraft: false)"
                    disabled="@(string.IsNullOrWhiteSpace(_name) || _selectedHolds.Count == 0 || _isSubmitting)">
                @(_isSubmitting ? "Publishing..." : $"Publish ({_selectedHolds.Count} holds)")
            </button>
        </div>
        @if (_isAnonymous)
        {
            <p class="hint">Nobody is signed in, so this boulder has to be saved while the tablet is online.</p>
        }
        <p class="hint">A draft is visible to the wall's members and any setter can edit it, but it can't be attempted or flashed until you publish it.</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-msg">@_error</div>
        }
    }
</div>

@code {
    [Parameter] public Guid WallId { get; set; }

    private Wall? _wall;
    private List<Hold> _holds = [];

    // The holds actually handed to the picker: the whole set on a single-image wall (same reference
    // as _holds, so a placed virtual hold mutates the master list exactly as before), or the current
    // panel's holds on a multi-image wall. A stable field (not a per-render projection) so a virtual
    // hold added inside the picker stays visible on the current panel.
    private List<Hold> _pickerHolds = [];

    // Big-wall (multi-image) panel switcher state; empty / null on a normal single-image wall.
    private List<WallPanelInfo> _panels = [];
    private WallPanelInfo? _currentPanel;

    // Cross-panel twin map handed to the picker so a hold linked across a seam reads as selected on
    // both panels. Built only for multi-image walls; null on single-image walls (no behaviour change).
    private IReadOnlyDictionary<Guid, IReadOnlyList<Guid>>? _holdTwins;

    private List<BoulderHoldInput> _selectedHolds = [];

    // Who may be credited, and who was ticked. For a signed-in setter that is the wall's members,
    // with themselves pre-selected (the common case is you setting your own boulder). For an
    // anonymous kiosk it is the CONSENTING members only — the same allow-list the tablet's own
    // picker is built from — and nobody is pre-selected, because the tablet does not know who is
    // standing in front of it. The server re-validates the ids either way; this list is only what
    // the screen offers.
    private List<SetterOption> _setterOptions = [];
    private readonly HashSet<Guid> _selectedSetters = [];

    // True when nobody is signed in: a registered kiosk tablet on a wall that opted in. Every other
    // anonymous visitor is redirected to sign in before this can be observed.
    private bool _isAnonymous;

    // True when this is an anonymous tablet on a wall that has NOT opted in. The service would refuse
    // the Publish, so the form is never shown at all.
    private bool _anonymousSettingNotAllowed;

    /// <summary>The message the offline path shows an anonymous tablet instead of queueing a create.</summary>
    private const string AnonymousOfflineMessage =
        "This tablet is offline. Nobody is signed in, so this boulder can't be queued — reconnect and publish it again.";

    /// <summary>
    /// The offline-queue wiring for a submit button — for a SIGNED-IN setter only.
    /// </summary>
    /// <remarks>
    /// An anonymous kiosk create must never be enqueued. <c>OfflineBouldersController</c> is
    /// <c>[Authorize]</c>, so the flush of such an entry answers 401, and offline-transport.js
    /// classifies a 401 as 'pause' — which stops the WHOLE queue awaiting a sign-in that will never
    /// happen on an unattended tablet. That is the poison-queue shape this repo has already had to
    /// fix once. So the anonymous branch omits the queue attributes entirely and carries
    /// data-bw-offline-unavailable instead, which offline-boulder.js turns into a plain "you are
    /// offline" message. The signed-in wiring below is unchanged.
    /// </remarks>
    private Dictionary<string, object> SubmitAttributes(bool isDraft)
    {
        if (_isAnonymous)
        {
            return new Dictionary<string, object>
            {
                ["data-bw-offline-unavailable"] = AnonymousOfflineMessage,
            };
        }

        return new Dictionary<string, object>
        {
            ["data-bw-boulder-action"] = "create",
            ["data-bw-boulder-form"] = "#bw-boulder-form",
            ["data-bw-boulder-draft"] = isDraft ? "true" : "false",
            ["data-bw-boulder-nav"] = DetailUrl,
            ["data-bw-mode"] = "offline-only",
        };
    }

    /// <summary>One tickable setter, from either source.</summary>
    private readonly record struct SetterOption(Guid UserId, string Name);

    // The current user's preferred grade scale, seeded into the GradePicker so a new boulder's grade
    // input opens on Fontainebleau or V-Scale to match their profile setting.
    private bool _preferFont = true;

    // Minted once, offline-safe. Both the online (CreateBoulderAsync) and the queued offline path
    // key on this id, so a create is an idempotent upsert no matter which path (or a replay) runs.
    private readonly Guid _clientId = Guid.NewGuid();
    private string _name = string.Empty;

    // The names already taken on this wall, kept so the shuffle button can keep suggesting unique ones.
    private List<string> _existingNames = [];
    private string? _grade;
    private bool _allKickboardOn = true;
    // The new experience always runs "hands follow feet": hand holds implicitly serve as feet and a
    // dedicated foothold is the explicit "Foot" choice in the radial menu. Never toggled there.
    private readonly bool _handsFollowFeet = true;
    private string? _footColorOnly;
    private bool _noMatch;
    private bool _isSubmitting;
    private string? _error;

    private string DetailUrl => $"/walls/{WallId}/boulders/{_clientId}";

    // The radial experience presents "feet follow hands" as always-on (no radio). At the storage layer,
    // the server's mutual-exclusivity invariant coerces every FootOnly mark to HandAndFoot whenever
    // HandsFollowFeet is true — which would silently discard the radial "Foot" footholds and the foot
    // colour rule. So persist HandsFollowFeet=true only while there are NO dedicated feet; the moment a
    // dedicated foothold (per-hold FootOnly or a colour rule) exists, persist false so it survives.
    // Hand holds stay HandAndFoot either way, so feet can always use them: "feet follow hands" holds.
    private bool EffectiveHandsFollowFeet =>
        !(_selectedHolds.Any(h => h.Usage == HoldUsage.FootOnly) || !string.IsNullOrEmpty(_footColorOnly));

    /// <summary>The whole boulder form as the JSON the offline queue replays. See offline-boulder.js.</summary>
    private string SnapshotJson => System.Text.Json.JsonSerializer.Serialize(new
    {
        id = _clientId,
        wallId = WallId,
        name = _name,
        grade = _grade,
        kickboardFootholdsOn = _allKickboardOn,
        handsFollowFeet = EffectiveHandsFollowFeet,
        footColorOnly = _footColorOnly,
        noMatch = _noMatch,
        holds = _selectedHolds.Select(h => new { holdId = h.HoldId, type = (int)h.Type, usage = (int)h.Usage }),
        setters = _selectedSetters.ToList(),
    });

    // Marks the app "busy" for the duration this create page is mounted (see EditActivityRegistry).
    // Released in Dispose, and as a backstop when the circuit's scope is torn down.
    private IDisposable? _editLease;

    protected override async Task OnInitializedAsync()
    {
        // Resolve the current user first: it seeds the preferred grade scale and the default setter,
        // and stamps the busy lease so the deploy gate knows who is mid-edit.
        User? currentUser = null;
        try
        {
            currentUser = await CurrentUserService.GetCurrentUserAsync();
        }
        catch (UnauthorizedAccessException)
        {
            // Nobody is signed in. A registered tablet on ITS OWN wall stays and sets a boulder; the
            // wall's opt-in and the kiosk key are re-checked at the service when Publish is tapped,
            // so this check is only about which screen to show. Every other anonymous visitor goes
            // to sign in, exactly as the removed [Authorize] attribute would have sent them.
            if (!KioskViewing.AllowsAnonymousViewOf(KioskContext, WallId))
            {
                Navigation.NavigateTo("/account/login", replace: true);
                return;
            }

            _isAnonymous = true;
        }

        _preferFont = currentUser?.PreferFontGrades ?? true;

        // The whole page is "create mode": hold a busy lease while it's mounted. An anonymous kiosk
        // edit is stamped to the Ghost row, so the deploy gate still sees the tablet as busy.
        _editLease = EditActivity.BeginBoulderCreate(WallId, currentUser?.Id ?? GhostUser.Id);

        _wall = await WallService.GetWallAsync(WallId);

        // The wall's opt-in, checked BEFORE any of the form is built. KioskViewing above only says
        // the tablet may look at this wall; setting on it is a separate, opt-in permission that
        // defaults to off, and finding that out at Publish time is finding it out too late.
        if (_wall != null && _isAnonymous && !_wall.AllowAnonymousKioskSetting)
        {
            _anonymousSettingNotAllowed = true;
            return;
        }

        if (_wall != null)
        {
            // Foot holds are always selectable; whether a hold is hand, foot or both
            // is now marked per hold from the picker.
            _holds = _wall.Holds.ToList();
            await LoadSetterOptionsAsync();

            // The wall's boulders already came back with the wall, so the suggested name costs no
            // extra round-trip. Pre-filling it means a kiosk tablet without a keyboard can publish.
            _existingNames = _wall.Boulders.Select(b => b.Name).ToList();
            _name = BoulderNameGenerator.Generate(_existingNames);

            // Pre-select the current user as the default setter, but only when they're actually a
            // member offered in the list (so the checkbox reflects the selection). Adding others stays
            // a conscious choice made in the collapsed setter card. Nothing is pre-selected for an
            // anonymous tablet — it has no idea who is holding it, and guessing would credit the
            // wrong person.
            if (currentUser is not null && _setterOptions.Any(o => o.UserId == currentUser.Id))
            {
                _selectedSetters.Add(currentUser.Id);
            }

            // Big walls carry their holds across several panel images, each in its own panel-local
            // coordinate space. Load the live panels and open on the centre (0,0) so the picker can
            // show one panel's photo + that panel's holds at a time. A single-image wall skips this.
            if (_wall.UsesMultipleImages)
            {
                try
                {
                    _panels = (await WallPanelService.GetPanelsAsync(WallId)).Where(p => p.IsLive).ToList();
                }
                catch (Exception)
                {
                    _panels = [];
                }

                _currentPanel = _panels.FirstOrDefault(p => p is { Col: 0, Row: 0 }) ?? _panels.FirstOrDefault();

                await BuildTwinMapAsync();
            }

            RefreshPickerHolds();
        }
    }

    // The photo behind the picker: a specific panel on a multi-image wall, else null so the picker
    // falls back to the wall's centre-photo default (unchanged single-image behaviour).
    private string? PickerPhotoUrl =>
        _wall is { UsesMultipleImages: true } && _currentPanel is not null
            ? $"/api/walls/{WallId}/panels/{_currentPanel.Id}/photo"
            : null;

    // Recomputes the picker's hold set for the current view. Single-image: the whole set (same
    // reference as _holds). Multi-image: only the current panel's holds, so they draw at their
    // panel-local coordinates on that panel's photo. Runs on load and on every panel switch.
    private void RefreshPickerHolds()
    {
        _pickerHolds = _wall is { UsesMultipleImages: true } && _currentPanel is not null
            ? _holds.Where(h => h.WallPanelId == _currentPanel.Id).ToList()
            : _holds;
    }

    // Builds the cross-panel twin map for the picker: each wall hold id → the OTHER hold ids in its
    // HoldLink connected component. Only holds with at least one twin appear. Reuses the shared
    // ConnectedComponents BFS over ALL wall hold ids so a transitive chain (centre-right-right2)
    // collapses into one component. A failed link load leaves the map null — picking still works, just
    // without cross-panel twin awareness.
    private async Task BuildTwinMapAsync()
    {
        try
        {
            var links = await WallPanelService.GetHoldLinksAsync(WallId);
            var components = HoldPropertySync.ConnectedComponents(_holds.Select(h => h.Id), links);
            var map = new Dictionary<Guid, IReadOnlyList<Guid>>();
            foreach (var component in components.Where(c => c.Count >= 2))
            {
                foreach (var id in component)
                {
                    map[id] = component.Where(other => other != id).ToList();
                }
            }

            _holdTwins = map.Count > 0 ? map : null;
        }
        catch (Exception)
        {
            _holdTwins = null;
        }
    }

    // Switching panels keeps the accumulated selection (it is holdId-based in _selectedHolds); only
    // the visible photo + hold set change.
    private void OnPanelChanged(WallPanelInfo panel)
    {
        _currentPanel = panel;
        RefreshPickerHolds();
    }

    /// <summary>
    /// Fills the tickable setter list. Wall members for a signed-in setter; for an anonymous kiosk,
    /// only members who CONSENTED to this wall's kiosk — the same allow-list the tablet's own member
    /// picker uses, and the same one the server re-validates against, so the screen cannot offer
    /// somebody the write would then refuse.
    /// </summary>
    private async Task LoadSetterOptionsAsync()
    {
        if (_isAnonymous)
        {
            var consenting = await KioskService.GetConsentingUsersAsync(WallId);
            _setterOptions = consenting.Select(u => new SetterOption(u.UserId, u.Name)).ToList();
            return;
        }

        var members = await WallService.GetMembersAsync(WallId);
        _setterOptions = members
            .Select(m => new SetterOption(m.UserId, m.User.Name))
            .ToList();
    }

    // Re-rolls the suggested name, treating the current one as taken so shuffling always visibly changes.
    private void ShuffleName()
    {
        _name = BoulderNameGenerator.Generate(_existingNames.Append(_name));
    }

    private void ToggleSetter(Guid userId, bool selected)
    {
        if (selected)
        {
            _selectedSetters.Add(userId);
        }
        else
        {
            _selectedSetters.Remove(userId);
        }
    }

    public void Dispose()
    {
        _editLease?.Dispose();
    }

    private Task SaveDraft() => Submit(isDraft: true);

    private Task Publish() => Submit(isDraft: false);

    private async Task Submit(bool isDraft)
    {
        _isSubmitting = true;
        _error = null;

        try
        {
            var boulder = await BoulderService.CreateBoulderAsync(
                WallId, _name, _grade, _selectedHolds, isDraft,
                _allKickboardOn, EffectiveHandsFollowFeet, _footColorOnly, _clientId, _noMatch,
                _selectedSetters.ToList());
            Navigation.NavigateTo($"/walls/{WallId}/boulders/{boulder.Id}");
        }
        catch (Exception ex)
        {
            // A stuck _isSubmitting was the BoulderDetail bug: only reset on the paths that stay on
            // the page. On success we navigate away, so the flag is torn down with the component.
            _error = ex.Message;
            _isSubmitting = false;
        }
    }
}
