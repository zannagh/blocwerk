@page "/walls/{WallId:guid}/boulders/create"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IWallService WallService
@inject IWallPanelService WallPanelService
@inject IBoulderService BoulderService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IHttpContextAccessor HttpContextAccessor
@inject PersistentComponentState ApplicationState
@inject CircuitEditActivity EditActivity
@implements IDisposable
@using Blocwerk.Web.Components.Shared
@using Blocwerk.Web.State

<PageTitle>Create Boulder - Blocwerk</PageTitle>

<div class="boulder-create">
    <div class="page-header">
        <a href="/walls/@WallId" class="back-link">&larr; Back</a>
        <h1>Create Boulder</h1>
    </div>

    @if (_wall == null)
    {
        <p class="loading">Loading...</p>
    }
    else
    {
        @if (!_useNew)
        {
            <button class="experience-banner" @onclick="UseNewExperienceAsync">
                <span class="experience-banner-title">Try the new boulder setting experience</span>
                <span class="experience-banner-sub">A faster, tap-to-classify way to set your holds.</span>
            </button>
        }

        <div class="form-section">
            <div class="form-group">
                <label>Name</label>
                <input @bind="_name" class="form-input" placeholder="e.g. Crimpy Traverse" />
            </div>

            <div class="form-group">
                <label>Proposed Grade</label>
                <GradePicker @bind-Value="_grade" />
            </div>

            @if (_members.Count > 0)
            {
                <div class="form-group">
                    <label>Setter(s)</label>
                    <p class="hint">Who set this boulder? Leave empty if it's just you adding it.</p>
                    <div class="setter-select">
                        @foreach (var member in _members)
                        {
                            var uid = member.UserId;
                            <label class="checkbox-label">
                                <input type="checkbox" checked="@_selectedSetters.Contains(uid)"
                                       @onchange="e => ToggleSetter(uid, e.Value is true)" />
                                @member.User.Name
                            </label>
                        }
                    </div>
                </div>
            }

            @if (_useNew)
            {
                <div class="rules-block">
                    <span class="rules-title">Rules</span>
                    <label class="checkbox-label">
                        <input type="checkbox" checked="@_allKickboardOn"
                               @onchange="e => _allKickboardOn = e.Value is true" />
                        All kickboard holds are on
                    </label>
                </div>
            }
            else
            {
                <BoulderRulesEditor @bind-KickboardFootholdsOn="_allKickboardOn"
                                    @bind-HandsFollowFeet="_handsFollowFeet"
                                    @bind-FootColorOnly="_footColorOnly"
                                    @bind-NoMatch="_noMatch"
                                    WallHolds="_holds"
                                    @bind-SelectedHolds="_selectedHolds" />
            }
        </div>

        @if (_wall.UsesMultipleImages && _currentPanel is not null)
        {
            <BoulderPanelSwitcher Panels="_panels" Current="_currentPanel" CurrentChanged="OnPanelChanged" />
        }

        <HoldPicker WallId="WallId"
                    PhotoUrl="@PickerPhotoUrl"
                    AllHolds="_pickerHolds"
                    WallAngle="_wall.Angle"
                    RadialMode="_useNew"
                    HandsFollowFeet="_handsFollowFeet"
                    FootColorOnly="_footColorOnly"
                    @bind-SelectedHolds="_selectedHolds" />

        @if (_useNew)
        {
            <BoulderNewRules @bind-FootColorOnly="_footColorOnly"
                             @bind-NoMatch="_noMatch"
                             WallHolds="_holds" />
        }

        @* Live form snapshot, recomputed every render so the offline submit path (offline-boulder.js)
           always reads the last state that reached the browser. Hidden from view and a11y. *@
        <div id="bw-boulder-form" hidden aria-hidden="true" data-bw-boulder-snapshot="@SnapshotJson"></div>

        <div class="submit-row">
            <button class="btn-secondary" @onclick="SaveDraft"
                    data-bw-boulder-action="create" data-bw-boulder-form="#bw-boulder-form"
                    data-bw-boulder-draft="true" data-bw-boulder-nav="@DetailUrl" data-bw-mode="offline-only"
                    disabled="@(string.IsNullOrWhiteSpace(_name) || _isSubmitting)">
                @(_isSubmitting ? "Saving..." : "Save as Draft")
            </button>
            <button class="btn-submit" @onclick="Publish"
                    data-bw-boulder-action="create" data-bw-boulder-form="#bw-boulder-form"
                    data-bw-boulder-draft="false" data-bw-boulder-nav="@DetailUrl" data-bw-mode="offline-only"
                    disabled="@(string.IsNullOrWhiteSpace(_name) || _selectedHolds.Count == 0 || _isSubmitting)">
                @(_isSubmitting ? "Publishing..." : $"Publish ({_selectedHolds.Count} holds)")
            </button>
        </div>
        <p class="hint">A draft is only visible to you until you publish it.</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-msg">@_error</div>
        }

        @if (_useNew)
        {
            <div class="experience-footer">
                <button class="btn-link" @onclick="UseOldExperienceAsync">Use the old boulder setting experience</button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid WallId { get; set; }

    private Wall? _wall;
    private List<Hold> _holds = [];

    // The holds actually handed to the picker: the whole set on a single-image wall (same reference
    // as _holds, so a placed virtual hold mutates the master list exactly as before), or the current
    // panel's holds on a multi-image wall. A stable field (not a per-render projection) so a virtual
    // hold added inside the picker stays visible on the current panel.
    private List<Hold> _pickerHolds = [];

    // Big-wall (multi-image) panel switcher state; empty / null on a normal single-image wall.
    private List<WallPanelInfo> _panels = [];
    private WallPanelInfo? _currentPanel;

    private List<BoulderHoldInput> _selectedHolds = [];

    // The wall's members, offered as selectable setters, and the ids the user picked. The creator is
    // deliberately NOT auto-selected: the setter may differ from whoever adds the boulder in the app.
    private List<WallMember> _members = [];
    private readonly HashSet<Guid> _selectedSetters = [];

    // Minted once, offline-safe. Both the online (CreateBoulderAsync) and the queued offline path
    // key on this id, so a create is an idempotent upsert no matter which path (or a replay) runs.
    private Guid _clientId = Guid.NewGuid();
    private string _name = string.Empty;
    private string? _grade;
    private bool _allKickboardOn = true;
    // The new experience always runs "hands follow feet": hand holds implicitly serve as feet and a
    // dedicated foothold is the explicit "Foot" choice in the radial menu. Never toggled there.
    private bool _handsFollowFeet = true;
    private string? _footColorOnly;
    private bool _noMatch;
    private bool _isSubmitting;
    private string? _error;

    // "new" | "old"; default "new" (unset cookie resolves to the new experience). Read server-side
    // (no flash) on the prerender pass, then reconciled from the cookie via JS on first interactive render.
    private string _experience = "new";
    private bool _useNew => _experience == "new";

    private string DetailUrl => $"/walls/{WallId}/boulders/{_clientId}";

    // The new experience presents "feet follow hands" as always-on (no radio). At the storage layer,
    // the server's mutual-exclusivity invariant coerces every FootOnly mark to HandAndFoot whenever
    // HandsFollowFeet is true — which would silently discard the radial "Foot" footholds and the foot
    // colour rule. So persist HandsFollowFeet=true only while there are NO dedicated feet; the moment a
    // dedicated foothold (per-hold FootOnly or a colour rule) exists, persist false so it survives.
    // Hand holds stay HandAndFoot either way, so feet can always use them: "feet follow hands" holds.
    private bool EffectiveHandsFollowFeet => _useNew
        ? !(_selectedHolds.Any(h => h.Usage == HoldUsage.FootOnly) || !string.IsNullOrEmpty(_footColorOnly))
        : _handsFollowFeet;

    /// <summary>The whole boulder form as the JSON the offline queue replays. See offline-boulder.js.</summary>
    private string SnapshotJson => System.Text.Json.JsonSerializer.Serialize(new
    {
        id = _clientId,
        wallId = WallId,
        name = _name,
        grade = _grade,
        kickboardFootholdsOn = _allKickboardOn,
        handsFollowFeet = EffectiveHandsFollowFeet,
        footColorOnly = _footColorOnly,
        noMatch = _noMatch,
        holds = _selectedHolds.Select(h => new { holdId = h.HoldId, type = (int)h.Type, usage = (int)h.Usage }),
        setters = _selectedSetters.ToList(),
    });

    private const string ExperienceStateKey = "boulder-create-experience";
    private PersistingComponentStateSubscription _persistingSubscription;

    // Marks the app "busy" for the duration this create page is mounted (see EditActivityRegistry).
    // Released in Dispose, and as a backstop when the circuit's scope is torn down.
    private IDisposable? _editLease;

    protected override async Task OnInitializedAsync()
    {
        // The whole page is "create mode": hold a busy lease while it's mounted. No current-user
        // service is injected here, so userId is left null (the deploy gate only needs the count).
        _editLease = EditActivity.BeginBoulderCreate(WallId, userId: null);

        // The experience is read server-side from the cookie on the prerender pass (HttpContext is
        // live there) and persisted via PersistentComponentState. On the interactive re-render
        // HttpContext is null, so without this the value would snap back to the "old" default and
        // flash the old UI before the JS reconcile flips it back. Restoring the persisted value
        // keeps the interactive render on the same experience the server already chose.
        if (ApplicationState.TryTakeFromJson<string>(ExperienceStateKey, out var restored)
            && (restored == "new" || restored == "old"))
        {
            _experience = restored;
        }
        else
        {
            var cookie = HttpContextAccessor.HttpContext?.Request.Cookies["blocwerk-boulder-experience"];
            if (cookie == "new" || cookie == "old")
            {
                _experience = cookie;
            }
        }

        _persistingSubscription = ApplicationState.RegisterOnPersisting(() =>
        {
            ApplicationState.PersistAsJson(ExperienceStateKey, _experience);
            return Task.CompletedTask;
        });

        _wall = await WallService.GetWallAsync(WallId);
        if (_wall != null)
        {
            // Foot holds are always selectable; whether a hold is hand, foot or both
            // is now marked per hold from the picker.
            _holds = _wall.Holds.ToList();
            _members = await WallService.GetMembersAsync(WallId);

            // Big walls carry their holds across several panel images, each in its own panel-local
            // coordinate space. Load the live panels and open on the centre (0,0) so the picker can
            // show one panel's photo + that panel's holds at a time. A single-image wall skips this.
            if (_wall.UsesMultipleImages)
            {
                try
                {
                    _panels = (await WallPanelService.GetPanelsAsync(WallId)).Where(p => p.IsLive).ToList();
                }
                catch (Exception)
                {
                    _panels = [];
                }

                _currentPanel = _panels.FirstOrDefault(p => p is { Col: 0, Row: 0 }) ?? _panels.FirstOrDefault();
            }

            RefreshPickerHolds();
        }
    }

    // The photo behind the picker: a specific panel on a multi-image wall, else null so the picker
    // falls back to the wall's centre-photo default (unchanged single-image behaviour).
    private string? PickerPhotoUrl =>
        _wall is { UsesMultipleImages: true } && _currentPanel is not null
            ? $"/api/walls/{WallId}/panels/{_currentPanel.Id}/photo"
            : null;

    // Recomputes the picker's hold set for the current view. Single-image: the whole set (same
    // reference as _holds). Multi-image: only the current panel's holds, so they draw at their
    // panel-local coordinates on that panel's photo. Runs on load and on every panel switch.
    private void RefreshPickerHolds()
    {
        _pickerHolds = _wall is { UsesMultipleImages: true } && _currentPanel is not null
            ? _holds.Where(h => h.WallPanelId == _currentPanel.Id).ToList()
            : _holds;
    }

    // Switching panels keeps the accumulated selection (it is holdId-based in _selectedHolds); only
    // the visible photo + hold set change.
    private void OnPanelChanged(WallPanelInfo panel)
    {
        _currentPanel = panel;
        RefreshPickerHolds();
    }

    private void ToggleSetter(Guid userId, bool selected)
    {
        if (selected)
        {
            _selectedSetters.Add(userId);
        }
        else
        {
            _selectedSetters.Remove(userId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var stored = await JS.InvokeAsync<string?>("bwPrefs.getExperience");
            // Only an explicit "old" cookie opts out; an unset/null pref keeps the new default.
            var resolved = stored == "old" ? "old" : "new";
            if (resolved != _experience)
            {
                _experience = resolved;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // Prefs helper unavailable: keep whatever the server read decided.
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away; nothing to reconcile.
        }
    }

    private async Task UseNewExperienceAsync()
    {
        await SetExperienceAsync("new");
    }

    private async Task UseOldExperienceAsync()
    {
        await SetExperienceAsync("old");
    }

    private async Task SetExperienceAsync(string value)
    {
        _experience = value == "new" ? "new" : "old";
        try
        {
            await JS.InvokeVoidAsync("bwPrefs.setExperience", _experience);
        }
        catch (JSException)
        {
            // The choice still applies for this render even if the cookie write failed.
        }
    }

    public void Dispose()
    {
        _persistingSubscription.Dispose();
        _editLease?.Dispose();
    }

    private Task SaveDraft() => Submit(isDraft: true);

    private Task Publish() => Submit(isDraft: false);

    private async Task Submit(bool isDraft)
    {
        _isSubmitting = true;
        _error = null;

        try
        {
            var boulder = await BoulderService.CreateBoulderAsync(
                WallId, _name, _grade, _selectedHolds, isDraft,
                _allKickboardOn, EffectiveHandsFollowFeet, _footColorOnly, _clientId, _noMatch,
                _selectedSetters.ToList());
            Navigation.NavigateTo($"/walls/{WallId}/boulders/{boulder.Id}");
        }
        catch (Exception ex)
        {
            // A stuck _isSubmitting was the BoulderDetail bug: only reset on the paths that stay on
            // the page. On success we navigate away, so the flag is torn down with the component.
            _error = ex.Message;
            _isSubmitting = false;
        }
    }
}
