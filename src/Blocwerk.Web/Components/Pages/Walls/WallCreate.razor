@page "/walls/create"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IWallService WallService
@inject NavigationManager Navigation

<PageTitle>Create Wall - Blocwerk</PageTitle>

<div class="create-wall">
    <h1>Create Wall</h1>

    <EditForm Model="_model" OnValidSubmit="Submit" FormName="create-wall">
        <div class="form-group">
            <label>Wall Name</label>
            <InputText @bind-Value="_model.Name" class="form-input" placeholder="e.g. Garage Wall" />
        </div>

        <div class="form-group">
            <label>Description (optional)</label>
            <InputTextArea @bind-Value="_model.Description" class="form-input" rows="2" placeholder="Describe your wall..." />
        </div>

        <div class="form-group">
            <label>Wall Angle: @(_model.Angle)&deg;</label>
            <input type="range" min="0" max="70" @bind="_model.Angle" @bind:event="oninput" class="angle-slider" />
            <div class="angle-labels">
                <span>0&deg; Vertical</span>
                <span>45&deg; Overhang</span>
                <span>70&deg; Roof</span>
            </div>
        </div>

        <div class="form-group">
            <label>Wall Photo</label>
            <InputFile OnChange="OnFileSelected" class="form-input" accept="image/*" />
            <p class="hint">Take a frontal photo of your climbing wall with all holds visible.</p>
        </div>

        @if (_photoPreview != null)
        {
            <div class="photo-preview">
                <img src="@_photoPreview" alt="Wall preview" />
            </div>

            <div class="form-group detect-choice">
                <label>Hold Detection</label>
                <div class="radio-group">
                    <label class="radio-label">
                        <input type="radio" name="detect" checked="@_autoDetect" @onchange="() => _autoDetect = true" />
                        Auto-detect holds
                    </label>
                    <label class="radio-label">
                        <input type="radio" name="detect" checked="@(!_autoDetect)" @onchange="() => _autoDetect = false" />
                        Place holds manually
                    </label>
                </div>
            </div>
        }

        <button type="submit" class="btn-submit" disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_model.Name))">
            @if (_isSubmitting)
            {
                <span>Creating...</span>
            }
            else
            {
                <span>Create Wall</span>
            }
        </button>
    </EditForm>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-msg">@_error</div>
    }
</div>

@code {
    private readonly WallCreateModel _model = new();
    private byte[]? _photoData;
    private string? _photoContentType;
    private string? _photoPreview;
    private bool _autoDetect = true;
    private bool _isSubmitting;
    private string? _error;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > 10 * 1024 * 1024)
        {
            _error = "Photo must be under 10MB";
            return;
        }

        _photoContentType = file.ContentType;
        using var stream = file.OpenReadStream(10 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _photoData = ms.ToArray();
        _photoPreview = $"data:{_photoContentType};base64,{Convert.ToBase64String(_photoData)}";
    }

    private async Task Submit()
    {
        _isSubmitting = true;
        _error = null;

        try
        {
            var wall = await WallService.CreateWallAsync(_model.Name, _model.Description, _model.Angle);

            if (_photoData != null && _photoContentType != null)
            {
                await WallService.UploadPhotoAsync(wall.Id, _photoData, _photoContentType, _autoDetect);
            }

            Navigation.NavigateTo($"/walls/{wall.Id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _isSubmitting = false;
        }
    }

    private class WallCreateModel
    {
        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }

        public int Angle { get; set; }
    }
}

