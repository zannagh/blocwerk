@page "/walls/create"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IWallService WallService
@inject NavigationManager Navigation
@inject CircuitEditActivity EditActivity
@inject IJSRuntime JS
@implements IDisposable
@using Blocwerk.Web.Components.Shared
@using Blocwerk.Web.State

<PageTitle>Create Wall - Blocwerk</PageTitle>

<div class="create-wall">
    <h1>Create Wall</h1>

    <EditForm Model="_model" OnValidSubmit="Submit" FormName="create-wall">
        <div class="form-group">
            <label>Wall Name</label>
            <InputText @bind-Value="_model.Name" class="form-input" placeholder="e.g. Garage Wall" />
        </div>

        <div class="form-group">
            <label>Description (optional)</label>
            <InputTextArea @bind-Value="_model.Description" class="form-input" rows="2" placeholder="Describe your wall..." />
        </div>

        <div class="form-group">
            <label>Wall Angle: @(_model.Angle)&deg; <span class="segment-angle-word">@WallAngleRange.Label(_model.Angle)</span></label>
            <input type="range" min="@WallAngleRange.Min" max="@WallAngleRange.Max" @bind="_model.Angle" @bind:event="oninput" class="angle-slider" />
            <div class="angle-labels">
                <span>0&deg; Vertical</span>
                <span>45&deg; Overhang</span>
                <span>90&deg; Roof</span>
            </div>
            <p class="hint">
                The angle of the wall as a whole. If your wall is built from planes at
                different angles &mdash; a slab beside an overhang, a vertical side panel
                &mdash; draw a <strong>segment</strong> per plane later, in the wall's
                settings. This value then only applies where no segment covers the wall.
            </p>
        </div>

        <div class="form-group">
            <label>Wall Photo</label>
            <InputFile OnChange="OnFileSelected" class="form-input" accept="image/*" />
            <p class="hint">Take a frontal photo of your climbing wall with all holds visible.</p>
        </div>

        @if (_photoPreview != null)
        {
            <div class="photo-preview">
                <img src="@_photoPreview" alt="Wall preview" />
            </div>

            <div class="form-group detect-choice">
                <label>Hold Detection</label>
                <div class="radio-group">
                    <label class="radio-label">
                        <input type="radio" name="detect" checked="@_autoDetect" @onchange="() => _autoDetect = true" />
                        Auto-detect holds
                    </label>
                    <label class="radio-label">
                        <input type="radio" name="detect" checked="@(!_autoDetect)" @onchange="() => _autoDetect = false" />
                        Place holds manually
                    </label>
                </div>
            </div>
        }

        <button type="submit" class="btn-submit" disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_model.Name))">
            @if (_isSubmitting)
            {
                <span>Creating...</span>
            }
            else
            {
                <span>Create Wall</span>
            }
        </button>
    </EditForm>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-msg">@_error</div>
    }
</div>

@code {
    private readonly WallCreateModel _model = new();
    private byte[]? _photoData;
    private string? _photoContentType;
    private string? _photoPreview;
    private bool _autoDetect = true;
    private bool _isSubmitting;
    private string? _error;

    // The whole page is an unsaved new-wall draft (_model, plus a possibly large staged photo): hold a
    // busy lease for its mounted lifetime so a deploy can't discard it. Released in Dispose, with the
    // circuit-teardown backstop behind it.
    private IDisposable? _editLease;

    // Mirrors _editLease onto the browser bwEditGuard so the maintenance watchdog holds back an
    // auto-reload while this unsaved new-wall draft is open. See EditGuardInterop / SyncEditGuardAsync.
    private bool _editGuardActive;

    protected override void OnInitialized()
    {
        _editLease = EditActivity.BeginWallCreate(userId: null);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncEditGuardAsync();
    }

    private async Task SyncEditGuardAsync()
    {
        _editGuardActive = await EditGuardInterop.SyncAsync(JS, "wall-create", _editLease is not null, _editGuardActive);
    }

    public void Dispose()
    {
        _editLease?.Dispose();

        if (_editGuardActive)
        {
            _ = EditGuardInterop.SyncAsync(JS, "wall-create", editing: false, active: _editGuardActive);
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > 10 * 1024 * 1024)
        {
            _error = "Photo must be under 10MB";
            return;
        }

        _photoContentType = file.ContentType;
        using var stream = file.OpenReadStream(10 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _photoData = ms.ToArray();
        _photoPreview = $"data:{_photoContentType};base64,{Convert.ToBase64String(_photoData)}";
    }

    private async Task Submit()
    {
        _isSubmitting = true;
        _error = null;

        try
        {
            var wall = await WallService.CreateWallAsync(_model.Name, _model.Description, _model.Angle);

            if (_photoData != null && _photoContentType != null)
            {
                await WallService.UploadPhotoAsync(wall.Id, _photoData, _photoContentType, _autoDetect);
            }

            Navigation.NavigateTo($"/walls/{wall.Id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _isSubmitting = false;
        }
    }

    private class WallCreateModel
    {
        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }

        public int Angle { get; set; }
    }
}

