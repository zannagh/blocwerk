@page "/walls/{WallId:guid}/look-over"
@rendermode InteractiveServer
@attribute [Authorize]
@using Blocwerk.Core.LookOver
@using Blocwerk.Web.Components.Shared.LookOver
@using Blocwerk.Web.Components.Shared.Refresh
@* "Look over the wall", the last step of a wall update: what an applied panel update was unsure about and nobody
   answered. The page is one screen that does not scroll: the update's header, a row of filter chips with what is
   open in each group, and the card deck (LookOverDeck), which asks about one finding at a time in one queue, what
   boulders use first. "List" shows the same findings as lists instead, with the bulk answers and the answered cards
   (LookOverList). Wall admins and moderators answer; Finish is in the header once nothing is open, and under "..."
   before that. With ?boulder= everything is about one boulder's holds. *@

<PageTitle>Look over the wall - Blocwerk</PageTitle>

<SectionContent SectionName="TopBarTitle">Look over the wall</SectionContent>

<div class="lookover-page @(listView ? "is-list" : null)">
    @if (blocked is not null)
    {
        <a href="/walls/@WallId" class="back-link">&larr; Back to the wall</a>
        <p class="empty-msg">@blocked</p>
    }
    else if (loading)
    {
        <p class="loading">Loading...</p>
    }
    else
    {
        <header class="lookover-header">
            <UpdateSteps WallId="WallId" Current="UpdateStep.LookOver" Compact="state is { Pending: true } && OpenCount == 0">
                @if (state is { Pending: true } && OpenCount == 0)
                {
                    <button type="button" class="btn-primary lookover-finish-now" disabled="@busy" @onclick="() => FinishAsync(false)">Finish</button>
                }
                <button type="button" class="lookover-tool @(listView ? "is-on" : null)" aria-pressed="@(listView ? "true" : "false")" @onclick="() => listView = !listView">List</button>
                <button type="button" class="lookover-tool" aria-expanded="@(detailsOpen ? "true" : "false")" aria-label="Details and finishing" @onclick="() => detailsOpen = !detailsOpen">&hellip;</button>
            </UpdateSteps>
            @if (detailsOpen)
            {
                <div class="lookover-details">
                    <p class="lookover-status" role="status">@StatusLine</p>
                    @if (LookOverCopy.Breakdown(listing.Findings) is { } breakdown)
                    {
                        <p class="hint">@breakdown</p>
                    }
                    @if (state is { Pending: true })
                    {
                        <p class="hint">@LookOverCopy.PageHint</p>
                        <div class="lookover-finish">
                            @if (OpenCount == 0)
                            {
                                <button type="button" class="btn-primary" disabled="@busy" @onclick="() => FinishAsync(false)">Finish look-over</button>
                            }
                            else
                            {
                                <ConfirmAction Label="@LookOverCopy.FinishAnyway(OpenCount)" Question="@LookOverCopy.FinishAnywayQuestion(OpenCount)"
                                               ConfirmLabel="@StayOpenLabel" ConfirmClass="btn-primary" Neutral="true" Disabled="busy" OnConfirm="() => FinishAsync(true)" />
                            }
                            <p class="hint">Finishing records that you looked over the wall and takes the notice off the wall page.</p>
                        </div>
                    }
                    <p class="hint lookover-keys">Keys: arrows turn the cards, 1 to 4 give the answers in their order, U takes the last answer back.</p>
                </div>
            }
        </header>

        @if (error is not null)
        {
            <p class="field-error" role="alert">@error</p>
        }
        @if (finished)
        {
            <p class="glyph-ok" role="status">The look-over is finished. <a href="/walls/@WallId">Back to the wall</a></p>
        }
        @if (FilterBoulder is { } filtered)
        {
            <p class="lookover-chip" role="status">
                <span>Showing findings for <strong>@(listing.BoulderName(filtered) ?? "this boulder")</strong></span>
                <a href="/walls/@WallId/look-over">Show all</a>
            </p>
        }

        @if (listView)
        {
            <div class="lookover-list">
                <LookOverList WallId="WallId" Listing="listing" FilterBoulder="FilterBoulder" Disabled="busy" LastTouched="lastTouched" Touches="touches"
                              OnAnswer="AnswerAsync" OnAct="ActOnAsync" OnUndo="UndoAsync" OnOpen="OpenCard" />
            </div>
        }
        else
        {
            var chips = listing.Chips(FilterBoulder);
            @if (chips.Count > 2)
            {
                <div class="deck-chips" role="group" aria-label="Which findings to ask about">
                    @foreach (var chip in chips)
                    {
                        <button type="button" class="@(chip.Filter == filter ? "is-on" : null)" aria-pressed="@(chip.Filter == filter ? "true" : "false")" @onclick="() => Pick(chip.Filter)">
                            @chip.Label <span>@chip.Open</span>
                        </button>
                    }
                </div>
            }
            <LookOverDeck @ref="deck" WallId="WallId" Queue="Queue" All="listing.Findings" Disabled="busy" Version="loads" QueueKey="queueKey"
                          OnAnswer="AnswerAsync" OnAct="ActOnAsync" OnUndo="UndoAsync">
                <Empty>
                    <p class="glyph-ok" role="status">@LookOverCopy.NothingOpen(filter != LookOverFilter.All && OpenCount > 0, FilterBoulder is not null)</p>
                    @if (filter != LookOverFilter.All && OpenCount > 0)
                    {
                        <button type="button" class="btn-secondary" @onclick="() => Pick(LookOverFilter.All)">Show all @OpenCount open</button>
                    }
                    else if (state is { Pending: true } && OpenCount == 0)
                    {
                        <button type="button" class="btn-primary" disabled="@busy" @onclick="() => FinishAsync(false)">Finish look-over</button>
                        <p class="hint">Finishing records that you looked over the wall and takes the notice off the wall page.</p>
                    }
                    else if (state is not { Pending: true })
                    {
                        <p class="hint">@StatusLine</p>
                    }
                </Empty>
            </LookOverDeck>
        }
    }
</div>
