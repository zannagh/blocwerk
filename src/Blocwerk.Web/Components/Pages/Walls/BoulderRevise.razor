@page "/walls/{WallId:guid}/boulders/{BoulderId:guid}/revise"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IWallService WallService
@inject IWallPanelService WallPanelService
@inject IBoulderService BoulderService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation
@inject CircuitEditActivity EditActivity
@inject IJSRuntime JS
@implements IDisposable
@using Blocwerk.Core.Helpers
@using Blocwerk.Web.Components.Shared
@using Blocwerk.Web.State

<PageTitle>@(_isDraft ? "Edit Draft" : "Revise Boulder") - Blocwerk</PageTitle>

<div class="boulder-create">
    <div class="page-header">
        <a href="/walls/@WallId/boulders/@BoulderId" class="back-link">&larr; Back</a>
        <h1>@(_isDraft ? "Edit Draft" : "Revise Boulder")</h1>
    </div>

    @if (_notFound)
    {
        <p class="error-msg">This boulder no longer exists.</p>
        <a href="/walls/@WallId" class="back-link">&larr; Back to wall</a>
    }
    else if (_boulder == null || _wall == null)
    {
        <p class="loading">Loading...</p>
    }
    else if (!_isCreator && !_isAdmin && !_isSetter)
    {
        <p class="error-msg">Only the creator, a setter, or a wall admin can edit this boulder.</p>
    }
    else
    {
        @if (_boulder.IsHistoric)
        {
            <p class="revision-hint">Some holds from the original boulder may no longer exist on the wall.
                Adjust the selected holds to match the current wall setup.</p>
        }

        @* Press-and-hold reference: editing happens on the CURRENT photo + current holds; while
           this button is held, the ORIGINAL photo (the generation the boulder was set on) with the
           boulder's original holds is overlaid, then released to return to editing. The overlay
           draws _boulder.BoulderHolds over the OLD photo, where those coordinates are correct. *@
        @if (_referenceGeneration.HasValue)
        {
            <div class="reference-hold">
                <button type="button" class="btn-reference"
                        @onpointerdown="ShowOriginal" @onpointerup="HideOriginal"
                        @onpointerleave="HideOriginal" @onpointercancel="HideOriginal"
                        @ontouchstart="ShowOriginal" @ontouchstart:preventDefault="true"
                        @ontouchend="HideOriginal" @ontouchcancel="HideOriginal"
                        @oncontextmenu:preventDefault="true">
                    Hold to see original
                </button>
                <p class="hint">Press and hold to compare with the boulder's original holds. Release to keep editing.</p>
            </div>

            @if (_showOriginal)
            {
                <div class="reference-overlay">
                    <div class="reference-photo">
                        <img src="/api/walls/@WallId/photo/@_referenceGeneration" alt="Original wall" />
                        <svg class="hold-overlay" viewBox="0 0 100 100" preserveAspectRatio="none">
                            @foreach (var bh in _boulder.BoulderHolds)
                            {
                                <circle cx="@F(bh.Hold.X * 100)" cy="@F(bh.Hold.Y * 100)"
                                        r="@F(bh.Hold.Radius * 100)"
                                        fill="@BoulderHoldColors.FillFor(bh.Type, bh.Usage)"
                                        stroke="@BoulderHoldColors.Stroke(bh.Type)"
                                        stroke-width="0.5" />
                            }
                        </svg>
                    </div>
                    @if (_wall.UsesMultipleImages)
                    {
                        <p class="reference-note">Reference shows the centre image.</p>
                    }
                </div>
            }
        }

        <div class="form-section">
            <div class="form-group">
                <label>Name</label>
                <input @bind="_name" class="form-input" placeholder="e.g. Crimpy Traverse" />
            </div>

            <div class="form-group">
                <label>Grade</label>
                <GradePicker @bind-Value="_grade" DefaultUseFont="_preferFont" />
            </div>
        </div>

        @if (_wall.UsesMultipleImages && _currentPanel is not null)
        {
            <BoulderPanelSwitcher Panels="_panels" Current="_currentPanel" CurrentChanged="OnPanelChanged" />
        }

        <HoldPicker WallId="WallId"
                    PhotoUrl="@PickerPhotoUrl"
                    AllHolds="_pickerHolds"
                    WallAngle="_wall.Angle"
                    HandsFollowFeet="_handsFollowFeet"
                    FootColorOnly="_footColorOnly"
                    HoldTwins="_holdTwins"
                    @bind-SelectedHolds="_selectedHolds" />

        <BoulderNewRules @bind-AllKickboardOn="_allKickboardOn"
                         @bind-FootColorOnly="_footColorOnly"
                         @bind-NoMatch="_noMatch"
                         WallHolds="_displayHolds" />

        @if (_members.Count > 0)
        {
            <details class="settings-panel settings-card">
                <summary class="settings-card-summary"><h2>Setter(s)</h2></summary>
                <div class="settings-card-body">
                    <p class="hint">Who set this boulder? Ticking these replaces the current setter list.</p>
                    <div class="setter-select">
                        @foreach (var member in _members)
                        {
                            var uid = member.UserId;
                            <label class="checkbox-label">
                                <input type="checkbox" checked="@_selectedSetters.Contains(uid)"
                                       @onchange="e => ToggleSetter(uid, e.Value is true)" />
                                @member.User.Name
                            </label>
                        }
                    </div>
                </div>
            </details>
        }

        @* Live form snapshot for the offline submit path (offline-boulder.js). *@
        <div id="bw-boulder-form" hidden aria-hidden="true" data-bw-boulder-snapshot="@SnapshotJson"></div>

        <button class="btn-submit" @onclick="Submit"
                data-bw-boulder-action="revise" data-bw-boulder-form="#bw-boulder-form"
                data-bw-boulder-nav="@DetailUrl" data-bw-mode="offline-only"
                disabled="@(string.IsNullOrWhiteSpace(_name) || _selectedHolds.Count == 0 || _isSubmitting)">
            @(_isSubmitting
                ? "Saving..."
                : _isDraft
                    ? $"Save Draft ({_selectedHolds.Count} holds)"
                    : $"Save Revision ({_selectedHolds.Count} holds)")
        </button>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-msg">@_error</div>
        }
    }
</div>

@code {
    [Parameter] public Guid WallId { get; set; }
    [Parameter] public Guid BoulderId { get; set; }

    private Wall? _wall;
    private Boulder? _boulder;
    private List<Hold> _displayHolds = [];

    // The holds actually handed to the picker: the whole current-generation set on a single-image
    // wall (same reference as _displayHolds), or the current panel's holds on a multi-image wall.
    // A stable field so a virtual hold placed inside the picker stays visible on the current panel.
    private List<Hold> _pickerHolds = [];

    // Big-wall (multi-image) panel switcher state; empty / null on a normal single-image wall.
    private List<WallPanelInfo> _panels = [];
    private WallPanelInfo? _currentPanel;

    // Cross-panel twin map handed to the picker so a hold linked across a seam reads as selected on
    // both panels. Built only for multi-image walls; null on single-image walls (no behaviour change).
    private IReadOnlyDictionary<Guid, IReadOnlyList<Guid>>? _holdTwins;

    private List<BoulderHoldInput> _selectedHolds = [];

    // The wall's members, offered as selectable setters, pre-selected from the boulder's existing
    // setters. Revise REPLACES the setter set, so whatever is checked at save becomes the new set.
    private List<WallMember> _members = [];
    private readonly HashSet<Guid> _selectedSetters = [];
    private string _name = string.Empty;
    private string? _grade;
    private bool _allKickboardOn = true;
    private bool _handsFollowFeet = true;
    private string? _footColorOnly;
    // Editable via the "No match" checkbox in the below-image rules (BoulderNewRules).
    private bool _noMatch;
    // The current user's preferred grade scale, seeded into the GradePicker so the grade input opens
    // on Fontainebleau or V-Scale to match their profile setting.
    private bool _preferFont = true;
    private bool _isCreator;
    private bool _isAdmin;
    private bool _isSetter;
    private bool _notFound;
    private bool _isDraft;
    private int? _referenceGeneration;
    // True only while the press-and-hold reference button is held: shows the original photo + holds.
    private bool _showOriginal;
    private bool _isSubmitting;
    private string? _error;

    private string DetailUrl => $"/walls/{WallId}/boulders/{BoulderId}";

    // The whole page is revise mode: hold a busy lease for its mounted lifetime so a deploy never
    // recreates the container while unsaved hold/rule edits are open. Released in Dispose, with the
    // circuit-teardown backstop behind it.
    private IDisposable? _editLease;

    // Mirrors _editLease onto the browser bwEditGuard so the maintenance watchdog holds back an
    // auto-reload while this unsaved revise page is open. See EditGuardInterop / SyncEditGuardAsync.
    private bool _editGuardActive;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncEditGuardAsync();
    }

    private async Task SyncEditGuardAsync()
    {
        _editGuardActive = await EditGuardInterop.SyncAsync(JS, "boulder-revise", _editLease is not null, _editGuardActive);
    }

    // A dedicated foothold in the radial experience is either a per-hold "Foot" mark or a foot-colour rule.
    private bool HasDedicatedFeet =>
        _selectedHolds.Any(h => h.Usage == HoldUsage.FootOnly) || !string.IsNullOrEmpty(_footColorOnly);

    // The radial experience has no hands-follow-feet toggle: hand holds always double as feet, and a
    // dedicated foothold is an explicit "Foot" radial mark. The server coerces every FootOnly mark to
    // HandAndFoot while HandsFollowFeet is true, which would silently discard the radial footholds and
    // the foot-colour rule. So persist HandsFollowFeet=false the moment a dedicated foothold exists,
    // letting it survive. When there are NONE, keep the boulder's LOADED value untouched — unlike
    // create (which always forces true), revise must never flip an existing hands-follow-feet=false
    // boulder to true on a no-op save.
    private bool EffectiveHandsFollowFeet => !HasDedicatedFeet && _handsFollowFeet;

    /// <summary>The whole revise form as the JSON the offline queue replays. See offline-boulder.js.</summary>
    private string SnapshotJson => System.Text.Json.JsonSerializer.Serialize(new
    {
        id = BoulderId,
        name = _name,
        grade = _grade,
        kickboardFootholdsOn = _allKickboardOn,
        handsFollowFeet = EffectiveHandsFollowFeet,
        // "" clears the foot colour server-side; the revise endpoint maps a missing value the same way.
        footColorOnly = _footColorOnly ?? string.Empty,
        noMatch = _noMatch,
        holds = _selectedHolds.Select(h => new { holdId = h.HoldId, type = (int)h.Type, usage = (int)h.Usage }),
        setters = _selectedSetters.ToList(),
    });

    protected override async Task OnInitializedAsync()
    {
        // Acquire before any await so the page is marked busy for its whole lifetime. No current-user
        // id is resolved yet here, so userId is left null (the deploy gate only needs the count).
        _editLease = EditActivity.BeginBoulderRevise(WallId, userId: null);

        _wall = await WallService.GetWallAsync(WallId);
        _boulder = await BoulderService.GetBoulderAsync(BoulderId);

        if (_wall == null || _boulder == null)
        {
            _notFound = true;
            return;
        }

        // [Authorize] proves the cookie is intact, not that the account behind it still exists: an
        // account merged away (or deleted) on another device leaves this tab holding a valid cookie
        // that resolves to nobody. Bounce to sign-in rather than 500 the page, same as the wall and
        // boulder pages do.
        User user;
        try
        {
            user = await CurrentUserService.GetCurrentUserAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/account/login", replace: true);
            return;
        }

        _isCreator = _boulder.CreatedByUserId == user.Id;
        // A wall admin (a WallRole.Admin member of this wall) may revise ANY boulder on the wall,
        // not only the ones they created — same membership-role check used across the wall UI.
        // The wall owner counts as an admin even without an explicit Admin member row, matching
        // WallAdminGuard on the server, so an owner is never bounced off a page the server would allow.
        var membership = _wall.Members.FirstOrDefault(m => m.UserId == user.Id);
        _isAdmin = membership?.Role == WallRole.Admin || _wall.OwnerId == user.Id;
        // A setter (or co-setter) of this boulder may revise it too — same rule the server enforces.
        _isSetter = _boulder.Setters.Any(s => s.UserId == user.Id);
        if (!_isCreator && !_isAdmin && !_isSetter)
        {
            return;
        }

        // Seed the grade scale from the boulder's EXISTING grade so it displays correctly; only fall
        // back to the reviser's personal preference when the boulder has no grade yet.
        _preferFont = string.IsNullOrWhiteSpace(_boulder.Grade)
            ? user.PreferFontGrades
            : GradeScale.FontGrades.Contains(_boulder.Grade);
        _isDraft = _boulder.IsDraft;
        _name = _boulder.Name;
        _grade = _boulder.Grade;
        _allKickboardOn = _boulder.KickboardFootholdsOn;
        _handsFollowFeet = _boulder.HandsFollowFeet;
        _footColorOnly = _boulder.FootColorOnly;
        _noMatch = _boulder.NoMatch;
        _displayHolds = _wall.Holds.ToList();

        // Big walls carry their holds across several panel images, each in its own panel-local
        // coordinate space. Load the live panels and open on the centre (0,0) so the picker can show
        // one panel's photo + that panel's holds at a time. A single-image wall skips this entirely.
        if (_wall.UsesMultipleImages)
        {
            try
            {
                _panels = (await WallPanelService.GetPanelsAsync(WallId)).Where(p => p.IsLive).ToList();
            }
            catch (Exception)
            {
                _panels = [];
            }

            _currentPanel = _panels.FirstOrDefault(p => p is { Col: 0, Row: 0 }) ?? _panels.FirstOrDefault();

            await BuildTwinMapAsync();
        }

        RefreshPickerHolds();

        // Offer the wall's members as setters and pre-check the boulder's existing ones.
        _members = await WallService.GetMembersAsync(WallId);
        foreach (var setter in _boulder.Setters)
        {
            _selectedSetters.Add(setter.UserId);
        }

        // Holds from a retired generation can no longer be selected, but the wall they
        // were set on is still available as a visual reference for remapping.
        if (_boulder.BoulderHolds.Count > 0)
        {
            var holdGen = _boulder.BoulderHolds.Max(bh => bh.Hold.Generation);
            if (holdGen < _wall.CurrentGeneration)
            {
                _referenceGeneration = holdGen;
            }
        }

        // Pre-select the current holds the boulder is now on. Editing is current-only, so the goal is
        // to open with the app's best guess already ticked, all adjustable in the HoldPicker below.
        var currentHoldIds = _wall.Holds.Select(h => h.Id).ToHashSet();
        var preselected = new List<BoulderHoldInput>();
        var usedHoldIds = new HashSet<Guid>();

        // 1. Holds that carried over by identity (still exist at the current generation).
        foreach (var bh in _boulder.BoulderHolds.Where(bh => currentHoldIds.Contains(bh.HoldId)))
        {
            if (usedHoldIds.Add(bh.HoldId))
            {
                preselected.Add(new BoulderHoldInput(bh.HoldId, bh.Type, bh.Usage));
            }
        }

        // 2. Orphaned holds the matcher couldn't carry (generation < current — virtual/manual holds,
        //    or anything the wall update dropped): best-guess each to the NEAREST current hold within a
        //    conservative distance, so a truly-gone hold isn't force-mapped to something unrelated.
        //    De-duped, so two old holds landing on the same current hold select it once.
        foreach (var bh in _boulder.BoulderHolds.Where(bh => !currentHoldIds.Contains(bh.HoldId)))
        {
            var nearest = NearestHold(_wall.Holds, bh.Hold.X, bh.Hold.Y, MaxRematchDistance);
            if (nearest is not null && usedHoldIds.Add(nearest.Id))
            {
                preselected.Add(new BoulderHoldInput(nearest.Id, bh.Type, bh.Usage));
            }
        }

        _selectedHolds = preselected;
    }

    // The photo behind the picker: a specific panel on a multi-image wall, else null so the picker
    // falls back to the wall's centre-photo default (unchanged single-image behaviour).
    private string? PickerPhotoUrl =>
        _wall is { UsesMultipleImages: true } && _currentPanel is not null
            ? $"/api/walls/{WallId}/panels/{_currentPanel.Id}/photo"
            : null;

    // Recomputes the picker's hold set for the current view. Single-image: the whole set (same
    // reference as _displayHolds). Multi-image: only the current panel's holds, so they draw at their
    // panel-local coordinates on that panel's photo. Runs on load and on every panel switch.
    private void RefreshPickerHolds()
    {
        _pickerHolds = _wall is { UsesMultipleImages: true } && _currentPanel is not null
            ? _displayHolds.Where(h => h.WallPanelId == _currentPanel.Id).ToList()
            : _displayHolds;
    }

    // Builds the cross-panel twin map for the picker: each wall hold id → the OTHER hold ids in its
    // HoldLink connected component. Only holds with at least one twin appear. Reuses the shared
    // ConnectedComponents BFS over ALL wall hold ids so a transitive chain (centre-right-right2)
    // collapses into one component. A failed link load leaves the map null — picking still works, just
    // without cross-panel twin awareness.
    private async Task BuildTwinMapAsync()
    {
        try
        {
            var links = await WallPanelService.GetHoldLinksAsync(WallId);
            var components = HoldPropertySync.ConnectedComponents(_displayHolds.Select(h => h.Id), links);
            var map = new Dictionary<Guid, IReadOnlyList<Guid>>();
            foreach (var component in components.Where(c => c.Count >= 2))
            {
                foreach (var id in component)
                {
                    map[id] = component.Where(other => other != id).ToList();
                }
            }

            _holdTwins = map.Count > 0 ? map : null;
        }
        catch (Exception)
        {
            _holdTwins = null;
        }
    }

    // Switching panels preserves the accumulated selection (it is holdId-based in _selectedHolds, so
    // already-picked holds on the new panel stay highlighted); only the visible photo + hold set change.
    private void OnPanelChanged(WallPanelInfo panel)
    {
        _currentPanel = panel;
        RefreshPickerHolds();
    }

    // Max Euclidean distance in the normalized [0,1] coordinate space for the orphaned-hold re-match.
    // Conservative on purpose: beyond this the nearest current hold is treated as "not a match" and the
    // old hold contributes nothing, rather than mis-mapping the boulder onto an unrelated hold.
    private const double MaxRematchDistance = 0.06;

    // The current hold nearest to a normalized (x, y), or null when the closest is farther than
    // maxDistance. Pure Euclidean nearest-neighbour over the current-generation holds.
    private static Hold? NearestHold(IEnumerable<Hold> holds, double x, double y, double maxDistance)
    {
        Hold? best = null;
        var bestDistanceSquared = maxDistance * maxDistance;
        foreach (var hold in holds)
        {
            var dx = hold.X - x;
            var dy = hold.Y - y;
            var distanceSquared = (dx * dx) + (dy * dy);
            if (distanceSquared <= bestDistanceSquared)
            {
                bestDistanceSquared = distanceSquared;
                best = hold;
            }
        }

        return best;
    }

    private void ShowOriginal()
    {
        _showOriginal = true;
    }

    private void HideOriginal()
    {
        _showOriginal = false;
    }

    private void ToggleSetter(Guid userId, bool selected)
    {
        if (selected)
        {
            _selectedSetters.Add(userId);
        }
        else
        {
            _selectedSetters.Remove(userId);
        }
    }

    private async Task Submit()
    {
        _isSubmitting = true;
        _error = null;

        try
        {
            // "" clears the foot colour server-side; null there would mean "leave unchanged".
            await BoulderService.ReviseBoulderAsync(
                BoulderId,
                _selectedHolds,
                _name,
                _grade,
                _allKickboardOn,
                EffectiveHandsFollowFeet,
                _footColorOnly ?? string.Empty,
                _noMatch,
                _selectedSetters.ToList());
            Navigation.NavigateTo($"/walls/{WallId}/boulders/{BoulderId}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _isSubmitting = false;
        }
    }

    private static string F(double v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    public void Dispose()
    {
        _editLease?.Dispose();

        if (_editGuardActive)
        {
            _ = EditGuardInterop.SyncAsync(JS, "boulder-revise", editing: false, active: _editGuardActive);
        }
    }
}
