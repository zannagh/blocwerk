@page "/walls/{WallId:guid}"
@page "/walls/{WallId:guid}/shared/{ShareToken}"
@rendermode InteractiveServer
@inject IWallService WallService
@inject IBoulderService BoulderService
@inject IAttemptService AttemptService
@inject IActivityLogService ActivityLogService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation
@using Blocwerk.Web.Components.Shared

<PageTitle>@(_wall?.Name ?? "Wall") - Blocwerk</PageTitle>

@if (_wall == null)
{
    <p class="loading">Loading...</p>
}
else
{
    <div class="wall-detail">
        <div class="wall-fold">
        <div class="wall-detail-card">
        <div class="detail-header">
            <h1>@_wall.Name</h1>
            <div class="header-actions">
                @if (!_isAnonymous)
                {
                    <button class="btn-icon" @onclick="ToggleActivity" title="Activity log">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                            <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
                        </svg>
                    </button>
                }
                @if (_isAdmin)
                {
                    <button class="btn-icon @(_isEditing ? "editing" : "")" @onclick="ToggleEditing" title="@(_isEditing ? "Exit edit mode" : "Edit wall")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                            <circle cx="12" cy="12" r="3" />
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                        </svg>
                    </button>
                }
            </div>
        </div>

        @if (_isAnonymous)
        {
            <div class="anon-banner">
                <span>Viewing as guest.</span>
                <a href="/account/login">Log in</a> to create boulders and log attempts.
            </div>
        }

        @if (!string.IsNullOrEmpty(_wall.Description))
        {
            <p class="description">@_wall.Description</p>
        }

        @if (_wall.PhotoContentType != null)
        {
            <div class="view-toggle">
                <button class="toggle-btn @(_viewMode == ViewMode.Photo ? "active" : "")" @onclick="() => _viewMode = ViewMode.Photo">Photo</button>
                <button class="toggle-btn @(_viewMode == ViewMode.Schematic ? "active" : "")" @onclick="() => _viewMode = ViewMode.Schematic">Schematic</button>
            </div>
        }

        <div class="wall-photo-container">
            @if (_wall.PhotoContentType != null && _viewMode == ViewMode.Photo)
            {
                <WallPhotoEditor WallId="_wall.Id"
                                 Holds="_holds"
                                 BorderPoints="_borderPoints"
                                 CanEdit="_isAdmin && _isEditing"
                                 ShareToken="@ShareToken"
                                 IsStaging="@_wall.StagedAt.HasValue"
                                 LiveGeneration="_wall.CurrentGeneration"
                                 OnBatchSave="OnBatchSave"
                                 OnRedetectRequested="OnRedetect"
                                 OnBorderChanged="OnBorderChanged"
                                 OnCleanArtifactsRequested="OnCleanArtifacts"
                                 OnMarkHoldModified="OnMarkHoldModified"
                                 OnMergeHolds="OnMergeHolds" />
            }
            else if (_wall.PhotoContentType != null && _viewMode == ViewMode.Schematic)
            {
                <WallSchematicView Holds="_holds" Angle="_wall.Angle" />
            }
            else if (_isAdmin && _isEditing)
            {
                <div class="upload-prompt">
                    <p>Upload a frontal photo of your wall to get started.</p>
                    <InputFile OnChange="OnPhotoSelected" accept="image/*" class="form-input" />
                </div>
            }
        </div>
        </div>

        <div class="stats-bar">
            <div class="stat">
                <span class="stat-value">@_holds.Count</span>
                <span class="stat-label">Holds</span>
            </div>
            <div class="stat">
                <span class="stat-value">@_wall.Boulders.Count</span>
                <span class="stat-label">Boulders</span>
            </div>
            <div class="stat clickable" @onclick="ToggleMembers">
                <span class="stat-value">@_wall.Members.Count</span>
                <span class="stat-label">Members</span>
            </div>
        </div>
        </div>

        <div class="boulder-section">
            <div class="section-header">
                <h2>Boulders</h2>
                @if (_holds.Count > 0 && !_isAnonymous)
                {
                    <a href="/walls/@WallId/boulders/create" class="btn-add-boulder">+ New</a>
                }
            </div>

            @if (_boulders.Count > 0)
            {
                <div class="filter-bar">
                    <input @bind="_searchText" @bind:event="oninput" placeholder="Search..." class="filter-input" />
                    <select @bind="_gradeFilter" class="filter-select">
                        <option value="">All grades</option>
                        @foreach (var g in _availableGrades)
                        {
                            <option value="@g">@g</option>
                        }
                    </select>
                </div>
            }

            @if (_boulders.Count == 0)
            {
                <div class="empty-boulders">
                    <p>No boulders yet. @(_holds.Count > 0 ? "Create your first boulder!" : "Add holds to the wall first.")</p>
                </div>
            }
            else
            {
                @foreach (var boulder in FilteredBoulders)
                {
                    var summary = _boulderSummaries.GetValueOrDefault(boulder.Id);
                    var boulderUrl = !string.IsNullOrEmpty(ShareToken)
                        ? $"/walls/{WallId}/boulders/{boulder.Id}/shared/{ShareToken}"
                        : $"/walls/{WallId}/boulders/{boulder.Id}";
                    <a href="@boulderUrl" class="boulder-card">
                        <div class="boulder-card-left">
                            <span class="boulder-name">
                                @boulder.Name
                                @if (boulder.IsHistoric) { <span class="historic-badge" title="Wall changed since creation">historic</span> }
                                @if (boulder.NeedsReview) { <span class="review-badge" title="A hold on this boulder changed — review needed">review</span> }
                            </span>
                            <span class="boulder-meta">
                                @boulder.BoulderHolds.Count holds &middot; by @boulder.CreatedBy.DisplayName
                            </span>
                        </div>
                        <div class="boulder-card-right">
                            @if (!_isAnonymous)
                            {
                                @if (summary is { HasFlashed: true })
                                {
                                    <span class="status-icon flash-icon" title="Flashed">&#9889;</span>
                                }
                                else if (summary is { HasSent: true })
                                {
                                    <span class="status-icon send-icon" title="Sent">&#10003;</span>
                                }
                                else if (summary is { TotalAttempts: > 0 })
                                {
                                    <span class="status-icon try-icon" title="@summary.TotalAttempts attempts">@summary.TotalAttempts</span>
                                }
                            }
                            @if (!string.IsNullOrEmpty(boulder.Grade))
                            {
                                <span class="boulder-grade">@boulder.Grade</span>
                            }
                        </div>
                    </a>
                }
            }
        </div>

        @if (_showMembers && _isAdmin)
        {
            <div class="settings-panel">
                <h2>Members</h2>
                @if (_members == null)
                {
                    <p class="loading-small">Loading...</p>
                }
                else
                {
                    @foreach (var member in _members)
                    {
                        <div class="member-row">
                            <span class="member-name">@member.User.DisplayName</span>
                            @if (member.UserId == _wall.OwnerId)
                            {
                                <span class="member-role owner">Owner</span>
                            }
                            else
                            {
                                <button class="role-toggle @(member.Role == WallRole.Admin ? "admin" : "member")"
                                        @onclick="() => ToggleMemberRole(member)">
                                    @(member.Role == WallRole.Admin ? "Admin" : "Member")
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        }

        @if (_showActivity)
        {
            <div class="settings-panel">
                <h2>Activity</h2>
                @if (_activityItems == null)
                {
                    <p class="loading-small">Loading...</p>
                }
                else
                {
                    @foreach (var item in _activityItems)
                    {
                        <div class="activity-row">
                            <span class="activity-icon">@ActivityIcon(item.Type)</span>
                            <span class="activity-text">@item.User.DisplayName @ActivityVerb(item.Type)</span>
                            <span class="activity-time">@RelativeTime(item.Timestamp)</span>
                        </div>
                    }
                    @if (_activityTotal > _activityItems.Count)
                    {
                        <div class="activity-pager">
                            @if (_activityPage > 0)
                            {
                                <button class="pager-btn" @onclick="() => LoadActivity(_activityPage - 1)">&larr; Newer</button>
                            }
                            <button class="pager-btn" @onclick="() => LoadActivity(_activityPage + 1)">Older &rarr;</button>
                        </div>
                    }
                    @if (_activityItems.Count == 0)
                    {
                        <p class="empty-activity">No activity yet.</p>
                    }
                }
            </div>
        }

        @if (_showSettings && _isAdmin)
        {
            <div class="settings-panel">
                <h2>Wall Settings</h2>

                <div class="form-group">
                    <label>@(_wall.StagedAt.HasValue ? "Replace Staged Photo" : "Upload New Photo")</label>
                    <InputFile OnChange="OnPhotoSelected" accept="image/*" class="form-input" />
                    @if (_wall.StagedAt.HasValue)
                    {
                        <p class="staged-hint">A new photo is staged. Adjust holds in the editor, then confirm or discard.</p>
                        <div class="staged-actions">
                            <button class="btn-primary" @onclick="ConfirmStagedPhoto">Confirm new photo</button>
                            <button class="btn-secondary" @onclick="DiscardStagedPhoto">Discard</button>
                        </div>
                    }
                </div>

                @if (string.IsNullOrEmpty(_shareLink))
                {
                    <button class="btn-secondary" @onclick="GenerateShareLink">Generate Share Link</button>
                }
                else
                {
                    <div class="share-link">
                        <input value="@_shareLink" readonly class="form-input" />
                    </div>
                }

                <button class="btn-danger" @onclick="DeleteWall">Delete Wall</button>
            </div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(_toast))
{
    <div class="toast-msg">@_toast</div>
}

@code {
    [Parameter] public Guid WallId { get; set; }
    [Parameter] public string? ShareToken { get; set; }

    private Wall? _wall;
    private List<Hold> _holds = [];
    private List<ShapePoint> _borderPoints = [];
    private List<Boulder> _boulders = [];
    private Dictionary<Guid, AttemptSummary> _boulderSummaries = [];
    private bool _isAdmin;
    private bool _isAnonymous;
    private bool _isEditing;
    private bool _showSettings;
    private bool _showActivity;
    private bool _showMembers;
    private string? _shareLink;
    private string? _toast;
    private string _searchText = string.Empty;
    private string _gradeFilter = string.Empty;
    private ViewMode _viewMode = ViewMode.Photo;

    private List<WallMember>? _members;
    private List<ActivityLogEntry>? _activityItems;
    private int _activityTotal;
    private int _activityPage;

    private enum ViewMode { Photo, Schematic }

    private List<string> _availableGrades => _boulders
        .Where(b => !string.IsNullOrEmpty(b.Grade))
        .Select(b => b.Grade!)
        .Distinct()
        .OrderBy(g => g)
        .ToList();

    private IEnumerable<Boulder> FilteredBoulders
    {
        get
        {
            var q = _boulders.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_searchText))
                q = q.Where(b => b.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(_gradeFilter))
                q = q.Where(b => b.Grade == _gradeFilter);
            return q;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadWall();
    }

    private async Task LoadWall()
    {
        if (!string.IsNullOrEmpty(ShareToken))
        {
            _wall = await WallService.GetWallByShareTokenAsync(ShareToken);
            _isAnonymous = true;
            _isAdmin = false;

            try
            {
                var user = await CurrentUserService.GetCurrentUserAsync();
                var membership = _wall?.Members.FirstOrDefault(m => m.UserId == user.Id);
                if (membership != null)
                {
                    _isAnonymous = false;
                    _isAdmin = membership.Role == WallRole.Admin;
                }
            }
            catch (UnauthorizedAccessException)
            {
            }
        }
        else
        {
            try
            {
                _wall = await WallService.GetWallAsync(WallId);
                if (_wall != null)
                {
                    var user = await CurrentUserService.GetCurrentUserAsync();
                    var membership = _wall.Members.FirstOrDefault(m => m.UserId == user.Id);
                    _isAdmin = membership?.Role == WallRole.Admin;
                }
            }
            catch (UnauthorizedAccessException)
            {
                Navigation.NavigateTo("/account/login", replace: true);
                return;
            }
        }

        if (_wall != null)
        {
            _holds = _wall.Holds.ToList();
            _borderPoints = _wall.BorderPoints ?? [];
            _boulders = !_isAnonymous
                ? await BoulderService.GetBouldersForWallAsync(WallId)
                : _wall.Boulders.ToList();

            if (!_isAnonymous)
            {
                _boulderSummaries = [];
                foreach (var b in _boulders)
                {
                    _boulderSummaries[b.Id] = await AttemptService.GetBoulderSummaryForUserAsync(b.Id);
                }
            }

            if (!string.IsNullOrEmpty(_wall.ShareToken))
            {
                _shareLink = $"{Navigation.BaseUri}join/{_wall.ShareToken}";
            }
        }
    }

    private async Task OnBatchSave(WallPhotoEditor.BatchChanges changes)
    {
        foreach (var hold in changes.Added)
        {
            var saved = await WallService.AddHoldAsync(WallId, hold.X, hold.Y, hold.Radius, hold.Color, hold.Category, hold.ShapePoints);
            var local = _holds.FirstOrDefault(h => h.Id == hold.Id);
            if (local != null) local.Id = saved.Id;
        }

        foreach (var hold in changes.Updated)
        {
            await WallService.UpdateHoldAsync(hold.Id, hold.X, hold.Y, hold.Radius, hold.Color, hold.Category, hold.IsOnKickboard, hold.ShapePoints, hold.Name);
        }

        foreach (var holdId in changes.Deleted)
        {
            await WallService.DeleteHoldAsync(holdId);
            _holds.RemoveAll(h => h.Id == holdId);
        }

        await ShowToast($"Saved {changes.Added.Count + changes.Updated.Count + changes.Deleted.Count} changes");
    }

    private async Task OnBorderChanged(List<ShapePoint> points)
    {
        await WallService.SetBorderPointsAsync(WallId, points);
    }

    private async Task OnCleanArtifacts()
    {
        var count = await WallService.CleanOutsideBorderAsync(WallId);
        await LoadWall();
        await ShowToast($"Removed {count} holds outside border");
    }

    private async Task OnRedetect()
    {
        var count = await WallService.RedetectHoldsAsync(WallId);
        await LoadWall();
        await ShowToast($"Detected {count} holds");
    }

    private void ToggleEditing()
    {
        _isEditing = !_isEditing;
        _showSettings = _isEditing;
    }

    private async Task ToggleActivity()
    {
        _showActivity = !_showActivity;
        _showMembers = false;
        if (_showActivity && _activityItems == null)
        {
            await LoadActivity(0);
        }
    }

    private async Task ToggleMembers()
    {
        if (!_isAdmin) return;
        _showMembers = !_showMembers;
        _showActivity = false;
        if (_showMembers && _members == null)
        {
            _members = await WallService.GetMembersAsync(WallId);
        }
    }

    private async Task LoadActivity(int page)
    {
        _activityPage = page;
        var (items, total) = await ActivityLogService.GetWallActivityAsync(WallId, page);
        _activityItems = items;
        _activityTotal = total;
    }

    private async Task ToggleMemberRole(WallMember member)
    {
        var newRole = member.Role == WallRole.Admin ? WallRole.Member : WallRole.Admin;
        await WallService.SetMemberRoleAsync(WallId, member.UserId, newRole);
        member.Role = newRole;
        await ShowToast($"{member.User.DisplayName} is now {newRole}");
    }

    private async Task GenerateShareLink()
    {
        var token = await WallService.GenerateShareTokenAsync(WallId);
        _shareLink = $"{Navigation.BaseUri}join/{token}";
    }

    private async Task DeleteWall()
    {
        await WallService.DeleteWallAsync(WallId);
        Navigation.NavigateTo("/walls");
    }

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > 10 * 1024 * 1024)
        {
            await ShowToast("Photo too large (max 10 MB)");
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            if (_wall?.PhotoContentType != null)
            {
                await WallService.StagePhotoAsync(WallId, ms.ToArray(), file.ContentType);
                await LoadWall();
                await ShowToast($"Photo staged — review holds and click Confirm");
            }
            else
            {
                await WallService.UploadPhotoAsync(WallId, ms.ToArray(), file.ContentType);
                await LoadWall();
                await ShowToast($"Photo uploaded — {_holds.Count} holds detected");
            }
        }
        catch (Exception ex)
        {
            await ShowToast($"Upload failed: {ex.Message}");
        }
    }

    private async Task ConfirmStagedPhoto()
    {
        try
        {
            await WallService.ConfirmStagedPhotoAsync(WallId);
            await LoadWall();
            await ShowToast("New photo confirmed");
        }
        catch (Exception ex)
        {
            await ShowToast($"Confirm failed: {ex.Message}");
        }
    }

    private async Task OnMergeHolds((Guid stagedHoldId, Guid liveHoldId) pair)
    {
        try
        {
            await WallService.MergeHoldsAsync(pair.stagedHoldId, pair.liveHoldId);
            await LoadWall();
            await ShowToast("Holds merged");
        }
        catch (Exception ex)
        {
            await ShowToast($"Merge failed: {ex.Message}");
        }
    }

    private async Task OnMarkHoldModified(Guid holdId)
    {
        try
        {
            await WallService.MarkHoldModifiedAsync(holdId);
            await LoadWall();
            await ShowToast("Hold marked as modified; affected boulders flagged for review");
        }
        catch (Exception ex)
        {
            await ShowToast($"Failed: {ex.Message}");
        }
    }

    private async Task DiscardStagedPhoto()
    {
        try
        {
            await WallService.DiscardStagedPhotoAsync(WallId);
            await LoadWall();
            await ShowToast("Staged photo discarded");
        }
        catch (Exception ex)
        {
            await ShowToast($"Discard failed: {ex.Message}");
        }
    }

    private static string ActivityIcon(ActivityType type) => type switch
    {
        ActivityType.HoldAdded => "+",
        ActivityType.HoldMoved => "~",
        ActivityType.HoldDeleted => "-",
        ActivityType.HoldColorChanged => "~",
        ActivityType.HoldShapeChanged => "~",
        ActivityType.HoldNamed => "T",
        ActivityType.BoulderCreated => "B",
        ActivityType.BoulderRevised => "R",
        ActivityType.WallPhotoUploaded => "P",
        ActivityType.WallPhotoStaged => "P",
        ActivityType.WallPhotoConfirmed => "P",
        ActivityType.WallPhotoDiscarded => "P",
        ActivityType.HoldMarkedModified => "!",
        ActivityType.HoldMerged => "M",
        ActivityType.WallReset => "!",
        ActivityType.MemberJoined => "J",
        ActivityType.MemberRoleChanged => "R",
        ActivityType.AttemptLogged => "A",
        ActivityType.CommentAdded => "C",
        _ => "?",
    };

    private static string ActivityVerb(ActivityType type) => type switch
    {
        ActivityType.HoldAdded => "added a hold",
        ActivityType.HoldMoved => "moved a hold",
        ActivityType.HoldDeleted => "removed a hold",
        ActivityType.HoldColorChanged => "changed a hold color",
        ActivityType.HoldShapeChanged => "refined a hold shape",
        ActivityType.HoldNamed => "named a hold",
        ActivityType.BoulderCreated => "created a boulder",
        ActivityType.BoulderRevised => "revised a boulder",
        ActivityType.WallPhotoUploaded => "uploaded a photo",
        ActivityType.WallPhotoStaged => "staged a new photo",
        ActivityType.WallPhotoConfirmed => "confirmed the new photo",
        ActivityType.WallPhotoDiscarded => "discarded the staged photo",
        ActivityType.HoldMarkedModified => "marked a hold as modified",
        ActivityType.HoldMerged => "merged holds across photos",
        ActivityType.WallReset => "reset the wall",
        ActivityType.MemberJoined => "joined the wall",
        ActivityType.MemberRoleChanged => "role was changed",
        ActivityType.AttemptLogged => "logged an attempt",
        ActivityType.CommentAdded => "commented on a boulder",
        _ => "did something",
    };

    private static string RelativeTime(DateTimeOffset timestamp)
    {
        var diff = DateTimeOffset.UtcNow - timestamp;
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return timestamp.ToString("MMM d");
    }

    private async Task ShowToast(string message)
    {
        _toast = message;
        StateHasChanged();
        await Task.Delay(2500);
        _toast = null;
        StateHasChanged();
    }
}

