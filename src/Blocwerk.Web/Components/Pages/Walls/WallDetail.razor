    private async Task ToggleEditing()
    {
        _isEditing = !_isEditing;
        SyncEditLease();

        // Entering edit mode on a big wall: default to the first live panel and load its editable
        // holds so the per-panel editor branch has a non-null selection to render.
        if (_isEditing && _livePanels.Count > 0)
        {
            _editingPanel ??= _livePanels[0];
            await LoadEditingPanelHolds();
        }
    }

    // Single source of truth for the busy lease: acquire when we start editing and don't already
    // hold one (so toggling on twice never double-acquires), release when we stop. Called after
    // every _isEditing change and from Dispose.
    private void SyncEditLease()
    {
        if (_isEditing)
        {
            _editLease ??= EditActivity.BeginWallEdit(WallId, _currentUserId == Guid.Empty ? null : _currentUserId);
        }
        else
        {
            _editLease?.Dispose();
            _editLease = null;
        }
    }

