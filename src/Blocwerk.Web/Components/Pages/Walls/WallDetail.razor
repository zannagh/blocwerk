    private async Task OnMakeHoldActual(Guid virtualHoldId)
    {
        try
        {
            await WallService.PromoteVirtualHoldAsync(virtualHoldId);
            // Repaint the editor overlay immediately: flip the in-memory hold so it stops rendering
            // dotted even before the wall reload swaps the list in.
            foreach (var h in _holds.Where(h => h.Id == virtualHoldId))
            {
                h.IsVirtual = false;
            }
            await LoadWall();
            // On multi-image walls the tool operates on the per-panel editor list, which LoadWall
            // never touches; reload it so the promoted hold repaints solid instead of staying dotted.
            if (_editingPanel is not null)
            {
                await LoadEditingPanelHolds();
            }
            await ShowToast("Virtual hold is now actual");
        }
        catch (Exception ex)
        {
            await ShowToast($"Failed: {ex.Message}");
        }
    }

    private async Task OnMergeVirtualHold((Guid virtualHoldId, Guid actualHoldId) pair)
    {
        try
        {
            await WallService.MergeVirtualHoldAsync(pair.virtualHoldId, pair.actualHoldId);
            // The virtual hold survives (now actual); the detected hold it absorbed is gone. Reflect
            // both on the in-memory list so the editor repaints before the wall reload.
            foreach (var h in _holds.Where(h => h.Id == pair.virtualHoldId))
            {
                h.IsVirtual = false;
            }
            _holds.RemoveAll(h => h.Id == pair.actualHoldId);
            await LoadWall();
            // On multi-image walls the tool operates on the per-panel editor list, which LoadWall
            // never touches; reload it so the merged hold repaints solid instead of staying dotted.
            if (_editingPanel is not null)
            {
                await LoadEditingPanelHolds();
            }
            await ShowToast("Virtual hold merged into detected hold");
        }
        catch (Exception ex)
        {
            await ShowToast($"Merge failed: {ex.Message}");
        }
    }

    private async Task OnJoinVirtualHolds((Guid survivorHoldId, Guid duplicateHoldId) pair)
    {
        try
        {
            await WallService.MergeDuplicateVirtualHoldsAsync(pair.survivorHoldId, pair.duplicateHoldId);
            // The survivor stays virtual and keeps its geometry; only the absorbed duplicate goes away.
            // Drop it from the in-memory list so the editor repaints before the wall reload.
            _holds.RemoveAll(h => h.Id == pair.duplicateHoldId);
            await LoadWall();
            // On multi-image walls the tool operates on the per-panel editor list, which LoadWall
            // never touches; reload it so the absorbed hold disappears from the overlay.
            if (_editingPanel is not null)
            {
                await LoadEditingPanelHolds();
            }
            await ShowToast("Duplicate virtual hold merged");
        }
        catch (Exception ex)
        {
            await ShowToast($"Merge failed: {ex.Message}");
        }
    }

