    /// <summary>
    /// Loads the wall's twin links once and reconciles every boulder's holds to a per-physical-hold
    /// count, so a boulder that saved both twins of a hold is not double-counted on its card. A wall
    /// with no links (single-panel) yields an empty map and the cards fall back to the raw count.
    /// </summary>
    private async Task LoadReconciledHoldCounts()
    {
        _reconciledHoldCounts = [];
        try
        {
            var links = await WallPanelService.GetHoldLinksAsync(WallId);
            if (links.Count == 0)
            {
                return;
            }

            var linkPairs = links.ToList();
            foreach (var boulder in _boulders)
            {
                var reconciled = BoulderHoldReconciler.Reconcile(
                    boulder.BoulderHolds.Select(bh => new ReconcilableHold(bh.HoldId, bh.Type, bh.Usage)),
                    linkPairs);
                _reconciledHoldCounts[boulder.Id] = reconciled.Count;
            }
        }
        catch (Exception)
        {
            // A failed link read just leaves cards on their raw count — never blocks the wall page.
            _reconciledHoldCounts = [];
        }
    }

    private int? ReconciledHoldCount(Boulder boulder) =>
        _reconciledHoldCounts.TryGetValue(boulder.Id, out var count) ? count : null;

