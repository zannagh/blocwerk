@page "/walls/{WallId:guid}"
@page "/walls/{WallId:guid}/shared/{ShareToken}"
@rendermode InteractiveServer
@inject IWallService WallService
@inject IWallPanelService WallPanelService
@inject WallCacheState Cache
@inject IWallSegmentService WallSegmentService
@inject IBoulderService BoulderService
@inject IBoulderFeedbackService FeedbackService
@inject IActivityLogService ActivityLogService
@inject ICurrentUserService CurrentUserService
@inject IKioskService KioskService
@inject Blocwerk.Core.Abstractions.IKioskContext KioskContext
@inject CircuitEditActivity EditActivity
@inject IWallUpdateSessionService WallUpdateSessions
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<WallDetail> Logger
@implements IDisposable
@using Blocwerk.Web.Components.Shared
@using Blocwerk.Core.Helpers

<PageTitle>@(_wall?.Name ?? "Wall") - Blocwerk</PageTitle>

@if (_wall == null)
{
    <p class="loading">Loading...</p>
}
else if (_wall.UnderMaintenance && _currentUserId != _wall.MaintenanceByUserId)
{
    @* Update mode: hide the wall from everyone except the admin who enabled it. *@
    <SectionContent SectionName="TopBarTitle">@_wall.Name</SectionContent>

    <div class="maintenance-notice">
        <div class="maintenance-icon">🛠️</div>
        <h2>This wall is currently being updated</h2>
        <p>@_wall.Name is being updated right now. Please check back in a little while.</p>
    </div>
}
else
{
    <SectionContent SectionName="TopBarTitle">@_wall.Name</SectionContent>

    <WallCarousel @ref="_carousel" InitialPage="@InitialCarouselPage" Locked="_isEditing">
        <Page1>
            @* Activity is visible to all wall members; settings/shape/API keys stay admin-only. *@
            <details open class="settings-panel settings-card">
                <summary class="settings-card-summary"><h2>Activity</h2></summary>
                <div class="settings-card-body">
                    @if (_isAnonymous)
                    {
                        <p class="empty-activity">Log in to see this wall's activity.</p>
                    }
                    else if (_activityItems == null)
                    {
                        <p class="loading-small">Loading...</p>
                    }
                    else
                    {
                        @foreach (var item in _activityItems)
                        {
                            <div class="activity-row">
                                <span class="activity-icon">@ActivityIcon(item.Type)</span>
                                <span class="activity-text">@item.User.Name @ActivityVerb(item.Type)</span>
                                <span class="activity-time"><LocalTime Value="@item.Timestamp" Format="LocalTimeFormat.Relative" /></span>
                            </div>
                        }
                        @if (_activityTotal > _activityItems.Count)
                        {
                            <div class="activity-pager">
                                @if (_activityPage > 0)
                                {
                                    <button class="pager-btn" @onclick="() => LoadActivity(_activityPage - 1)">&larr; Newer</button>
                                }
                                <button class="pager-btn" @onclick="() => LoadActivity(_activityPage + 1)">Older &rarr;</button>
                            </div>
                        }
                        @if (_activityItems.Count == 0)
                        {
                            <p class="empty-activity">No activity yet.</p>
                        }
                    }
                </div>
            </details>

            @if (_isAdmin)
            {
                <details class="settings-panel settings-card">
                    <summary class="settings-card-summary"><h2>Wall Settings</h2></summary>
                    <div class="settings-card-body">

                    <div class="form-group">
                        <label class="filter-check">
                            <input type="checkbox" checked="@_wall.UnderMaintenance" @onchange="OnToggleMaintenance" />
                            Update mode — hide this wall from others while you work on it
                        </label>
                        <p class="field-hint">While this is on, everyone except you sees a "currently being updated" notice instead of the wall.</p>
                    </div>

                    @if (_showBigUpdate)
                    {
                        <BigWallUpdate WallId="WallId"
                                       OnClose="CloseBigUpdate" OnPromoted="OnBigUpdatePromoted" />
                    }
                    else
                    {
                        <div class="form-group">
                            <WallPanelGrid WallId="WallId" />
                            @* An update session belongs to the wall, so a second moderator should JOIN
                               it rather than collide with it — say who has it open and since when. *@
                            @if (_openUpdate is { } openUpdate)
                            {
                                <p class="staged-hint">
                                    An update is already in progress, started by
                                    @(openUpdate.CreatedByName ?? "another admin") on
                                    @openUpdate.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm").
                                    @if (openUpdate.LastActiveByUserId is not null
                                         && openUpdate.LastActiveByUserId != openUpdate.CreatedByUserId)
                                    {
                                        <span>
                                            Last continued by @(openUpdate.LastActiveByName ?? "another admin")
                                            on @openUpdate.UpdatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm").
                                        </span>
                                    }
                                    <span>Opening it continues where they left off.</span>
                                </p>
                            }
                            <button class="btn-secondary bigupdate-entry" @onclick="OpenBigUpdate">
                                @(_openUpdate is null ? "Update wall with new photos" : "Continue the wall update")
                            </button>
                        </div>
                    }

                    @* While the big-wall update wizard is open, hide the rest of the settings so its
                       Continue/Done buttons don't sit one tap above the destructive Delete Wall control.
                       _showBigUpdate is the parent's own "in the flow" flag (set in OpenBigUpdate, cleared
                       by every wizard exit through CloseBigUpdate), so these restore on discard/Not now/Done. *@
                    @if (!_showBigUpdate)
                    {
                        @* A share link is membership that outlives the 30-minute session, so WallService
                           refuses to mint one from a tablet. Hiding the button keeps it from rendering a
                           control whose only outcome is an error; the service guard is still the gate. *@
                        @if (KioskContext.IsKiosk)
                        {
                            <p class="hint">Share links are generated from your own device, not from this wall tablet.</p>
                        }
                        else if (string.IsNullOrEmpty(_shareLink))
                        {
                            <button class="btn-secondary" @onclick="GenerateShareLink">Generate Share Link</button>
                        }
                        else
                        {
                            <div class="share-link">
                                <input value="@_shareLink" readonly class="form-input" />
                            </div>
                        }

                        <button class="btn-danger" @onclick="DeleteWall">Delete Wall</button>
                    }
                    </div>
                </details>

                @* Hidden alongside the controls above while the big-wall update wizard is open;
                   restored when it closes. See the note on the guard inside the Wall Settings card. *@
                @if (!_showBigUpdate)
                {
                <details class="settings-panel settings-card">
                    <summary class="settings-card-summary"><h2>Wall Shape</h2></summary>
                    <div class="settings-card-body">
                    <div class="form-group">
                        <label>Fallback angle: @_wall.Angle&deg; <span class="segment-angle-word">@WallAngleRange.Label(_wall.Angle)</span></label>
                        <input type="range" min="@WallAngleRange.Min" max="@WallAngleRange.Max" value="@_wall.Angle"
                               @oninput="OnWallAngleInput" @onchange="SaveWallAngle" class="angle-slider" />
                        <p class="hint">
                            Used for every part of the wall that no segment covers. If the whole
                            wall is one plane you only need this; add segments when the photo
                            captures planes at different angles.
                        </p>
                    </div>

                    @if (_wall.PhotoContentType != null)
                    {
                        @* The wall border is one polygon per wall, drawn over the centre-panel image
                           (/api/walls/{id}/photo). It feeds the schematic/projection views and is
                           separate from the per-panel hold editing on the overview page. *@
                        <details class="segment-settings">
                            <summary>
                                Wall border &amp; shape
                                @if (_borderPoints.Count >= 3)
                                {
                                    <span class="segment-settings-count">@_borderPoints.Count</span>
                                }
                            </summary>
                            <WallPhotoEditor WallId="_wall.Id"
                                             Holds="_holds"
                                             BorderPoints="_borderPoints"
                                             Segments="_segments"
                                             CanEdit="false"
                                             CanEditShape="_isAdmin"
                                             BorderOnly="true"
                                             OnBorderChanged="OnBorderChanged" />
                        </details>

                        <details class="segment-settings">
                            <summary>
                                Wall segments &amp; projection
                                @if (_segments.Count > 0)
                                {
                                    <span class="segment-settings-count">@_segments.Count</span>
                                }
                            </summary>
                            <WallSegmentEditor WallId="_wall.Id" FallbackAngle="_wall.Angle"
                                               Holds="_holds" BorderPoints="_borderPoints"
                                               OnSegmentsSaved="OnSegmentsSaved" />
                        </details>
                    }
                    else
                    {
                        <p class="empty-msg">Upload a wall photo to draw the border and segments on it.</p>
                    }
                    </div>
                </details>

                @if (_currentUserId != Guid.Empty)
                {
                    @* KioskGuardedApiKeyService refuses every key mint from a tablet, so this card
                       could only render controls that fail on tap. Hidden here; the service guard
                       is still the gate. *@
                    @if (KioskContext.IsKiosk)
                    {
                        <p class="hint">API keys are managed from your own device, not from this wall tablet.</p>
                    }
                    else
                    {
                        <details class="settings-panel settings-card">
                            <summary class="settings-card-summary"><h2>API key</h2></summary>
                            <div class="settings-card-body">
                                <WallApiKeyPanel WallId="WallId" CurrentUserId="_currentUserId" />
                            </div>
                        </details>
                    }

                    @* Pairing a tablet by code, so nobody has to type a bwk_ key on an on-screen
                       keyboard. Admin-only, and scoped to this wall: the card can never approve a
                       tablet for anything else. A kiosk approver is refused at the service, so on a
                       tablet the card is hidden rather than left to fail. *@
                    @if (_isAdmin)
                    {
                        @if (KioskContext.IsKiosk)
                        {
                            <p class="hint">Kiosk registration is approved from your own device, not from this wall tablet.</p>
                        }
                        else
                        {
                            <details class="settings-panel settings-card">
                                <summary class="settings-card-summary"><h2>Kiosk Registration</h2></summary>
                                <div class="settings-card-body">
                                    <WallKioskPairingPanel WallId="WallId" CurrentUserId="_currentUserId" />
                                </div>
                            </details>
                        }
                    }
                }
                }
            }
        </Page1>

        <Page2>
            @* Members (visible to all wall members) + leaderboard *@
            @if (_isMember)
            {
                <div class="settings-panel">
                    <h2>Members</h2>
                    @if (_members == null)
                    {
                        <p class="loading-small">Loading...</p>
                    }
                    else
                    {
                        @foreach (var member in _members)
                        {
                            <div class="member-row">
                                <a href="/profile/@member.UserId" class="member-name-link">
                                    <UserAvatar UserId="member.UserId" Name="@(member.User?.Name ?? "Unknown")"
                                                HasAvatar="member.User?.HasAvatar ?? false" CssClass="avatar-sm" />
                                    @(member.User?.Name ?? "Unknown")
                                </a>
                                @if (member.UserId == _wall.OwnerId)
                                {
                                    <span class="member-role owner">Owner</span>
                                }
                                else if (_isAdmin)
                                {
                                    <select class="role-select @(member.Role == WallRole.Admin ? "admin" : member.Role == WallRole.Moderator ? "moderator" : "member")"
                                            value="@member.Role"
                                            @onchange="e => OnMemberRoleChanged(member, e)">
                                        <option value="@WallRole.Member">Member</option>
                                        <option value="@WallRole.Moderator">Moderator</option>
                                        <option value="@WallRole.Admin">Admin</option>
                                    </select>
                                }
                                else
                                {
                                    <span class="member-role">@member.Role</span>
                                }
                            </div>
                            @* Consent to appear on the tablet is granted and withdrawn from your own
                               device — KioskService refuses both from a kiosk session, so on a tablet
                               these controls only ever produced an error line. *@
                            @if (member.UserId == _currentUserId && KioskContext.IsKiosk)
                            {
                                <div class="kiosk-consent-line">
                                    <span class="kiosk-consent-state">
                                        Kiosk consent is managed from your own device, not from this tablet.
                                    </span>
                                </div>
                            }
                            else if (member.UserId == _currentUserId)
                            {
                                <div class="kiosk-consent-line">
                                    @if (_kioskConsented)
                                    {
                                        <span class="kiosk-consent-state">📟 You appear on this wall's kiosk tablet</span>
                                        @if (_kioskConfirmRevoke)
                                        {
                                            <span class="kiosk-consent-confirm">Remove yourself and clear your PIN?</span>
                                            <button type="button" class="kiosk-consent-btn danger" disabled="@_kioskBusy"
                                                    @onclick="RevokeKioskConsent">Yes, remove me</button>
                                            <button type="button" class="kiosk-consent-btn" disabled="@_kioskBusy"
                                                    @onclick="() => _kioskConfirmRevoke = false">Cancel</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="kiosk-consent-btn" disabled="@_kioskBusy"
                                                    @onclick="OpenKioskDialog">Change PIN</button>
                                            <button type="button" class="kiosk-consent-btn" disabled="@_kioskBusy"
                                                    @onclick="() => _kioskConfirmRevoke = true">Remove me</button>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" class="kiosk-consent-btn" disabled="@_kioskBusy"
                                                @onclick="OpenKioskDialog">📟 Use Kiosk mode on this wall</button>
                                    }
                                </div>
                                @if (_kioskError != null)
                                {
                                    <div class="error-msg">@_kioskError</div>
                                }
                            }
                        }
                    }
                </div>

                <WallLeaderboardCard WallId="WallId" />
            }
            else
            {
                <div class="settings-panel">
                    <h2>Members</h2>
                    <p class="leaderboard-empty">Members are visible to wall members.</p>
                </div>
            }
        </Page2>

        <Page3>
            @* Overview (centre page — the wall itself) *@
            <div class="wall-main">
                <div class="wall-detail-card">
                    @if (_isAnonymous && KioskContext.IsKiosk)
                    {
                        @* The tablet's resting state, and the ONLY next step that works on it: the
                           picker, not a login page. See the anonymous-kiosk branch in LoadWall. *@
                        <div class="bw-anon-notice">
                            <span>Nobody's climbing yet.</span>
                            <a href="/kiosk/users">Pick yourself</a> to log attempts and set boulders.
                        </div>
                    }
                    else if (_isAnonymous)
                    {
                        <div class="bw-anon-notice">
                            <span>Viewing as guest.</span>
                            <a href="/account/login">Log in</a> to create boulders and log attempts.
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_wall.Description) && !_isEditing)
                    {
                        <p class="description">@_wall.Description</p>
                    }

                    <div class="wall-photo-container">
                        @* Edit pencil overlaid on the image's top-right, co-located with the editor's
                           usage "lens" button — not in a separate row above. Rendered at the WallDetail
                           level (not inside WallPhotoEditor) so it covers every view path uniformly:
                           the single-image editor, the multi-panel viewer, and the schematic view,
                           where WallPhotoEditor isn't the renderer. Shows an X while editing. The
                           Photo/Schematic toggle was removed; _viewMode stays and defaults to Photo. *@
                        @if (_canEditHolds)
                        {
                            <button class="btn-icon wall-edit-fab @(_isEditing ? "editing" : "")" @onclick="ToggleEditing" title="@(_isEditing ? "Exit edit mode" : "Edit wall")">
                                @if (_isEditing)
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="22" height="22" stroke-linecap="round">
                                        <line x1="6" y1="6" x2="18" y2="18" />
                                        <line x1="18" y1="6" x2="6" y2="18" />
                                    </svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                                        <path d="M12 20h9" />
                                        <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                                    </svg>
                                }
                            </button>
                        }
                        @if (_viewMode == ViewMode.Photo && _livePanels.Count > 0 && _canEditHolds && _isEditing && _editingPanel != null)
                        {
                            @* Big wall in edit mode: scope the single-image editor to one live panel
                               (its own photo + holds) and let the admin step between panels. Wall-level
                               tools (border, segments, redetect, merge, alignment) are inert here —
                               those belong to the wall/panel-grid settings, not per-panel hold editing. *@
                            <div class="panel-selector">
                                <button class="btn-icon" @onclick="() => StepEditingPanel(-1)"
                                        disabled="@(_livePanels.Count < 2 || _confirmingPanelStep)" title="Previous panel">‹</button>
                                <span class="panel-selector-label">Panel @(_livePanels.FindIndex(p => p.Id == _editingPanel.Id) + 1)/@_livePanels.Count</span>
                                <button class="btn-icon" @onclick="() => StepEditingPanel(1)"
                                        disabled="@(_livePanels.Count < 2 || _confirmingPanelStep)" title="Next panel">›</button>
                            </div>
                            @if (_confirmingPanelStep)
                            {
                                @* Uses the shared Modal rather than inline markup so it renders the
                                   .bw-modal-backdrop the global keyboard dispatcher stands down on, and
                                   so it gets Escape-to-close plus a focus trap. Escape and backdrop
                                   clicks map to Cancel — the non-destructive action, which keeps the
                                   unsaved hold edits and stays on the current panel. *@
                                <Modal AriaLabel="Discard unsaved hold changes?" OnClose="CancelPanelStep">
                                    <p class="staged-hint">Unsaved hold changes on this panel will be discarded. Switch anyway?</p>
                                    <div class="staged-actions">
                                        <button class="btn-primary" @onclick="ConfirmPanelStep">Discard &amp; switch</button>
                                        <button class="btn-secondary" @onclick="CancelPanelStep">Cancel</button>
                                    </div>
                                </Modal>
                            }
                            <WallPhotoEditor WallId="_wall.Id"
                                             @ref="_panelEditor"
                                             ResetToken="_editingPanel?.Id"
                                             PhotoUrlOverride="@($"/api/walls/{_wall.Id}/panels/{_editingPanel!.Id}/photo")"
                                             Holds="_editingPanelHolds"
                                             BorderPoints="new List<ShapePoint>()"
                                             Segments="null"
                                             CanEdit="true"
                                             BottomToolbar="true"
                                             IsStaging="false"
                                             ManualAlignment="false"
                                             ChangeReview="true"
                                             OnBatchSave="OnPanelBatchSave"
                                             OnRedetectRequested="OnRedetectPanel"
                                             OnMarkHoldModified="OnMarkHoldModified"
                                             OnMakeHoldActual="OnMakeHoldActual"
                                             OnMergeVirtualHold="OnMergeVirtualHold"
                                             OnJoinVirtualHolds="OnJoinVirtualHolds"
                                             OnRestoreUnchangedHold="OnRestoreUnchangedHold"
                                             HasMultiplePanels="_livePanels.Count >= 2"
                                             OnLinkPanels="OpenLinkTool"
                                             OnRequestHoldUsage="@(_isAnonymous ? null : LoadHoldUsage)" />
                        }
                        else if (_viewMode == ViewMode.Photo && _livePanels.Count > 0)
                        {
                            @* Big wall: step between the live panel images instead of one flat photo.
                               Editing the panel grid lives in the wall settings, never here. *@
                            <MultiPanelViewer WallId="_wall.Id" ShareToken="@ShareToken" Panels="_livePanels"
                                              StartCol="0" StartRow="0"
                                              ArrowMode="MultiPanelViewer.ArrowDisplayMode.AllNeighbours"
                                              HoldsProvider="LoadPanelHolds"
                                              EnableSwipe="true"
                                              OnRequestHoldUsage="@(_isAnonymous ? null : LoadHoldUsage)" />
                        }
                        else if (_wall.PhotoContentType != null && _viewMode == ViewMode.Photo)
                        {
                            @* Fallback flat-photo view for when no live panels are enumerable — in
                               practice an anonymous share viewer who can't list panels, so it renders
                               read-only. Wall-level border/shape now lives in the Wall Shape settings
                               card and per-panel redetect/clean-artifacts on the per-panel editor above,
                               so this arm no longer carries them. Border stays wired for the rare admin
                               who reaches it with zero live panels; virtual-hold tools stay too. *@
                            <WallPhotoEditor WallId="_wall.Id"
                                             Holds="_holds"
                                             BorderPoints="_borderPoints"
                                             Segments="_segments"
                                             CanEdit="_canEditHolds && _isEditing"
                                             CanEditShape="_isAdmin"
                                             BottomToolbar="_isEditing"
                                             ShareToken="@ShareToken"
                                             LiveGeneration="_wall.CurrentGeneration"
                                             OnBatchSave="OnBatchSave"
                                             OnBorderChanged="OnBorderChanged"
                                             OnMarkHoldModified="OnMarkHoldModified"
                                             OnMakeHoldActual="OnMakeHoldActual"
                                             OnMergeVirtualHold="OnMergeVirtualHold"
                                             OnJoinVirtualHolds="OnJoinVirtualHolds"
                                             OnRestoreUnchangedHold="OnRestoreUnchangedHold"
                                             OnRequestHoldUsage="@(_isAnonymous ? null : LoadHoldUsage)" />
                        }
                        else if (_wall.PhotoContentType != null && _viewMode == ViewMode.Schematic)
                        {
                            <WallSchematicView Holds="_holds" Angle="_wall.Angle" Segments="_segments"
                                               ShowSegments="false" />
                        }
                        else if (_isAdmin && _isEditing)
                        {
                            <div class="upload-prompt">
                                <p>Upload a frontal photo of your wall to get started.</p>
                                <InputFile OnChange="OnPhotoSelected" accept="image/*" class="form-input" />
                            </div>
                        }
                    </div>
                </div>

                @if (_showLinkTool && _canEditHolds)
                {
                    <PanelLinkTool WallId="_wall.Id" ActingUserId="_currentUserId" OnClose="CloseLinkTool" />
                }

                @if (!_isEditing)
                {
                    <div class="stats-bar">
                        <div class="stat">
                            @* Count the LIVE holds only. GetWallAsync returns the live holds per panel
                               (which span generations after a subset promote — an untouched panel keeps
                               its old generation) plus, during an in-flight big update, the staged
                               (gen+1) holds. Everything at or below the wall generation is live; the
                               staged gen+1 rows must not inflate the stat. *@
                            <span class="stat-value">@_holds.Count(h => h.Generation <= _wall.CurrentGeneration)</span>
                            <span class="stat-label">Holds</span>
                        </div>
                        <button type="button" class="stat clickable" @onclick="GoToBoulders">
                            <span class="stat-value">@_wall.Boulders.Count</span>
                            <span class="stat-label">Boulders</span>
                        </button>
                        <button type="button" class="stat clickable" @onclick="GoToMembers">
                            <span class="stat-value">@_wall.Members.Count</span>
                            <span class="stat-label">Members</span>
                        </button>
                        @* Any member can hand out the wall's invite link, not just admins. Hidden for
                           non-members (kiosks and never-joined viewers); the service guard is the gate. *@
                        @if (_isMember)
                        {
                            <button type="button" class="stat clickable" @onclick="InviteAsync">
                                <svg class="stat-value" width="24" height="24" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="18" cy="5" r="3"></circle>
                                    <circle cx="6" cy="12" r="3"></circle>
                                    <circle cx="18" cy="19" r="3"></circle>
                                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                                </svg>
                                <span class="stat-label">Invite</span>
                            </button>
                        }
                    </div>

                    @if (_showInviteLink && !string.IsNullOrEmpty(_shareLink))
                    {
                        <div class="share-link">
                            <input value="@_shareLink" readonly class="form-input" />
                            <p class="hint">@_inviteCopyLabel</p>
                        </div>
                    }

                    @* The cross-panel link tool used to be reachable only as a bare chain-link icon
                       inside per-panel edit mode, so a wall could be updated with zero links and lose
                       twin expansion for every boulder that spans two panels — which is exactly what
                       happened in production. Say the state out loud on the wall page instead, with a
                       way in. Editors only; the tool re-checks the role on the server anyway. *@
                    @if (_canEditHolds && _livePanels.Count >= 2)
                    {
                        <div class="panel-link-callout @(_holdLinkCount == 0 ? "warn" : "")">
                            <div class="panel-link-callout-text">
                                <strong>
                                    @_livePanels.Count panels ·
                                    @(_holdLinkCount == 0
                                        ? "no holds linked across them"
                                        : $"{_holdLinkCount} hold pair{(_holdLinkCount == 1 ? "" : "s")} linked across them")
                                </strong>
                                <span class="hint">
                                    A hold visible on two panels is two holds until you link them. Link
                                    them and a boulder that spans the panels counts once — and survives
                                    the next wall update as one hold.
                                </span>
                            </div>
                            <button type="button" class="btn-secondary" @onclick="OpenLinkTool">
                                Link holds across panels
                            </button>
                        </div>
                    }
                }
            </div>
        </Page3>

        <Page4>
            @* Boulders *@
            <div class="boulder-section">
                <div class="section-header">
                    <h2>Boulders</h2>
                    @* Anonymous kiosk setting is opt-in per wall, so the button mirrors exactly what
                       BoulderCreate and BoulderService.EnsureAnonymousKioskCreateAllowedAsync accept:
                       this tablet's own wall, with the setting on. Without the kiosk branch a tablet
                       with nobody picked could never reach the create flow the server already allows. *@
                    @if (_holds.Count > 0 && (!_isAnonymous || _canCreateAnonymously))
                    {
                        <a href="/walls/@WallId/boulders/create" class="btn-add-boulder">+ New</a>
                    }
                </div>

                @if (_items.Count > 0)
                {
                    @* All boulder filters live in one collapsible card (collapsed by default), reusing
                       the page's settings-card/summary chrome. The summary carries a filter icon, a
                       "Filters" label and — when any filter is active — a count badge, so a collapsed
                       card still signals that the list below is filtered. *@
                    <details class="settings-panel settings-card filter-card">
                        <summary class="settings-card-summary">
                            <span class="filter-card-title">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                                </svg>
                                Filters
                                @if (ActiveFilterCount > 0)
                                {
                                    <span class="filter-count">@ActiveFilterCount</span>
                                }
                            </span>
                        </summary>
                        <div class="settings-card-body">
                            <div class="filter-bar">
                                <input @bind="_searchText" @bind:event="oninput" placeholder="Search..." class="filter-input" />
                                <div class="sort-row">
                                    <label class="sort-label">Sort</label>
                                    <select @bind="_sort" class="filter-select">
                                        <option value="@SortMode.Newest">Newest</option>
                                        <option value="@SortMode.Oldest">Oldest</option>
                                        <option value="@SortMode.GradeAsc">Grade ↑ (easy first)</option>
                                        <option value="@SortMode.GradeDesc">Grade ↓ (hard first)</option>
                                        <option value="@SortMode.Rating">Rating</option>
                                        @if (!_isAnonymous)
                                        {
                                            <option value="@SortMode.MyAttempts">Most attempts by me</option>
                                        }
                                    </select>
                                </div>
                                <div class="grade-range-row">
                                    <label class="sort-label">Grade</label>
                                    <GradeRangePicker @bind-Min="_gradeMin" @bind-Max="_gradeMax" />
                                </div>
                                @* Every checkbox filter needs per-user or beta data that only the
                                   signed-in boulder list carries; the anonymous/kiosk share view builds
                                   its rows without it, so these stay hidden there (search/sort/grade
                                   remain). "Not done by me" also needs a "me" to be meaningful. *@
                                @if (!_isAnonymous)
                                {
                                    <div class="filter-checks">
                                        <label class="filter-check"><input type="checkbox" @bind="_fAttempted" /> Attempted by me</label>
                                        <label class="filter-check"><input type="checkbox" @bind="_fDone" /> Done by me</label>
                                        <label class="filter-check"><input type="checkbox" @bind="_fNotDone" /> Not done by me</label>
                                        <label class="filter-check"><input type="checkbox" @bind="_fFavorites" /> My favourites</label>
                                        <label class="filter-check"><input type="checkbox" @bind="_fCreated" /> Created by me</label>
                                        <label class="filter-check"><input type="checkbox" @bind="_fBeta" /> Has beta video</label>
                                    </div>
                                }
                            </div>
                        </div>
                    </details>
                }

                @if (_items.Count == 0)
                {
                    <div class="empty-boulders">
                        <p>No boulders yet. @(_holds.Count > 0 ? "Create your first boulder!" : "Add holds to the wall first.")</p>
                    </div>
                }
                else if (ActiveBoulders.Count == 0 && ArchivedBoulders.Count == 0)
                {
                    <div class="empty-boulders">
                        <p>No boulders match your filters.</p>
                    </div>
                }
                else
                {
                    @foreach (var item in ActiveBoulders)
                    {
                        <BoulderCard @key="item.Boulder.Id" Item="item" WallId="WallId" ShareToken="@ShareToken"
                                     CurrentUserId="_currentUserId" IsAnonymous="_isAnonymous"
                                     IsWallAdmin="_isAdmin"
                                     ShowArchiveAction="true" ReconciledHoldCount="ReconciledHoldCount(item.Boulder)"
                                     OnPublish="PublishBoulder" OnArchive="ArchiveBoulder" OnUnarchive="UnarchiveBoulder" />
                    }

                    @if (ArchivedBoulders.Count > 0)
                    {
                        <details class="archive-section">
                            <summary class="archive-summary">Archive (@ArchivedBoulders.Count)</summary>
                            @foreach (var item in ArchivedBoulders)
                            {
                                <BoulderCard @key="item.Boulder.Id" Item="item" WallId="WallId" ShareToken="@ShareToken"
                                             CurrentUserId="_currentUserId" IsAnonymous="_isAnonymous"
                                             IsWallAdmin="_isAdmin"
                                             ReconciledHoldCount="ReconciledHoldCount(item.Boulder)"
                                             OnPublish="PublishBoulder" OnArchive="ArchiveBoulder" OnUnarchive="UnarchiveBoulder" />
                            }
                        </details>
                    }
                }
            </div>
        </Page4>

        <Page5>
            @* Wall details: temperature and gallery *@
            <WallTemperaturePanel WallId="WallId" />

            <WallGalleryPanel WallId="WallId" ShareToken="@ShareToken"
                              IsAdmin="_isAdmin" CurrentUserId="_currentUserId" />
        </Page5>
    </WallCarousel>
}

@* Nothing opens this dialog on a tablet any more (the consent line that did is hidden above), but
   the flag is state and state can be set; the submit behind it is refused by KioskService either way. *@
@if (_kioskDialogOpen && !KioskContext.IsKiosk)
{
    <Modal Title="Use Kiosk mode on this wall" OnClose="CloseKioskDialog">
            <p class="kiosk-modal-text">
                This wall's kiosk tablet will list your name. Anyone standing at it can pick you and act
                as you &mdash; logging climbs, commenting, editing &mdash; until the kiosk session ends.
            </p>

            @if (_kioskIsPrivileged)
            {
                <p class="kiosk-modal-warning">
                    You have @(_isAdmin ? "admin" : "moderator") rights on this wall. Without a PIN, anyone
                    at the tablet gets those rights too. You can still skip the PIN &mdash; just untick the box.
                </p>
            }

            <label class="kiosk-pin-toggle">
                <input type="checkbox" checked="@_kioskUsePin" @onchange="OnKioskUsePinChanged" />
                Protect my pick with a PIN
            </label>
            <p class="hint">With a PIN, only someone who knows it can pick you at the tablet.</p>

            @if (_kioskUsePin)
            {
                <div class="form-group">
                    <label for="kiosk-pin">PIN (4&ndash;8 digits)</label>
                    <input id="kiosk-pin" class="form-input" type="password" inputmode="numeric" maxlength="8"
                           autocomplete="off" @bind="_kioskPin" @bind:event="oninput" />
                </div>
            }

            @if (_kioskDialogError != null)
            {
                <div class="error-msg">@_kioskDialogError</div>
            }

            <div class="kiosk-modal-actions">
                <button type="button" class="kiosk-consent-btn" disabled="@_kioskBusy" @onclick="CloseKioskDialog">Cancel</button>
                <button type="button" class="kiosk-consent-btn primary" disabled="@_kioskBusy" @onclick="SubmitKioskConsent">
                    @(_kioskBusy ? "Working..." : _kioskConsented ? "Save" : "Add me to the kiosk")
                </button>
            </div>
    </Modal>
}

@if (!string.IsNullOrEmpty(_toast))
{
    <div class="toast-msg">@_toast</div>
}

@code {
    [Parameter] public Guid WallId { get; set; }
    [Parameter] public string? ShareToken { get; set; }

    /// <summary>Deep-link target for the carousel: <c>?view=boulders</c> opens on the boulder list
    /// (used by the live-session tab), otherwise the wall opens on its main view.</summary>
    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    @* Carousel pages (0-based): 0 Settings, 1 Members, 2 Overview (centre), 3 Boulders, 4 Details. *@
    private int InitialCarouselPage =>
        string.Equals(View, "boulders", StringComparison.OrdinalIgnoreCase) ? 3 : 2;

    private WallCarousel? _carousel;
    private Wall? _wall;

    // Answered by the SAME helper the server gate runs (via IBoulderService), so the button and the
    // create can never disagree: viewing rights, a live kiosk key, the wall's opt-in AND this
    // tablet's own per-key flag all have to hold. Refreshed by every LoadWall, which is also what
    // the wall-cache change handler re-runs.
    private bool _canCreateAnonymously;

    // The wall the loaded state belongs to, so OnParametersSetAsync can tell a real wall change from
    // an ordinary re-render or a query-only navigation.
    private Guid _loadedWallId;
    private string? _loadedShareToken;
    private List<Hold> _holds = [];
    private List<ShapePoint> _borderPoints = [];
    private List<WallSegment> _segments = [];
    private List<WallPanelInfo> _livePanels = [];
    private WallPanelInfo? _editingPanel;
    private List<Hold> _editingPanelHolds = [];
    private WallPhotoEditor? _panelEditor;
    private bool _confirmingPanelStep;
    private int _pendingPanelStepDelta;
    private List<Boulder> _boulders = [];
    private List<BoulderListItem> _items = [];

    // Twin-reconciled hold count per boulder id, computed once from the wall's links after each load.
    // Empty on single-panel walls (no links), where a card's raw BoulderHolds.Count is already right.
    private Dictionary<Guid, int> _reconciledHoldCounts = [];
    private bool _isAdmin;
    private bool _isModerator;
    private bool _isMember;
    private bool _isAnonymous;
    private Guid _currentUserId;
    private bool _isEditing;

    // Hold-editor access: owner, admin, or moderator. Mirrors WallAdminGuard.EnsureWallEditorAsync
    // on the server. Settings/photos/shape/API keys/border stay on _isAdmin.
    private bool _canEditHolds => _isAdmin || _isModerator;

    // Marks the app "busy" while this wall is in edit/alignment mode. Kept in lock-step with
    // _isEditing via SyncEditLease() so every enter/leave transition is covered exactly once.
    private IDisposable? _editLease;

    // Mirrors _editLease onto the browser bwEditGuard so the maintenance watchdog holds back an
    // auto-reload while this wall is in edit/alignment mode with unsaved changes. Synced every render
    // (the lease toggles on enter/leave) via EditGuardInterop.
    private bool _editGuardActive;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Every render, not just the first: the lease toggles when edit mode is entered or left.
        _editGuardActive = await EditGuardInterop.SyncAsync(JS, "wall-edit", _editLease is not null, _editGuardActive);
    }

    private bool _showBigUpdate;

    // The wall's in-flight update, if any — surfaced at the entry point so a second admin joins it.
    private WallUpdateSessionInfo? _openUpdate;
    private bool _showLinkTool;

    // How many cross-panel hold links the wall has. Only loaded for an editor of a multi-panel wall,
    // where it is what the discoverability card reports; a single-panel wall can have none.
    private int _holdLinkCount;
    private string? _shareLink;
    private bool _showInviteLink;
    private string _inviteCopyLabel = string.Empty;
    private string? _toast;
    private string _searchText = string.Empty;
    private string? _gradeMin;
    private string? _gradeMax;
    private bool _fAttempted;
    private bool _fDone;
    private bool _fNotDone;
    private bool _fFavorites;
    private bool _fCreated;
    private bool _fBeta;
    private SortMode _sort = SortMode.Newest;
    private ViewMode _viewMode = ViewMode.Photo;

    private enum SortMode { Newest, Oldest, GradeAsc, GradeDesc, Rating, MyAttempts }

    // Active-filter badge for the collapsed filter card: search text, a grade bound, and each
    // checked box count once. Sort is an ordering, not a filter, so it is deliberately excluded.
    private int ActiveFilterCount
    {
        get
        {
            var count = 0;
            if (!string.IsNullOrWhiteSpace(_searchText)) { count++; }
            if (!string.IsNullOrEmpty(_gradeMin) || !string.IsNullOrEmpty(_gradeMax)) { count++; }
            if (_fAttempted) { count++; }
            if (_fDone) { count++; }
            if (_fNotDone) { count++; }
            if (_fFavorites) { count++; }
            if (_fCreated) { count++; }
            if (_fBeta) { count++; }
            return count;
        }
    }

    private List<WallMember>? _members;

    // Kiosk consent (the current user's own opt-in on this wall's kiosk tablet). Loaded once with
    // the members list; never inside a render path.
    private bool _kioskConsented;
    private bool _kioskDialogOpen;
    private bool _kioskConfirmRevoke;
    private bool _kioskBusy;
    private bool _kioskUsePin;
    private string _kioskPin = string.Empty;
    private string? _kioskDialogError;
    private string? _kioskError;

    /// <summary>Admins (owner included) and moderators hand over real wall powers, so they get the
    /// PIN pre-ticked and a plain warning — but are never blocked from skipping it.</summary>
    private bool _kioskIsPrivileged => _isAdmin || _isModerator;

    private List<ActivityLogEntry>? _activityItems;
    private int _activityTotal;
    private int _activityPage;

    private enum ViewMode { Photo, Schematic }

    // ActiveBoulders/ArchivedBoulders are read several times per render (empty-check, count,
    // foreach), and the page re-renders on every unrelated state change (toasts, activity). The
    // filter+sort chain parses grades per item, so recomputing it 6x/render was pure waste. Cache
    // the results and only recompute when the underlying data (_items is always *reassigned*, never
    // mutated in place) or a filter/sort field actually changes.
    private List<BoulderListItem>? _activeCache;
    private List<BoulderListItem>? _archivedCache;
    private object? _boulderCacheItemsRef;
    private (string?, bool, bool, bool, bool, bool, bool, string?, string?, SortMode, Guid?) _boulderCacheKey;

    private void EnsureBoulderLists()
    {
        var key = (_searchText, _fAttempted, _fDone, _fNotDone, _fFavorites, _fCreated, _fBeta, _gradeMin, _gradeMax, _sort, _currentUserId);
        if (_activeCache is not null && _archivedCache is not null
            && ReferenceEquals(_boulderCacheItemsRef, _items) && key.Equals(_boulderCacheKey))
        {
            return;
        }

        _boulderCacheItemsRef = _items;
        _boulderCacheKey = key;

        // Historic boulders always sink to the bottom of the active list; OrderBy is a stable
        // sort in LINQ-to-objects, so the chosen sort order is preserved within each group.
        _activeCache = ApplySort(ApplyFilters(_items.Where(i => !i.Boulder.IsArchived)))
            .OrderBy(i => i.Boulder.IsHistoric)
            .ToList();
        _archivedCache = ApplySort(ApplyFilters(_items.Where(i => i.Boulder.IsArchived))).ToList();
    }

    private List<BoulderListItem> ActiveBoulders
    {
        get { EnsureBoulderLists(); return _activeCache!; }
    }

    private List<BoulderListItem> ArchivedBoulders
    {
        get { EnsureBoulderLists(); return _archivedCache!; }
    }

    private IEnumerable<BoulderListItem> ApplyFilters(IEnumerable<BoulderListItem> src)
    {
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            src = src.Where(i => i.Boulder.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
        }

        if (_fAttempted)
        {
            src = src.Where(i => i.AttemptedByMe);
        }

        if (_fDone)
        {
            src = src.Where(i => i.DoneByMe);
        }

        if (_fNotDone)
        {
            src = src.Where(i => !i.DoneByMe);
        }

        if (_fBeta)
        {
            src = src.Where(i => i.HasBetaVideo);
        }

        if (_fFavorites)
        {
            src = src.Where(i => i.IsFavorite);
        }

        if (_fCreated)
        {
            src = src.Where(i => i.Boulder.CreatedByUserId == _currentUserId);
        }

        var minScore = ScoreOf(_gradeMin);
        var maxScore = ScoreOf(_gradeMax);
        if (minScore.HasValue || maxScore.HasValue)
        {
            src = src.Where(i => MatchesGradeRange(i.Boulder.Grade, minScore, maxScore));
        }

        return src;
    }

    // Ungraded (or unrecognised) boulders always stay visible when a grade range is set.
    private static bool MatchesGradeRange(string? grade, int? minScore, int? maxScore)
    {
        var score = GradeScoring.GetScore(grade, false);
        if (score == 0)
        {
            return true;
        }

        if (minScore.HasValue && score < minScore.Value)
        {
            return false;
        }

        return !maxScore.HasValue || score <= maxScore.Value;
    }

    private static int? ScoreOf(string? grade)
    {
        if (string.IsNullOrEmpty(grade))
        {
            return null;
        }

        var score = GradeScoring.GetScore(grade, false);
        return score == 0 ? null : score;
    }

    private IEnumerable<BoulderListItem> ApplySort(IEnumerable<BoulderListItem> src) => _sort switch
    {
        SortMode.Newest => src.OrderByDescending(i => i.Boulder.CreatedAt),
        SortMode.Oldest => src.OrderBy(i => i.Boulder.CreatedAt),
        // Ungraded (score 0) sinks to the bottom of the easy-first order.
        SortMode.GradeAsc => src.OrderBy(i => GradeScoring.GetScore(i.Boulder.Grade, false) is 0 ? int.MaxValue : GradeScoring.GetScore(i.Boulder.Grade, false)),
        SortMode.GradeDesc => src.OrderByDescending(i => GradeScoring.GetScore(i.Boulder.Grade, false)),
        SortMode.Rating => src.OrderByDescending(i => i.AverageRating ?? -1),
        SortMode.MyAttempts => src.OrderByDescending(i => i.MyAttemptCount),
        _ => src,
    };

    protected override async Task OnInitializedAsync()
    {
        Cache.Changed += OnCacheChanged;
        await LoadCurrentWall();
    }

    // Navigating from one wall to another keeps this component alive — same route template, new
    // parameters — so without this the page would keep showing the wall it first loaded. A pure
    // ?view= change needs no reload: InitialCarouselPage recomputes and the carousel repositions on
    // the parameter change.
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedWallId == WallId && _loadedShareToken == ShareToken)
        {
            return;
        }

        // Drop the old wall first: it puts the page back on its "Loading..." state, which also
        // recreates the carousel so it opens on the new wall's initial page rather than wherever the
        // user had swiped the previous one.
        _wall = null;
        StateHasChanged();
        await LoadCurrentWall();
    }

    private async Task LoadCurrentWall()
    {
        _loadedWallId = WallId;
        _loadedShareToken = ShareToken;
        await LoadWall();
        if (_wall != null && !_isAnonymous)
        {
            await LoadActivity(0);
            if (_isMember)
            {
                _members = await WallService.GetMembersAsync(WallId);
                await LoadKioskConsent();
            }
        }
    }

    private async Task LoadKioskConsent()
    {
        try
        {
            _kioskConsented = await KioskService.HasConsentedAsync(WallId);
        }
        catch (UnauthorizedAccessException)
        {
            _kioskConsented = false;
        }
        catch (Exception ex)
        {
            Serilog.Log.Error(ex, "Loading the kiosk consent of wall {WallId} failed", WallId);
            _kioskConsented = false;
        }
    }

    private void OpenKioskDialog()
    {
        _kioskConfirmRevoke = false;
        _kioskError = null;
        _kioskDialogError = null;
        _kioskPin = string.Empty;

        // Privileged members start with the PIN ticked: skipping it must be a deliberate untick.
        _kioskUsePin = _kioskIsPrivileged;
        _kioskDialogOpen = true;
    }

    private void CloseKioskDialog()
    {
        _kioskDialogOpen = false;
        _kioskPin = string.Empty;
        _kioskDialogError = null;
    }

    private void OnKioskUsePinChanged(ChangeEventArgs e)
    {
        _kioskUsePin = e.Value is bool value && value;
        _kioskDialogError = null;
        if (!_kioskUsePin)
        {
            _kioskPin = string.Empty;
        }
    }

    private async Task SubmitKioskConsent()
    {
        if (_kioskBusy)
        {
            return;
        }

        string? pin = null;
        if (_kioskUsePin)
        {
            pin = _kioskPin.Trim();
            if (pin.Length is < 4 or > 8 || !pin.All(char.IsAsciiDigit))
            {
                _kioskDialogError = "The PIN has to be 4 to 8 digits.";
                return;
            }
        }

        _kioskBusy = true;
        _kioskDialogError = null;
        try
        {
            await KioskService.ConsentAsync(WallId, pin);
            _kioskConsented = true;
            _kioskDialogOpen = false;
            _kioskPin = string.Empty;
            await ShowToast(pin == null ? "You're on this wall's kiosk, without a PIN" : "You're on this wall's kiosk");
        }
        catch (UnauthorizedAccessException)
        {
            _kioskDialogError = "Please sign in again to change your kiosk settings.";
        }
        catch (InvalidOperationException ex)
        {
            _kioskDialogError = ex.Message;
        }
        catch (Exception ex)
        {
            Serilog.Log.Error(ex, "Recording kiosk consent for wall {WallId} failed", WallId);
            _kioskDialogError = "Your kiosk consent could not be saved. Please try again.";
        }
        finally
        {
            _kioskBusy = false;
        }
    }

    private async Task RevokeKioskConsent()
    {
        if (_kioskBusy)
        {
            return;
        }

        _kioskBusy = true;
        _kioskError = null;
        try
        {
            await KioskService.RevokeConsentAsync(WallId);
            _kioskConsented = false;
            _kioskConfirmRevoke = false;
            await ShowToast("You no longer appear on this wall's kiosk");
        }
        catch (UnauthorizedAccessException)
        {
            _kioskError = "Please sign in again to change your kiosk settings.";
        }
        catch (Exception ex)
        {
            Serilog.Log.Error(ex, "Revoking kiosk consent for wall {WallId} failed", WallId);
            _kioskError = "Your kiosk consent could not be withdrawn. Please try again.";
        }
        finally
        {
            _kioskBusy = false;
        }
    }

    /// <summary>
    /// Live-refresh when this wall (or one of its boulders) changes on any circuit — so a co-owner's
    /// edit shows up without a reload. Skipped while this user is editing, so a background reload
    /// never clobbers in-progress hold edits; their own post-save <see cref="LoadWall"/> covers that.
    /// </summary>
    private void OnCacheChanged(DomainChange change)
    {
        if (change.Scope == DomainChangeScope.WallList || change.WallId != WallId || _isEditing)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadWall();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Cache.Changed -= OnCacheChanged;
        _editLease?.Dispose();

        if (_editGuardActive)
        {
            // Best-effort clear on navigate-away; a torn-down circuit no-ops (the safe failure).
            _ = EditGuardInterop.SyncAsync(JS, "wall-edit", editing: false, active: _editGuardActive);
        }
    }

    private async Task LoadWall()
    {
        // Cleared before ANY branch that can return, so no path out of this method can leave last
        // wall's answer standing while _wall already points at the next one. The early return on the
        // login redirect is such a path: a render still happens before the navigation completes, and
        // a stale true would offer "+ New" for a wall this tablet may not even write to.
        _canCreateAnonymously = false;

        if (!string.IsNullOrEmpty(ShareToken))
        {
            _wall = await WallService.GetWallByShareTokenAsync(ShareToken);
            _isAnonymous = true;
            _isAdmin = false;
            _isModerator = false;
            _isMember = false;

            try
            {
                var user = await CurrentUserService.GetCurrentUserAsync();
                var membership = _wall?.Members.FirstOrDefault(m => m.UserId == user.Id);
                var isOwner = _wall?.OwnerId == user.Id;
                if (membership != null || isOwner)
                {
                    _currentUserId = user.Id;
                    _isAnonymous = false;
                    _isMember = true;
                    _isAdmin = membership?.Role == WallRole.Admin || isOwner;
                    _isModerator = membership?.Role == WallRole.Moderator;
                }
            }
            catch (UnauthorizedAccessException ex)
            {
                // No signed-in user behind the share link; the viewer stays anonymous.
                Logger.LogDebug(ex, "Share-token viewer of wall {WallId} is not signed in", WallId);
            }
        }
        else
        {
            try
            {
                _wall = await Cache.GetWallAsync(WallId);
                if (_wall != null)
                {
                    var user = await CurrentUserService.GetCurrentUserAsync();
                    var membership = _wall.Members.FirstOrDefault(m => m.UserId == user.Id);
                    _currentUserId = user.Id;
                    _isMember = membership != null;
                    _isAdmin = membership?.Role == WallRole.Admin || _wall.OwnerId == user.Id;
                    _isModerator = membership?.Role == WallRole.Moderator;
                }
            }
            catch (UnauthorizedAccessException)
            {
                // A registered tablet with nobody picked yet is the kiosk's RESTING state, not a
                // signed-out visitor, and bouncing it to a login page it is not meant to complete is
                // what made a freshly paired tablet spin: /account/login sent it to /oauth-select and
                // every way back here threw again. It views its own wall read-only instead, on the
                // same _isAnonymous machinery a share-token viewer uses — writes still need a picked
                // user. EVERY other anonymous caller, including a kiosk pointed at somebody else's
                // wall, still goes to sign in exactly as before.
                if (!KioskViewing.AllowsAnonymousViewOf(KioskContext, WallId))
                {
                    Navigation.NavigateTo("/account/login", replace: true);
                    return;
                }

                _isAnonymous = true;
                _currentUserId = Guid.Empty;
                _isMember = false;
                _isAdmin = false;
                _isModerator = false;
            }
        }

        // The one place the anonymous "+ New" button is decided, and it asks the server's own gate.
        // Only worth a round-trip for a session that has no signed-in user; anybody else creates on
        // their own authority. Reset to false at the top of this method, so this is the only place
        // that can turn it back on.
        _canCreateAnonymously = _isAnonymous
            && _wall != null
            && await BoulderService.CanCreateAnonymouslyAsync(WallId);

        await LoadOpenUpdateAsync();

        if (_wall != null)
        {
            // Clone the holds/border points: _wall now comes from the shared per-circuit cache and
            // the photo editor mutates these in place while dragging. Editing the cached instances
            // directly would leak uncommitted edits back into the cache on discard/navigate-away.
            _holds = _wall.Holds.Select(h => h.Clone()).ToList();
            _borderPoints = _wall.BorderPoints?.Select(p => new ShapePoint { Dx = p.Dx, Dy = p.Dy }).ToList() ?? [];
            await LoadSegments();
            await LoadPanels();
            if (!_isAnonymous)
            {
                _items = await FeedbackService.GetBoulderListAsync(WallId);
            }
            else
            {
                // Anonymous share view: no per-user data, but the rows still name the setters, so
                // pull every setter name for the wall in one query rather than per boulder.
                var setterNames = await WallService.GetBoulderSetterNamesAsync(WallId);
                _items = _wall.Boulders
                    .Where(b => !b.IsDraft && !b.IsArchived)
                    .Select(b => new BoulderListItem(
                        b, 0, false, false, false, null, 0, null, setterNames.GetValueOrDefault(b.Id)))
                    .ToList();
            }

            _boulders = _items.Select(i => i.Boulder).ToList();
            await LoadReconciledHoldCounts();

            if (!string.IsNullOrEmpty(_wall.ShareToken))
            {
                _shareLink = $"{Navigation.BaseUri}join/{_wall.ShareToken}";
            }
        }
    }

    private async Task OnBatchSave(WallPhotoEditor.BatchChanges changes)
    {
        foreach (var hold in changes.Added)
        {
            var saved = await WallService.AddHoldAsync(WallId, hold.X, hold.Y, hold.Radius, hold.Color, hold.Category, hold.ShapePoints, material: hold.Material, handType: hold.HandType);
            var local = _holds.FirstOrDefault(h => h.Id == hold.Id);
            if (local != null) local.Id = saved.Id;
        }

        foreach (var hold in changes.Updated)
        {
            await WallService.UpdateHoldAsync(hold.Id, hold.X, hold.Y, hold.Radius, hold.Color, hold.Category, hold.IsOnKickboard, hold.ShapePoints, hold.Name, hold.Material, handType: hold.HandType);
        }

        foreach (var holdId in changes.Deleted)
        {
            await WallService.DeleteHoldAsync(holdId);
            _holds.RemoveAll(h => h.Id == holdId);
        }

        await ShowToast($"Saved {changes.Added.Count + changes.Updated.Count + changes.Deleted.Count} changes");
    }

    /// <summary>
    /// Loads the wall's segments. <c>GetWallAsync</c> does not include them, and a guest
    /// viewing through a share link has no identity to query them with — in that case the
    /// renderers simply fall back to the wall's single angle.
    /// </summary>
    private async Task LoadSegments()
    {
        try
        {
            _segments = await WallSegmentService.GetSegmentsAsync(WallId);
        }
        catch (Exception)
        {
            _segments = [];
        }
    }

    /// <summary>
    /// Loads the wall's live panels for the multi-image viewer. Every wall is a big wall now (a
    /// centre panel at 0,0). A failed read (e.g. an anonymous share viewer who can't enumerate
    /// panels) leaves an empty list and falls back to the flat-photo view.
    /// </summary>
    private async Task LoadPanels()
    {
        if (_wall is null)
        {
            _livePanels = [];
            _editingPanel = null;
            return;
        }

        try
        {
            var panels = await WallPanelService.GetPanelsAsync(WallId);
            _livePanels = panels.Where(p => p.IsLive).ToList();
        }
        catch (Exception)
        {
            _livePanels = [];
        }

        await LoadHoldLinkCount();

        // Keep the edited-panel selection pointing at a panel that still exists after a reload.
        if (_editingPanel is not null && _livePanels.All(p => p.Id != _editingPanel.Id))
        {
            _editingPanel = _livePanels.Count > 0 ? _livePanels[0] : null;
        }
    }

    /// <summary>
    /// Counts the wall's cross-panel hold links that are actually in force right now, for the card
    /// that tells an editor the linking tool exists. Only worth asking for on a multi-panel wall an
    /// editor is looking at; a failure (or a viewer who cannot enumerate links) simply leaves the
    /// card reporting none.
    /// </summary>
    /// <remarks>
    /// <c>HoldLink</c> rows are wall-level facts between two hold rows and carry no generation, so
    /// the wall-wide row count keeps counting links whose endpoints belong to holds of a superseded
    /// generation. <see cref="PanelLinkTool"/> counts only links whose endpoints are holds of the
    /// panels' CURRENT generation, which is why the two disagreed after a wall update. Count what the
    /// tool counts: intersect the link rows with the live panels' live hold ids.
    /// </remarks>
    private async Task LoadHoldLinkCount()
    {
        _holdLinkCount = 0;
        if (_livePanels.Count < 2 || !_canEditHolds)
        {
            return;
        }

        try
        {
            var liveHoldIds = new HashSet<Guid>();
            foreach (var panel in _livePanels)
            {
                foreach (var hold in await LoadPanelHolds(panel.Id))
                {
                    liveHoldIds.Add(hold.Id);
                }
            }

            var links = await WallPanelService.GetHoldLinksAsync(WallId);
            _holdLinkCount = links.Count(l => liveHoldIds.Contains(l.HoldAId) && liveHoldIds.Contains(l.HoldBId));
        }
        catch (Exception)
        {
            _holdLinkCount = 0;
        }
    }

    private async Task<IReadOnlyList<PanelHold>> LoadPanelHolds(Guid panelId) =>
        await WallPanelService.GetPanelHoldsAsync(WallId, panelId, includeStaged: false);

    /// <summary>
    /// Loads the editable working set of full holds for the panel currently being edited on a big
    /// wall. Cloned like <c>_holds</c> is: the photo editor mutates hold coordinates in place while
    /// dragging, so handing it the cached read result would corrupt shared state.
    /// </summary>
    private async Task LoadEditingPanelHolds()
    {
        if (_editingPanel is null)
        {
            _editingPanelHolds = [];
            return;
        }

        var holds = await WallPanelService.GetPanelHoldEntitiesAsync(WallId, _editingPanel.Id);
        _editingPanelHolds = holds.Select(h => h.Clone()).ToList();
    }

    /// <summary>
    /// Selects a panel to edit on a big wall and reloads its holds. Used by the panel selector.
    /// </summary>
    private async Task SelectEditingPanel(WallPanelInfo panel)
    {
        _editingPanel = panel;
        await LoadEditingPanelHolds();
    }

    private async Task StepEditingPanel(int delta)
    {
        // Stepping panels reloads fresh holds, so any unsaved edits on the current panel are lost.
        // Guard behind an inline confirm banner (the app's convention) instead of switching silently.
        if (_panelEditor?.HasUnsavedChanges == true)
        {
            _pendingPanelStepDelta = delta;
            _confirmingPanelStep = true;
            return;
        }

        await DoStepEditingPanel(delta);
    }

    private async Task ConfirmPanelStep()
    {
        _confirmingPanelStep = false;
        await DoStepEditingPanel(_pendingPanelStepDelta);
    }

    private void CancelPanelStep()
    {
        _confirmingPanelStep = false;
    }

    private async Task DoStepEditingPanel(int delta)
    {
        if (_editingPanel is null || _livePanels.Count == 0)
        {
            return;
        }

        var idx = _livePanels.FindIndex(p => p.Id == _editingPanel.Id);
        if (idx < 0)
        {
            idx = 0;
        }

        var next = ((idx + delta) % _livePanels.Count + _livePanels.Count) % _livePanels.Count;
        await SelectEditingPanel(_livePanels[next]);
    }

    /// <summary>
    /// Batch-saves per-panel hold edits. Mirrors <see cref="OnBatchSave"/>, except added holds go
    /// through <c>AddPanelHoldAsync</c> so they stay parented to the edited panel; updates and
    /// deletes reuse the by-id wall APIs (which preserve <c>WallPanelId</c>).
    /// </summary>
    private async Task OnPanelBatchSave(WallPhotoEditor.BatchChanges changes)
    {
        if (_editingPanel is null)
        {
            return;
        }

        foreach (var hold in changes.Added)
        {
            var savedId = await WallPanelService.AddPanelHoldAsync(
                WallId, _editingPanel.Id, hold.X, hold.Y, hold.Radius, hold.Color, hold.Category, hold.ShapePoints, hold.Material, hold.HandType);
            var local = _editingPanelHolds.FirstOrDefault(h => h.Id == hold.Id);
            if (local != null)
            {
                local.Id = savedId;
            }
        }

        foreach (var hold in changes.Updated)
        {
            // Per-panel edit: a hold's position shifts by parallax between panel photos, so a move must
            // not auto-flag boulders. "Changed" is a manual per-hold decision here (Mark modified /
            // Mark unchanged), surfaced by the panel editor's change-review overlay.
            await WallService.UpdateHoldAsync(hold.Id, hold.X, hold.Y, hold.Radius, hold.Color, hold.Category, hold.IsOnKickboard, hold.ShapePoints, hold.Name, hold.Material, flagBouldersOnMove: false, handType: hold.HandType);
        }

        foreach (var holdId in changes.Deleted)
        {
            await WallService.DeleteHoldAsync(holdId);
        }

        await LoadEditingPanelHolds();
        await ShowToast($"Saved {changes.Added.Count + changes.Updated.Count + changes.Deleted.Count} changes");
    }

