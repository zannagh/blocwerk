@page "/tools/image-stitcher"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IJSRuntime JS
@inject IWallService WallService
@inject IImageAlignmentService ImageAlignment
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation

<PageTitle>Image Stitcher - Blocwerk</PageTitle>

<div class="stitcher-page">
    <div class="stitcher-toolbar">
        <label class="btn-secondary stitcher-upload">
            + Add images
            <InputFile OnChange="OnUpload" accept="image/*" multiple hidden />
        </label>
        <span class="option-hint">@_layers.Count image@(_layers.Count == 1 ? "" : "s")</span>
        <div class="stitcher-spacer"></div>
        @if (_layers.Count > 0)
        {
            <button class="btn-secondary" @onclick="ExportDownload" disabled="@_exporting">Export PNG</button>
            @if (_myWalls?.Count > 0)
            {
                <select class="filter-select" @bind="_targetWallId">
                    <option value="">Use on wall…</option>
                    @foreach (var w in _myWalls)
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                </select>
                <button class="btn-primary" @onclick="ExportToWall" disabled="@(_targetWallId == Guid.Empty || _exporting)">Stage</button>
            }
        }
    </div>

    @* Background pan/pinch/wheel are handled entirely in JS (wwwroot/js/viewport.js,
       transform model) so they never round-trip per pixel and work on touch. Blazor
       only handles the layer/corner drags, which need the C# geometry. *@
    <div class="stitcher-viewport" @ref="_viewportRef"
         @onmousemove="OnPointerMove"
         @onmouseup="OnPointerUp"
         @onmouseleave="OnPointerUp"
         @ontouchmove="OnTouchMove"
         @ontouchend="OnPointerUp"
         @ontouchcancel="OnPointerUp">

        <div class="stitcher-world" @ref="_worldRef">
            @foreach (var layer in _layers)
            {
                <img class="stitcher-layer @(layer.Id == _selectedId ? "selected" : "")" src="@layer.DataUrl"
                     draggable="false"
                     style="position:absolute; left:0; top:0; width:@Px(layer.Width); height:@Px(layer.Height); transform-origin:0 0; opacity:@N(layer.Opacity); transform:@StitcherMath.Matrix3d(layer.Width, layer.Height, layer.Corners);"
                     @onmousedown="(e) => StartLayerMove(e, layer)" @onmousedown:stopPropagation="true"
                     @onmousedown:preventDefault="true"
                     @ontouchstart="(e) => StartLayerMoveTouch(e, layer)" @ontouchstart:stopPropagation="true" />
            }
        </div>

        @if (_selectedId != null)
        {
            var sel = _layers.FirstOrDefault(l => l.Id == _selectedId);
            if (sel != null)
            {
                var s = sel.Corners.Select(ToScreen).ToArray();
                var (mcx, mcy) = ToScreen((sel.Corners.Average(c => c.X), sel.Corners.Average(c => c.Y)));
                <svg class="stitcher-overlay" width="100%" height="100%">
                    <polygon points="@string.Join(" ", s.Select(p => $"{N(p.X)},{N(p.Y)}"))"
                             fill="none" stroke="#4aa8ff" stroke-width="1.5" stroke-dasharray="5 4" style="pointer-events:none" />
                    @for (var i = 0; i < 4; i++)
                    {
                        var idx = i;
                        <circle cx="@N(s[idx].X)" cy="@N(s[idx].Y)" r="12" fill="#f5a623" stroke="#fff" stroke-width="2"
                                style="cursor:crosshair; pointer-events:all"
                                @onmousedown="(e) => StartCorner(e, idx)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true"
                                @ontouchstart="(e) => StartCornerTouch(e, idx)" @ontouchstart:stopPropagation="true">
                            <title>Drag to warp corner</title>
                        </circle>
                    }
                    <circle cx="@N(mcx)" cy="@N(mcy)" r="14" fill="rgba(255,215,0,0.9)" stroke="#000" stroke-width="2"
                            style="cursor:move; pointer-events:all"
                            @onmousedown="(e) => StartLayerMove(e, sel)" @onmousedown:stopPropagation="true" @onmousedown:preventDefault="true"
                            @ontouchstart="(e) => StartLayerMoveTouch(e, sel)" @ontouchstart:stopPropagation="true">
                        <title>Move</title>
                    </circle>
                </svg>
            }
        }

        <div class="stitcher-zoom" @onmousedown:stopPropagation="true">
            <button class="fab-btn" @onclick="ZoomIn" title="Zoom in">+</button>
            <button class="fab-btn" @onclick="ZoomOut" title="Zoom out">−</button>
            <button class="fab-btn" @onclick="FitToContent" title="Fit to content">⤢</button>
        </div>
    </div>

    @if (_selectedId != null)
    {
        var sel = _layers.FirstOrDefault(l => l.Id == _selectedId);
        if (sel != null)
        {
            <div class="stitcher-layer-controls">
                <label class="opacity-slider" title="Layer opacity (visual only; export ignores this)">
                    <span>Opacity</span>
                    <input type="range" min="10" max="100" step="5"
                           value="@((int)(sel.Opacity * 100))"
                           @oninput="OnOpacityChanged" />
                    <span class="opacity-value">@((int)(sel.Opacity * 100))%</span>
                    <button class="opt-btn" @onclick="ResetOpacity" title="Reset to 100%">↻</button>
                </label>
                <button class="opt-btn" @onclick="() => ResetCorners(sel)" title="Reset perspective to a plain rectangle">Reset shape</button>
                <div class="stitcher-spacer"></div>
                @if (_layers.Count > 1)
                {
                    <button class="opt-btn" @onclick="AutoAlign" disabled="@_aligning" title="Auto-align this image to the one beneath it">
                        @(_aligning ? "Aligning…" : "Auto-align")
                    </button>
                }
                <button class="opt-btn" @onclick="BringForward" title="Bring forward">▲</button>
                <button class="opt-btn" @onclick="SendBackward" title="Send backward">▼</button>
                <button class="opt-btn danger" @onclick="DeleteSelected">Delete</button>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(_toast))
    {
        <div class="toast-msg">@_toast</div>
    }
</div>
