@page "/guides"
@page "/tools"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@using Blocwerk.Web.Components.Shared

<PageTitle>Tools &amp; Guides - Blocwerk</PageTitle>

<WallCarousel InitialPage="0">
    <Page1>
        <div class="guides-page">
            <h1>Tools</h1>
            <div class="guide-sections">
                <div class="guide-section-card">
                    <h2>Image Stitcher</h2>
                    <div class="guide-tools">
                        <a href="/tools/image-stitcher" class="guide-tool-link">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="8" height="8" rx="1" />
                                <rect x="13" y="8" width="8" height="8" rx="1" />
                                <rect x="6" y="13" width="8" height="8" rx="1" />
                            </svg>
                            Stitch photos for a wall update
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </Page1>
    <Page2>
        <div class="guides-page">
            <h1>Guides</h1>

            <div class="guide-sections">
                <div class="guide-section-card">
                    <h2>Homewalls</h2>
                    <div class="guide-tools">
                        <a href="/guides/homewalls/volumes" class="guide-tool-link">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polygon points="12 2 22 22 2 22" />
                                <line x1="12" y1="2" x2="12" y2="22" stroke-dasharray="2 2" />
                            </svg>
                            Volume Calculator
                        </a>
                    </div>
                </div>

                <div class="guide-section-card coming-soon">
                    <h2>Training</h2>
                </div>

                <div class="guide-section-card coming-soon">
                    <h2>Shoes</h2>
                </div>

                <div class="guide-section-card coming-soon">
                    <h2>Equipment</h2>
                </div>
            </div>
        </div>
    </Page2>
</WallCarousel>
