@page "/guides/homewalls/angle-wedge"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@using Blocwerk.Core.Helpers
@using System.Globalization
@inject IJSRuntime JS

<PageTitle>Angle Change Wedge - Blocwerk</PageTitle>

<div class="volume-calc">
    <div class="page-header">
        <a href="/guides" class="back-link">&larr; Guides</a>
        <h1>Angle Change Wedge</h1>
        <p class="description">Design a wedge that changes your wall angle to a new face. Set your wall and resulting face angle (steeper or shallower), the face size and wood thickness, and optionally a lower portion on the opposite side of the wall &mdash; get the cutting plan with fold angles for every piece.</p>
        <div class="bw-anon-notice">This tool is in active development. Double-check all measurements and angles before cutting wood.</div>
    </div>

    <div class="volume-input">
        <div class="input-row">
            <div class="form-group">
                <label>Wall Angle (&deg;)</label>
                <input type="number" class="form-input" @bind="_wallAngle" min="1" max="179" step="1" />
            </div>
            <div class="form-group">
                <label>Resulting Face Angle (&deg;)</label>
                <input type="number" class="form-input" @bind="_targetAngle" min="1" max="179" step="1" />
                <span class="field-hint">Absolute from horizontal. May be steeper or shallower than the wall.</span>
            </div>
        </div>
        <div class="input-row">
            <div class="form-group">
                <label>Face Width (mm)</label>
                <input type="number" class="form-input" @bind="_faceWidth" min="1" step="1" />
            </div>
            <div class="form-group">
                <label>Face Height (mm)</label>
                <input type="number" class="form-input" @bind="_faceHeight" min="1" step="1" />
            </div>
        </div>
        <div class="input-row">
            <div class="form-group">
                <label>Wood Thickness (mm)</label>
                <input type="number" class="form-input" @bind="_thickness" min="1" step="1" />
            </div>
            <div class="form-group">
                <label class="wedge-check">
                    <input type="checkbox" @bind="_useLowerPortion" />
                    Lower portion
                </label>
            </div>
        </div>

        @if (_useLowerPortion)
        {
            <div class="input-row">
                <div class="form-group">
                    <label>Lower Portion Angle (&deg;)</label>
                    <input type="number" class="form-input" @bind="_lowerAngle" min="0" max="179" step="1" />
                    <span class="field-hint">Absolute from horizontal (0&deg; = horizontal). Must sit on the opposite side of the wall from the face; its length is worked out for you.</span>
                </div>
            </div>
        }

        <button class="btn-submit" @onclick="Calculate">Calculate</button>

        @if (_error != null)
        {
            <div class="error-msg">@_error</div>
        }
    </div>

    @if (_result != null)
    {
        <div class="volume-results">
            <div class="summary-grid">
                <div class="summary-item">
                    <span class="label">Angle Change</span>
                    <span class="value">@F(_result.AngleChangeDeg)<span class="unit">&deg;</span></span>
                </div>
                @if (_result.FaceToLowerFoldDeg != null)
                {
                    <div class="summary-item">
                        <span class="label">Face &rarr; Lower Fold</span>
                        <span class="value">@F(_result.FaceToLowerFoldDeg.Value)<span class="unit">&deg;</span></span>
                    </div>
                    <div class="summary-item">
                        <span class="label">Lower &rarr; Wall Fold</span>
                        <span class="value">@F(_result.LowerToWallFoldDeg!.Value)<span class="unit">&deg;</span></span>
                    </div>
                    <div class="summary-item">
                        <span class="label">Lower Portion Length</span>
                        <span class="value">@F(_result.LowerPortionLengthMm)<span class="unit"> mm</span></span>
                    </div>
                }
                else
                {
                    <div class="summary-item">
                        <span class="label">Base Length</span>
                        <span class="value">@F(_result.LowerPortionLengthMm)<span class="unit"> mm</span></span>
                    </div>
                }
                <div class="summary-item">
                    <span class="label">Tip from Wall</span>
                    <span class="value">@F(_result.DepthMm)<span class="unit"> mm</span></span>
                </div>
                <div class="summary-item">
                    <span class="label">Wall Footprint</span>
                    <span class="value">@F(_result.WallFootprintMm)<span class="unit"> mm</span></span>
                </div>
                <div class="summary-item">
                    <span class="label">Overall Width</span>
                    <span class="value">@F(_result.OverallWidthMm)<span class="unit"> mm</span></span>
                </div>
            </div>

            <div class="isometric-section">
                <h2>Cross Section (side view)</h2>
                <div class="isometric-container">
                    @RenderCrossSection()
                </div>
                <p class="description">Fold angles are the included angle between adjoining panels. For a panel seating flat against the wall, tilt your blade by the fold; for a joint between two boards, split it (fold &divide; 2 on each).</p>
            </div>

            <div class="piece-list">
                <div class="piece-list-header">
                    <h2>Cutting Plan (@_result.Pieces.Sum(p => p.Quantity) pieces)</h2>
                    <button class="btn-pdf" @onclick="DownloadPdf">&darr; Cutting plan PDF</button>
                </div>

                @foreach (var piece in _result.Pieces)
                {
                    <div class="piece-card">
                        <h3>@piece.Name @(piece.Quantity > 1 ? $"(x{piece.Quantity})" : string.Empty)</h3>
                        <div class="piece-details">
                            @for (var i = 0; i < piece.EdgeLengths.Length; i++)
                            {
                                <span class="piece-detail-chip">
                                    Edge @(i + 1): <strong>@F(piece.EdgeLengths[i]) mm</strong>
                                    &middot; @F(piece.EdgeBevelAngles[i])&deg;
                                </span>
                            }
                        </div>
                        <div class="piece-svg-container">
                            @RenderPieceSvg(piece)
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private double _wallAngle = 45;
    private double _targetAngle = 90;
    private double _faceWidth = 300;
    private double _faceHeight = 400;
    private double _thickness = 18;
    private bool _useLowerPortion;
    private double _lowerAngle = 30;
    private WedgeResult? _result;
    private string? _error;

    private void Calculate()
    {
        _error = null;
        _result = null;
        try
        {
            _result = WedgeCalculator.Calculate(
                _wallAngle,
                _targetAngle,
                _faceWidth,
                _faceHeight,
                _thickness,
                _useLowerPortion ? _lowerAngle : null);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DownloadPdf()
    {
        if (_result == null)
        {
            return;
        }

        const string title = "Angle Change Wedge";
        var pieces = CuttingPlan.FromWedge(_result, _thickness);
        var assembly = AssemblyModels.FromWedge(title, _result, _faceWidth);
        var bytes = CuttingPlanPdf.Build(title, assembly, pieces);

        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("blocwerkDownloadStream", "angle-wedge-cutting-plan.pdf", "application/pdf", streamRef);
    }

    private RenderFragment RenderPieceSvg(WedgePiece piece) => builder =>
    {
        var verts = piece.FlatVertices;
        if (verts.Length < 3) return;

        var minX = verts.Min(v => v.X);
        var maxX = verts.Max(v => v.X);
        var minY = verts.Min(v => v.Y);
        var maxY = verts.Max(v => v.Y);
        var pad = Math.Max(maxX - minX, maxY - minY) * 0.18;

        var vbX = minX - pad;
        var vbY = -(maxY + pad);
        var vbW = maxX - minX + 2 * pad;
        var vbH = maxY - minY + 2 * pad;

        var points = string.Join(" ", verts.Select(v => $"{F2(v.X)},{F2(-v.Y)}"));
        var fontSize = Math.Max(vbW, vbH) * 0.045;

        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "viewBox", $"{F2(vbX)} {F2(vbY)} {F2(vbW)} {F2(vbH)}");
        builder.AddAttribute(2, "width", "280");
        builder.AddAttribute(3, "height", "280");
        builder.AddAttribute(4, "xmlns", "http://www.w3.org/2000/svg");

        builder.OpenElement(5, "polygon");
        builder.AddAttribute(6, "points", points);
        builder.AddAttribute(7, "fill", "var(--bg-surface-alt, #f0f0f0)");
        builder.AddAttribute(8, "stroke", "var(--text-heading, #1a1a2e)");
        builder.AddAttribute(9, "stroke-width", F2(Math.Max(vbW, vbH) * 0.005));
        builder.CloseElement();

        for (var i = 0; i < verts.Length; i++)
        {
            var a = verts[i];
            var b = verts[(i + 1) % verts.Length];
            var mx = (a.X + b.X) / 2.0;
            var my = -(a.Y + b.Y) / 2.0;
            var dx = b.X - a.X;
            var dy = b.Y - a.Y;
            var len = Math.Sqrt(dx * dx + dy * dy);
            if (len == 0) continue;
            var nx = -dy / len * pad * 0.4;
            var ny = dx / len * pad * 0.4;

            builder.OpenElement(10, "text");
            builder.AddAttribute(11, "x", F2(mx + nx));
            builder.AddAttribute(12, "y", F2(my - ny));
            builder.AddAttribute(13, "text-anchor", "middle");
            builder.AddAttribute(14, "dominant-baseline", "middle");
            builder.AddAttribute(15, "font-size", F2(fontSize));
            builder.AddAttribute(16, "fill", "var(--accent, #e94560)");
            builder.AddAttribute(17, "font-weight", "600");
            builder.AddAttribute(18, "font-family", "sans-serif");
            builder.AddMarkupContent(19, $"{F(piece.EdgeLengths[i])}mm");
            builder.CloseElement();

            builder.OpenElement(20, "text");
            builder.AddAttribute(21, "x", F2(mx - nx));
            builder.AddAttribute(22, "y", F2(my + ny));
            builder.AddAttribute(23, "text-anchor", "middle");
            builder.AddAttribute(24, "dominant-baseline", "middle");
            builder.AddAttribute(25, "font-size", F2(fontSize * 0.8));
            builder.AddAttribute(26, "fill", "var(--text-secondary, #888)");
            builder.AddAttribute(27, "font-family", "sans-serif");
            builder.AddMarkupContent(28, $"{F(piece.EdgeBevelAngles[i])}&deg;");
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    // Side view drawn as you would look at the wall from the side: the wall angle is
    // an overhang measured from vertical (0° = vertical, larger = more overhung), so
    // the wall leans over the climber. The solid wall is hatched behind it and the
    // wedge is "stuck" to it. Drawing only — the cut geometry is orientation-free.
    private RenderFragment RenderCrossSection() => builder =>
    {
        if (_result == null) return;

        var cross = _result.CrossSection;
        if (cross.Length < 3) return;

        // Rotate the whole picture 90° left so the wall reads as an overhang.
        var wallRad = (_wallAngle - 90.0) * Math.PI / 180.0;
        var cos = Math.Cos(wallRad);
        var sin = Math.Sin(wallRad);
        Point2D Rot(Point2D p) => new(p.X * cos - p.Y * sin, p.X * sin + p.Y * cos);

        var rc = cross.Select(Rot).ToArray();
        var tip = rc[1];

        // Wall span (both attachment points sit on the wall-frame x-axis).
        var xsMin = Math.Min(0, cross.Min(p => p.X));
        var xsMax = Math.Max(0, cross.Max(p => p.X));
        var span = Math.Max(xsMax - xsMin, _result.DepthMm);
        var ext = span * 0.28;
        var bandDepth = span * 0.32;

        var wallLo = Rot(new Point2D(xsMin - ext, 0));
        var wallHi = Rot(new Point2D(xsMax + ext, 0));
        var bandC = Rot(new Point2D(xsMax + ext, -bandDepth));
        var bandD = Rot(new Point2D(xsMin - ext, -bandDepth));
        var foot = Rot(new Point2D(cross[1].X, 0));

        var all = rc.Concat(new[] { wallLo, wallHi, bandC, bandD, foot }).ToArray();
        var minX = all.Min(p => p.X);
        var maxX = all.Max(p => p.X);
        var minMy = all.Min(p => p.Y);
        var maxMy = all.Max(p => p.Y);
        var size = Math.Max(maxX - minX, maxMy - minMy);
        var pad = size * 0.14;

        var vbX = minX - pad;
        var vbY = -maxMy - pad;
        var vbW = (maxX - minX) + 2 * pad;
        var vbH = (maxMy - minMy) + 2 * pad;
        var sw = size * 0.006;
        var font = size * 0.05;
        var tile = size * 0.04;

        string Sx(Point2D p) => F2(p.X);
        string Sy(Point2D p) => F2(-p.Y);

        void Seg(Point2D a, Point2D b, string stroke, double width, string? dash)
        {
            builder.OpenElement(40, "line");
            builder.AddAttribute(41, "x1", Sx(a));
            builder.AddAttribute(42, "y1", Sy(a));
            builder.AddAttribute(43, "x2", Sx(b));
            builder.AddAttribute(44, "y2", Sy(b));
            builder.AddAttribute(45, "stroke", stroke);
            builder.AddAttribute(46, "stroke-width", F2(width));
            if (dash != null) builder.AddAttribute(47, "stroke-dasharray", dash);
            builder.CloseElement();
        }

        void Txt(Point2D at, string text, double sz, string fill, string weight)
        {
            builder.OpenElement(50, "text");
            builder.AddAttribute(51, "x", Sx(at));
            builder.AddAttribute(52, "y", Sy(at));
            builder.AddAttribute(53, "text-anchor", "middle");
            builder.AddAttribute(54, "dominant-baseline", "middle");
            builder.AddAttribute(55, "font-size", F2(sz));
            builder.AddAttribute(56, "fill", fill);
            builder.AddAttribute(57, "font-weight", weight);
            builder.AddAttribute(58, "font-family", "sans-serif");
            builder.AddMarkupContent(59, text);
            builder.CloseElement();
        }

        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "viewBox", $"{F2(vbX)} {F2(vbY)} {F2(vbW)} {F2(vbH)}");
        builder.AddAttribute(2, "width", "340");
        builder.AddAttribute(3, "height", "340");
        builder.AddAttribute(4, "xmlns", "http://www.w3.org/2000/svg");

        // Hatch pattern for the solid wall material.
        builder.OpenElement(5, "defs");
        builder.OpenElement(6, "pattern");
        builder.AddAttribute(7, "id", "wallHatch");
        builder.AddAttribute(8, "patternUnits", "userSpaceOnUse");
        builder.AddAttribute(9, "width", F2(tile));
        builder.AddAttribute(10, "height", F2(tile));
        builder.AddAttribute(11, "patternTransform", "rotate(45)");
        builder.OpenElement(12, "line");
        builder.AddAttribute(13, "x1", "0");
        builder.AddAttribute(14, "y1", "0");
        builder.AddAttribute(15, "x2", "0");
        builder.AddAttribute(16, "y2", F2(tile));
        builder.AddAttribute(17, "stroke", "var(--text-secondary, #888)");
        builder.AddAttribute(18, "stroke-width", F2(sw * 0.8));
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();

        // Solid wall material (hatched) behind the wall surface.
        builder.OpenElement(19, "polygon");
        builder.AddAttribute(20, "points", $"{Sx(wallLo)},{Sy(wallLo)} {Sx(wallHi)},{Sy(wallHi)} {Sx(bandC)},{Sy(bandC)} {Sx(bandD)},{Sy(bandD)}");
        builder.AddAttribute(21, "fill", "url(#wallHatch)");
        builder.CloseElement();

        Seg(wallLo, wallHi, "var(--text-heading, #1a1a2e)", sw * 2.2, null);

        // Wedge cross-section, stuck to the wall.
        builder.OpenElement(23, "polygon");
        builder.AddAttribute(24, "points", string.Join(" ", rc.Select(p => $"{Sx(p)},{Sy(p)}")));
        builder.AddAttribute(25, "fill", "rgba(233,69,96,0.15)");
        builder.AddAttribute(26, "stroke", "var(--text-heading, #1a1a2e)");
        builder.AddAttribute(27, "stroke-width", F2(sw * 1.4));
        builder.CloseElement();

        // Perpendicular "tip from wall" dimension.
        Seg(tip, foot, "var(--accent, #e94560)", sw, $"{F2(tile * 0.4)} {F2(tile * 0.25)}");
        var depthMid = new Point2D(((tip.X + foot.X) / 2.0) + cos * size * 0.11, ((tip.Y + foot.Y) / 2.0) + sin * size * 0.11);
        Txt(depthMid, $"Tip {F(_result.DepthMm)}mm", font * 0.9, "var(--accent, #e94560)", "700");

        // Edge length labels, pushed outward from the wedge centroid.
        var cx = rc.Average(p => p.X);
        var cy = rc.Average(p => p.Y);
        for (var i = 0; i < rc.Length; i++)
        {
            var a = rc[i];
            var b = rc[(i + 1) % rc.Length];
            var mid = new Point2D((a.X + b.X) / 2.0, (a.Y + b.Y) / 2.0);
            var ox = mid.X - cx;
            var oy = mid.Y - cy;
            var ol = Math.Sqrt(ox * ox + oy * oy);
            if (ol < 1e-6) ol = 1;
            var lp = new Point2D(mid.X + ox / ol * size * 0.08, mid.Y + oy / ol * size * 0.08);
            var label = i < _result.CrossSectionLabels.Length ? _result.CrossSectionLabels[i] : string.Empty;
            var edgeLen = i < _result.CrossSectionEdgeLengths.Length ? _result.CrossSectionEdgeLengths[i] : 0;
            Txt(lp, $"{label} {F(edgeLen)}mm", font, "var(--text-heading, #1a1a2e)", "600");
        }

        // Fold angle at each vertex, nudged toward the centroid.
        for (var i = 0; i < rc.Length; i++)
        {
            var v = rc[i];
            var ix = cx - v.X;
            var iy = cy - v.Y;
            var il = Math.Sqrt(ix * ix + iy * iy);
            if (il < 1e-6) il = 1;
            var ap = new Point2D(v.X + ix / il * size * 0.09, v.Y + iy / il * size * 0.09);
            var angle = i < _result.CrossSectionEdgeAngles.Length ? _result.CrossSectionEdgeAngles[i] : 0;
            Txt(ap, $"{F(angle)}&deg;", font * 0.85, "var(--accent, #e94560)", "700");
        }

        builder.CloseElement();
    };

    private static string F(double v) => v.ToString("F1", CultureInfo.InvariantCulture);

    private static string F2(double v) => v.ToString("F2", CultureInfo.InvariantCulture);
}
