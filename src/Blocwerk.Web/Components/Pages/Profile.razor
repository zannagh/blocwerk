@page "/profile"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ICurrentUserService CurrentUserService
@inject IProgressionService ProgressionService
@inject ITopLoggerService TopLogger
@using Blocwerk.Core.Services.TopLogger

<PageTitle>Profile - Blocwerk</PageTitle>

<div class="profile-page">
    @if (_user == null)
    {
        <p class="loading">Loading...</p>
    }
    else
    {
        <div class="profile-card">
            <div class="avatar">@_user.DisplayName.FirstOrDefault()</div>
            <h1>@_user.DisplayName</h1>
            <span class="role-badge">@_user.Role</span>
            <p class="member-since">Member since @_user.CreatedAt.ToString("MMMM yyyy")</p>
        </div>

        @if (_progression != null)
        {
            <div class="score-cards">
                <div class="score-card">
                    <span class="score-label">Boulder</span>
                    <span class="score-value">@_progression.BoulderScore.ToString("F0")</span>
                    @if (_progression.BoulderGrade != null)
                    {
                        <span class="score-grade">~@_progression.BoulderGrade</span>
                    }
                </div>
                <div class="score-card">
                    <span class="score-label">Training</span>
                    <span class="score-value">@_progression.TrainingScore.ToString("F0")</span>
                </div>
            </div>

            @if (BoulderScores() is { Count: > 1 } boulderScores)
            {
                <div class="chart-section">
                    <h2>Boulder Progression</h2>
                    <div class="chart-box">
                        <svg viewBox="0 0 @boulderScores.Count 100" class="chart-svg" preserveAspectRatio="none">
                            <polyline points="@ChartPoints(boulderScores)"
                                      fill="none" stroke="#e94560" stroke-width="1.5" />
                        </svg>
                    </div>
                </div>
            }

            @if (TrainingScores() is { Count: > 1 } trainingScores)
            {
                <div class="chart-section">
                    <h2>Training Progression</h2>
                    <div class="chart-box">
                        <svg viewBox="0 0 @trainingScores.Count 100" class="chart-svg" preserveAspectRatio="none">
                            <polyline points="@ChartPoints(trainingScores)"
                                      fill="none" stroke="#0f3460" stroke-width="1.5" />
                        </svg>
                    </div>
                </div>
            }

            <p class="activity-hint">
                <a href="/activity">Activity</a> has detailed progression with configurable time windows.
            </p>
        }

        <div class="section tl-card">
            <h2>TopLogger</h2>
            @if (_tlStatus is null)
            {
                <p class="loading">Loading…</p>
            }
            else if (!_tlStatus.Enabled)
            {
                <p class="tl-hint">TopLogger import isn't enabled on this server.</p>
            }
            else if (_tlStatus.Connected)
            {
                <p class="tl-connected">Connected as <strong>@_tlStatus.Email</strong></p>
                <p class="tl-meta">
                    @_tlStatus.AscentCount ascents imported@(_tlStatus.LastSyncAt is { } ls ? $" · last sync {ls.LocalDateTime:dd MMM HH:mm}" : "")
                </p>
                @if (!string.IsNullOrEmpty(_tlStatus.LastError))
                {
                    <p class="tl-error">@_tlStatus.LastError</p>
                }
                <div class="tl-actions">
                    <button class="btn-primary" @onclick="SyncNow" disabled="@_tlBusy">Sync now</button>
                    <button class="btn-secondary" @onclick="Disconnect" disabled="@_tlBusy">Disconnect</button>
                </div>
            }
            else
            {
                <p class="tl-hint">Import your TopLogger sessions & ascents into your activities and rating.</p>
                <div class="tl-form">
                    <input type="email" @bind="_tlEmail" placeholder="TopLogger email" class="tl-input" autocomplete="off" />
                    <input type="password" @bind="_tlPassword" placeholder="TopLogger password" class="tl-input" autocomplete="off" />
                    <button class="btn-primary" @onclick="Connect"
                            disabled="@(_tlBusy || string.IsNullOrWhiteSpace(_tlEmail) || string.IsNullOrWhiteSpace(_tlPassword))">
                        Connect
                    </button>
                </div>
                <p class="tl-fineprint">We store only an encrypted access token — never your password.</p>
            }
            @if (!string.IsNullOrEmpty(_tlMessage))
            {
                <p class="tl-message">@_tlMessage</p>
            }
        </div>
    }
</div>

@code {
    private User? _user;
    private UserProgression? _progression;

    private TopLoggerStatus? _tlStatus;
    private string _tlEmail = string.Empty;
    private string _tlPassword = string.Empty;
    private bool _tlBusy;
    private string? _tlMessage;

    protected override async Task OnInitializedAsync()
    {
        _user = await CurrentUserService.GetCurrentUserAsync();
        _progression = await ProgressionService.GetProgressionAsync();
        _tlStatus = await TopLogger.GetStatusAsync();
    }

    private async Task Connect()
    {
        _tlBusy = true;
        _tlMessage = null;
        try
        {
            var result = await TopLogger.ConnectAsync(_tlEmail.Trim(), _tlPassword);
            _tlPassword = string.Empty;
            _tlMessage = result.Success
                ? (result.Error ?? $"Connected — imported {result.Imported} ascents.")
                : result.Error;
            _tlStatus = await TopLogger.GetStatusAsync();
        }
        finally
        {
            _tlBusy = false;
        }
    }

    private async Task SyncNow()
    {
        _tlBusy = true;
        _tlMessage = null;
        try
        {
            var result = await TopLogger.SyncNowAsync();
            _tlMessage = result.Success ? $"Imported {result.Imported} new ascents." : result.Error;
            _tlStatus = await TopLogger.GetStatusAsync();
        }
        finally
        {
            _tlBusy = false;
        }
    }

    private async Task Disconnect()
    {
        _tlBusy = true;
        _tlMessage = null;
        try
        {
            await TopLogger.DisconnectAsync(deleteImportedAscents: false);
            _tlStatus = await TopLogger.GetStatusAsync();
            _tlMessage = "Disconnected. Imported ascents were kept.";
        }
        finally
        {
            _tlBusy = false;
        }
    }

    private List<double> BoulderScores() =>
        _progression!.Buckets.Where(b => b.BoulderScore.HasValue).Select(b => b.BoulderScore!.Value).ToList();

    private List<double> TrainingScores() =>
        _progression!.Buckets.Where(b => b.TrainingScore.HasValue).Select(b => b.TrainingScore!.Value).ToList();

    private static string ChartPoints(List<double> values)
    {
        var max = values.Count > 0 ? values.Max() : 0;
        if (max <= 0) return "";
        return string.Join(" ", values.Select((v, i) =>
            $"{i},{(100 - v / max * 100):F1}"));
    }
}

