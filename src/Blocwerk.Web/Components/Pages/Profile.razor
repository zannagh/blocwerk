@page "/profile"
@page "/profile/{UserId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ICurrentUserService CurrentUserService
@inject IProgressionService ProgressionService
@inject IWallService WallService
@inject Blocwerk.Core.Configuration.BlocwerkSettings Settings
@inject NavigationManager Navigation
@using Blocwerk.Core.Helpers

<PageTitle>Profile - Blocwerk</PageTitle>

<div class="profile-page">
    @if (_loading)
    {
        <p class="loading">Loading...</p>
    }
    else if (!_available || _target == null)
    {
        <div class="profile-card">
            <h1>Profile unavailable</h1>
            <p class="member-since">This profile isn't available.</p>
        </div>
    }
    else
    {
        <div class="profile-card">
            <UserAvatar UserId="_target.Id" Name="_target.Name" HasAvatar="_target.HasAvatar" />
            <h1>@_target.Name</h1>
            <span class="role-badge">@_target.Role</span>
            <p class="member-since">Member since <LocalTime Value="@_target.CreatedAt" Format="LocalTimeFormat.MonthYear" /></p>
        </div>

        @if (_isSelf)
        {
            <div class="section">
                <h2>Profile</h2>

                <div class="field-group">
                    <label class="field-label" for="display-name">Display name</label>
                    <input id="display-name" class="text-input" maxlength="256" @bind="_nameInput" @bind:event="oninput" />
                    <div class="field-actions">
                        <button class="btn-primary" @onclick="SaveDisplayNameAsync" disabled="@_savingName">Save</button>
                        @if (!string.IsNullOrWhiteSpace(_target.CustomDisplayName))
                        {
                            <button class="btn-secondary" @onclick="ResetDisplayNameAsync" disabled="@_savingName">Reset to @_target.DisplayName</button>
                        }
                    </div>
                    <p class="member-since">Leave empty to use your account name (@_target.DisplayName).</p>
                    @if (_nameError != null)
                    {
                        <p class="field-error">@_nameError</p>
                    }
                </div>

                <div class="field-group">
                    <label class="field-label">Profile picture</label>
                    <div class="field-actions">
                        <InputFile OnChange="OnAvatarSelectedAsync" accept="image/*" disabled="@_savingAvatar" />
                        @if (_target.HasAvatar)
                        {
                            <button class="btn-secondary" @onclick="RemoveAvatarAsync" disabled="@_savingAvatar">Remove photo</button>
                        }
                    </div>
                    <p class="member-since">JPEG, PNG or WebP, up to 4 MB.</p>
                    @if (_avatarError != null)
                    {
                        <p class="field-error">@_avatarError</p>
                    }
                </div>
            </div>

            <div class="section">
                <h2>Password sign-in</h2>
                @if (_target.HasPassword)
                {
                    <p class="member-since">
                        A password is set for username <strong>@_target.LoginUsername</strong>.
                        You can sign in without a provider. Enter a new username and password below to change it.
                    </p>
                }
                else
                {
                    <p class="member-since">
                        Set a username and password to sign in without an OAuth provider. This never
                        replaces your linked accounts — it's an additional way in.
                    </p>
                }

                <div class="field-group">
                    <label class="field-label" for="login-username">Username</label>
                    <input id="login-username" class="text-input" maxlength="64" autocomplete="off"
                           @bind="_pwUsername" @bind:event="oninput" />

                    @if (_target.HasPassword)
                    {
                        <label class="field-label" for="login-current-password">Current password</label>
                        <input id="login-current-password" class="text-input" type="password" autocomplete="current-password"
                               @bind="_pwCurrent" @bind:event="oninput" />
                    }

                    <label class="field-label" for="login-password">Password</label>
                    <input id="login-password" class="text-input" type="password" autocomplete="new-password"
                           @bind="_pwPassword" @bind:event="oninput" />

                    <label class="field-label" for="login-password-confirm">Confirm password</label>
                    <input id="login-password-confirm" class="text-input" type="password" autocomplete="new-password"
                           @bind="_pwConfirm" @bind:event="oninput" />

                    <div class="field-actions">
                        <button class="btn-primary" @onclick="SavePasswordAsync" disabled="@_savingPassword">
                            @(_target.HasPassword ? "Change password" : "Set password")
                        </button>
                    </div>
                    <p class="member-since">Username 3–64 characters (letters, digits, dot, underscore, hyphen); password at least 8 characters.</p>
                    @if (_passwordError != null)
                    {
                        <p class="field-error">@_passwordError</p>
                    }
                    @if (_passwordSuccess)
                    {
                        <p class="field-label">Password saved.</p>
                    }
                </div>
            </div>

            @if (_target.HasPassword)
            {
                <div class="section">
                    <h2>Two-factor authentication</h2>
                    @if (_target.HasTotp)
                    {
                        <p class="member-since">
                            Two-factor authentication is <strong>on</strong>. It is required <strong>only when
                            you sign in with your username &amp; password</strong> — signing in through a linked
                            OAuth provider is not affected. Enter a current code to turn it off.
                        </p>
                        <div class="field-group">
                            <label class="field-label" for="totp-disable">6-digit code</label>
                            <input id="totp-disable" class="text-input" inputmode="numeric" maxlength="8"
                                   autocomplete="one-time-code" @bind="_totpCode" @bind:event="oninput" />
                            <div class="field-actions">
                                <button class="btn-secondary" @onclick="DisableTotpAsync" disabled="@_totpBusy">Disable 2FA</button>
                            </div>
                        </div>
                        @if (_totpError != null)
                        {
                            <p class="field-error">@_totpError</p>
                        }
                    }
                    else if (_totpEnrollment != null)
                    {
                        <p class="member-since">
                            Scan this QR code with your authenticator app (or enter the secret manually),
                            then enter a code below to finish enabling 2FA.
                        </p>
                        <img class="totp-qr" width="220" height="220" alt="TOTP QR code"
                             src="data:image/png;base64,@Convert.ToBase64String(_totpEnrollment.QrPng)" />
                        <p class="member-since">Secret: <code>@_totpEnrollment.Secret</code></p>

                        <div class="field-group">
                            <label class="field-label" for="totp-confirm">6-digit code</label>
                            <input id="totp-confirm" class="text-input" inputmode="numeric" maxlength="8"
                                   autocomplete="one-time-code" @bind="_totpCode" @bind:event="oninput" />
                            <div class="field-actions">
                                <button class="btn-primary" @onclick="ConfirmTotpAsync" disabled="@_totpBusy">Confirm &amp; enable</button>
                                <button class="btn-secondary" @onclick="CancelTotpEnrollment" disabled="@_totpBusy">Cancel</button>
                            </div>
                            @if (_totpError != null)
                            {
                                <p class="field-error">@_totpError</p>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="member-since">
                            Add a second factor: after your password, sign-in will ask for a rotating
                            6-digit code from an authenticator app (Google Authenticator, Aegis, 1Password…).
                        </p>
                        <div class="field-actions">
                            <button class="btn-primary" @onclick="EnableTotpAsync" disabled="@_totpBusy">Enable 2FA</button>
                        </div>
                        @if (_totpError != null)
                        {
                            <p class="field-error">@_totpError</p>
                        }
                    }
                </div>
            }

            <div class="profile-links">
                <a href="/settings/api-keys">API keys</a>
            </div>

            @if (_allProviders.Count > 0)
            {
                <div class="section">
                    <h2>Linked accounts</h2>
                    @if (_linkMessage != null)
                    {
                        <p class="field-label">@_linkMessage</p>
                    }
                    <p class="member-since">Sign in with any linked provider to reach this account. Linking a provider that already belongs to another account merges that account into this one.</p>
                    <div class="field-group">
                        @foreach (var provider in _allProviders)
                        {
                            <div class="field-actions">
                                <span class="field-label">@provider.Label</span>
                                @if (_linkedProviders.Contains(provider.Key))
                                {
                                    <span class="role-badge">Linked</span>
                                }
                                else
                                {
                                    <button class="btn-secondary" @onclick="() => StartLink(provider.Key)">Link @provider.Label</button>
                                }
                            </div>
                        }
                    </div>
                    <p class="member-since">Unlinking a provider isn't supported yet.</p>
                </div>
            }

            <div class="section">
                <div class="progression-header">
                    <h2>Home wall</h2>
                    <div class="window-control">
                        <select class="window-select" value="@_viewer?.HomeWallId" @onchange="OnHomeWallChange">
                            <option value="">None</option>
                            @foreach (var wall in _myWalls)
                            {
                                <option value="@wall.Id">@wall.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <p class="member-since">Adds a Home shortcut to the bottom bar that jumps to this wall.</p>
                @if (_homeWallError != null)
                {
                    <p class="field-error">@_homeWallError</p>
                }
            </div>
        }

        @if (_progression != null)
        {
            <div class="section">
                <div class="progression-header">
                    <h2>Progression</h2>
                    <div class="window-control">
                        <select class="window-select" value="@_progression.WindowDays" @onchange="OnWindowChange">
                            <option value="14">14 days</option>
                            <option value="30">30 days</option>
                            <option value="60">60 days</option>
                            <option value="90">90 days</option>
                            <option value="180">180 days</option>
                            <option value="365">1 year</option>
                        </select>
                        <select class="window-select" value="@((int)_progression.GroupBy)" @onchange="OnGroupByChange">
                            <option value="0">Day</option>
                            <option value="1">Week</option>
                            <option value="2">Month</option>
                        </select>
                    </div>
                </div>

                <div class="score-cards">
                    <div class="score-card">
                        <span class="score-label">Boulder</span>
                        <span class="score-value">@_progression.BoulderScore.ToString("F0")</span>
                        @if (_progression.BoulderGrade != null)
                        {
                            <span class="score-grade">~@_progression.BoulderGrade</span>
                        }
                    </div>
                    <div class="score-card">
                        <span class="score-label">Training</span>
                        <span class="score-value">@_progression.TrainingScore.ToString("F0")</span>
                    </div>
                </div>

                @{ var bScale = BoulderScale(); }
                <ProgressionChart Title="Boulder progression" Caption="rolling 60-day rating · drag axis to zoom" Stroke="#e94560"
                                  Points="BoulderPoints()" YTicks="bScale.Ticks" YMin="bScale.Min" YMax="bScale.Max"
                                  ShowTrendline="true" OnYScaleStep="OnBoulderYScale"
                                  EmptyText="No sends in this window yet." />

                <ProgressionChart Title="Training progression" Stroke="#0f3460"
                                  Points="TrainingPoints()" YTicks="TrainingYTicks()"
                                  EmptyText="No training logged in this window yet." />
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "link")]
    public string? LinkResult { get; set; }

    private IReadOnlyList<string> _linkedProviders = [];
    private List<(string Key, string Label)> _allProviders = [];
    private string? _linkMessage;

    private User? _viewer;
    private User? _target;
    private UserProgression? _progression;
    private bool _isSelf;
    private bool _available = true;
    private bool _loading = true;
    private Guid? _loadedFor;
    private int _boulderGradeSpan = 5;
    private List<Wall> _myWalls = [];
    private string? _homeWallError;

    private const long MaxAvatarBytes = 4L * 1024 * 1024;
    private string _nameInput = string.Empty;
    private bool _savingName;
    private string? _nameError;
    private bool _savingAvatar;
    private string? _avatarError;

    private string _pwUsername = string.Empty;
    private string _pwCurrent = string.Empty;
    private string _pwPassword = string.Empty;
    private string _pwConfirm = string.Empty;
    private bool _savingPassword;
    private string? _passwordError;
    private bool _passwordSuccess;

    private TotpEnrollment? _totpEnrollment;
    private string _totpCode = string.Empty;
    private bool _totpBusy;
    private string? _totpError;

    // Window/grouping for the other-user view is kept locally: it must not persist onto the viewer's
    // own settings, nor onto the target's. Self view reuses the persisted per-user settings.
    private int _otherWindowDays = 90;
    private ProgressionGroupBy _otherGroupBy = ProgressionGroupBy.Week;

    protected override async Task OnParametersSetAsync()
    {
        // The same component instance is reused when navigating between profiles, so reload only when
        // the target actually changes.
        if (!_loading && _loadedFor == UserId)
        {
            return;
        }

        _loadedFor = UserId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _available = true;
        _target = null;
        _progression = null;

        _viewer = await CurrentUserService.GetCurrentUserAsync();

        if (UserId == null || UserId == _viewer.Id)
        {
            _isSelf = true;
            _target = _viewer;
            _nameInput = _viewer.CustomDisplayName ?? string.Empty;
            _progression = await ProgressionService.GetProgressionAsync();
            _myWalls = await WallService.GetMyWallsAsync();
            _linkedProviders = await CurrentUserService.GetLinkedProvidersAsync();
            _allProviders = EnabledProviders();
            _linkMessage = LinkResultMessage(LinkResult);
        }
        else
        {
            _isSelf = false;
            var target = await CurrentUserService.GetUserByIdAsync(UserId.Value);
            if (target == null || !await WallService.UsersShareAWallAsync(_viewer.Id, UserId.Value))
            {
                _available = false;
            }
            else
            {
                _target = target;
                _progression = await ProgressionService.GetProgressionForUserAsync(target.Id, _otherWindowDays, _otherGroupBy);
            }
        }

        _loading = false;
    }

    // Enabled providers, in a stable display order, for the linked-accounts list.
    private List<(string Key, string Label)> EnabledProviders()
    {
        var providers = new List<(string, string)>();
        if (Settings.GitHubOAuth.Enabled)
        {
            providers.Add(("github", "GitHub"));
        }

        if (Settings.GoogleOAuth.Enabled)
        {
            providers.Add(("google", "Google"));
        }

        if (Settings.MicrosoftOAuth.Enabled)
        {
            providers.Add(("microsoft", "Microsoft"));
        }

        return providers;
    }

    private static string? LinkResultMessage(string? result) => result switch
    {
        "linked" => "Account linked.",
        "merged" => "Accounts merged — the other account was absorbed into this one.",
        "already" => "That account is already linked to this profile.",
        "error" => "Couldn't link that account. Please try again.",
        "unavailable" => "That provider isn't available.",
        _ => null,
    };

    private void StartLink(string provider)
    {
        // Full navigation (not enhanced): /account/link 302s to a cross-origin OAuth provider, which
        // Blazor's fetch-based enhanced navigation cannot follow.
        Navigation.NavigateTo($"/account/link?provider={Uri.EscapeDataString(provider)}", forceLoad: true);
    }

    private async Task OnWindowChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var days))
        {
            return;
        }

        if (_isSelf)
        {
            await ProgressionService.UpdateProgressionWindowAsync(days);
            _progression = await ProgressionService.GetProgressionAsync();
        }
        else if (_target != null)
        {
            _otherWindowDays = days;
            _progression = await ProgressionService.GetProgressionForUserAsync(_target.Id, _otherWindowDays, _otherGroupBy);
        }
    }

    private async Task OnGroupByChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value) || !Enum.IsDefined(typeof(ProgressionGroupBy), value))
        {
            return;
        }

        if (_isSelf)
        {
            await ProgressionService.UpdateProgressionGroupingAsync((ProgressionGroupBy)value);
            _progression = await ProgressionService.GetProgressionAsync();
        }
        else if (_target != null)
        {
            _otherGroupBy = (ProgressionGroupBy)value;
            _progression = await ProgressionService.GetProgressionForUserAsync(_target.Id, _otherWindowDays, _otherGroupBy);
        }
    }

    private async Task OnHomeWallChange(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        Guid? selected = null;
        if (!string.IsNullOrEmpty(raw))
        {
            if (!Guid.TryParse(raw, out var wallId))
            {
                return;
            }

            selected = wallId;
        }

        try
        {
            await CurrentUserService.SetHomeWallAsync(selected);
            _homeWallError = null;
            if (_viewer != null)
            {
                _viewer.HomeWallId = selected;
            }
        }
        catch (Exception)
        {
            _homeWallError = "Couldn't update your main wall. Please try again.";
        }
    }

    private async Task SaveDisplayNameAsync()
    {
        _savingName = true;
        _nameError = null;
        try
        {
            await CurrentUserService.SetDisplayNameAsync(_nameInput);
            CurrentUserService.InvalidateCache();
            await ReloadSelfAsync();
        }
        catch (Exception)
        {
            _nameError = "Couldn't update your display name. Please try again.";
        }
        finally
        {
            _savingName = false;
        }
    }

    private async Task ResetDisplayNameAsync()
    {
        _nameInput = string.Empty;
        await SaveDisplayNameAsync();
    }

    private async Task OnAvatarSelectedAsync(InputFileChangeEventArgs e)
    {
        _savingAvatar = true;
        _avatarError = null;
        try
        {
            var file = e.File;
            if (file.Size > MaxAvatarBytes)
            {
                _avatarError = "That image is too large (max 4 MB).";
                return;
            }

            using var stream = file.OpenReadStream(MaxAvatarBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);

            await CurrentUserService.SetAvatarAsync(memory.ToArray(), file.ContentType);
            CurrentUserService.InvalidateCache();
            await ReloadSelfAsync();
        }
        catch (InvalidOperationException ex)
        {
            _avatarError = ex.Message;
        }
        catch (Exception)
        {
            _avatarError = "Couldn't update your photo. Please try again.";
        }
        finally
        {
            _savingAvatar = false;
        }
    }

    private async Task RemoveAvatarAsync()
    {
        _savingAvatar = true;
        _avatarError = null;
        try
        {
            await CurrentUserService.SetAvatarAsync(null, null);
            CurrentUserService.InvalidateCache();
            await ReloadSelfAsync();
        }
        catch (Exception)
        {
            _avatarError = "Couldn't remove your photo. Please try again.";
        }
        finally
        {
            _savingAvatar = false;
        }
    }

    private async Task SavePasswordAsync()
    {
        _savingPassword = true;
        _passwordError = null;
        _passwordSuccess = false;
        try
        {
            if (_pwPassword.Length < 8)
            {
                _passwordError = "Password must be at least 8 characters.";
                return;
            }

            if (_pwPassword != _pwConfirm)
            {
                _passwordError = "The passwords don't match.";
                return;
            }

            // Server-side validation (username format, case-insensitive uniqueness, and — when a password
            // already exists — the current-password step-up check) runs in the service and surfaces here
            // as InvalidOperationException. currentPassword is ignored for a first-time set.
            var currentPassword = _target?.HasPassword == true ? _pwCurrent : null;
            await CurrentUserService.SetPasswordAsync(_pwUsername, _pwPassword, currentPassword);
            CurrentUserService.InvalidateCache();
            await ReloadSelfAsync();

            _pwCurrent = string.Empty;
            _pwPassword = string.Empty;
            _pwConfirm = string.Empty;
            _passwordSuccess = true;
        }
        catch (InvalidOperationException ex)
        {
            _passwordError = ex.Message;
        }
        catch (Exception)
        {
            _passwordError = "Couldn't save your password. Please try again.";
        }
        finally
        {
            _savingPassword = false;
        }
    }

    private async Task EnableTotpAsync()
    {
        _totpBusy = true;
        _totpError = null;
        try
        {
            _totpEnrollment = await CurrentUserService.BeginTotpEnrollmentAsync();
            _totpCode = string.Empty;
        }
        catch (InvalidOperationException ex)
        {
            _totpError = ex.Message;
        }
        catch (Exception)
        {
            _totpError = "Couldn't start two-factor setup. Please try again.";
        }
        finally
        {
            _totpBusy = false;
        }
    }

    private async Task ConfirmTotpAsync()
    {
        _totpBusy = true;
        _totpError = null;
        try
        {
            var ok = await CurrentUserService.ConfirmTotpAsync(_totpCode);
            if (ok)
            {
                _totpEnrollment = null;
                _totpCode = string.Empty;
                CurrentUserService.InvalidateCache();
                await ReloadSelfAsync();
            }
            else
            {
                _totpError = "That code didn't match. Check your app's time and try again.";
            }
        }
        catch (Exception)
        {
            _totpError = "Couldn't verify that code. Please try again.";
        }
        finally
        {
            _totpBusy = false;
        }
    }

    private void CancelTotpEnrollment()
    {
        _totpEnrollment = null;
        _totpCode = string.Empty;
        _totpError = null;
    }

    private async Task DisableTotpAsync()
    {
        _totpBusy = true;
        _totpError = null;
        try
        {
            // Step-up: a current authenticator code is required to disable 2FA.
            var ok = await CurrentUserService.DisableTotpAsync(_totpCode);
            if (ok)
            {
                _totpEnrollment = null;
                _totpCode = string.Empty;
                CurrentUserService.InvalidateCache();
                await ReloadSelfAsync();
            }
            else
            {
                _totpError = "That code didn't match. Check your app's time and try again.";
            }
        }
        catch (Exception)
        {
            _totpError = "Couldn't disable two-factor. Please try again.";
        }
        finally
        {
            _totpBusy = false;
        }
    }

    private async Task ReloadSelfAsync()
    {
        _viewer = await CurrentUserService.GetCurrentUserAsync();
        _target = _viewer;
        _nameInput = _viewer.CustomDisplayName ?? string.Empty;
    }

    // ---- chart data builders (mirrors Activity's progression charts) ----

    private List<ChartSeriesPoint> BoulderPoints() => _progression!.Buckets.Select(b =>
        new ChartSeriesPoint(
            b.BoulderScore,
            b.BoulderScore.HasValue ? $"{Range(b)} — {b.BoulderScore.Value:F0} / {b.BoulderGrade}" : $"{Range(b)} — no sends",
            b.Label)).ToList();

    private List<ChartSeriesPoint> TrainingPoints() => _progression!.Buckets.Select(b =>
        new ChartSeriesPoint(
            b.TrainingScore,
            b.TrainingScore.HasValue ? $"{Range(b)} — {b.TrainingScore.Value:F0}" : $"{Range(b)} — no training",
            b.Label)).ToList();

    // The boulder Y scale shows at least _boulderGradeSpan grades centred on the current rating (so
    // "6C" sits amid 6B..7A rather than filling the axis), always keeping the data in view. Dragging
    // the axis changes the span.
    private (double Min, double Max, List<(double, string)> Ticks) BoulderScale()
    {
        var sorted = GradeScoring.AllScores.OrderBy(kv => kv.Value).ToList();
        if (sorted.Count == 0 || _progression == null)
        {
            return (0, 1, []);
        }

        var vals = _progression.Buckets.Where(b => b.BoulderScore.HasValue).Select(b => b.BoulderScore!.Value).ToList();
        var center = _progression.BoulderScore > 0
            ? _progression.BoulderScore
            : (vals.Count > 0 ? vals.Average() : sorted[sorted.Count / 2].Value);

        var nearest = 0;
        var best = double.MaxValue;
        for (var i = 0; i < sorted.Count; i++)
        {
            var d = Math.Abs(sorted[i].Value - center);
            if (d < best)
            {
                best = d;
                nearest = i;
            }
        }

        var span = Math.Clamp(_boulderGradeSpan, 3, sorted.Count);
        var lo = Math.Clamp(nearest - (span / 2), 0, Math.Max(0, sorted.Count - span));
        var hi = Math.Min(sorted.Count - 1, lo + span - 1);

        double min = sorted[lo].Value;
        double max = sorted[hi].Value;
        if (vals.Count > 0)
        {
            min = Math.Min(min, vals.Min());
            max = Math.Max(max, vals.Max());
        }

        var pad = (max - min) * 0.08;
        if (pad <= 0)
        {
            pad = 100;
        }

        min -= pad;
        max += pad;

        var ticks = sorted.Where(kv => kv.Value >= min && kv.Value <= max)
            .Select(kv => ((double)kv.Value, kv.Key)).ToList();
        return (min, max, ticks);
    }

    private void OnBoulderYScale(int direction)
    {
        // Drag down (+1) widens the range → more grades; drag up (-1) narrows it.
        _boulderGradeSpan = Math.Clamp(_boulderGradeSpan + direction, 3, 12);
    }

    private List<(double, string)> TrainingYTicks() => NumericYTicks(TrainingPoints(), v => v.ToString("F0"));

    private static List<(double, string)> NumericYTicks(List<ChartSeriesPoint> points, Func<double, string> format)
    {
        var vals = points.Where(p => p.Value.HasValue).Select(p => p.Value!.Value).ToList();
        if (vals.Count == 0)
        {
            return [];
        }

        double hi = vals.Max();
        double lo = Math.Min(0, vals.Min());
        if (hi <= lo)
        {
            hi = lo + 1;
        }

        return [(lo, format(lo)), ((lo + hi) / 2, format((lo + hi) / 2)), (hi, format(hi))];
    }

    private string Range(ProgressionBucket b) => _progression!.GroupBy switch
    {
        ProgressionGroupBy.Day => b.Start.ToString("dd.MM.yyyy"),
        ProgressionGroupBy.Month => b.Start.ToString("MMM yyyy"),
        _ => $"{b.Start.ToString("dd.MM")}–{b.End.ToString("dd.MM.yyyy")}",
    };
}
