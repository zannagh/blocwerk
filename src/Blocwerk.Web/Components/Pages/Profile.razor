@page "/profile"
@page "/profile/{UserId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ICurrentUserService CurrentUserService
@inject IWallService WallService
@inject Blocwerk.Core.Configuration.BlocwerkSettings Settings
@inject NavigationManager Navigation
@inject Blocwerk.Core.Abstractions.IKioskContext KioskContext
@using Blocwerk.Web.Components.Shared.ProfilePanes

<PageTitle>Profile - Blocwerk</PageTitle>

<div class="profile-page profile-shell">
    @if (!string.IsNullOrEmpty(_toast))
    {
        <div class="toast-msg">@_toast</div>
    }

    @if (_loading)
    {
        <p class="loading">Loading...</p>
    }
    else if (!_available || _target == null)
    {
        <div class="profile-card">
            <h1>Profile unavailable</h1>
            <p class="member-since">This profile isn't available.</p>
        </div>
    }
    else if (!_isSelf)
    {
        @* Another member's profile: identity and progression only — no settings, no tabs. *@
        <div class="profile-columns">
            <div class="profile-side">
                <ProfileIdentityCard Target="_target" IsSelf="false" />
            </div>
            <div class="profile-main">
                <ProfileProgressionPane TargetUserId="_target.Id" IsSelf="false" />
            </div>
        </div>
    }
    else
    {
        @* Everything on this page is content WE author, so it is a staged composition rather than one
           long scroll: the identity card and the navigation links stay put in a side column, and the
           four settings screens — each holding one job somebody comes here to do — swap in beside them. *@
        <div class="profile-columns">
            <div class="profile-side">
                <ProfileIdentityCard Target="_target" IsSelf="true" OnSelfChanged="ReloadSelfAsync" />

                @* Moved off the bottom tab bar, which was up to six items on a phone. The Admin entry
                   keeps the tab bar's condition exactly — the viewer's Admin role — and both routes keep
                   their own authorization; this is navigation only. The kiosk gate is additional:
                   /administration is on the kiosk deny-list, so offering it on a tablet is a tap that
                   only ever bounces, and Tools is already on the kiosk tab bar. *@
                @if (!KioskContext.IsKiosk)
                {
                    <div class="section profile-section-card">
                        <h2>More</h2>
                        <div class="profile-links">
                            <a class="btn-secondary" href="/tools">Tools</a>
                            @if (_target.Role == IdentityRole.Admin)
                            {
                                <a class="btn-secondary" href="/administration">Administration</a>
                            }
                        </div>
                        <p class="member-since">Calculators and guides@(_target.Role == IdentityRole.Admin ? ", and the installation-wide administration dashboard" : string.Empty).</p>
                    </div>
                }
            </div>

            <div class="profile-main">
                <nav class="profile-tabs" aria-label="Profile sections">
                    @foreach (var tab in Tabs)
                    {
                        <button type="button" class="profile-tab @(_tab == tab ? "is-active" : null)"
                                aria-current="@(_tab == tab ? "page" : null)"
                                @onclick="() => _tab = tab">
                            @TabLabel(tab)
                        </button>
                    }
                </nav>

                @switch (_tab)
                {
                    case ProfileTab.App:
                        <ProfilePreferencesPane Viewer="_target" MyWalls="_myWalls" />
                        break;

                    case ProfileTab.Account:
                        @* Account security lives on your OWN device, never on a wall tablet. These writes
                           are refused at the service (CurrentUserService.EnsureNotKiosk) and, for the
                           e-mail, inline at the write; hiding the widgets is defence in depth, not the
                           gate. *@
                        @if (KioskContext.IsKiosk)
                        {
                            <div class="section profile-section-card">
                                <p class="member-since">
                                    Your email, password, two-factor authentication and linked accounts are
                                    managed from your own device — not from this wall tablet.
                                </p>
                            </div>
                        }
                        else
                        {
                            <ProfileAccountPane Target="_target" OnSelfChanged="ReloadSelfAsync"
                                                LinkedProviders="_linkedProviders" AllProviders="_allProviders"
                                                LinkMessage="_linkMessage" />
                        }

                        break;

                    case ProfileTab.TopLogger:
                        <ProfileTopLoggerPane Viewer="_target" HasPassword="_target.HasPassword"
                                              OnToast="ShowToast"
                                              OnGoToAccount="() => _tab = ProfileTab.Account" />
                        break;

                    default:
                        <ProfileProgressionPane TargetUserId="_target.Id" IsSelf="true" />
                        break;
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "link")]
    public string? LinkResult { get; set; }

    private static readonly ProfileTab[] Tabs =
        [ProfileTab.Progress, ProfileTab.App, ProfileTab.Account, ProfileTab.TopLogger];

    private ProfileTab _tab = ProfileTab.Progress;

    private IReadOnlyList<string> _linkedProviders = [];
    private IReadOnlyList<(string Key, string Label)> _allProviders = [];
    private string? _linkMessage;

    private User? _viewer;
    private User? _target;
    private bool _isSelf;
    private bool _available = true;
    private bool _loading = true;
    private Guid? _loadedFor;
    private IReadOnlyList<Wall> _myWalls = [];
    private string? _toast;

    private static string TabLabel(ProfileTab tab) => tab switch
    {
        ProfileTab.App => "App",
        ProfileTab.Account => "Account",
        ProfileTab.TopLogger => "TopLogger",
        _ => "Progress",
    };

    protected override async Task OnParametersSetAsync()
    {
        // The same component instance is reused when navigating between profiles, so reload only when
        // the target actually changes.
        if (!_loading && _loadedFor == UserId)
        {
            return;
        }

        _loadedFor = UserId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _available = true;
        _target = null;

        if (await TryResolveViewerAsync() is not { } viewer)
        {
            _loading = false;
            return;
        }

        _viewer = viewer;

        if (UserId == null || UserId == _viewer.Id)
        {
            _isSelf = true;
            _target = _viewer;
            _myWalls = await WallService.GetMyWallsAsync();
            _linkedProviders = await CurrentUserService.GetLinkedProvidersAsync();
            _allProviders = EnabledProviders();
            _linkMessage = LinkResultMessage(LinkResult);

            // A link round trip lands on /profile?link=…, and the only thing worth looking at then is
            // the linked-accounts list.
            if (_linkMessage != null)
            {
                _tab = ProfileTab.Account;
            }
        }
        else
        {
            _isSelf = false;
            var target = await CurrentUserService.GetUserByIdAsync(UserId.Value);
            if (target == null || !await WallService.UsersShareAWallAsync(_viewer.Id, UserId.Value))
            {
                _available = false;
            }
            else
            {
                _target = target;
            }
        }

        _loading = false;
    }

    // Enabled providers, in a stable display order, for the linked-accounts list.
    private List<(string Key, string Label)> EnabledProviders()
    {
        var providers = new List<(string, string)>();
        if (Settings.GitHubOAuth.Enabled)
        {
            providers.Add(("github", "GitHub"));
        }

        if (Settings.GoogleOAuth.Enabled)
        {
            providers.Add(("google", "Google"));
        }

        if (Settings.MicrosoftOAuth.Enabled)
        {
            providers.Add(("microsoft", "Microsoft"));
        }

        return providers;
    }

    private static string? LinkResultMessage(string? result) => result switch
    {
        "linked" => "Account linked.",
        "merged" => "Accounts merged — the other account was absorbed into this one.",
        "already" => "That account is already linked to this profile.",
        "error" => "Couldn't link that account. Please try again.",
        "unavailable" => "That provider isn't available.",
        _ => null,
    };

    private async Task ReloadSelfAsync()
    {
        if (await TryResolveViewerAsync() is not { } viewer)
        {
            return;
        }

        _viewer = viewer;
        _target = _viewer;
    }

    /// <summary>
    /// Resolves the viewer, or sends the browser to a clean sign-in prompt and returns null.
    /// </summary>
    /// <remarks>
    /// <c>[Authorize]</c> only proves the cookie is intact; it says nothing about the account behind
    /// it still existing. An account merged away (or deleted) on another device leaves this tab with
    /// a perfectly valid cookie that resolves to nobody — and an unguarded call there did not fail
    /// gracefully, it 500ed the page on every reload with no hint that signing in again would fix it.
    /// Same bounce MainLayout, Home, Join, WallDetail and BoulderDetail already make.
    /// </remarks>
    private async Task<User?> TryResolveViewerAsync()
    {
        try
        {
            return await CurrentUserService.GetCurrentUserAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/account/login", replace: true);
            return null;
        }
    }

    private async Task ShowToast(string message)
    {
        _toast = message;
        StateHasChanged();
        await Task.Delay(2500);
        _toast = null;
        StateHasChanged();
    }
}
