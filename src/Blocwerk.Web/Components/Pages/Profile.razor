@page "/profile"
@page "/profile/{UserId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ICurrentUserService CurrentUserService
@inject IProgressionService ProgressionService
@inject IWallService WallService
@inject Blocwerk.Core.Configuration.BlocwerkSettings Settings
@inject NavigationManager Navigation
@inject ITopLoggerImportService TopLogger
@inject IEmailVerificationService EmailVerification
@inject IJSRuntime JS
@inject IDbContextFactory<Blocwerk.Core.Data.BlocwerkDbContext> DbContextFactory
@using Blocwerk.Core.Helpers
@using Blocwerk.Core.Services.TopLogger
@using Microsoft.EntityFrameworkCore

<PageTitle>Profile - Blocwerk</PageTitle>

<div class="profile-page">
    @if (!string.IsNullOrEmpty(_toast))
    {
        <div class="toast-msg">@_toast</div>
    }

    @if (_loading)
    {
        <p class="loading">Loading...</p>
    }
    else if (!_available || _target == null)
    {
        <div class="profile-card">
            <h1>Profile unavailable</h1>
            <p class="member-since">This profile isn't available.</p>
        </div>
    }
    else
    {
        <div class="profile-card">
            @if (_isSelf)
            {
                <div class="avatar-edit">
                    <UserAvatar UserId="_target.Id" Name="_target.Name" HasAvatar="_target.HasAvatar" />

                    @* Hidden file input triggered by the pencil label below, overlaying the header avatar. *@
                    <InputFile id="avatar-file" class="avatar-file-input" OnChange="OnAvatarSelectedAsync"
                               accept="image/*" disabled="@_savingAvatar" />
                    <label class="avatar-icon-btn avatar-edit-btn @(_savingAvatar ? "is-disabled" : null)"
                           for="avatar-file" title="Change photo" aria-label="Change photo">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                            <path d="M12 20h9" />
                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
                        </svg>
                    </label>

                    @if (_target.HasAvatar)
                    {
                        <button type="button" class="avatar-icon-btn avatar-delete-btn"
                                @onclick="RemoveAvatarAsync" disabled="@_savingAvatar"
                                title="Remove photo" aria-label="Remove photo">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                <polyline points="3 6 5 6 21 6" />
                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                            </svg>
                        </button>
                    }
                </div>
            }
            else
            {
                <UserAvatar UserId="_target.Id" Name="_target.Name" HasAvatar="_target.HasAvatar" />
            }
            <h1>@_target.Name</h1>
            <span class="role-badge">@_target.Role</span>
            <p class="member-since">Member since <LocalTime Value="@_target.CreatedAt" Format="LocalTimeFormat.MonthYear" /></p>
            @if (_isSelf && _avatarError != null)
            {
                <p class="field-error">@_avatarError</p>
            }
        </div>

        @if (_isSelf)
        {
            <div class="section">
                <h2>Profile</h2>

                <div class="field-group">
                    <label class="field-label" for="display-name">Display name</label>
                    <input id="display-name" class="text-input" maxlength="256" @bind="_nameInput" @bind:event="oninput" />
                    <div class="field-actions">
                        <button class="btn-primary" @onclick="SaveDisplayNameAsync" disabled="@_savingName">Save</button>
                        @if (!string.IsNullOrWhiteSpace(_target.CustomDisplayName))
                        {
                            <button class="btn-secondary" @onclick="ResetDisplayNameAsync" disabled="@_savingName">Reset to @_target.DisplayName</button>
                        }
                    </div>
                    <p class="member-since">Leave empty to use your account name (@_target.DisplayName).</p>
                    @if (_nameError != null)
                    {
                        <p class="field-error">@_nameError</p>
                    }
                </div>
            </div>

            <div class="section profile-section-card">
                <h2>Home wall</h2>
                <select class="window-select home-wall-select" value="@_viewer?.HomeWallId" @onchange="OnHomeWallChange">
                    <option value="">None</option>
                    @foreach (var wall in _myWalls)
                    {
                        <option value="@wall.Id">@wall.Name</option>
                    }
                </select>
                <p class="member-since">Adds a Home shortcut to the bottom bar that jumps to this wall.</p>
                @if (_homeWallError != null)
                {
                    <p class="field-error">@_homeWallError</p>
                }
            </div>

            <div class="section profile-section-card">
                <h2>Zoom lens magnification</h2>
                <select class="window-select" value="@_zoomLensMag" @onchange="OnZoomLensMagChange">
                    @foreach (var mag in ZoomLensMagOptions)
                    {
                        <option value="@mag">@(mag)×</option>
                    }
                </select>
                <p class="member-since">
                    How much the long-press magnifier enlarges the wall photo (relative to its
                    original resolution) while viewing a wall or boulder. Currently @(_zoomLensMag)×.
                </p>
            </div>

            <details class="section profile-collapsible" id="email-section">
                <summary>@(_target.EmailVerified ? "Email (verified)" : "Email")</summary>

                @if (_target.EmailVerified && !string.IsNullOrEmpty(_target.Email))
                {
                    <p class="member-since">
                        Your email <strong>@_target.Email</strong> is verified. Enter a new address and
                        verify it below to change it.
                    </p>
                }
                else if (!string.IsNullOrEmpty(_target.Email))
                {
                    <p class="member-since">Your email <strong>@_target.Email</strong> isn't verified yet.</p>
                }
                else
                {
                    <p class="member-since">Add an email address and confirm it with a code we send you.</p>
                }

                @if (!Settings.Smtp.IsConfigured)
                {
                    <p class="member-since">Email sending isn't configured on this server, so email can't be verified right now.</p>
                }
                else
                {
                    <div class="field-group">
                        <label class="field-label" for="verify-email">Email address</label>
                        <input id="verify-email" class="text-input" type="email" maxlength="256" autocomplete="email"
                               @bind="_emailInput" @bind:event="oninput" />
                        <div class="field-actions">
                            <button class="btn-primary" @onclick="SendEmailCodeAsync" disabled="@_emailBusy">Send code</button>
                        </div>

                        @if (_emailCodeSent)
                        {
                            <label class="field-label" for="verify-email-code">6-digit code</label>
                            <input id="verify-email-code" class="text-input" inputmode="numeric" maxlength="6"
                                   autocomplete="one-time-code" @bind="_emailCode" @bind:event="oninput" />
                            <div class="field-actions">
                                <button class="btn-primary" @onclick="VerifyEmailCodeAsync" disabled="@_emailBusy">Verify</button>
                            </div>
                        }

                        @if (_emailError != null)
                        {
                            <p class="field-error">@_emailError</p>
                        }
                        @if (_emailInfo != null)
                        {
                            <p class="field-label">@_emailInfo</p>
                        }
                    </div>
                }
            </details>

            <details class="section profile-collapsible" id="password-section">
                <summary>@(_target.HasPassword ? "Password sign-in (all set)" : "Password sign-in")</summary>
                @if (_target.HasPassword)
                {
                    <p class="member-since">
                        A password is set for username <strong>@_target.LoginUsername</strong>.
                        You can sign in without a provider. Enter a new username and password below to change it.
                    </p>
                }
                else
                {
                    <p class="member-since">
                        Set a username and password to sign in without an OAuth provider. This never
                        replaces your linked accounts — it's an additional way in.
                    </p>
                }

                <div class="field-group">
                    <label class="field-label" for="login-username">Username</label>
                    <input id="login-username" class="text-input" maxlength="64" autocomplete="off"
                           @bind="_pwUsername" @bind:event="oninput" />

                    @if (_target.HasPassword)
                    {
                        <label class="field-label" for="login-current-password">Current password</label>
                        <input id="login-current-password" class="text-input" type="password" autocomplete="current-password"
                               @bind="_pwCurrent" @bind:event="oninput" />
                    }

                    <label class="field-label" for="login-password">Password</label>
                    <input id="login-password" class="text-input" type="password" autocomplete="new-password"
                           @bind="_pwPassword" @bind:event="oninput" />

                    <label class="field-label" for="login-password-confirm">Confirm password</label>
                    <input id="login-password-confirm" class="text-input" type="password" autocomplete="new-password"
                           @bind="_pwConfirm" @bind:event="oninput" />

                    <div class="field-actions">
                        <button class="btn-primary" @onclick="SavePasswordAsync" disabled="@_savingPassword">
                            @(_target.HasPassword ? "Change password" : "Set password")
                        </button>
                    </div>
                    <p class="member-since">Username 3–64 characters (letters, digits, dot, underscore, hyphen); password at least 8 characters.</p>
                    @if (_passwordError != null)
                    {
                        <p class="field-error">@_passwordError</p>
                    }
                    @if (_passwordSuccess)
                    {
                        <p class="field-label">Password saved.</p>
                    }
                </div>
            </details>

            @if (_target.HasPassword)
            {
                <details class="section profile-collapsible">
                    <summary>@(_target.HasTotp ? "Two-factor authentication (all set)" : "Two-factor authentication")</summary>
                    @if (_target.HasTotp)
                    {
                        <p class="member-since">
                            Two-factor authentication is <strong>on</strong>. It is required <strong>only when
                            you sign in with your username &amp; password</strong> — signing in through a linked
                            OAuth provider is not affected. Enter a current code to turn it off.
                        </p>
                        <div class="field-group">
                            <label class="field-label" for="totp-disable">6-digit code</label>
                            <input id="totp-disable" class="text-input" inputmode="numeric" maxlength="8"
                                   autocomplete="one-time-code" @bind="_totpCode" @bind:event="oninput" />
                            <div class="field-actions">
                                <button class="btn-secondary" @onclick="DisableTotpAsync" disabled="@_totpBusy">Disable 2FA</button>
                            </div>
                        </div>
                        @if (_totpError != null)
                        {
                            <p class="field-error">@_totpError</p>
                        }
                    }
                    else if (_totpEnrollment != null)
                    {
                        <p class="member-since">
                            Scan this QR code with your authenticator app (or enter the secret manually),
                            then enter a code below to finish enabling 2FA.
                        </p>
                        <img class="totp-qr" width="220" height="220" alt="TOTP QR code"
                             src="data:image/png;base64,@Convert.ToBase64String(_totpEnrollment.QrPng)" />
                        <p class="member-since">Secret: <code>@_totpEnrollment.Secret</code></p>

                        <div class="field-group">
                            <label class="field-label" for="totp-confirm">6-digit code</label>
                            <input id="totp-confirm" class="text-input" inputmode="numeric" maxlength="8"
                                   autocomplete="one-time-code" @bind="_totpCode" @bind:event="oninput" />
                            <div class="field-actions">
                                <button class="btn-primary" @onclick="ConfirmTotpAsync" disabled="@_totpBusy">Confirm &amp; enable</button>
                                <button class="btn-secondary" @onclick="CancelTotpEnrollment" disabled="@_totpBusy">Cancel</button>
                            </div>
                            @if (_totpError != null)
                            {
                                <p class="field-error">@_totpError</p>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="member-since">
                            Add a second factor: after your password, sign-in will ask for a rotating
                            6-digit code from an authenticator app (Google Authenticator, Aegis, 1Password…).
                        </p>
                        <div class="field-actions">
                            <button class="btn-primary" @onclick="EnableTotpAsync" disabled="@_totpBusy">Enable 2FA</button>
                        </div>
                        @if (_totpError != null)
                        {
                            <p class="field-error">@_totpError</p>
                        }
                    }
                </details>
            }

            <div class="section tl-card profile-section-card">
                <h2>TopLogger import</h2>

                @if (!_target.HasPassword)
                {
                    <p class="member-since">
                        Set a password first to connect TopLogger — your tokens are stored encrypted.
                        <a href="#password-section">Set a password above.</a>
                    </p>
                }
                else
                {
                    var tlConnected = _tlStatus is { Connected: true, NeedsReauth: false };
                    var tlBusy = _tlBusyPhase is not null;

                    // The token form (help text + two textareas + Connect). Shown expanded when not
                    // connected (or on reauth) as the primary call-to-action, and tucked inside a
                    // collapsed "Update tokens" disclosure once connected and healthy.
                    RenderFragment tokenForm =
                        @<text>
                            <p class="member-since">
                                Paste your TopLogger access + refresh token from app.toplogger.nu → DevTools →
                                Network → a graphql request's Authorization header (access token) and the refresh token.
                            </p>
                            <div class="field-group">
                                <label class="field-label" for="tl-access">Access token</label>
                                <textarea id="tl-access" class="text-input tl-token" rows="2" autocomplete="off"
                                          @bind="_tlAccessToken" @bind:event="oninput"></textarea>

                                <label class="field-label" for="tl-refresh">Refresh token</label>
                                <textarea id="tl-refresh" class="text-input tl-token" rows="2" autocomplete="off"
                                          @bind="_tlRefreshToken" @bind:event="oninput"></textarea>

                                <div class="field-actions">
                                    <button class="btn-primary" @onclick="ConnectTopLoggerAsync" disabled="@tlBusy">
                                        @(tlBusy ? TlBusyLabel : "Connect")
                                    </button>
                                </div>
                            </div>
                        </text>;

                    @if (_tlStatus?.NeedsReauth == true)
                    {
                        <p class="tl-reauth">
                            Reset TopLogger Tokens — your saved session was rejected. Paste fresh tokens below to reconnect.
                        </p>
                        @if (!string.IsNullOrEmpty(_tlStatus.LastError))
                        {
                            <p class="field-error">@_tlStatus.LastError</p>
                        }
                    }

                    @if (tlConnected)
                    {
                        <p class="tl-meta">
                            Last sync:
                            @if (_tlStatus!.LastSyncAt != null)
                            {
                                <LocalTime Value="@_tlStatus.LastSyncAt" Format="LocalTimeFormat.DateTime" />
                            }
                            else
                            {
                                <span>never</span>
                            }
                        </p>
                        <p class="tl-meta">@_tlStatus.AscentCount imported ascent(s).</p>
                        @if (_tlStatus.UnmappedGradeCount > 0)
                        {
                            <p class="tl-meta">@_tlStatus.UnmappedGradeCount send(s) need a grade.</p>
                            <details class="tl-resolve" @ontoggle="OnResolveGradesToggle">
                                <summary>Resolve grades</summary>
                                @if (_tlUnmapped == null)
                                {
                                    <p class="tl-meta">Loading…</p>
                                }
                                else
                                {
                                    @foreach (var item in _tlUnmapped)
                                    {
                                        var selection = GetGradeSelection(item.RawGrade);
                                        <div class="tl-resolve-row">
                                            <div class="tl-resolve-info">
                                                <span class="tl-resolve-raw">@(string.IsNullOrEmpty(item.RawGrade) ? "(no grade)" : item.RawGrade)</span>
                                                <span class="tl-meta">
                                                    @item.Count ascent(s)@(string.IsNullOrEmpty(item.SampleClimbName) ? string.Empty : $" · e.g. {item.SampleClimbName}")
                                                </span>
                                            </div>
                                            <GradePicker Value="@selection"
                                                         ValueChanged="@(v => SetGradeSelection(item.RawGrade, v))" />
                                            <button class="btn-primary"
                                                    @onclick="() => ResolveGradeAsync(item)"
                                                    disabled="@(tlBusy || _tlResolveBusy || string.IsNullOrEmpty(selection))">
                                                Save
                                            </button>
                                        </div>
                                    }
                                }
                            </details>
                        }

                        <details class="tl-calibration" @ontoggle="OnCalibrationToggle">
                            <summary>Gym grade points</summary>
                            <p class="tl-meta">
                                Enter the points your gym awards per grade, plus the flash bonus. We use these
                                to read the grade and flash from each ascent's points.
                            </p>
                            @if (_tlGyms == null)
                            {
                                <p class="tl-meta">Loading…</p>
                            }
                            else if (_tlGyms.Count == 0)
                            {
                                <p class="tl-meta">No gyms yet — sync some ascents first.</p>
                            }
                            else
                            {
                                <div class="field-group">
                                    <label class="field-label" for="tl-calib-gym">Gym</label>
                                    <select id="tl-calib-gym" class="window-select"
                                            value="@_tlSelectedGymId" @onchange="OnCalibrationGymChange">
                                        <option value="">Select a gym…</option>
                                        @foreach (var g in _tlGyms)
                                        {
                                            <option value="@g.Id">@g.Name</option>
                                        }
                                    </select>
                                </div>

                                @if (_tlSelectedGymId != null)
                                {
                                    <div class="tl-calib-grid">
                                        <table class="tl-calib-table">
                                            <thead>
                                                <tr><th>Grade</th><th>Points</th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var grade in GradeScale.FontGrades)
                                                {
                                                    <tr>
                                                        <td>@grade</td>
                                                        <td>
                                                            <input type="number" min="0" inputmode="numeric"
                                                                   class="text-input tl-calib-input"
                                                                   value="@GetCalibPoints(grade)"
                                                                   @onchange="e => SetCalibPoints(grade, e.Value?.ToString())" />
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="field-group">
                                        <label class="field-label" for="tl-calib-bonus">Bonus points for flash</label>
                                        <input id="tl-calib-bonus" type="number" min="0" inputmode="numeric"
                                               class="text-input tl-calib-input"
                                               value="@_tlFlashBonusInput"
                                               @onchange="e => _tlFlashBonusInput = e.Value?.ToString() ?? string.Empty" />
                                    </div>

                                    <div class="tl-actions">
                                        <button class="btn-primary" @onclick="SaveCalibrationAsync"
                                                disabled="@(tlBusy || _tlCalibBusy)">
                                            @(_tlCalibBusy ? "Saving…" : "Save")
                                        </button>
                                        <button class="btn-secondary" @onclick="DiscardCalibrationAsync"
                                                disabled="@(tlBusy || _tlCalibBusy)">Discard</button>
                                    </div>
                                }
                            }
                        </details>

                        @if (!string.IsNullOrEmpty(_tlStatus.LastError))
                        {
                            <p class="field-error">@_tlStatus.LastError</p>
                        }

                        <div class="tl-actions">
                            <button class="btn-primary" @onclick="SyncTopLoggerAsync" disabled="@tlBusy">
                                @(tlBusy ? TlBusyLabel : "Sync now")
                            </button>
                            @if (!_tlConfirmingDisconnect)
                            {
                                <button class="btn-secondary" @onclick="() => _tlConfirmingDisconnect = true" disabled="@tlBusy">Disconnect</button>
                            }
                        </div>

                        @if (_tlConfirmingDisconnect)
                        {
                            <div class="tl-confirm">
                                <label class="tl-check">
                                    <input type="checkbox" @bind="_tlDeleteAscents" disabled="@tlBusy" />
                                    Also delete imported ascents
                                </label>
                                <div class="tl-actions">
                                    <button class="btn-secondary" @onclick="DisconnectTopLoggerAsync" disabled="@tlBusy">Confirm disconnect</button>
                                    <button class="btn-secondary" @onclick="() => _tlConfirmingDisconnect = false" disabled="@tlBusy">Cancel</button>
                                </div>
                            </div>
                        }

                        @if (tlBusy)
                        {
                            <div class="tl-busy">
                                <span class="tl-spinner" aria-hidden="true"></span>
                                <span>@TlBusyLabel</span>
                            </div>
                        }

                        <details class="tl-token-edit">
                            <summary>Update tokens</summary>
                            @tokenForm
                        </details>
                    }
                    else
                    {
                        @tokenForm

                        @if (tlBusy)
                        {
                            <div class="tl-busy">
                                <span class="tl-spinner" aria-hidden="true"></span>
                                <span>@TlBusyLabel</span>
                            </div>
                        }
                    }

                    @if (_tlError != null)
                    {
                        <p class="field-error">@_tlError</p>
                    }
                }
            </div>

            <div class="profile-links">
                <a class="btn-secondary" href="/settings/api-keys">API keys</a>
            </div>

            @if (_allProviders.Count > 0)
            {
                // Only providers the user hasn't linked yet can be linked; already-linked ones are listed
                // read-only below so the section still shows what's connected.
                var unlinkedProviders = _allProviders.Where(p => !IsProviderLinked(p.Key)).ToList();
                var linkedLabels = _allProviders.Where(p => IsProviderLinked(p.Key)).Select(p => p.Label).ToList();

                <details class="section profile-collapsible">
                    <summary>Linked accounts</summary>
                    @if (_linkMessage != null)
                    {
                        <p class="field-label">@_linkMessage</p>
                    }
                    <p class="member-since">Sign in with any linked provider to reach this account. Linking a provider that already belongs to another account merges that account into this one.</p>

                    @if (linkedLabels.Count > 0)
                    {
                        <div class="field-group">
                            @foreach (var label in linkedLabels)
                            {
                                <div class="field-actions">
                                    <span class="field-label">@label</span>
                                    <span class="role-badge">Linked</span>
                                </div>
                            }
                        </div>
                    }

                    @if (unlinkedProviders.Count > 0)
                    {
                        <div class="field-group">
                            @foreach (var provider in unlinkedProviders)
                            {
                                <div class="field-actions">
                                    <span class="field-label">@provider.Label</span>
                                    <button class="btn-secondary" @onclick="() => StartLink(provider.Key)">Link @provider.Label</button>
                                </div>
                            }
                        </div>
                    }
                    <p class="member-since">Unlinking a provider isn't supported yet.</p>
                </details>
            }

        }

        @if (_progression != null)
        {
            <div class="section">
                <div class="progression-header">
                    <h2>Progression</h2>
                    <div class="window-control">
                        <select class="window-select" value="@_progression.WindowDays" @onchange="OnWindowChange">
                            <option value="14">14 days</option>
                            <option value="30">30 days</option>
                            <option value="60">60 days</option>
                            <option value="90">90 days</option>
                            <option value="180">180 days</option>
                            <option value="365">1 year</option>
                        </select>
                        <select class="window-select" value="@((int)_progression.GroupBy)" @onchange="OnGroupByChange">
                            <option value="0">Day</option>
                            <option value="1">Week</option>
                            <option value="2">Month</option>
                        </select>
                    </div>
                </div>

                <div class="score-cards">
                    <div class="score-card">
                        <span class="score-label">Boulder</span>
                        <span class="score-value">@_progression.BoulderScore.ToString("F0")</span>
                        @if (_progression.BoulderGrade != null)
                        {
                            <span class="score-grade">~@_progression.BoulderGrade</span>
                        }
                    </div>
                    <div class="score-card">
                        <span class="score-label">Training</span>
                        <span class="score-value">@_progression.TrainingScore.ToString("F0")</span>
                    </div>
                </div>

                @{ var bScale = BoulderScale(); }
                <ProgressionChart Title="Boulder progression" Caption="rolling 60-day rating · drag axis to zoom" Stroke="#e94560"
                                  Points="BoulderPoints()" YTicks="bScale.Ticks" YMin="bScale.Min" YMax="bScale.Max"
                                  ShowTrendline="true" OnYScaleStep="OnBoulderYScale"
                                  EmptyText="No sends in this window yet." />

                <ProgressionChart Title="Training progression" Stroke="#0f3460"
                                  Points="TrainingPoints()" YTicks="TrainingYTicks()"
                                  EmptyText="No training logged in this window yet." />
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "link")]
    public string? LinkResult { get; set; }

    private IReadOnlyList<string> _linkedProviders = [];
    private List<(string Key, string Label)> _allProviders = [];
    private string? _linkMessage;

    private User? _viewer;
    private User? _target;
    private UserProgression? _progression;
    private bool _isSelf;
    private bool _available = true;
    private bool _loading = true;
    private Guid? _loadedFor;
    private int _boulderGradeSpan = 5;
