@page "/forgot-password"
@rendermode InteractiveServer
@layout EmptyLayout
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@inject IEmailSender EmailSender
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<ForgotPassword> Logger

@* Password recovery — request a reset code. NO account enumeration: the response is identical whether
   or not an account exists, and a code is actually issued only when a VERIFIED email matches. Throttling
   is swallowed into the same uniform message. "Email isn't configured" is a server-state fact (true for
   everyone), not an enumeration signal, so it's safe to surface. *@

<PageTitle>Forgot password - Blocwerk</PageTitle>

<div class="oauth-container">
    <div class="header">
        <h1>Blocwerk</h1>
        <p>Reset your password</p>
    </div>

    @if (_error is not null)
    {
        <div class="oauth-error" role="alert">@_error</div>
    }

    <div class="password-login">
        @if (!_sent)
        {
            <p style="color:var(--text-secondary);font-size:0.9rem;margin-bottom:12px;">
                Enter your email and we'll send a 6-digit code to reset your password.
            </p>
            <label class="field-label" for="fp-email">Email</label>
            <input id="fp-email" class="text-input" type="email" @bind="_email" maxlength="256"
                   autocomplete="email" disabled="@_busy" />
            <button type="button" class="provider-button password-submit" @onclick="SendAsync"
                    disabled="@_busy">@(_busy ? "Sending…" : "Send reset code")</button>
        }
        else
        {
            <div role="status" style="background:rgba(88,166,255,0.12);color:var(--text);border:1px solid rgba(88,166,255,0.35);border-radius:8px;padding:10px 14px;margin-bottom:16px;font-size:0.9rem;">
                If an account with that email exists, we've sent it a 6-digit reset code. It expires in 10 minutes.
            </div>
            <a class="provider-button password-submit" style="display:block;text-align:center;text-decoration:none;"
               href="@ResetHref">Enter your code</a>
        }

        <div class="password-links" style="display:flex;justify-content:center;gap:12px;margin-top:16px;font-size:0.9rem;">
            <a href="@LoginHref">Back to sign in</a>
        </div>
    </div>

    <div class="footer">
        <p>Recovery requires a confirmed email on your account.</p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private string _email = string.Empty;
    private bool _sent;
    private bool _busy;
    private string? _error;

    private string LoginHref =>
        string.IsNullOrEmpty(ReturnUrl) ? "/oauth-select" : $"/oauth-select?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    private string ResetHref
    {
        get
        {
            var href = $"/reset-password?email={Uri.EscapeDataString(_email.Trim())}";
            if (!string.IsNullOrEmpty(ReturnUrl))
            {
                href += $"&returnUrl={Uri.EscapeDataString(ReturnUrl)}";
            }

            return href;
        }
    }

    private async Task SendAsync()
    {
        _error = null;

        // Server-state, not enumeration: if SMTP is off the feature can't work for anyone.
        if (!EmailSender.IsConfigured)
        {
            _error = "Password recovery isn't available: email sending isn't configured on this server.";
            return;
        }

        var email = _email.Trim();
        if (email.Length == 0 || !email.Contains('@'))
        {
            _error = "Enter a valid email address.";
            return;
        }

        // Do the real lookup + code issue on a DETACHED task with its OWN DI scope, so the request thread
        // spends the SAME (near-zero) time whether or not the account exists. Awaiting the lookup+send here
        // would let an attacker time the response to learn which emails have verified accounts — that timing
        // oracle is what this indirection removes. Both branches now return after only constant request work.
        _ = Task.Run(async () =>
        {
            try
            {
                using var scope = ScopeFactory.CreateScope();
                var users = scope.ServiceProvider.GetRequiredService<IPasswordLoginService>();
                var codes = scope.ServiceProvider.GetRequiredService<IEmailVerificationService>();
                var user = await users.FindByEmailAsync(email);
                if (user is not null)
                {
                    await codes.IssueCodeAsync(EmailVerificationPurpose.PasswordReset, email, user.Id);
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "detached password-reset issue failed");
            }
        });

        // Identical uniform message regardless of whether the email matched an account.
        _sent = true;
    }
}
