@page "/reset-password"
@rendermode InteractiveServer
@layout EmptyLayout
@inject IPasswordLoginService PasswordLogin
@inject IEmailVerificationService EmailVerification
@inject NavigationManager Navigation

@* Password recovery — set a new password with the emailed code. The code is bound to (email,
   PasswordReset) and, on issue, to the account's id; VerifyCodeAsync consumes it and hands back that
   UserId, so the new password is set ONLY on the account the code was minted for — a code for A can
   never reset B. On success we redirect to the login page (no auto-sign-in) so the user proves the new
   password. Failures are reported generically. *@

<PageTitle>Reset password - Blocwerk</PageTitle>

<div class="oauth-container">
    <div class="header">
        <h1>Blocwerk</h1>
        <p>Choose a new password</p>
    </div>

    @if (_error is not null)
    {
        <div class="oauth-error" role="alert">@_error</div>
    }

    <div class="password-login">
        <p style="color:var(--text-secondary);font-size:0.9rem;margin-bottom:12px;">
            Enter the 6-digit code we emailed you and your new password.
        </p>
        <label class="field-label" for="rp-email">Email</label>
        <input id="rp-email" class="text-input" type="email" @bind="_email" maxlength="256"
               autocomplete="email" disabled="@_busy" />
        <label class="field-label" for="rp-code">Verification code</label>
        <input id="rp-code" class="text-input" type="text" @bind="_code" inputmode="numeric"
               autocomplete="one-time-code" maxlength="6" disabled="@_busy" />
        <label class="field-label" for="rp-password">New password</label>
        <input id="rp-password" class="text-input" type="password" @bind="_password"
               autocomplete="new-password" disabled="@_busy" />
        <button type="button" class="provider-button password-submit" @onclick="ResetAsync"
                disabled="@_busy">@(_busy ? "Resetting…" : "Reset password")</button>

        <div class="password-links" style="display:flex;justify-content:center;gap:12px;margin-top:16px;font-size:0.9rem;">
            <a href="@LoginHref">Back to sign in</a>
        </div>
    </div>

    <div class="footer">
        <p>Need a code? <a href="@ForgotHref">Request one</a>.</p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private string _email = string.Empty;
    private string _code = string.Empty;
    private string _password = string.Empty;
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        _email = Email?.Trim() ?? string.Empty;
    }

    private string LoginHref =>
        string.IsNullOrEmpty(ReturnUrl) ? "/oauth-select" : $"/oauth-select?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    private string ForgotHref =>
        string.IsNullOrEmpty(ReturnUrl) ? "/forgot-password" : $"/forgot-password?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    private async Task ResetAsync()
    {
        _error = null;

        var email = _email.Trim();
        var code = _code.Trim();
        if (email.Length == 0 || code.Length == 0)
        {
            _error = "Enter your email and the 6-digit code.";
            return;
        }

        if (_password.Length < 8)
        {
            _error = "Password must be at least 8 characters.";
            return;
        }

        _busy = true;
        try
        {
            // Single-use verification: consume the code exactly once. Only a Success permits a reset.
            var verify = await EmailVerification.VerifyCodeAsync(EmailVerificationPurpose.PasswordReset, email, code);
            switch (verify.Status)
            {
                case EmailVerificationStatus.Success:
                    break;
                case EmailVerificationStatus.Expired:
                    _error = "That code has expired. Request a new one.";
                    return;
                case EmailVerificationStatus.TooManyAttempts:
                    _error = "Too many attempts. Request a new code.";
                    return;
                default:
                    _error = "That code didn't match. Check it and try again.";
                    return;
            }

            // Bind the reset to the account the code was issued for. Prefer the id the verified code
            // carries; fall back to the verified-email lookup (both resolve the same unique account).
            var userId = verify.UserId ?? (await PasswordLogin.FindByEmailAsync(email))?.Id;
            if (userId is not { } id)
            {
                _error = "That code didn't match. Check it and try again.";
                return;
            }

            await PasswordLogin.ResetPasswordAsync(id, _password);

            // Redirect to login (no auto-sign-in) so the user signs in with the new password.
            var target = string.IsNullOrEmpty(ReturnUrl)
                ? "/oauth-select?reset=1"
                : $"/oauth-select?reset=1&returnUrl={Uri.EscapeDataString(ReturnUrl)}";
            Navigation.NavigateTo(target, forceLoad: true);
        }
        catch (Exception)
        {
            _error = "Couldn't reset your password. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
