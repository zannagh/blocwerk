@page "/signing-in"
@layout EmptyLayout

@* Static SSR interstitial shown while /account/callback performs the OAuth token exchange (~1-2s).
   It forwards to the callback via a full navigation; the browser keeps THIS spinner on screen until
   the callback responds with the final redirect, so the user never sees a blank or a clickable page
   mid-login. Target is the fixed local /account/callback path (never taken from the query) to avoid
   an open redirect; only state+code ride along. *@

<PageTitle>Signing you in… - Blocwerk</PageTitle>

<style>
    .signing-in { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; padding: 2rem 0; }
    .signing-in .bw-spinner {
        width: 44px; height: 44px; border-radius: 50%;
        border: 3px solid rgba(233, 69, 96, 0.25); border-top-color: #e94560;
        animation: bw-spin 0.8s linear infinite;
    }
    .signing-in p { color: var(--text-secondary, #9aa0a6); margin: 0; }
    @@keyframes bw-spin { to { transform: rotate(360deg); } }
</style>

<div class="oauth-container">
    <div class="header">
        <h1>Blocwerk</h1>
    </div>
    <div class="signing-in">
        <div class="bw-spinner" aria-hidden="true"></div>
        <p>Signing you in…</p>
        <noscript>
            <a href="@CallbackUrl" class="provider-button">Continue</a>
        </noscript>
    </div>
</div>

@* data-attribute (HTML-encoded by Razor) rather than inlining the URL into script text, so the
   provider-supplied code can never break out into executable JS. *@
<div id="bw-signin-forward" data-url="@CallbackUrl" hidden></div>
<script>
    (function () {
        var el = document.getElementById('bw-signin-forward');
        var url = el && el.getAttribute('data-url');
        if (url) { location.replace(url); }
    })();
</script>

@code {
    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }

    [SupplyParameterFromQuery(Name = "code")] public string? Code { get; set; }

    private string CallbackUrl =>
        $"/account/callback?state={Uri.EscapeDataString(State ?? string.Empty)}&code={Uri.EscapeDataString(Code ?? string.Empty)}";
}
