@page "/oauth-select"
@inject BlocwerkSettings Settings
@layout EmptyLayout

@* Static SSR by design: no @rendermode, so this page does NOT depend on the SignalR circuit.
   Login must work the instant the HTML lands — an InteractiveServer login page left the provider
   buttons dead until the websocket connected (tempting a second click) and ran the redirect over
   the circuit, which could race/short-circuit. These are now plain GET links to a controller that
   302s straight to the provider, so a click always leaves this page immediately and cleanly. *@

<PageTitle>Sign In - Blocwerk</PageTitle>

<div class="oauth-container">
    <div class="header">
        <h1>Blocwerk</h1>
        <p>Sign in to track your climbing walls</p>
    </div>

    @if (Error is not null)
    {
        <div class="oauth-error" role="alert">Sign-in didn't complete. Please try again.</div>
    }

    @if (PasswordError is not null)
    {
        <div class="oauth-error" role="alert">Invalid username or password.</div>
    }

    @* data-enhance-nav="false": these links 302 to a cross-origin OAuth provider, which Blazor's
       enhanced navigation cannot apply (it fetch()es the link and silently drops a cross-origin
       redirect). Force a real full-document navigation so the browser follows the provider redirect. *@
    <div class="providers" data-enhance-nav="false">
        @if (Settings.GitHubOAuth.Enabled)
        {
            <a href="@ProviderHref("github")" class="provider-button github" rel="nofollow">
                <div class="provider-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                </div>
                <div class="provider-text">Sign in with GitHub</div>
            </a>
        }

        @if (Settings.MicrosoftOAuth.Enabled)
        {
            <a href="@ProviderHref("microsoft")" class="provider-button microsoft" rel="nofollow">
                <div class="provider-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M11.4 24H0V12.6h11.4V24zM24 24H12.6V12.6H24V24zM11.4 11.4H0V0h11.4v11.4zM24 11.4H12.6V0H24v11.4z"/>
                    </svg>
                </div>
                <div class="provider-text">Sign in with Microsoft</div>
            </a>
        }

        @if (Settings.GoogleOAuth.Enabled)
        {
            <a href="@ProviderHref("google")" class="provider-button google" rel="nofollow">
                <div class="provider-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                </div>
                <div class="provider-text">Sign in with Google</div>
            </a>
        }
    </div>

    <label class="remember-method">
        <input type="checkbox" id="remember-method" checked />
        <span>Remember my sign-in method on this device</span>
    </label>

    @* Password sign-in for accounts that set a username + password (in Profile). A plain form POST to
       the AccountController — no Blazor circuit needed. data-enhance-nav="false" so the browser does a
       real navigation and follows the controller's redirect. AntiforgeryToken emits the
       __RequestVerificationToken the [ValidateAntiForgeryToken] action requires. *@
    <div class="password-login" data-enhance-nav="false">
        <div class="password-divider"><span>or sign in with a password</span></div>
        <form method="post" action="/account/password">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <label class="field-label" for="pw-username">Username</label>
            <input id="pw-username" class="text-input" type="text" name="username"
                   autocomplete="username" maxlength="64" required />
            <label class="field-label" for="pw-password">Password</label>
            <input id="pw-password" class="text-input" type="password" name="password"
                   autocomplete="current-password" required />
            <label class="password-remember">
                <input type="checkbox" name="keepSignedIn" value="true" />
                <span>Keep me signed in</span>
            </label>
            <button type="submit" class="provider-button password-submit">Sign in</button>
        </form>
    </div>

    <div class="footer">
        <p>Secure authentication via OAuth 2.0</p>
    </div>
</div>

@* Keeps the provider links' remember flag in sync with the checkbox. The links are server-rendered
   with remember=0 (fail-safe: if this script never runs, nothing is remembered), and this stamps
   remember=1 whenever the box is checked. Runs on the fresh full-page load of this route. *@
<script>
    (function () {
        var box = document.getElementById('remember-method');
        if (!box) { return; }
        function sync() {
            var val = box.checked ? '1' : '0';
            document.querySelectorAll('.providers a.provider-button').forEach(function (a) {
                var u = new URL(a.getAttribute('href'), window.location.origin);
                u.searchParams.set('remember', val);
                a.setAttribute('href', u.pathname + u.search);
            });
        }
        box.addEventListener('change', sync);
        sync();
    })();
</script>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "perror")] public string? PasswordError { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    // Links default to remember=0 (fail-safe); the inline script flips them to 1 while the box is
    // checked. returnUrl is preserved so a successful login lands back where the user started.
    private string ProviderHref(string provider)
    {
        var href = $"/account/external?provider={provider}&remember=0";
        if (!string.IsNullOrEmpty(ReturnUrl))
        {
            href += $"&returnUrl={Uri.EscapeDataString(ReturnUrl)}";
        }

        return href;
    }
}
