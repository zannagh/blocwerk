@page "/join/{ShareToken}"
@rendermode InteractiveServer
@inject IWallService WallService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Navigation

<PageTitle>Join Wall - Blocwerk</PageTitle>

<div class="join-page">
    @if (_isJoining)
    {
        <p>Joining wall...</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-state">
            <h2>Could not join wall</h2>
            <p>@_error</p>
            <a href="/walls" class="btn-primary">Go to My Walls</a>
        </div>
    }
</div>

@code {
    [Parameter] public string ShareToken { get; set; } = string.Empty;

    private bool _isJoining = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUserService.GetCurrentUserAsync();
            var wall = await WallService.JoinWallAsync(ShareToken);
            Navigation.NavigateTo($"/walls/{wall.Id}");
        }
        catch (UnauthorizedAccessException)
        {
            var wall = await WallService.GetWallByShareTokenAsync(ShareToken);
            if (wall != null)
            {
                Navigation.NavigateTo($"/walls/{wall.Id}/shared/{ShareToken}");
            }
            else
            {
                _error = "Invalid share link.";
                _isJoining = false;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _isJoining = false;
        }
    }
}

