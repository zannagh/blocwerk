@page "/"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpContextAccessor HttpContextAccessor
@inject Blocwerk.Core.Abstractions.ICurrentUserService CurrentUser
@inject Blocwerk.Core.Abstractions.IKioskContext KioskContext

<PageTitle>Blocwerk</PageTitle>

@if (!_redirecting)
{
    <div class="landing">
        <div class="landing-content">
            <h1>Blocwerk</h1>
            <p>Track your climbing wall boulders, log sends, and watch your progression.</p>
            <a href="/walls" class="btn-primary">Get Started</a>
        </div>
    </div>
}

@code {
    private bool _redirecting;

    // A user with a home wall set lands there directly ("The Attic" as the landing page). Otherwise
    // resume the last page recorded client-side in blocwerk-last-page, falling back to the walls list.
    // HttpContext is live on the prerender pass and null on an interactive re-render — a failure there
    // simply falls through to the last-page/list target rather than crashing.
    private async Task<string> ResolveLandingTargetAsync()
    {
        try
        {
            var user = await CurrentUser.GetCurrentUserAsync();
            if (user?.HomeWallId is { } homeWallId)
            {
                return $"/walls/{homeWallId}";
            }
        }
        catch (Exception)
        {
            // Fall through to the last-page/list target.
        }

        var stored = HttpContextAccessor.HttpContext?.Request.Cookies["blocwerk-last-page"];
        return LastPageRedirect.Resolve(stored, "/walls");
    }

    protected override async Task OnInitializedAsync()
    {
        // A registered tablet WAKES UP into kiosk mode. It has no business on the marketing landing
        // page, and — the bug this fixes — must not fall through to the "returning device" branch
        // below, which sent every paired tablet to a login nobody is meant to complete on it. The
        // wall comes from the validated kiosk context, never from a cookie or the URL, and the page
        // it lands on renders anonymously, so this cannot become a redirect loop. Note this does NOT
        // sign anyone in: the tablet arrives anonymous and a human still picks themselves at
        // /kiosk/users. It also applies to an acting kiosk session, whose home wall may be a wall
        // this device is not allowed to see at all.
        if (Blocwerk.Core.Abstractions.KioskViewing.ViewableWallId(KioskContext) is { } kioskWallId)
        {
            _redirecting = true;
            Navigation.NavigateTo($"/walls/{kioskWallId}", replace: true);
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            _redirecting = true;
            Navigation.NavigateTo(await ResolveLandingTargetAsync(), replace: true);
            return;
        }

        // Logged out: a device that has signed in before (blocwerk-returning is set on every successful
        // sign-in) skips the Get Started landing and goes straight to login, which itself silently
        // re-auths when a method is remembered. First-time visitors fall through to the CTA. HttpContext
        // is live on the prerender pass and null on an interactive re-render, so a missing cookie simply
        // shows the landing rather than crashing.
        var returning = HttpContextAccessor.HttpContext?.Request.Cookies["blocwerk-returning"];
        if (!string.IsNullOrEmpty(returning))
        {
            _redirecting = true;
            Navigation.NavigateTo("/account/login", forceLoad: true);
        }
    }
}
