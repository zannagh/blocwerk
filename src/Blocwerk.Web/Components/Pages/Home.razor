@page "/"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Blocwerk</PageTitle>

@if (!_redirecting)
{
    <div class="landing">
        <div class="landing-content">
            <h1>Blocwerk</h1>
            <p>Track your climbing wall boulders, log sends, and watch your progression.</p>
            <a href="/walls" class="btn-primary">Get Started</a>
        </div>
    </div>
}

@code {
    private bool _redirecting;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            _redirecting = true;

            // Prefer the last page the user was on (recorded client-side into blocwerk-last-page by
            // prefs.js). Reading the cookie server-side on the prerender pass — HttpContext is live
            // there, mirroring BoulderCreate — gives a no-flash redirect. On an interactive
            // re-render HttpContext is null, so we simply fall back to /walls without crashing.
            var stored = HttpContextAccessor.HttpContext?.Request.Cookies["blocwerk-last-page"];
            var target = LastPageRedirect.Resolve(stored, "/walls");

            Navigation.NavigateTo(target, replace: true);
        }
    }
}
