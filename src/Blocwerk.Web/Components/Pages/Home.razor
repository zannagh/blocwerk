@page "/"
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject NavigationManager Navigation

<PageTitle>Blocwerk</PageTitle>

<AuthorizeView>
    <Authorized>
        @{ Navigation.NavigateTo("/walls", replace: true); }
    </Authorized>
    <NotAuthorized>
        <div class="landing">
            <div class="landing-content">
                <h1>Blocwerk</h1>
                <p>Track your climbing wall boulders, log sends, and watch your progression.</p>
                <a href="/walls" class="btn-primary">Get Started</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    .landing {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        color: white;
        padding: 20px;
    }

    .landing-content {
        text-align: center;
        max-width: 400px;
    }

    .landing-content h1 {
        font-size: 3rem;
        font-weight: 700;
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
    }

    .landing-content p {
        font-size: 1.1rem;
        opacity: 0.8;
        margin-bottom: 2rem;
        line-height: 1.6;
    }

    .btn-primary {
        display: inline-block;
        padding: 14px 32px;
        background: #e94560;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: background 0.2s;
    }

    .btn-primary:hover {
        background: #d63851;
    }
</style>
