@using Microsoft.AspNetCore.Components.Web
@using Blocwerk.Web.Components
@using Blocwerk.Web.Components.Layout
@using Blocwerk.Core.Abstractions
@inject ICurrentUserService CurrentUserService
@inject IKioskContext KioskContext

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    @* No maximum-scale / user-scalable=no: locking the page scale is a WCAG 2.2 SC 1.4.4 failure, and
       a pointed one in an app whose content is photographs of small holds. Browser zoom is now allowed
       on ordinary page content; it is suppressed ONLY inside the photo surfaces, which run their own
       pinch (viewport-gestures.js preventDefaults touch/gesture/ctrl-wheel on the viewport element, and
       viewport.js keeps touch-action at pan-y/none there). Double-tap-to-zoom stays off app-wide via
       `touch-action: manipulation` on body, so the custom double-tap zoom has no browser rival. *@
    @* viewport-fit=cover: ~15 rules across the stylesheets budget for env(safe-area-inset-*),
       which evaluates to 0 without it — so on a notched phone the tab bar sat under the home
       indicator and, in LANDSCAPE, content ran under the notch. Every one of those rules is
       written as max(fallback, env(...)) or calc(base + env(...)), so switching the insets on
       can only ever add the real inset, never double-pad. *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#16162a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Blocwerk" />
    <link rel="apple-touch-icon" href="icons/icon-192.png" />
    <link rel="icon" type="image/png" href="icons/icon-192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=Manrope:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/pages.css"]" />
    <link rel="stylesheet" href="@Assets["css/components.css"]" />
    <link rel="stylesheet" href="@Assets["css/training.css"]" />
    <link rel="stylesheet" href="@Assets["css/guides.css"]" />
    <link rel="stylesheet" href="@Assets["css/fullscreen-stage.css"]" />
    <link rel="stylesheet" href="@Assets["css/marker-planner.css"]" />
    @* The Blazor scoped-CSS bundle (every *.razor.css in this project). It was never linked, which
       made every scoped rule inert — the components that had been migrated to real <button>s were
       silently keeping the user-agent button chrome their .razor.css exists to strip. Last, so a
       component's own rules win over the global sheets, which is what scoped CSS is for. *@
    <link rel="stylesheet" href="@Assets["Blocwerk.Web.styles.css"]" />
    <script src="@Assets["js/theme.js"]"></script>
    <script src="@Assets["js/nav.js"]"></script>
    <script src="@Assets["js/prefs.js"]"></script>
    @* Must be in <head>: it listens for beforeinstallprompt, which fires once and is not replayed
       for a listener attached later. Everything else it does is driven by InstallPrompt.razor. *@
    <script src="@Assets["js/install-prompt.js"]"></script>
    @* Deferred: its own work already waits for DOMContentLoaded, and nothing reads bwTime at parse,
       so deferring costs no earlier behaviour and frees first paint. *@
    <script defer src="@Assets["js/localtime.js"]"></script>
    @* NOT deferred: like theme.js this applies a stored visual pref (--wall-dim on <html>) at parse
       to avoid a flash of the undimmed wall on first paint. *@
    <script src="@Assets["js/wall-dim.js"]"></script>
    @* Inert unless the page renders the kiosk release form; the real idle gate is server-side.
       Deferred: it only arms after the DOM exists and defines no parse-time global. *@
    <script defer src="@Assets["js/kiosk-idle.js"]"></script>
    @* Defines bwKioskPair; does nothing until /kiosk/pair calls it to submit its completion form.
       Deferred: that call is a user action, never at parse. *@
    <script defer src="@Assets["js/kiosk-pair.js"]"></script>
    @* Inert unless the page renders the kiosk PIN form; it only types into that form and submits it.
       Deferred: its listeners bind on/after DOM-ready and it defines no parse-time global. *@
    <script defer src="@Assets["js/kiosk-numpad.js"]"></script>
    <HeadOutlet />
    <title>Blocwerk</title>
</head>
@* data-bw-user is the id of whoever this page was rendered for, and nothing else. It is not a
   credential — it grants nothing and is never accepted as authentication — it exists so the offline
   queue can stamp each action it stores with the person who tapped it, instead of leaving the
   attribution to be decided by whoever happens to be signed in when the queue finally drains. That
   matters on any device several people share in sequence, kiosk tablets above all. The server
   re-checks the stamp against the real cookie identity on replay (OfflineActionOwnership), so a
   stale or forged value here can only ever get an action refused, never mis-attributed.

   It lives on <body> rather than in the layout because the auth-flow and home-wall pages use
   EmptyLayout, and it is correct on every page because every identity transition in the app is a
   real page load: the header Login/Logout links and the kiosk act-as/release forms all carry
   data-enhance-nav="false". *@

   @* data-bw-kiosk marks a kiosk tablet so the client can tell one apart — the kiosk cookie itself
      is HttpOnly and unreadable from JS. It gates ONE thing: the maintenance watchdog's new
      auto-reconnect reload, which reloads a kiosk off a rejected circuit once the server is reachable
      again (maintenance.js isKiosk()). It grants nothing and is only ever emitted when true, so a
      regular device simply never carries it. *@
<body data-bw-user="@ActingUserId" data-bw-kiosk="@(KioskContext.IsKiosk ? "true" : null)">
    <Routes />

    @* Blazor sets components-reconnect-* classes and raises components-reconnect-state-changed on
       this element. It lives outside <Routes /> so it exists before the circuit starts and is
       never touched by a re-render. wwwroot/js/blazor-boot.js listens on it; the branded UI is the
       status pill, so this element itself stays invisible. *@
    <div id="components-reconnect-modal" class="bw-reconnect-sentinel" aria-hidden="true"></div>

    @* Blazor unhides this on an unhandled exception on the circuit. Without it a failed
       server-side call is silent, which is how a button ends up stuck in its "busy" state
       with nothing shown to the user. *@
    <div id="blazor-error-ui">
        <div class="bw-error-ui-inner">
            <span class="bw-error-ui-text">Something went wrong. Anything you queued is still saved on this device.</span>
            <a class="bw-error-ui-action" href="javascript:location.reload()">Reload</a>
            <a class="bw-error-ui-dismiss"
               href="javascript:void(0)"
               title="Dismiss"
               onclick="document.getElementById('blazor-error-ui').style.display='none'">&times;</a>
        </div>
    </div>

    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script src="@Assets["js/image-res.js"]"></script>
    @* The shared wheel recogniser must load before both surfaces that page off a trackpad
       (the panel stepper in viewport.js and the carousel around it). *@
    <script src="@Assets["js/wheel-pager.js"]"></script>
    <script src="@Assets["js/viewport-gestures.js"]"></script>
    <script src="@Assets["js/viewport.js"]"></script>
    <script src="@Assets["js/wall-editor.js"]"></script>
    <script src="@Assets["js/wall-carousel.js"]"></script>
    @* After both of the modules it drives: it binds its listeners at parse and calls into
       bwViewport / wallCarousel lazily, so this order is what keeps it from ever seeing a
       half-defined global. One coordinator for orientationchange/resize for the whole app. *@
    <script src="@Assets["js/orientation.js"]"></script>
    @* The full-screen takeover. After viewport-gestures.js (it binds the shared recogniser) and
       after its own model; the lock last, because it reads bwStage in its watchdog — lazily, inside
       a function, so the order is for readability rather than load-bearing. Registered here like
       every other viewport helper so both files and css/fullscreen-stage.css are fingerprinted:
       editing an un-fingerprinted asset silently serves a stale one. *@
    <script src="@Assets["js/fullscreen-stage-model.js"]"></script>
    <script src="@Assets["js/fullscreen-stage.js"]"></script>
    <script src="@Assets["js/fullscreen-stage-lock.js"]"></script>
    @* Defines window.bwKeys before any interactive component can register against it. *@
    <script src="@Assets["js/keyboard-shortcuts.js"]"></script>
    <script src="@Assets["js/progression-chart.js"]"></script>
    <script src="@Assets["js/image-stitcher.js"]"></script>
    <script src="@Assets["js/file-download.js"]"></script>
    <script src="@Assets["js/beta-video.js"]"></script>
    <script src="@Assets["js/capture-video.js"]"></script>
    @* Small glue only; it lazy-loads the large lib/hls/hls.min.js on first playback of an HLS clip. *@
    <script src="@Assets["js/beta-hls.js"]"></script>
    @* bwViewport.blockPageZoom() is deliberately NOT called any more. It registered window-level
       preventDefault on ctrl/cmd+wheel and on every Safari gesture* event, i.e. it killed browser
       zoom across the whole app — which would have made the meta-viewport change above pointless.
       The photo surfaces do not need it: viewport-gestures.js binds the same preventDefaults on the
       viewport ELEMENT (target phase, so it always ran first anyway), so custom pinch there is
       unchanged and the browser cannot double-zoom on top of it. Everywhere else the page now zooms
       like any other website. The function itself is left in viewport.js, unused. *@
    <script src="@Assets["js/cookie-consent.js"]"></script>

    @* Order matters: the queue needs its store, the delegated click handler needs the queue, and
       blazor-boot.js starts the circuit last so the offline path is live even if the circuit
       never comes up. maintenance.js goes after it because it subscribes to
       window.blocwerkConnection, and before offline-status.js only for readability — the two read
       each other lazily off window, inside functions, so neither order can break the other. *@
    <script src="@Assets["js/offline-db.js"]"></script>
    <script src="@Assets["js/offline-transport.js"]"></script>
    <script src="@Assets["js/offline-queue.js"]"></script>
    <script src="@Assets["js/offline-actions.js"]"></script>
    <script src="@Assets["js/offline-boulder.js"]"></script>
    <script src="@Assets["js/blazor-boot.js"]"></script>
    @* Defines bwEditGuard before any editor component (which loads with the circuit, later) can call
       it, and before maintenance.js reads it in safeToReload(). Order is otherwise not load-bearing:
       both sides read window.bwEditGuard lazily, inside functions. *@
    <script src="@Assets["js/edit-guard.js"]"></script>
    <script src="@Assets["js/maintenance.js"]"></script>
    <script src="@Assets["js/offline-status.js"]"></script>
    <script src="@Assets["js/pwa.js"]"></script>
    @* Defines bwPush; inert until NotificationPrompt.razor / the profile notification card calls it.
       No parse-time event to catch (unlike install-prompt.js), so it loads with the deferred bundle. *@
    <script src="@Assets["js/push.js"]"></script>
</body>
</html>

@code {
    private string? ActingUserId;

    // Empty for anonymous pages, which is exactly right: an action queued with no known user stays
    // unstamped and keeps the pre-existing behaviour. GetCurrentUserAsync throws for anonymous
    // callers and is cached per request scope, so this costs nothing the page was not already paying.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await CurrentUserService.GetCurrentUserAsync();
            ActingUserId = user?.Id.ToString();
        }
        catch (UnauthorizedAccessException)
        {
            ActingUserId = null;
        }
    }
}
