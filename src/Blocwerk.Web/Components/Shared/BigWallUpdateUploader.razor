@inject IJSRuntime JS
@implements IAsyncDisposable

@* Entry to the big-wall update: pick the new CENTRE photo (required, grid 0,0) and any neighbour
   photos, each dropped into its direction slot (right = col+1, left = col-1, up = row-1, down = row+1).
   "Upload all wall-piece photos at once", then Start hands the assembled set to StageAsync.
   Large phone photos are downscaled client-side (image-downscale.js) so nothing is silently dropped;
   if a pick fails, its slot is flagged and Start stays disabled until it is fixed or removed.
   Every update re-declares whether the photos carry printed ArUco markers (defaulting to the wall's
   current setting); a changed answer is saved to the wall BEFORE staging, so StageAsync itself is
   unchanged and simply sees the wall's up-to-date setting. *@

<div class="bigupdate-uploader">
    <p class="hint">
        Upload the fresh photos of your wall. The <strong>centre</strong> photo is required and becomes the
        new middle of the wall; drop each neighbouring photo into the direction it sits, relative to the centre.
        Your old holds (and their boulders) are matched onto the new centre so nothing is lost.
    </p>

    <div class="bigupdate-slots">
        @foreach (var slot in _slots)
        {
            <div class="bigupdate-slot @(slot.Required ? "required" : "") @(slot.HasFile ? "filled" : "") @(slot.Invalid ? "invalid" : "")">
                <div class="bigupdate-slot-head">
                    <span class="bigupdate-slot-label">@slot.Label</span>
                    @if (slot.Required)
                    {
                        <span class="bigupdate-slot-req">required</span>
                    }
                </div>
                @if (slot.HasFile)
                {
                    <span class="bigupdate-slot-file">@slot.FileName</span>
                    <button class="btn-link" @onclick="() => Clear(slot)" disabled="@_busy">Remove</button>
                }
                else
                {
                    <label class="bigupdate-slot-pick">
                        <span class="panel-add-plus">+</span>
                        <InputFile id="@slot.InputId" OnChange="e => OnSlotFile(e, slot)" accept="image/*"
                                   class="panel-add-input" disabled="@(_busy || slot.Working)" />
                    </label>
                    @if (slot.Working)
                    {
                        <span class="bigupdate-slot-file">Preparing…</span>
                    }
                    else if (slot.Invalid)
                    {
                        <span class="bigupdate-slot-error">@(slot.Error ?? "Could not use this photo — pick another.")</span>
                    }
                }
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="staged-hint danger">@_error</p>
    }
    else if (AnyInvalid)
    {
        <p class="staged-hint danger">One of your photos could not be used. Pick another for the flagged slot, or remove it, before starting.</p>
    }
    else if (AnyWorking)
    {
        <p class="staged-hint">A photo is still being prepared — large images take a moment. Start will enable once it is ready.</p>
    }

    @if (markers.Loaded)
    {
        <WallMarkerDeclaration Label="@WallMarkerDeclarationState.WholeWallLabel"
                               Hint="@(markers.HintFor("Tick this if the printed marker sheets are on the wall in these photos. Leave it off for a wall without markers."))"
                               @bind-Enabled="markers.Enabled" @bind-SizeMm="markers.SizeMm" Disabled="_busy" />
    }

    <div class="staged-actions">
        <button class="btn-primary" @onclick="Start" disabled="@(_busy || !CentreReady || AnyInvalid || AnyWorking)">
            @(_busy ? "Preparing…" : "Start update")
        </button>
        <button class="btn-secondary" @onclick="() => OnCancel.InvokeAsync()" disabled="@_busy">Cancel</button>
    </div>
</div>

@code {
    [Parameter] public EventCallback<IReadOnlyList<BigUpdatePhoto>> OnStart { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    // The server upload cap. A file at or under it is staged as-is; a larger one is downscaled
    // client-side to fit, so a big phone photo works instead of being silently dropped.
    private const long MaxBytes = 10 * 1024 * 1024;

    // Downscale target: long edge in pixels and JPEG quality. 2560px keeps ample detail for hold
    // detection while bringing a 15-20 MP photo comfortably under the cap.
    private const int MaxLongEdge = 2560;
    private const double JpegQuality = 0.85;

    private bool _busy;
    private string? _error;
    private IJSObjectReference? _module;

    private readonly List<BigWallUpdateUploaderSlot> _slots = BigWallUpdateUploaderSlot.CreateAll();

    private bool CentreReady => _slots[0].HasFile;

    // Safety net: any slot whose last pick failed keeps Start disabled so an update can never begin
    // with a missing / failed panel.
    private bool AnyInvalid => _slots.Any(s => s.Invalid);

    private bool AnyWorking => _slots.Any(s => s.Working);

    private async Task<IJSObjectReference?> EnsureModuleAsync()
    {
        if (_module is not null)
        {
            return _module;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/image-downscale.js");
        }
        catch (JSException)
        {
            // Module could not load; the direct-read + safety-net path below still applies.
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away; nothing to attach to.
        }

        return _module;
    }

    private async Task OnSlotFile(InputFileChangeEventArgs e, BigWallUpdateUploaderSlot slot)
    {
        _error = null;
        slot.Invalid = false;
        slot.Error = null;
        slot.Working = true;

        var file = e.File;
        try
        {
            if (file.Size <= MaxBytes)
            {
                // Already within the cap: stage the original bytes, no re-encode, best quality.
                using var stream = file.OpenReadStream(MaxBytes);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                slot.Bytes = ms.ToArray();
                slot.ContentType = string.IsNullOrEmpty(file.ContentType) ? "image/jpeg" : file.ContentType;
                slot.FileName = file.Name;
                return;
            }

            // Too large for a direct upload: downscale it client-side so it just works.
            var bytes = await TryDownscaleAsync(slot);
            if (bytes is { Length: > 0 } && bytes.Length <= MaxBytes)
            {
                slot.Bytes = bytes;
                slot.ContentType = "image/jpeg";
                slot.FileName = DownscaledName(file.Name);
                return;
            }

            // Downscale failed / unsupported: flag the slot so Start stays disabled.
            slot.Bytes = null;
            slot.ContentType = null;
            slot.FileName = null;
            slot.Invalid = true;
            slot.Error = $"{slot.Label} photo is too large and could not be resized here — try a smaller photo.";
        }
        catch (Exception ex)
        {
            slot.Bytes = null;
            slot.ContentType = null;
            slot.FileName = null;
            slot.Invalid = true;
            slot.Error = $"Could not read {slot.Label} photo: {ex.Message}";
        }
        finally
        {
            slot.Working = false;
        }
    }

    private async Task<byte[]?> TryDownscaleAsync(BigWallUpdateUploaderSlot slot)
    {
        var module = await EnsureModuleAsync();
        if (module is null)
        {
            return null;
        }

        try
        {
            var streamRef = await module.InvokeAsync<IJSStreamReference?>(
                "downscaleFromInput", slot.InputId, MaxLongEdge, JpegQuality);
            if (streamRef is null)
            {
                return null;
            }

            await using var stream = await streamRef.OpenReadStreamAsync(MaxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            return ms.ToArray();
        }
        catch (JSException)
        {
            return null;
        }
        catch (JSDisconnectedException)
        {
            return null;
        }
    }

    private static string DownscaledName(string original)
    {
        var baseName = Path.GetFileNameWithoutExtension(original);
        return string.IsNullOrEmpty(baseName) ? "photo.jpg" : $"{baseName}.jpg";
    }

    private void Clear(BigWallUpdateUploaderSlot slot)
    {
        slot.Bytes = null;
        slot.ContentType = null;
        slot.FileName = null;
        slot.Invalid = false;
        slot.Error = null;
    }

    /// <summary>
    /// Keyboard entry point for the wizard's Enter binding. It mirrors the Start button's own
    /// disabled state so a shortcut can never begin an update the button would refuse to — a key
    /// pressed while a photo is still being prepared has to be a silent no-op, not an early start.
    /// </summary>
    public async Task TryStartAsync()
    {
        if (_busy || !CentreReady || AnyInvalid || AnyWorking)
        {
            return;
        }

        await Start();
        StateHasChanged();
    }

    private async Task Start()
    {
        if (!CentreReady)
        {
            _error = "A centre photo is required.";
            return;
        }

        // _busy is checked first and set before the first await: a double tap arrives before the
        // disabled button reaches the phone, and the awaited marker save widens that window.
        if (_busy || AnyInvalid || AnyWorking)
        {
            return;
        }

        _busy = true;
        if (!await DeclareMarkersAsync())
        {
            _busy = false;
            return;
        }

        var photos = _slots
            .Where(s => s.HasFile)
            .Select(s => new BigUpdatePhoto(s.Bytes!, s.ContentType!, s.Col, s.Row))
            .ToList();

        await OnStart.InvokeAsync(photos);
        _busy = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone.
        }
    }
}
