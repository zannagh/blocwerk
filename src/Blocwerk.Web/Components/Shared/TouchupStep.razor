@* The manual hold touch-up surface, used twice: pre-match (right after detection) and as the final
   pass before confirm — same behaviour, only the copy differs. Correct the model's detection across
   every staged panel: add missed holds, drag/resize holds into place, delete strays. These are
   detection corrections, so nothing here flags a hold or boulder for review. See TouchupStep.razor.cs. *@

@if (_loading)
{
    <p class="loading-small">Loading the staged holds…</p>
}
else
{
    <div class="bigupdate-phase">
        <div class="bigupdate-step-label">@Heading</div>

        <div class="bigupdate-attention clear" role="status">
            <strong class="bigupdate-attention-head">@Lead</strong>
            <span class="bigupdate-attention-sub">
                @if (LeadDetail is not null)
                {
                    @LeadDetail
                }
                else
                {
                    <text>
                        These are corrections of the automatic detection — they will <strong>not</strong> flag any
                        hold or boulder as changed or for review. Only holds you explicitly mark elsewhere are.
                    </text>
                }
            </span>
        </div>

        @if (_panels.Count > 1)
        {
            <div class="bigupdate-primary-actions" role="tablist" aria-label="Staged panels">
                @for (var i = 0; i < _panels.Count; i++)
                {
                    var index = i;
                    <button class="btn-secondary @(index == _panelIndex ? "active" : "")"
                            role="tab" aria-selected="@(index == _panelIndex)"
                            @onclick="() => SelectPanel(index)">
                        @_panels[index].Label
                    </button>
                }
            </div>
        }

        @if (CurrentPanel is { } panel)
        {
            <div class="panel-step-solo">
                <PanelImageView @key="panel.PanelId" WallId="WallId" Caption="@panel.Label"
                                PhotoUrl="@StagedPhotoUrl(panel.PanelId)"
                                Holds="_holds"
                                Editable="true" AddMode="@(_tool == HoldTouchupTool.Add)"
                                SelectedHoldId="_selectedHoldId"
                                ExactHitTargets="@(_tool == HoldTouchupTool.Delete)"
                                OnHoldTap="OnHoldTapAsync"
                                OnEmptyTap="OnEmptyTap"
                                OnHoldGeometryChanged="OnHoldGeometryChanged" />
            </div>

            <div class="bigupdate-edit-tools">
                <span class="hint">
                    Pick <strong>+</strong> to add a hold the detector missed, the <strong>pipette</strong> to copy
                    an existing hold's size onto the ones you add next, or the <strong>bin</strong> to delete a false
                    detection. Drag a hold to reposition it; the <strong>size slider</strong> resizes the selected hold.
                </span>
                <HoldTouchupToolbar Tool="_tool" ToolChanged="SetTool"
                                    Size="_newHoldRadius" SizeChanged="OnSizeChanged"
                                    OnSizeCommitted="OnSizeCommittedAsync"
                                    HasSelection="@(_selectedHoldId is not null)" />
            </div>
        }

        <div class="staged-actions">
            <button class="btn-primary" @onclick="() => OnContinue.InvokeAsync()">Continue →</button>
            <button class="btn-secondary" @onclick="() => OnSkip.InvokeAsync()">Skip touch-up</button>
        </div>
    </div>
}
