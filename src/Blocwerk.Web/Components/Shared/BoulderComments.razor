@inject ICommentService CommentService
@inject WallCacheState Cache
@using Blocwerk.Web.State.Live
@implements IDisposable

@*
    The comment list plus its (circuit-independent) compose box. Owns its own paging and its own
    delete, so the boulder page keeps none of that state. Posting is NOT handled here: the submit
    button in BoulderCommentForm goes through the offline queue, and BoulderDetail calls
    ReloadAsync() through an @ref once the queue confirms the comment landed.

    Live (design §5.5): other people's comments arrive through the feed and are patched in by id
    (CommentList). The compose box is never touched by a patch: its draft is owned by the DOM (an
    unbound input) and it sits outside the keyed rows, so a comment landing while someone types
    neither re-creates the input nor moves it.
*@

<div class="comments-section">
    <h2>Comments</h2>
    @if (!IsAnonymous)
    {
        <BoulderCommentForm BoulderId="BoulderId" />
    }

    @if (_loaded)
    {
        @foreach (var comment in _list.Rows)
        {
            <div class="comment-row" @key="comment.Id">
                <div class="comment-header">
                    <UserAvatar UserId="comment.Author.Id" Name="@comment.Author.Name"
                                HasAvatar="comment.Author.HasAvatar" CssClass="avatar-sm" />
                    <span class="comment-author">@comment.Author.Name</span>
                    <span class="comment-time"><LocalTime Value="@comment.CreatedAt" Format="LocalTimeFormat.Relative" /></span>
                    @if (CurrentUserId != Guid.Empty && comment.OwnerId == CurrentUserId)
                    {
                        <button class="delete-btn" @onclick="() => DeleteAsync(comment.Id)">x</button>
                    }
                </div>
                <p class="comment-text">@comment.Text</p>
            </div>
        }
        @if (_list.Rows.Count == 0)
        {
            <p class="empty-msg">No comments yet.</p>
        }
        @if (_list.HasMore)
        {
            <button class="pager-btn" @onclick="LoadMoreAsync">Load more</button>
        }
    }

    @if (_error != null)
    {
        <div class="error-msg">@_error</div>
    }
</div>

@code {
    [Parameter] public Guid BoulderId { get; set; }

    /// <summary>The boulder's wall, whose feed keeps the list live.</summary>
    [Parameter] public Guid WallId { get; set; }

    [Parameter] public Guid CurrentUserId { get; set; }

    [Parameter] public bool IsAnonymous { get; set; }

    private CommentList _list = new();
    private LeafFeed? _feed;
    private (Guid Wall, Guid Boulder)? _key;
    private bool _loaded;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        if (_key == (WallId, BoulderId))
        {
            return;
        }

        _key = (WallId, BoulderId);
        _list = new CommentList();
        _feed?.Dispose();
        _feed = WallId == Guid.Empty
            ? null
            : LeafFeed.Open(Cache, new LeafScope(WallId, BoulderId, CommentList.Kinds), InvokeAsync, ApplyAsync);
        await LoadAsync();
    }

    /// <summary>Re-reads the loaded window (every "load more" page so far).</summary>
    public Task ReloadAsync() => LoadAsync();

    public void Dispose() => _feed?.Dispose();

    private Task LoadMoreAsync()
    {
        _list.Grow();
        return LoadAsync();
    }

    // On the dispatcher. A patch that cannot be applied from the event alone re-reads.
    private async Task ApplyAsync(LeafBatch batch)
    {
        if (_list.Apply(batch))
        {
            await LoadAsync();
            return;
        }

        StateHasChanged();
    }

    // Renders itself at the end. ReloadAsync is called from outside this component's own event
    // dispatch (BoulderDetail's [JSInvokable] queue-flush callback), where nothing re-renders it
    // automatically; depending on the caller to do it meant a failure anywhere else in that
    // callback left a freshly loaded list sitting unrendered until the next navigation.
    private async Task LoadAsync()
    {
        try
        {
            var read = () => CommentService.GetCommentsAsync(BoulderId, 0, _list.Window);
            var (items, total) = _feed is { } feed ? await feed.LoadAsync(read) : await read();
            _list.Load(items, total, _feed?.Viewer);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"Comments could not be loaded: {ex.Message}";
        }

        _loaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteAsync(Guid commentId)
    {
        try
        {
            await CommentService.DeleteCommentAsync(commentId);
            _list.Drop(commentId);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"That comment could not be deleted: {ex.Message}";
        }
    }
}
