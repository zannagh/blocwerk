@using Blocwerk.Core.LookOver
@using Blocwerk.Core.Refresh
@* One finding of the look-over, laid out like a card of the confirm screen (old photo, new photo, 3D texture), with
   the boulders that use the hold and the answers it takes now from this user. Every answer that changes the wall
   asks first, naming the boulders, and is sent with exactly those boulders; only what removes or merges asks in red.
   An answered card keeps its place and its pictures, says what was answered and by whom, and offers Undo when the
   answer changed nothing on the wall. Undo sits at the far end of the row, away from where the answer was tapped. *@

<li class="refresh-check @(Open ? null : "is-answered")" tabindex="-1" @ref="card">
    <p class="refresh-check-title"><strong>@LookOverCopy.Heading(Finding)</strong> @LookOverCopy.Detail(Finding)</p>
    <div class="refresh-check-crops">
        @foreach (var (view, caption, alt) in Pictures)
        {
            <figure>
                <button type="button" class="lookover-crop" @onclick="() => zoomed = true" aria-label="@($"Show larger: {alt}")">
                    <img loading="lazy" onerror="this.closest('figure').style.display='none'" src="@Crop(view)" alt="@alt" />
                </button>
                <figcaption>@caption</figcaption>
            </figure>
        }
    </div>
    @if (Finding.Boulders.Count > 0)
    {
        <p class="lookover-boulders">
            <span>@(Finding.Boulders.Count == 1 ? "Boulder:" : "Boulders:")</span>
            @foreach (var boulder in Finding.Boulders)
            {
                <a href="/walls/@WallId/boulders/@boulder.Id">@boulder.Name</a>
            }
        </p>
    }
    <div class="refresh-check-actions">
        @if (!Open)
        {
            <span class="refresh-badge is-user">@LookOverCopy.AnsweredLabel(Finding)</span>
            @if (Finding.CanUndo)
            {
                <button type="button" class="btn-link lookover-undo" disabled="@Disabled" @onclick="() => OnUndo.InvokeAsync(Finding.Id)">Undo</button>
            }
        }
        else
        {
            @if (Finding.Answers.Contains(LookOverAnswer.Settle))
            {
                <button type="button" class="btn-secondary" disabled="@Disabled" @onclick="() => AnswerAsync(LookOverAnswer.Settle)">@LookOverCopy.SettleLabel(Finding)</button>
            }
            @if (Finding.Answers.Contains(LookOverAnswer.DifferentHold))
            {
                <ConfirmAction Label="Different hold" Question="@LookOverCopy.DifferentQuestion(Finding)" ConfirmLabel="Mark as a different hold"
                               ConfirmClass="btn-primary" Neutral="true" Disabled="Disabled" OnConfirm="() => AnswerAsync(LookOverAnswer.DifferentHold)" />
            }
            @if (Finding.Answers.Contains(LookOverAnswer.UseNewHold))
            {
                <ConfirmAction Label="@LookOverCopy.MergeLabel(Finding)" Question="@LookOverCopy.UseNewQuestion(Finding)" ConfirmLabel="Merge into the new hold"
                               Disabled="Disabled" OnConfirm="() => AnswerAsync(LookOverAnswer.UseNewHold)" />
            }
            @if (Finding.Answers.Contains(LookOverAnswer.RemoveHold))
            {
                <ConfirmAction Label="@LookOverCopy.RemoveLabel(Finding)" Question="@LookOverCopy.RemoveQuestion(Finding)" ConfirmLabel="Remove the hold"
                               Disabled="Disabled" OnConfirm="() => AnswerAsync(LookOverAnswer.RemoveHold)" />
            }
        }
    </div>
    @if (!Open && LookOverCopy.ResultLine(Finding) is { } result)
    {
        <p class="hint">@result</p>
    }
    @if (Open && Finding.MergeNeedsAdmin)
    {
        <p class="hint">A new hold sits on this spot. A wall admin can merge the old hold into it instead of removing it.</p>
    }
</li>

@if (zoomed)
{
    <Modal Title="@LookOverCopy.Heading(Finding)" PanelClass="lookover-zoom" OnClose="() => zoomed = false">
        <div class="lookover-zoom-pictures">
            @foreach (var (view, caption, alt) in Pictures)
            {
                <figure>
                    <img onerror="this.closest('figure').style.display='none'" src="@Crop(view)" alt="@alt" />
                    <figcaption>@caption</figcaption>
                </figure>
            }
        </div>
        <button type="button" class="btn-secondary" @onclick="() => zoomed = false">Close</button>
    </Modal>
}

@code {
    private ElementReference card;
    private bool zoomed;
    private bool focused;

    [Parameter, EditorRequired]
    public Guid WallId { get; set; }

    [Parameter, EditorRequired]
    public LookOverFindingView Finding { get; set; } = default!;

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>The card was just answered or reopened: it takes the focus, so no other card's button has it.</summary>
    [Parameter]
    public bool Focus { get; set; }

    [Parameter]
    public EventCallback<LookOverChoice> OnAnswer { get; set; }

    [Parameter]
    public EventCallback<Guid> OnUndo { get; set; }

    private bool Open => Finding.Status == LookOverFindingStatus.Open;

    private IEnumerable<(CheckCropView View, string Caption, string Alt)> Pictures
    {
        get
        {
            if (Finding.HasOld)
            {
                yield return (CheckCropView.Old, "Before the update", "the old photo around this hold");
            }

            yield return (CheckCropView.New, "Now", "the current photo around this spot");
            if (Finding.HasModel)
            {
                yield return (CheckCropView.Model, "3D texture", "the 3D texture around this spot");
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Focus)
        {
            focused = false;
            return;
        }

        if (focused)
        {
            return;
        }

        focused = true;
        try
        {
            await card.FocusAsync(preventScroll: true);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            // Cosmetic: the answer is saved whether or not the card could take the focus.
        }
    }

    private string Crop(CheckCropView view) => WallLookOverCropEndpoint.Url(WallId, Finding.Id, view);

    /// <summary>The answer goes out with the boulders this card shows: the server refuses when they are not the ones on the hold any more.</summary>
    private Task AnswerAsync(LookOverAnswer answer) =>
        OnAnswer.InvokeAsync(new LookOverChoice(Finding.Id, answer, [.. Finding.Boulders.Select(b => b.Id)]));
}
