@using Blocwerk.Core.LookOver
@using Blocwerk.Core.Refresh
@* One finding of the look-over, laid out like a card of the confirm screen (old photo, new photo, 3D texture), with
   the boulders that use the hold and the answers it takes now from this user. Every answer that changes the wall
   asks first, naming the boulders, and is sent with exactly those boulders; only what removes or merges asks in red.
   The pictures show the holds' real outlines, as on the wall (LookOverPictureView).
   An answered card keeps its place and its pictures, says what was answered and by whom, and offers Undo when the
   answer changed nothing on the wall. A finding the hold editor dealt with says so and takes no answer. Undo sits at
   the far end of the row, away from where the answer was tapped. *@

<li class="refresh-check @(Open ? null : "is-answered")" tabindex="-1" @ref="card">
    <p class="refresh-check-title"><strong>@LookOverCopy.Heading(Finding)</strong> @LookOverCopy.Detail(Finding)</p>
    <div class="refresh-check-crops">
        @foreach (var picture in Pictures)
        {
            <button type="button" class="lookover-crop" @onclick="() => zoomed = true" aria-label="Show the pictures larger">
                <LookOverPictureView WallId="WallId" FindingId="Finding.Id" Picture="picture" Linked="@(Finding.Kind == LookOverFindingKind.UnsureLink)" />
            </button>
        }
    </div>
    @if (Finding.Boulders.Count > 0)
    {
        <p class="lookover-boulders">
            <span>@(Finding.Boulders.Count == 1 ? "Boulder:" : "Boulders:")</span>
            @foreach (var boulder in Finding.Boulders)
            {
                <a href="/walls/@WallId/boulders/@boulder.Id">@boulder.Name</a>
            }
        </p>
    }
    <div class="refresh-check-actions">
        @if (!Open)
        {
            <span class="refresh-badge is-user">@LookOverCopy.AnsweredLabel(Finding)</span>
            @if (Finding.CanUndo)
            {
                <button type="button" class="btn-link lookover-undo" disabled="@Disabled" @onclick="() => OnUndo.InvokeAsync(Finding.Id)">Undo</button>
            }
        }
        else
        {
            @if (Finding.Answers.Contains(LookOverAnswer.Settle))
            {
                <button type="button" class="btn-secondary" disabled="@Disabled" @onclick="() => AnswerAsync(LookOverAnswer.Settle)">@LookOverCopy.SettleLabel(Finding)</button>
            }
            @if (Finding.Answers.Contains(LookOverAnswer.Unlink))
            {
                <button type="button" class="btn-secondary" disabled="@Disabled" @onclick="() => AnswerAsync(LookOverAnswer.Unlink)">@LookOverCopy.UnlinkLabel</button>
            }
            @if (Finding.Answers.Contains(LookOverAnswer.ConfirmMove))
            {
                <ConfirmAction Label="@LookOverCopy.ConfirmMoveLabel" Question="@LookOverCopy.ConfirmMoveQuestion(Finding)" ConfirmLabel="Mark as moved"
                               ConfirmClass="btn-primary" Neutral="true" Disabled="Disabled" OnConfirm="() => AnswerAsync(LookOverAnswer.ConfirmMove)" />
            }
            @if (Finding.Answers.Contains(LookOverAnswer.DifferentHold))
            {
                <ConfirmAction Label="Different hold" Question="@LookOverCopy.DifferentQuestion(Finding)" ConfirmLabel="Mark as a different hold"
                               ConfirmClass="btn-primary" Neutral="true" Disabled="Disabled" OnConfirm="() => AnswerAsync(LookOverAnswer.DifferentHold)" />
            }
            @if (Finding.Answers.Contains(LookOverAnswer.UseNewHold))
            {
                <ConfirmAction Label="@LookOverCopy.MergeLabel(Finding)" Question="@LookOverCopy.UseNewQuestion(Finding)"
                               ConfirmLabel="@LookOverCopy.UseNewConfirmLabel(Finding, declined.Count)" Disabled="Disabled" OnConfirm="UseNewHoldAsync">
                    @if (Finding.Boulders.Count > 0)
                    {
                        <LookOverNewHoldPicker FindingId="Finding.Id" Boulders="Finding.Boulders" Declined="declined" Disabled="Disabled" OnChanged="StateHasChanged" />
                    }
                </ConfirmAction>
            }
            @if (Finding.Answers.Contains(LookOverAnswer.RemoveHold))
            {
                <ConfirmAction Label="@LookOverCopy.RemoveLabel(Finding)" Question="@LookOverCopy.RemoveQuestion(Finding)" ConfirmLabel="Remove the hold"
                               Disabled="Disabled" OnConfirm="() => AnswerAsync(LookOverAnswer.RemoveHold)" />
            }
        }
    </div>
    @if (!Open && LookOverCopy.ResultLine(Finding) is { } result)
    {
        <p class="hint">@result</p>
    }
    @if (Open && Finding.MergeNeedsAdmin)
    {
        <p class="hint">A new hold sits on this spot. A wall admin can merge the old hold into it instead of removing it.</p>
    }
</li>

@if (zoomed)
{
    @* Close comes first: the dialog moves the focus to its first control, and with Close at the bottom that scrolled
       the first picture out of view. *@
    <Modal Title="@LookOverCopy.Heading(Finding)" PanelClass="lookover-zoom" OnClose="() => zoomed = false">
        <button type="button" class="btn-secondary lookover-zoom-close" @onclick="() => zoomed = false">Close</button>
        <div class="lookover-zoom-pictures">
            @foreach (var picture in Pictures)
            {
                <LookOverPictureView WallId="WallId" FindingId="Finding.Id" Picture="picture" Linked="@(Finding.Kind == LookOverFindingKind.UnsureLink)" Eager="true" />
            }
        </div>
    </Modal>
}

@code {
    private ElementReference card;
    private bool zoomed;

    /// <summary>The boulders answered no to "use the new hold" (yes by default).</summary>
    private readonly HashSet<Guid> declined = [];
    private Guid declinedFor;
    private int focusedFor;

    [Parameter, EditorRequired]
    public Guid WallId { get; set; }

    [Parameter, EditorRequired]
    public LookOverFindingView Finding { get; set; } = default!;

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Non-zero on the card that was just answered or reopened, and different each time: the card takes the focus once
    /// per value, so no other card's button has it, also when the same card is answered, undone and answered again.
    /// </summary>
    [Parameter]
    public int FocusFor { get; set; }

    [Parameter]
    public EventCallback<LookOverChoice> OnAnswer { get; set; }

    [Parameter]
    public EventCallback<Guid> OnUndo { get; set; }

    /// <summary>A card shown for another finding starts again from yes for every boulder.</summary>
    protected override void OnParametersSet()
    {
        if (declinedFor != Finding.Id)
        {
            declinedFor = Finding.Id;
            declined.Clear();
        }
    }

    private bool Open => Finding.Status == LookOverFindingStatus.Open;

    /// <summary>The pictures as the list sends them (with the holds to outline); the plain three when it sent none.</summary>
    private IReadOnlyList<LookOverPicture> Pictures => Finding.Pictures ?? Fallback();

    private List<LookOverPicture> Fallback()
    {
        var pictures = new List<LookOverPicture>();
        if (Finding.HasOld)
        {
            pictures.Add(new LookOverPicture(CheckCropView.Old, []));
        }

        pictures.Add(new LookOverPicture(CheckCropView.New, []));
        if (Finding.HasModel)
        {
            pictures.Add(new LookOverPicture(CheckCropView.Model, []));
        }

        return pictures;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusFor == 0 || FocusFor == focusedFor)
        {
            return;
        }

        focusedFor = FocusFor;
        try
        {
            await card.FocusAsync(preventScroll: true);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            // Cosmetic: the answer is saved whether or not the card could take the focus.
        }
    }

    /// <summary>The answer goes out with the boulders this card shows: the server refuses when they are not the ones on the hold any more.</summary>
    private Task AnswerAsync(LookOverAnswer answer) =>
        OnAnswer.InvokeAsync(new LookOverChoice(Finding.Id, answer, [.. Finding.Boulders.Select(b => b.Id)]));

    /// <summary>
    /// "Use the new hold" with the per-boulder answers: every boulder yes is the merge (no list), otherwise the list of the
    /// yes boulders goes along (empty when every boulder said no: the old hold is gone).
    /// </summary>
    private Task UseNewHoldAsync()
    {
        var shown = Finding.Boulders.Select(b => b.Id).ToList();
        var yes = shown.Where(id => !declined.Contains(id)).ToList();
        return OnAnswer.InvokeAsync(new LookOverChoice(Finding.Id, LookOverAnswer.UseNewHold, shown, yes.Count == shown.Count ? null : yes));
    }
}
