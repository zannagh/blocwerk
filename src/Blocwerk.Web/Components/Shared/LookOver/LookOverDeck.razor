@using Blocwerk.Core.LookOver
@* The look-over on the card deck (CardDeck): the open findings one at a time, in one queue. An answered card leaves
   the queue and the next one is shown; the last answer stays in a bar above the answers, with Undo where it can be
   taken back. A number key gives the answer with that number, U takes the last one back. On a wide screen the queue
   is listed beside the card, a stretch of it around the current card. *@

<CardDeck Count="Queue.Count" Index="Index" Label="@(Current is { } shown ? LookOverCopy.QueueLabel(shown) : null)" OnStep="Step" OnKey="OnKeyAsync"
          Empty="Empty" Note="@(LastAnswered is null ? null : LastAnswerNote)" QueueList="QueueRows">
    @if (Current is { Missing: true } missing)
    {
        <LookOverMissing @key="missing.Id" @ref="missingCard" WallId="WallId" Finding="missing" Disabled="Disabled" Version="Version"
                         OnAnswer="AnswerAsync" OnAct="ActAsync" />
    }
    else if (Current is { } finding)
    {
        <LookOverDeckCard @key="finding.Id" @ref="card" WallId="WallId" Finding="finding" Disabled="Disabled" OnAnswer="AnswerAsync" />
    }
</CardDeck>

@code {
    private RenderFragment LastAnswerNote => @<p class="deck-undo" role="status">
        @if (LastAnswered is { } last)
        {
            <span>@LookOverCopy.AnsweredLabel(last)@(LookOverCopy.ResultLine(last) is { } result ? $". {result}" : null)</span>
            @if (last.CanUndo)
            {
                <button type="button" class="btn-link" disabled="@Disabled" @onclick="() => UndoLastAsync(last.Id)">Undo</button>
            }
            <button type="button" class="btn-link deck-undo-close" @onclick="() => lastId = null" aria-label="Hide this note">&times;</button>
        }
    </p>;

    private RenderFragment QueueRows => @<text>
        @if (WindowStart > 0)
        {
            <p class="deck-queue-more">@WindowStart earlier</p>
        }
        <ol start="@(WindowStart + 1)">
            @foreach (var item in Window)
            {
                <li @key="item.Id">
                    <button type="button" class="@(item.Id == Current?.Id ? "is-current" : null)" aria-current="@(item.Id == Current?.Id ? "true" : null)"
                            @onclick="() => JumpTo(item.Id)">
                        <span>@LookOverCopy.QueueLabel(item)</span>
                        <small>@(item.HoldName ?? "hold")@(item.Boulders.Count > 0 ? $" · {PlainCopy.Plural(item.Boulders.Count, "boulder")}" : null)</small>
                    </button>
                </li>
            }
        </ol>
        @if (WindowStart + Window.Count < Queue.Count)
        {
            <p class="deck-queue-more">@(Queue.Count - WindowStart - Window.Count) more</p>
        }
    </text>;
}
