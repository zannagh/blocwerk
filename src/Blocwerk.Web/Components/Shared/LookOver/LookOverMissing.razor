@using Blocwerk.Core.LookOver
@using Blocwerk.Core.Refresh
@* "Holds the update could not find": one hold at a time. On the left (on a phone: in a strip that stays in view) the
   hold as it was, with its real outline on the photo from before the update; on the right the photo of its panel as
   it is now, to pan and zoom, with the holds the update found and a dashed outline where the old hold was. The user
   says it is still here, taps the hold it is, taps where it is, or says it is not there any more; every answer but
   "still here" asks first. Below that, the holds no boulder uses that lie under a new hold can be removed at once, after a
   question that says how many. Holds are asked about on their own panel's photo only (a merge works within one photo). *@

<section class="lookover-group lookover-missing">
    <div class="lookover-missing-title">
        <h2>@LookOverCopy.MissingTitle</h2>
        <span class="lookover-group-count @(Queue.Count == 0 ? "is-done" : null)">@(Queue.Count == 0 ? "all answered" : $"{Queue.Count} open")</span>
    </div>
    <p class="hint">@LookOverCopy.MissingHint</p>
    @if (notice is not null)
    {
        <p class="lookover-chip" role="status">@notice</p>
    }

    @if (Current is { } finding)
    {
        <div class="lookover-missing-body">
            <div class="lookover-missing-old">
                <div class="lookover-stepper">
                    <button type="button" class="btn-secondary" disabled="@(Queue.Count < 2)" @onclick="() => Step(-1)" aria-label="Previous hold">&lsaquo;</button>
                    <span role="status">Hold @(Index + 1) of @Queue.Count</span>
                    <button type="button" class="btn-secondary" disabled="@(Queue.Count < 2)" @onclick="() => Step(1)" aria-label="Next hold">&rsaquo;</button>
                </div>
                <div class="lookover-missing-was">
                    @if (Before(finding) is { } before)
                    {
                        <LookOverPictureView @key="finding.Id" WallId="WallId" FindingId="finding.Id" Picture="before" Eager="true" />
                    }
                    <div class="lookover-missing-about">
                        <strong>@(finding.HoldName is { } name ? $"The {name} hold" : "This hold")@(finding.Covered ? ", under a new hold" : null)</strong>
                        <p>@LookOverCopy.MissingQuestion</p>
                        @if (finding.Boulders.Count > 0)
                        {
                            <p class="lookover-boulders">
                                <span>@(finding.Boulders.Count == 1 ? "Boulder:" : "Boulders:")</span>
                                @foreach (var boulder in finding.Boulders)
                                {
                                    <a href="/walls/@WallId/boulders/@boulder.Id">@boulder.Name</a>
                                }
                            </p>
                        }
                        else
                        {
                            <p class="hint">No boulder uses it.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="lookover-missing-wall">
                @if (CanMove(finding))
                {
                    <p class="hint">@(finding.CanReassign ? LookOverCopy.TapHint : LookOverCopy.ReassignNeedsAdmin)</p>
                }
                @if (finding.PanelId is { } panelId)
                {
                    <PanelImageView WallId="WallId" Caption="The wall now" PhotoUrl="@PhotoUrl(panelId)" Holds="PanelHolds(panelId)"
                                    Ghost="Ghost(finding)" GhostMovedTo="movedTo" SelectedHoldId="targetId"
                                    Interactive="finding.CanReassign" AddMode="CanMove(finding)" OnHoldTap="ChooseHold" OnEmptyTap="ChooseSpot"
                                    FocusKey="focusKey" FocusPoint="Spot(finding)" FocusZoom="3" />
                }

                @if (Target(finding) is { } target)
                {
                    <div class="lookover-ask" role="group" aria-label="It is this hold">
                        <p>@LookOverCopy.ReassignQuestion(finding)</p>
                        <div class="lookover-ask-pictures">
                            @if (Before(finding) is { } was)
                            {
                                <LookOverPictureView WallId="WallId" FindingId="finding.Id" Picture="was" Eager="true" />
                            }
                            <LookOverSpotView PhotoUrl="@PhotoUrl(finding.PanelId!.Value)" Hold="target" X="target.X" Y="target.Y" Caption="The hold you tapped" Alt="the hold you tapped on the new photo" />
                        </div>
                        <div class="lookover-ask-buttons">
                            <button type="button" class="btn-primary" disabled="@Disabled" @onclick="() => ReassignAsync(finding, target.Id)">It is this hold</button>
                            <button type="button" class="btn-secondary" disabled="@Disabled" @onclick="ClearChoice">Cancel</button>
                        </div>
                    </div>
                }
                else if (movedTo is { } to && Ghost(finding) is { } ghost)
                {
                    <div class="lookover-ask" role="group" aria-label="It is here">
                        <p>@LookOverCopy.MoveQuestion(finding)</p>
                        <div class="lookover-ask-pictures">
                            <LookOverSpotView PhotoUrl="@PhotoUrl(finding.PanelId!.Value)" Hold="ghost" X="to.X" Y="to.Y" Stroke="var(--status-success)" Caption="Where you tapped" Alt="the spot you tapped on the new photo" />
                        </div>
                        <div class="lookover-ask-buttons">
                            <button type="button" class="btn-primary" disabled="@Disabled" @onclick="() => MoveAsync(finding, to)">It is here</button>
                            <button type="button" class="btn-secondary" disabled="@Disabled" @onclick="ClearChoice">Cancel</button>
                        </div>
                    </div>
                }

                <div class="lookover-missing-answers">
                    <button type="button" class="btn-secondary" disabled="@Disabled" @onclick="() => AnswerAsync(finding, LookOverAnswer.Settle)">Still here</button>
                    @if (finding.Answers.Contains(LookOverAnswer.RemoveHold))
                    {
                        <ConfirmAction @key="finding.Id" Label="Not there any more" Question="@LookOverCopy.RemoveQuestion(finding)" ConfirmLabel="Remove the hold"
                                       Disabled="Disabled" OnConfirm="() => AnswerAsync(finding, LookOverAnswer.RemoveHold)" />
                    }
                    <button type="button" class="btn-link" disabled="@(Queue.Count < 2)" @onclick="() => Step(1)">Skip</button>
                </div>
            </div>
        </div>

        @if (!ForOneBoulder && CoveredUnused.Count > 0)
        {
            <div class="lookover-bulk">
                <ConfirmAction Label="@LookOverCopy.BulkRemoveLabel(CoveredUnused.Count, true)" Question="@LookOverCopy.BulkRemoveQuestion(CoveredUnused.Count, true)"
                               ConfirmLabel="@($"Remove {PlainCopy.Plural(CoveredUnused.Count, "hold")}")" Disabled="Disabled" OnConfirm="() => RemoveUnusedAsync(true)" />
            </div>
        }
    }
    else
    {
        <p class="glyph-ok" role="status">Every hold the update could not find is answered.</p>
    }

    @if (LastAnswered is { } last)
    {
        <p class="lookover-last" role="status">
            <span>Last answer: @LookOverCopy.AnsweredLabel(last)@(LookOverCopy.ResultLine(last) is { } result ? $". {result}" : null)</span>
            @if (last.CanUndo)
            {
                <button type="button" class="btn-link" disabled="@Disabled" @onclick="() => UndoLastAsync(last.Id)">Undo last</button>
            }
        </p>
    }

    @if (Answered.Count > 0)
    {
        <button type="button" class="btn-link lookover-answered-toggle" aria-expanded="@(showAnswered ? "true" : "false")" @onclick="() => showAnswered = !showAnswered">
            @(showAnswered ? "Hide" : "Show") the @Answered.Count answered
        </button>
        @if (showAnswered)
        {
            <ul class="refresh-check-list">
                @foreach (var answered in Answered.Take(AnsweredShown))
                {
                    <LookOverCard @key="answered.Id" WallId="WallId" Finding="answered" Disabled="Disabled" OnUndo="OnUndo" />
                }
            </ul>
            @if (Answered.Count > AnsweredShown)
            {
                <p class="hint">The @AnsweredShown most recent of @Answered.Count are shown.</p>
            }
        }
    }
</section>
