@using Blocwerk.Core.LookOver
@using Blocwerk.Core.Refresh
@* A hold the update could not find, as a card of the deck. At the top, small, the hold as it was (its real outline on
   the photo from before the update) with whose boulders use it; below it, in all the height that is left, the photo
   of its panel as it is now, to pan and zoom, with the holds the update found and a dashed outline where the old hold
   was. The user says it is still here, taps the hold it is, taps where it is, or says it is not there any more; every
   answer but "still here" asks first, in the answer bar under the card. Holds are asked about on their own panel's
   photo only (a merge works within one photo). *@

<div class="deck-body deck-missing">
    <div class="deck-was">
        @if (Before(Finding) is { } before)
        {
            <LookOverPictureView WallId="WallId" FindingId="Finding.Id" Picture="before" Eager="true" />
        }
        <div class="deck-about">
            <strong>@LookOverCopy.HoldLabel(Finding)@(Finding.Covered ? ", under a new hold" : null)</strong>
            <LookOverBoulders WallId="WallId" Boulders="Finding.Boulders" />
            <p class="deck-detail">@LookOverCopy.MissingQuestion</p>
        </div>
    </div>
    @if (CanMove(Finding))
    {
        <p class="hint deck-tap-hint">@(Finding.CanReassign ? LookOverCopy.TapHint : LookOverCopy.ReassignNeedsAdmin)</p>
    }
    @if (Finding.PanelId is { } panelId)
    {
        <div class="deck-wall">
            <PanelImageView WallId="WallId" Caption="The wall now" PhotoUrl="@PhotoUrl(panelId)" Holds="PanelHolds(panelId)"
                            Ghost="Ghost(Finding)" GhostMovedTo="movedTo" SelectedHoldId="targetId"
                            Interactive="Finding.CanReassign" AddMode="CanMove(Finding)" OnHoldTap="ChooseHold" OnEmptyTap="ChooseSpot"
                            FocusKey="focusKey" FocusPoint="Spot(Finding)" FocusZoom="3" />
        </div>
    }
</div>

<div class="deck-answers" role="group" aria-label="Answer">
    @if (Target(Finding) is { } target)
    {
        <div class="lookover-ask" role="group" aria-label="It is this hold">
            <p>@LookOverCopy.ReassignQuestion(Finding)</p>
            <div class="lookover-ask-row">
                @if (Before(Finding) is { } was)
                {
                    <LookOverPictureView WallId="WallId" FindingId="Finding.Id" Picture="was" Eager="true" />
                }
                <LookOverSpotView PhotoUrl="@PhotoUrl(Finding.PanelId!.Value)" Hold="target" X="target.X" Y="target.Y" Caption="You tapped" Alt="the hold you tapped on the new photo" />
                <div class="lookover-ask-buttons">
                    <button type="button" class="btn-primary" disabled="@Disabled" @onclick="() => ReassignAsync(target.Id)">It is this hold</button>
                    <button type="button" class="btn-secondary" disabled="@Disabled" @onclick="ClearChoice">Cancel</button>
                </div>
            </div>
        </div>
    }
    else if (movedTo is { } to && Ghost(Finding) is { } ghost)
    {
        <div class="lookover-ask" role="group" aria-label="It is here">
            <p>@LookOverCopy.MoveQuestion(Finding)</p>
            <div class="lookover-ask-row">
                <LookOverSpotView PhotoUrl="@PhotoUrl(Finding.PanelId!.Value)" Hold="ghost" X="to.X" Y="to.Y" Caption="You tapped" Alt="the spot you tapped on the new photo" />
                <div class="lookover-ask-buttons">
                    <button type="button" class="btn-primary" disabled="@Disabled" @onclick="() => MoveAsync(to)">It is here</button>
                    <button type="button" class="btn-secondary" disabled="@Disabled" @onclick="ClearChoice">Cancel</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <button type="button" class="btn-secondary" disabled="@Disabled" @onclick="() => AnswerAsync(LookOverAnswer.Settle)">Still here</button>
        @if (Finding.Answers.Contains(LookOverAnswer.RemoveHold))
        {
            <ConfirmAction @ref="remove" Label="Not there any more" Question="@LookOverCopy.RemoveQuestion(Finding)" ConfirmLabel="Remove the hold"
                           Disabled="Disabled" OnConfirm="() => AnswerAsync(LookOverAnswer.RemoveHold)" />
        }
    }
</div>
