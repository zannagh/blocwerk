@* The big-wall update surface: upload → review the raw detection → carryover → per-neighbour
   overlaps → apply. A dedicated flow that replaces the normal settings body while it runs.
   See BigWallUpdate.razor.cs. *@

<div class="bigupdate">
    <div class="bigupdate-head">
        <h2>Update wall with new photos</h2>
        @if (!_superseded && _phase is not WallUpdatePhase.Done and not WallUpdatePhase.Working)
        {
            <button class="btn-link" @onclick="Discard">Discard update</button>
        }
    </div>

    @* A session belongs to the WALL, so the person working it may not be the person who started it.
       Say so plainly wherever the flow is live, so a second moderator joins rather than collides. *@
    @if (HasOwnerInfo && !_superseded && _phase is not WallUpdatePhase.Upload and not WallUpdatePhase.Done)
    {
        <p class="hint bigupdate-owner">
            @StartedByLine
            @if (LastActiveLine is { } lastLine)
            {
                <span class="bigupdate-owner-last"> · @lastLine</span>
            }
        </p>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="staged-hint danger">@_error</p>
    }

    @if (_superseded)
    {
        @* Terminal: another admin replaced this update, so every staged photo and decision on this
           screen is gone. Say that plainly instead of letting Apply or Discard act on someone else's
           capture — the service refuses either way, but the user deserves the reason, not the stack. *@
        <p class="staged-hint danger">
            This update was replaced by a newer one on this wall, so it can no longer be applied.
            Nothing you did here was written to the live wall.
        </p>
        <p class="staged-hint">
            Close and reopen the wall to see the update that is in progress now.
        </p>
        <div class="staged-actions">
            <button class="btn-primary" @onclick="Close">Close</button>
        </div>
    }
    else
    {
    @switch (_phase)
    {
        case WallUpdatePhase.Loading:
        case WallUpdatePhase.Working:
            <p class="loading-small">Working…</p>
            break;

        case WallUpdatePhase.ResumePrompt:
            <p class="staged-hint">
                An update to this wall is already in progress, with every decision made so far saved.
                You can pick up exactly where it was left, or discard it and start over. Discarding
                leaves the live wall untouched.
            </p>
            <div class="staged-actions">
                <button class="btn-primary" @onclick="ResumeExistingAsync">@ResumeLabel</button>
                <button class="btn-secondary" @onclick="Close">Not now</button>
                <button class="btn-danger-soft" @onclick="DiscardAndRestart">Discard &amp; start over</button>
            </div>
            break;

        case WallUpdatePhase.Upload:
            @if (_conflict is not null)
            {
                @* Never a silent takeover: another admin's staged photos and decisions are on this
                   wall, so the user chooses — and the destructive choice is the secondary one. *@
                <p class="staged-hint danger">
                    This wall already has an update in progress, so your photos were not staged.
                </p>
                <p class="staged-hint">
                    Continuing picks that update up where it was left, with every decision intact.
                    Starting over throws away its photos and decisions permanently.
                </p>
                <div class="staged-actions">
                    <button class="btn-primary" @onclick="ResumeConflictingAsync">Resume their update</button>
                    <button class="btn-secondary" @onclick="CancelConflict">Back to my photos</button>
                    <button class="btn-danger-soft" @onclick="TakeOverAsync">Discard theirs &amp; start over</button>
                </div>
            }
            else
            {
                <BigWallUpdateUploader @ref="_uploader" WallId="WallId" Prefill="Prefill" OnStart="OnUpload" OnCancel="Close" />
            }
            break;

        case WallUpdatePhase.Detected:
            @if (_session is not null)
            {
                <TouchupStep @ref="_detectedStep" WallId="WallId" Session="_session"
                             Heading="Check the detected holds"
                             Lead="Fix the detection before we match it against the old wall."
                             OnContinue="OnDetectedContinue" OnSkip="OnDetectedContinue">
                    <LeadDetail>
                        Add holds the detector missed, drag or resize the ones it got wrong, and delete
                        false ones. Continuing matches these holds against the current wall — the better
                        they are now, the better the carryover and overlap proposals.
                    </LeadDetail>
                </TouchupStep>
            }
            break;

        case WallUpdatePhase.Carryover:
            @if (_session is not null)
            {
                <CarryoverReview @ref="_carryover" WallId="WallId" Session="_session"
                                 Restored="_restored"
                                 ScopeResets="_scopeResets"
                                 OnScopeResetsAcknowledged="AcknowledgeScopeResets"
                                 OnContinue="OnCarryoverContinue" OnDiscard="Discard"
                                 OnSubViewOpenChanged="OnCarryoverSubViewOpenChanged" />
            }
            break;

        case WallUpdatePhase.Neighbours:
            @if (CurrentNeighbour is { } n)
            {
                <div class="bigupdate-step-label">
                    Overlaps — neighbour @(_neighbourIndex + 1) of @_session!.Neighbours.Count
                </div>
                <PanelOverlapStepper @key="n.PanelId" WallId="WallId" PanelId="n.PanelId"
                                     Col="n.Col" Row="n.Row" Proposals="n.Proposals" NeighbourStaged="true"
                                     AlignmentFailed="n.AlignmentFailed"
                                     Restored="RestoredFor(n.PanelId)"
                                     OnConfirm="OnNeighbourConfirm" OnProgress="OnNeighbourProgress"
                                     OnDiscard="OnNeighbourSkip" />
            }
            break;

        case WallUpdatePhase.Touchup:
            @if (_session is not null)
            {
                <TouchupStep @ref="_touchupStep" WallId="WallId" Session="_session"
                             OnContinue="OnTouchupContinue" OnSkip="OnTouchupSkip" />
            }
            break;

        case WallUpdatePhase.Shapes:
            <ShapeRecognitionStep @ref="_shapeStep" WallId="WallId" SessionId="_sessionInfo?.Id"
                                  OnReview="OnShapesReview" OnSkip="OnShapesSkipped" />
            break;

        case WallUpdatePhase.ShapeReview:
            <ShapeReviewStep @ref="_shapeReview" WallId="WallId" SessionId="_sessionInfo?.Id"
                             OnContinue="OnShapeReviewContinue" OnBack="OnShapeReviewBack" />
            break;

        case WallUpdatePhase.Confirm:
            @* Verdicts recorded against holds on panels no review surface can display. They are already
               reset to "carry in place" in the payload below; the promote waits until that has been
               read, because resuming straight to this step never re-walks the carryover review. *@
            @if (_scopeResets.Count > 0)
            {
                <div class="bigupdate-banner" role="alert">
                    <strong>@_scopeResets.Count earlier hold decision(s) were reset to "carry in place".</strong>
                    <span>
                        They were recorded against holds on re-photographed panels other than the centre,
                        which the carryover review cannot show — so they could be neither seen nor undone.
                        A "remove" among them would have retired real boulders to history with nothing on
                        screen saying so. Those holds are carried over instead; nothing else changes.
                    </span>
                    @if (!_scopeResetsAcknowledged)
                    {
                        <button class="btn-secondary" @onclick="AcknowledgeScopeResets">I understand</button>
                    }
                </div>
            }

            <p class="hint">Ready to apply. Nothing changes on the live wall until you confirm.</p>
            <div class="bigupdate-summary">
                <span class="bigupdate-chip carry">Carrying @CarriedCount</span>
                <span class="bigupdate-chip changed">@ChangedCount changed</span>
                <span class="bigupdate-chip remove">@RemovedCount removed</span>
                <span class="bigupdate-chip new">@NewKeptCount new</span>
                <span class="bigupdate-chip link">@LinkCount links</span>
            </div>
            <p class="staged-hint">
                Removed holds retire their boulders to history; everything carried keeps its boulders.
                This replaces the wall photo and cannot be undone.
            </p>
            <div class="staged-actions">
                <button class="btn-primary" @onclick="Apply" disabled="@ScopeResetsPending">Apply update</button>
                <button class="btn-danger-soft" @onclick="Discard">Discard update</button>
            </div>
            break;

        case WallUpdatePhase.Done:
            <p class="staged-hint">
                Update applied. Carried @CarriedCount · changed @ChangedCount · removed @RemovedCount ·
                new @NewKeptCount · @LinkCount overlap link(s).
            </p>
            <div class="staged-actions">
                <button class="btn-primary" @onclick="Close">Done</button>
            </div>
            break;
    }
    }
</div>
