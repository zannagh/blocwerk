@* Focused, one-at-a-time carryover review. Old photo (left) and new centre (right) side by side,
   each independently zoom/pannable via PanelImageView, the subject hold highlighted. Every old hold
   is CARRIED unchanged by default; the primary control is a per-hold "has physically changed" toggle,
   with an always-available manual re-target and a distinct Remove. See CarryoverStepper.razor.cs. *@

<div class="panel-stepper" tabindex="0" @ref="_rootRef" @onkeydown="OnKeyDown">
    <div class="panel-stepper-head">
        <div>
            <h3 class="panel-overlap-title">@ModeTitle</h3>
            <p class="hint">@ModeHint</p>
        </div>
        <button class="btn-secondary" @onclick="() => OnClose.InvokeAsync()">Done — back to overview</button>
    </div>

    @if (Items.Count == 0)
    {
        <p class="staged-hint">Nothing to review here.</p>
    }
    else
    {
        <div class="panel-stepper-bar">
            <span class="panel-stepper-progress">@(_index + 1) / @Items.Count</span>
            @* Only ever set while the parent is force-showing reviewed holds: say who signed this one
               off so a second admin knows they are looking at somebody else's decision. *@
            @if (CurrentReviewedNote is { } reviewedNote)
            {
                <span class="panel-stepper-reviewed">@reviewedNote</span>
            }
        </div>

        <div class="panel-stepper-pair">
            @* When an old hold maps to a new hold (matcher suggestion or manual re-target) badge both
               green so the eye pairs them across the two images (the R&D green-dot ↔ green-dot link
               cue). Unmapped old holds stay amber / new-centre stays blue. *@
            <PanelImageView WallId="WallId" Caption="Old wall (before)"
                            PhotoUrl="@OldPhotoUrl"
                            Holds="OldHolds"
                            HighlightHoldId="Current?.OldHoldId"
                            BadgeNumber="_index + 1" BadgeColor="@LeftBadgeColor"
                            FocusKey="_index" FocusPoint="Point(OldHold)" />

            @* The right pane is editable ONLY while a touch-up tool is picked, so with no tool active it
               behaves exactly as it always has: taps re-target, drags pan the zoomed image. *@
            <PanelImageView WallId="WallId" Caption="@RightCaption"
                            PhotoUrl="@NewPhotoUrl"
                            Holds="NewHolds"
                            HighlightHoldId="@(_interactive ? null : EffectiveNewHoldId)"
                            SelectedHoldId="@RightPaneSelectedId"
                            HintPoint="@(_interactive ? Point(NewHold) : null)"
                            Interactive="@RightPaneInteractive"
                            Editable="@RightPaneEditable"
                            AddMode="@(RightPaneEditable && _touchup.AddMode)"
                            ExactHitTargets="@(RightPaneEditable && _touchup.DeleteMode)"
                            DragToMove="@(RightPaneEditable && _touchup.MoveMode)"
                            BadgeNumber="_index + 1" BadgeColor="@RightBadgeColor"
                            FocusKey="_index" FocusPoint="Point(NewHold ?? OldHold)"
                            OnHoldTap="OnRightHoldTapAsync"
                            OnEmptyTap="OnTouchupEmptyTapAsync"
                            OnHoldGeometryChanged="OnHoldGeometryChanged" />
        </div>

        @* Fix a wrong hold without leaving the review. stopPropagation keeps the slider's own arrow
           keys (and any letter typed while it has focus) out of the stepper's keydown handler. *@
        @if (ToolsEnabled)
        {
            <div class="bigupdate-edit-tools" @onkeydown:stopPropagation="true">
                <HoldTouchupToolbar Tool="_touchup.Tool" ToolChanged="SetTouchupTool"
                                    Size="_touchup.Radius" SizeChanged="OnTouchupSizeChanged"
                                    OnSizeCommitted="OnTouchupSizeCommittedAsync"
                                    HasSelection="@(_touchup.SelectedHoldId is not null)" />
            </div>
        }

        @if (_interactive)
        {
            <div class="panel-stepper-actions">
                <span class="panel-stepper-hint">Tap the hold on the right that this old hold really is now.</span>
                <button class="btn-primary" @onclick="UseInteractive" disabled="@(_selectedNewId is null)">Use this hold</button>
                <button class="btn-secondary" @onclick="CancelInteractive">Cancel</button>
            </div>
        }
        else if (Mode == CarryReviewMode.New)
        {
            <div class="panel-stepper-actions">
                <button class="btn-secondary" @onclick="Back" disabled="@(_index == 0)" title="Previous (←)">←</button>
                <button class="btn-primary" @onclick="KeepNew" disabled="@CurrentNewHoldGone" title="Keep this new hold (Enter)">Keep ✓</button>
                <button class="btn-danger-soft" @onclick="DiscardNew" disabled="@CurrentNewHoldGone" title="False detection (X)">Discard</button>
                <button class="btn-secondary" @onclick="Next" title="Skip (→)">→</button>
            </div>
            <div class="panel-stepper-foot">
                <span class="panel-stepper-legend"><kbd>Enter</kbd> keep · <kbd>X</kbd> discard · <kbd>←</kbd>/<kbd>→</kbd> step</span>
                @if (ToolsEnabled)
                {
                    <span class="panel-stepper-legend"><kbd>A</kbd> add · <kbd>M</kbd> move · <kbd>D</kbd> delete · <kbd>P</kbd> pipette</span>
                }
            </div>
            @if (CurrentNewHoldGone)
            {
                <p class="staged-hint">This hold has been deleted — step past it.</p>
            }
        }
        else
        {
            @* Old-hold carryover: carried unchanged by default. The toggle is the only thing that
               makes it "changed"; re-target just fixes the mapping; Remove is physically gone. *@
            <div class="panel-stepper-actions">
                <button class="btn-secondary" @onclick="Back" disabled="@(_index == 0)" title="Previous (←)">←</button>
                <label class="panel-stepper-toggle" title="Marks affected boulders for review">
                    <input type="checkbox" checked="@IsChanged" @onchange="ToggleChanged" />
                    <span>Has physically changed — marks affected boulders for review</span>
                </label>
                <button class="btn-secondary" @onclick="EnterInteractive" title="Point at the matching hold on the new photo">Re-target</button>
                <button class="btn-danger-soft" @onclick="RemoveOld" title="This hold is gone (X)">Remove</button>
                <button class="btn-primary" @onclick="AcceptCarry" title="Accept and continue (Enter)">Accept ✓</button>
                <button class="btn-secondary" @onclick="Next" title="Skip (→)">→</button>
            </div>
            <div class="panel-stepper-foot">
                <span class="panel-stepper-legend"><kbd>Enter</kbd> accept · <kbd>C</kbd> changed · <kbd>X</kbd> remove · <kbd>←</kbd>/<kbd>→</kbd> step</span>
                @if (ToolsEnabled)
                {
                    <span class="panel-stepper-legend"><kbd>A</kbd> add · <kbd>M</kbd> move · <kbd>D</kbd> delete · <kbd>P</kbd> pipette</span>
                }
            </div>
        }
    }
</div>
