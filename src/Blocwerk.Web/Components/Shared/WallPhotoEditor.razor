    {
        foreach (var h in Holds)
        {
            _changedHoldIds.Add(h.Id);
        }
    }

    private void MarkAllUnchanged()
    {
        _changedHoldIds.Clear();
    }

    // ---- Changed overlay + MarkUnchanged tool ------------------------------
    private void CaptureManualBaseline()
    {
        _manualBaseline.Clear();
        foreach (var h in Holds)
        {
            _manualBaseline[h.Id] = (h.X, h.Y, h.Radius,
                h.ShapePoints?.Select(sp => new ShapePoint { Dx = sp.Dx, Dy = sp.Dy }).ToList());
        }
    }

    /// <summary>
    /// True when a staged hold's geometry drifted from its previous-generation baseline beyond a
    /// small threshold (position, radius, or shape). Derived/visual only — no persistence.
    /// </summary>
    private int ChangedCount => ManualAlignment ? Holds.Count(h => _changedHoldIds.Contains(h.Id)) : 0;

    // Holds flagged for review on this panel (the change-review overlay's count).
    private int ReviewChangedCount => Holds.Count(h => h.NeedsReview);

    // Holds still missing information the owner has to supply (the "?" overlay's count). Counted
    // under the ACTIVE criteria while the overlay is on, and under the default (colour) while it is
    // off, so the badge still tells the owner there is something to find.
    private int IncompleteCount => HoldCompleteness.CountIncomplete(
        Holds, _showIncomplete ? _incompleteCriteria : HoldCompleteness.Default);

    // One wording for the toggle, the count badge and the help page, so none of them can overstate
    // what the overlay is able to detect.
    private string IncompleteHint => HoldCompleteness.Describe(_incompleteCriteria);

    // Off -> colour -> colour + sub-type -> off.
    private void CycleIncompleteCriteria()
    {
        _incompleteCriteria = HoldCompleteness.Next(_incompleteCriteria);
    }

    /// <summary>
    /// Pre-promote fix: snap a falsely-flagged staged clone back to its previous-generation
    /// geometry and clear its changed flag, so confirming the alignment records DidChange=false
    /// and no boulder is flagged for review. Client-only until the alignment is confirmed.
    /// </summary>
    private void ResetHoldToUnchanged(Guid holdId)
    {
        var hold = Holds.FirstOrDefault(h => h.Id == holdId);
        if (hold == null || !_manualBaseline.TryGetValue(holdId, out var b))
        {
            return;
        }

        TakeSnapshot();
        hold.X = b.X;
        hold.Y = b.Y;
        hold.Radius = b.Radius;
        hold.ShapePoints = b.Shape?.Select(sp => new ShapePoint { Dx = sp.Dx, Dy = sp.Dy }).ToList();
        _changedHoldIds.Remove(holdId);
        _alignedHoldIds.Add(holdId);
    }

    /// <summary>
    /// The MarkChanged tool's confirm: flag the hold, and with it every non-archived boulder using
    /// it, for review. Server-side and immediate, so the pick is dropped first.
    /// </summary>
    private async Task ConfirmMarkChanged(Guid holdId)
    {
        _markChangedHoldId = null;
        await OnMarkHoldModified.InvokeAsync(holdId);
    }

    private async Task RestoreUnchangedBoulders(Guid holdId)
    {
        _markUnchangedHoldId = null;
        await OnRestoreUnchangedHold.InvokeAsync(holdId);
    }

