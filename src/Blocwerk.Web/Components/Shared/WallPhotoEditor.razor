    private async Task OnSvgClick(MouseEventArgs e)
    {
        if (!CanEdit || _mode != EditMode.Add) return;
        var pos = await JS.InvokeAsync<RelativePos>("wallEditor.getRelativePosition", _containerRef, e.ClientX, e.ClientY);
        var radius = _selectedRadius;
        TakeSnapshot();
        var hold = new Hold
        {
            Id = Guid.NewGuid(), WallId = WallId,
            X = Math.Clamp(pos.X, 0, 1), Y = Math.Clamp(pos.Y, 0, 1),
            Radius = radius, Category = _addCategory,
            Color = _addColor == "none" ? null : _addColor,
            Material = _addMaterial,
            IsOnKickboard = _addOnKickboard, IsAutoDetected = false,
        };
        _addedHolds.Add(hold);
        Holds.Add(hold);
    }

    private async Task OnSvgMouseMove(MouseEventArgs e)
    {
        // Nothing is being dragged: don't pay a SignalR interop round-trip just to follow a hovering
        // cursor. Only once a drag is active do we resolve the pointer's wall-relative position.
        var dragging = _alignDragHandle.HasValue
            || _shapeTiltDragging
            || _draggingBorderIdx.HasValue
            || _draggingShapePointIdx.HasValue
            || _draggingHoldId != null;
        if (!dragging)
        {
            return;
        }

        var pos = await JS.InvokeAsync<RelativePos>("wallEditor.getRelativePosition", _containerRef, e.ClientX, e.ClientY);

        if (_alignDragHandle.HasValue)
        {
            ApplyAlignDrag(pos.X, pos.Y);
            StateHasChanged(); return;
        }
        if (_shapeTiltDragging && _shapeTiltSnapshot != null)
        {
            _shapeTiltAngleY = (pos.X - _shapeTiltDragStartX) * ShapeTiltGain;
            _shapeTiltAngleX = -(pos.Y - _shapeTiltDragStartY) * ShapeTiltGain;
            ApplyShapeTilt();
            StateHasChanged(); return;
        }

        if (_draggingBorderIdx.HasValue && _draggingBorderIdx.Value < BorderPoints.Count)
        {
            BorderPoints[_draggingBorderIdx.Value] = new ShapePoint { Dx = Math.Clamp(pos.X, 0, 1), Dy = Math.Clamp(pos.Y, 0, 1) };
            StateHasChanged(); return;
        }
        if (_draggingShapePointIdx.HasValue && _draggingShapeHold != null)
        {
            var sp = _draggingShapeHold.ShapePoints![_draggingShapePointIdx.Value];
            sp.Dx = pos.X - _draggingShapeHold.X;
            sp.Dy = pos.Y - _draggingShapeHold.Y;
            StateHasChanged(); return;
        }
        if (_draggingHoldId == null) return;
        var hold = Holds.FirstOrDefault(h => h.Id == _draggingHoldId);
        if (hold == null) return;
        hold.X = Math.Clamp(pos.X, 0, 1);
        hold.Y = Math.Clamp(pos.Y, 0, 1);
        StateHasChanged();
    }

    private async Task OnSvgMouseUp(EventArgs e)
    {
        if (_alignDragHandle.HasValue) { _alignDragHandle = null; _alignSnapshot = null; return; }
        if (_shapeTiltDragging) { _shapeTiltDragging = false; return; }
        if (_draggingBorderIdx.HasValue) { _draggingBorderIdx = null; await OnBorderChanged.InvokeAsync(BorderPoints); return; }
        if (_draggingShapePointIdx.HasValue && _draggingShapeHold != null)
        {
            var h = _draggingShapeHold; _draggingShapePointIdx = null; _draggingShapeHold = null;
            _updatedHoldIds.Add(h.Id); return;
        }
        if (_draggingHoldId == null) return;
        var hold = Holds.FirstOrDefault(h => h.Id == _draggingHoldId);
        _draggingHoldId = null;
        if (hold != null) _updatedHoldIds.Add(hold.Id);
    }

    private void DeleteSelected()
    {
        if (_selectedHoldId == null) return;
        TakeSnapshot();
        _deletedHoldIds.Add(_selectedHoldId.Value);
        Holds.RemoveAll(h => h.Id == _selectedHoldId.Value);
        _selectedHoldId = null;
    }

    private async Task MarkSelectedModified(Guid holdId)
    {
        await OnMarkHoldModified.InvokeAsync(holdId);
    }

    private async Task MarkSelectedUnchanged(Guid holdId)
    {
        await OnRestoreUnchangedHold.InvokeAsync(holdId);
    }

    // ---- Manual alignment --------------------------------------------------
    private string ManualStroke(Hold hold)
    {
        if (!_alignedHoldIds.Contains(hold.Id))
        {
            return "#ff9933"; // not yet aligned
        }

        return _changedHoldIds.Contains(hold.Id) ? "#ff5555" : "#33dd66"; // changed vs unchanged
    }

    private void ToggleHoldChanged(Guid holdId)
    {
        if (!_changedHoldIds.Remove(holdId))
        {
            _changedHoldIds.Add(holdId);
        }
    }

    private void ConfirmHoldAligned(Guid holdId)
    {
        _alignedHoldIds.Add(holdId);
    }

    private void MarkAllChanged()
    {
        foreach (var h in Holds)
        {
            _changedHoldIds.Add(h.Id);
        }
    }

    private void MarkAllUnchanged()
    {
        _changedHoldIds.Clear();
    }

    // ---- Changed overlay + MarkUnchanged tool ------------------------------
    private void CaptureManualBaseline()
    {
        _manualBaseline.Clear();
        foreach (var h in Holds)
        {
            _manualBaseline[h.Id] = (h.X, h.Y, h.Radius,
                h.ShapePoints?.Select(sp => new ShapePoint { Dx = sp.Dx, Dy = sp.Dy }).ToList());
        }
    }

    /// <summary>
    /// True when a staged hold's geometry drifted from its previous-generation baseline beyond a
    /// small threshold (position, radius, or shape). Derived/visual only — no persistence.
    /// </summary>
    private int ChangedCount => ManualAlignment ? Holds.Count(h => _changedHoldIds.Contains(h.Id)) : 0;

    // Holds flagged for review on this panel (the change-review overlay's count).
    private int ReviewChangedCount => Holds.Count(h => h.NeedsReview);

    /// <summary>
    /// Pre-promote fix: snap a falsely-flagged staged clone back to its previous-generation
    /// geometry and clear its changed flag, so confirming the alignment records DidChange=false
    /// and no boulder is flagged for review. Client-only until the alignment is confirmed.
    /// </summary>
    private void ResetHoldToUnchanged(Guid holdId)
    {
        var hold = Holds.FirstOrDefault(h => h.Id == holdId);
        if (hold == null || !_manualBaseline.TryGetValue(holdId, out var b))
        {
            return;
        }

        TakeSnapshot();
        hold.X = b.X;
        hold.Y = b.Y;
        hold.Radius = b.Radius;
        hold.ShapePoints = b.Shape?.Select(sp => new ShapePoint { Dx = sp.Dx, Dy = sp.Dy }).ToList();
        _changedHoldIds.Remove(holdId);
        _alignedHoldIds.Add(holdId);
    }

    private async Task RestoreUnchangedBoulders(Guid holdId)
    {
        _markUnchangedHoldId = null;
        await OnRestoreUnchangedHold.InvokeAsync(holdId);
    }

    private async Task ConfirmManualAlignment()
    {
        var addedIds = _addedHolds.Select(h => h.Id).ToHashSet();
        var result = new ManualAlignmentResult(
            Holds.ToList(),
            new HashSet<Guid>(_changedHoldIds),
            addedIds,
            _deletedHoldIds.ToList());
        await OnConfirmManualAlignment.InvokeAsync(result);
    }

    private async Task DiscardManualAlignment()
    {
        await OnDiscardManualAlignment.InvokeAsync();
    }

    private void OnRadiusChange(ChangeEventArgs e)
    {
        if (_selectedHoldId == null || !int.TryParse(e.Value?.ToString(), out var val)) return;
        _selectedRadius = val / 1000.0;
        var hold = Holds.FirstOrDefault(h => h.Id == _selectedHoldId);
        if (hold == null) return;
        TakeSnapshot();
        hold.Radius = _selectedRadius;
        if (hold.ShapePoints != null) hold.ShapePoints = ShapePoint.DefaultOctagon(_selectedRadius);
        _updatedHoldIds.Add(hold.Id);
    }

    private void SetSelectedCategory(HoldCategory cat)
    {
        var h = Holds.FirstOrDefault(h => h.Id == _selectedHoldId);
        if (h == null) return;
        TakeSnapshot();
        h.Category = cat;
        _updatedHoldIds.Add(h.Id);
    }

    private void ToggleKickboard(Hold h)
    {
        TakeSnapshot();
        h.IsOnKickboard = !h.IsOnKickboard;
        _updatedHoldIds.Add(h.Id);
    }

    private void OnSelectedColorChange(ChangeEventArgs e)
    {
        var h = Holds.FirstOrDefault(h => h.Id == _selectedHoldId);
        if (h == null) return;
        TakeSnapshot();
        var v = e.Value?.ToString();
        h.Color = v == "none" ? null : v;
        _updatedHoldIds.Add(h.Id);
    }

    private void OnAddMaterialChange(ChangeEventArgs e)
    {
        if (!Enum.TryParse<HoldMaterial>(e.Value?.ToString(), out var m)) return;
        _addMaterial = m;
        // Keep the pending color legal for the new material (e.g. drop blue when
        // switching to wood, defaulting wood to its medium tone).
        _addColor = HoldPalette.CoerceTo(_addColor == "none" ? null : _addColor, m)
            ?? (m == HoldMaterial.Wood ? "wood-medium" : "none");
    }

    private void OnAddColorChange(ChangeEventArgs e)
    {
        _addColor = e.Value?.ToString() ?? "none";
    }

    private void OnSelectedMaterialChange(Hold h, ChangeEventArgs e)
    {
        TakeSnapshot();
        h.Material = Enum.TryParse<HoldMaterial>(e.Value?.ToString(), out var m) ? m : null;
        // A blue hold turned wooden can't stay blue; snap it to a valid tone.
        h.Color = HoldPalette.CoerceTo(h.Color, h.Material)
            ?? (h.Material == HoldMaterial.Wood ? "wood-medium" : null);
        _updatedHoldIds.Add(h.Id);
    }

    private void OnSelectedHandTypeChange(Hold h, ChangeEventArgs e)
    {
        TakeSnapshot();
        h.HandType = Enum.TryParse<HoldHandType>(e.Value?.ToString(), out var t) ? t : null;
        _updatedHoldIds.Add(h.Id);
    }

    // Painting a wood tone implies the hold is wooden, and vice versa — keep the
    // material in step so its color stays selectable in the dropdown.
    private static void SyncMaterialToColor(Hold hold)
    {
        if (HoldPalette.WoodColors.Any(c => c.Key == hold.Color))
        {
            hold.Material = HoldMaterial.Wood;
        }
        else if (hold.Material == HoldMaterial.Wood)
        {
            hold.Material = null;
        }
    }

    private async Task SaveChanges()
    {
        var added = _addedHolds.ToList();
        var manuallyTouchedIds = new HashSet<Guid>(_updatedHoldIds);
        manuallyTouchedIds.UnionWith(_alignmentChangedIds);
        var updated = Holds.Where(h => manuallyTouchedIds.Contains(h.Id) && !_addedHolds.Any(a => a.Id == h.Id)).ToList();
        var deleted = _deletedHoldIds.ToList();

        if (OnBatchSave.HasDelegate)
        {
            await OnBatchSave.InvokeAsync(new BatchChanges(added, updated, deleted));
        }
        else
        {
            foreach (var h in added) await OnHoldAdded.InvokeAsync(h);
            foreach (var h in updated) await OnHoldUpdated.InvokeAsync(h);
            foreach (var id in deleted) await OnHoldDeleted.InvokeAsync(id);
        }

        _addedHolds.Clear();
        _updatedHoldIds.Clear();
        _deletedHoldIds.Clear();
        _alignmentChangedIds.Clear();
        _snapshotHolds = null;
    }

    private void DiscardChanges()
    {
        if (_snapshotHolds != null)
        {
            Holds.Clear();
            Holds.AddRange(_snapshotHolds);
        }

        _addedHolds.Clear();
        _updatedHoldIds.Clear();
        _deletedHoldIds.Clear();
        _alignmentChangedIds.Clear();
        _snapshotHolds = null;
        _selectedHoldId = null;
    }

    private void OnShapePointSizeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
            _shapePointRadius = val / 10.0;
    }

    private void AddShapePoint()
    {
        var h = Holds.FirstOrDefault(x => x.Id == _shapeEditHoldId);
        if (h?.ShapePoints is not { Count: >= 3 } pts) return;
        TakeSnapshot();
        // Split the longest edge so the polygon gains detail where it's coarsest.
        var edgeIdx = 0;
        var longest = -1.0;
        for (var i = 0; i < pts.Count; i++)
        {
            var a = pts[i];
            var b = pts[(i + 1) % pts.Count];
            var lenSq = (b.Dx - a.Dx) * (b.Dx - a.Dx) + (b.Dy - a.Dy) * (b.Dy - a.Dy);
            if (lenSq > longest) { longest = lenSq; edgeIdx = i; }
        }

        var p1 = pts[edgeIdx];
        var p2 = pts[(edgeIdx + 1) % pts.Count];
        pts.Insert(edgeIdx + 1, new ShapePoint { Dx = (p1.Dx + p2.Dx) / 2, Dy = (p1.Dy + p2.Dy) / 2 });
        _updatedHoldIds.Add(h.Id);
    }

    private void RemoveShapePoint()
    {
        var h = Holds.FirstOrDefault(x => x.Id == _shapeEditHoldId);
        if (h?.ShapePoints is not { Count: > 3 } pts) return;
        TakeSnapshot();
        pts.RemoveAt(pts.Count - 1);
        _updatedHoldIds.Add(h.Id);
    }

    private async Task OnRedetect() { _isDetecting = true; StateHasChanged(); await OnRedetectRequested.InvokeAsync(); _isDetecting = false; }

    private async Task InitBorder()
    {
        BorderPoints.Clear();
        BorderPoints.AddRange(new[] {
            new ShapePoint { Dx = 0.05, Dy = 0.05 }, new ShapePoint { Dx = 0.35, Dy = 0.03 },
            new ShapePoint { Dx = 0.65, Dy = 0.03 }, new ShapePoint { Dx = 0.95, Dy = 0.05 },
            new ShapePoint { Dx = 0.95, Dy = 0.60 }, new ShapePoint { Dx = 0.85, Dy = 0.95 },
            new ShapePoint { Dx = 0.15, Dy = 0.95 }, new ShapePoint { Dx = 0.05, Dy = 0.60 },
        });
        _showBorder = true;
        await OnBorderChanged.InvokeAsync(BorderPoints);
    }

    private async Task ClearBorder() { BorderPoints.Clear(); await OnBorderChanged.InvokeAsync(BorderPoints); }
    private async Task CleanArtifacts() { await OnCleanArtifactsRequested.InvokeAsync(); }

    private static string F(double v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    private static string Pts(IEnumerable<(double X, double Y)> pts) =>
        string.Join(" ", pts.Select(p => $"{F(p.X * 100)},{F(p.Y * 100)}"));

    private static string GetCssColor(string? c) => HoldPalette.Hex(c);

    private static string GetHoldFillColor(Hold h, bool sel) =>
        sel ? "rgba(255,255,255,0.4)" : HoldPalette.Fill(h.Color);

    private static string GetHoldStrokeColor(Hold h) => HoldPalette.Hex(h.Color);
