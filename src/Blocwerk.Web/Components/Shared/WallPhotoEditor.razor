    /// <summary>
    /// True while this editor holds unsaved hold edits (adds/updates/deletes). Lets the parent
    /// warn before it re-scopes the editor (e.g. stepping panels) and drops them.
    /// </summary>
    public bool HasUnsavedChanges => _pendingChanges > 0;

    // Any unsaved manual-alignment work: holds dragged (tracked in _pendingChanges via _updatedHoldIds),
    // confirmed-aligned, or moved by the auto-align gizmo. All of it lives only in the circuit until
    // "Confirm & Update Wall", so navigating away (internal or external) would discard it silently.
    private bool _hasPendingAlignmentWork => ManualAlignment
        && (_pendingChanges > 0 || _alignedHoldIds.Count > 0 || _alignmentChangedIds.Count > 0);

    private async Task OnBeforeNavigateAway(LocationChangingContext ctx)
    {
        if (!_hasPendingAlignmentWork)
        {
            return;
        }

        var proceed = await JS.InvokeAsync<bool>("confirm", "You have unsaved alignment changes. Leave and discard them?");
        if (!proceed)
        {
            ctx.PreventNavigation();
        }
    }

    /// <summary>
    /// Supplies the hold-to-boulders map for the usage tool. The tool button is hidden
    /// when this is not wired up.
    /// </summary>
    [Parameter] public Func<Task<Dictionary<Guid, List<HoldUsageRef>>>>? OnRequestHoldUsage { get; set; }

    private bool _autoAligning;
    private string? _autoAlignMsg;

    private async Task OnAutoAlignClick()
    {
        if (_autoAligning || OnRequestAutoAlign == null)
        {
            return;
        }

        _autoAligning = true;
        _autoAlignMsg = null;
        StateHasChanged();
        try
        {
            var h = await OnRequestAutoAlign();
            if (h == null)
            {
                _autoAlignMsg = "No reliable match found — align by hand.";
            }
            else
            {
                ApplyAutoAlign(h);
                _autoAlignMsg = $"Auto-aligned (confidence {h.Confidence:0.00}) — fine-tune, then Save.";
            }
        }
        catch (Exception ex)
        {
            _autoAlignMsg = $"Auto-align failed: {ex.Message}";
        }
        finally
        {
            _autoAligning = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Applies the estimated old->new homography to the overlay holds in-memory,
    /// hooking into the editor's change tracking so the user reviews then Saves
    /// (auto-detect mode) or Confirms (manual mode), and can Discard to revert.
    /// </summary>
    private void ApplyAutoAlign(Homography h)
    {
        TakeSnapshot();
        var targets = (ManualAlignment ? Holds.Where(IsStagedHold) : Holds.Where(IsLiveHold)).ToList();
        foreach (var hold in targets)
        {
            HoldAlignment.Apply(hold, h);
            if (ManualAlignment)
            {
                _alignedHoldIds.Add(hold.Id);
            }
            else
            {
                _alignmentChangedIds.Add(hold.Id);
            }
        }
    }

