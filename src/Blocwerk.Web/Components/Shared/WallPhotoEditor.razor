    private string ManualStroke(Hold hold)
    {
        if (!_alignedHoldIds.Contains(hold.Id))
        {
            return "#ff9933"; // not yet aligned
        }

        return _changedHoldIds.Contains(hold.Id) ? "#ff5555" : "#33dd66"; // changed vs unchanged
    }

    private void ToggleHoldChanged(Guid holdId)
    {
        if (!_changedHoldIds.Remove(holdId))
        {
            _changedHoldIds.Add(holdId);
        }
    }

