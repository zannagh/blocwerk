    private static readonly HoldHandType[] _handTypes = [HoldHandType.Jug, HoldHandType.Pinch, HoldHandType.Crimp, HoldHandType.Pocket, HoldHandType.Sloper];
    private static string MaterialLabel(HoldMaterial m) => m == HoldMaterial.DualTex ? "DualTex" : m.ToString();

    // Handles are drawn in SVG user units, which the zoom scales up with the photo.
    // Divide their size by the zoom so they stay a constant on-screen size instead of
    // ballooning when zoomed in.
    // The upper clamp must track SCROLL_ZOOM_MAX in wwwroot/js/viewport.js (12.0); otherwise the
    // handles stop shrinking at the old 6x cap and are oversized for the rest of the range.
    private double HandleScale => 1.0 / Math.Clamp(_zoom, 0.5, 12.0);

    /// <summary>
    /// One save's worth of editor state. <paramref name="MarkedChanged"/> is the deliberate
    /// "this physical hold was swapped / turned / re-set" verdict, kept apart from
    /// <paramref name="Updated"/> on purpose: moving or resizing a circle only corrects where we
    /// think a hold IS, and must not retire the boulders that use it.
    /// </summary>
    public record BatchChanges(List<Hold> Added, List<Hold> Updated, List<Guid> Deleted, List<Guid> MarkedChanged);

    public WallPhotoEditor()
    {
        _zoomState = new ViewportZoomState(() => InvokeAsync(StateHasChanged));

        // The editor has always opened in Add; the shared tool state's zero value is None, so the
        // opening tool is stated here rather than left to the enum's default.
        tools.SetTool(HoldTouchupTool.Add);
    }

    // Toolbar placement, resolved before the first render so the toolbar is never drawn in the wrong
    // shape. Two passes, two sources — both of which are the SAME cookie:
    //   * static/prerender pass: HttpContext is live, so the cookie comes off the request and the
    //     first paint is already correct (this is why the pref is a cookie and not localStorage);
    //   * interactive pass (circuit activation, or the editor being switched on later by the pencil
    //     FAB, where there is no HttpContext at all): read it through bwPrefs.
    // Awaiting the interop here rather than in OnAfterRenderAsync is the point — a render that has
    // already happened cannot be un-flashed. A failed read simply keeps the top bar.
    protected override async Task OnInitializedAsync()
    {
        if (HttpContextAccessor.HttpContext is { } context)
        {
            placement = ToolbarPlacementPreference.Parse(
                context.Request.Cookies[ToolbarPlacementPreference.CookieName]);
            return;
        }

        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        try
        {
            var stored = await JS.InvokeAsync<string>("bwPrefs.getToolbarPlacement");
            placement = ToolbarPlacementPreference.Parse(stored);
        }
        catch (Exception)
        {
            /* interop unavailable (circuit torn down, script blocked) — keep the top bar. */
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The dispatcher is global and last-registered wins, so only an editable instance may claim
        // these letters: WallDetail renders a read-only border-only editor alongside the editing one,
        // and CanEdit flips at runtime when the page enters/leaves edit mode. Hence this lives here
        // rather than behind firstRender.
        if (CanEdit && _keys == null)
        {
            // Left unregistered on purpose: the reconcile below registers it on its first pass,
            // because SetKeysAsync falls back to RegisterAsync while the scope has no token yet.
            _keys = new KeyboardShortcutScope(JS, OnShortcut, KeyGate);
            _keysDeclared = null;
        }
        else if (!CanEdit && _keys != null)
        {
            await _keys.DisposeAsync();
            _keys = null;
            _keysDeclared = null;
        }

        // The conditional keys (ctrl+s, Escape) turn on and off from a dozen places, including async
        // continuations, so the set is reconciled here after every render instead of at each call
        // site — one place, no drift. Guarded on the joined declaration so an unchanged set costs no
        // interop round-trip.
        if (_keys != null)
        {
            var keys = CurrentShortcutKeys();
            var declared = string.Join(',', keys);
            if (declared != _keysDeclared)
            {
                _keysDeclared = declared;
                await _keys.SetKeysAsync(keys);
            }
        }

        // Re-attach every render, unconditionally. setupScroll is idempotent in JS (a no-op once
        // bound to this exact node), so the common case is cheap — but attaching on firstRender
        // ONLY meant a stale ref at that moment (the reconnect / fast re-render race), or a node
        // later replaced by a structural re-render, disabled zoom permanently for this editor.
        try
        {
            await JS.InvokeVoidAsync("bwViewport.setupScroll", _viewportRef, _zoomState.Reference);

            // In the read-only view the box is framed to the wall region (_frame), so it pins that
            // region's aspect and scrolls to it once. In edit mode _frame is null: publish the full
            // photo aspect as --fit-aspect only (no inline aspect-ratio) so the box keeps its
            // flex-driven height until the .bw-fullscreen CSS opts in — exactly as before. Gated so
            // the one-time framing scroll is never re-applied on top of the user panning.
            var fitKey = EffectivePhotoUrl + "|" + (_frame == null ? string.Empty : string.Join(",", _frame));
            if (_fitKey != fitKey)
            {
                _fitKey = fitKey;
                await JS.InvokeVoidAsync("bwViewport.fitBox", _viewportRef, _frame != null, _frame);
            }
        }
        catch (JSException)
        {
            // Stale element reference after a re-render/reconnect: allow the next render to retry.
            // Never let it become an unhandled circuit error.
            _fitKey = null;
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away mid-call; nothing to attach to.
            _fitKey = null;
        }
    }

    public void Dispose() => _zoomState.Dispose();

    /// <remarks>
    /// The renderer prefers <see cref="IAsyncDisposable"/> over <see cref="IDisposable"/>, so this
    /// path must release the zoom state too; <see cref="Dispose"/> stays for any other caller.
    /// </remarks>
    public async ValueTask DisposeAsync()
    {
        if (_keys != null)
        {
            await _keys.DisposeAsync();
            _keys = null;
        }

        _zoomState.Dispose();
    }

    protected override void OnParametersSet()
    {
        // Frame the read-only view to the wall region (border if present, else the holds' bbox) so
        // the photo isn't mostly floor/ceiling. Editing stays uncropped: the editor needs the whole
        // canvas (adding holds outside the border, editing the border itself) and its flex/fullscreen
        // layout doesn't cleanly adopt the region aspect. A null frame renders exactly as before.
        // Border-only editing is uncropped for the same reason — you shape the border over the whole photo.
        _frame = CanEdit || BorderOnly ? null : WallFraming.TryComputeFrame(BorderPoints, Holds);

        // Border-only mode has no tool but the border tool, so open straight in border mode.
        if (BorderOnly)
        {
            SetMode(HoldTouchupTool.Border);
        }

        // Reset all editing state whenever we enter or leave manual alignment so
        // stale hold ids from a prior staging session never bleed into the next one.
        if (ManualAlignment != _lastManualAlignment)
        {
            _alignedHoldIds.Clear();
            _changedHoldIds.Clear();
            _addedHolds.Clear();
            _updatedHoldIds.Clear();
            _deletedHoldIds.Clear();
            _markChangedHoldIds.Clear();
            _alignmentChangedIds.Clear();
            _snapshotHolds = null;
            _selectedHoldId = null;
            _markUnchangedHoldId = null;
            _manualBaseline.Clear();
            if (ManualAlignment)
            {
                SetMode(HoldTouchupTool.Move);
                CaptureManualBaseline();
            }

            _lastManualAlignment = ManualAlignment;
        }

        // Reset the per-panel edit tracking whenever the parent re-scopes this editor to a
        // different subject (a new ResetToken), so a previous panel's unsaved adds/updates/deletes
        // never carry over onto the next panel. Only outside manual alignment: the alignment sets
        // (_alignedHoldIds/_changedHoldIds/_alignmentChangedIds/_manualBaseline) are owned by the
        // ManualAlignment toggle above and must survive.
        if (ResetToken != _lastResetToken)
        {
            _lastResetToken = ResetToken;
            if (!ManualAlignment)
            {
                _addedHolds.Clear();
                _updatedHoldIds.Clear();
                _deletedHoldIds.Clear();
                _markChangedHoldIds.Clear();
                _snapshotHolds = null;
                _selectedHoldId = null;
            }
        }
    }

    // Returns a CSS class, never an inline cursor: an inline style on .photo-viewport is rewritten
    // wholesale by Blazor on a tool switch and takes viewport.js's inline touch-action/--fit-aspect/
    // --crop-scale/aspect-ratio with it, which makes the view pan on its own. See components.css.
    private string CursorClassForMode() => _mode switch
    {
        HoldTouchupTool.Delete => "bw-cursor-crosshair",
        HoldTouchupTool.Add => "bw-cursor-crosshair",
        HoldTouchupTool.Name => "bw-cursor-help",
        HoldTouchupTool.ShapeTilt => "bw-cursor-pointer",
        HoldTouchupTool.Merge => "bw-cursor-pointer",
        HoldTouchupTool.MakeActual => "bw-cursor-pointer",
        HoldTouchupTool.JoinVirtual => "bw-cursor-pointer",
        HoldTouchupTool.MarkUnchanged => "bw-cursor-pointer",
        HoldTouchupTool.MarkChanged => "bw-cursor-pointer",
        _ => "bw-cursor-default"
    };

    /// <summary>
    /// Picks a tool through the toolbar's own state and drops the previous tool's working state.
    /// The keyboard shortcuts come through here, so keys and clicks write the SAME object.
    /// </summary>
    private void SetMode(HoldTouchupTool mode)
    {
        tools.SetTool(mode);
        ClearToolState(mode);
    }

    /// <summary>
    /// The per-tool working state this component owns (which hold is being named, the pending merge,
    /// …). It is deliberately NOT in the toolbar: it is wall state, and handing the toolbar a
    /// reference to this component to reach it is exactly what sank the previous two extractions.
    /// </summary>
    private void ClearToolState(HoldTouchupTool mode)
    {
        _showUsage = false;
        _usageHoldId = null;
        if (mode != HoldTouchupTool.ShapeTilt)
        {
            _shapeTiltHoldId = null;
            ClearShapeTiltSnapshot();
        }
        if (mode != HoldTouchupTool.Move) _selectedHoldId = null;
        if (mode != HoldTouchupTool.Shape) _shapeEditHoldId = null;
        if (mode != HoldTouchupTool.Name) _namingHoldId = null;
        if (mode != HoldTouchupTool.MakeActual)
        {
            _makeActualVirtualId = null;
            _makeActualTargetId = null;
        }
        if (mode != HoldTouchupTool.JoinVirtual)
        {
            _joinSurvivorId = null;
            _joinDuplicateId = null;
        }
        if (mode != HoldTouchupTool.MarkUnchanged)
        {
            _markUnchangedHoldId = null;
        }
        if (mode != HoldTouchupTool.MarkChanged)
        {
            _markChangedHoldId = null;
        }
    }

    private void TakeSnapshot()
    {
        if (_snapshotHolds != null) return;
        _snapshotHolds = Holds.Select(h => new Hold
        {
            Id = h.Id, WallId = h.WallId, X = h.X, Y = h.Y, Radius = h.Radius,
            Color = h.Color, Material = h.Material, Category = h.Category, HandType = h.HandType, IsOnKickboard = h.IsOnKickboard,
            IsAutoDetected = h.IsAutoDetected, Confidence = h.Confidence, Generation = h.Generation,
            Name = h.Name,
            ShapePoints = h.ShapePoints?.Select(sp => new ShapePoint { Dx = sp.Dx, Dy = sp.Dy }).ToList(),
        }).ToList();
    }

    private void TrackUpdate(Hold hold)
    {
        TakeSnapshot();
        if (!_addedHolds.Contains(hold))
            _updatedHoldIds.Add(hold.Id);
    }

    /// <summary>
    /// Enters the read-only usage tool, loading the map on first use. Leaving restores
    /// whichever editing tool was active before, so it doubles as a quick peek.
    /// </summary>
    private async Task ToggleUsageMode()
    {
        if (_showUsage)
        {
            SetMode(_modeBeforeUsage);
            return;
        }

        _modeBeforeUsage = _mode;

        // SetMode clears _showUsage, so the flag is raised AFTER parking the tool.
        SetMode(HoldTouchupTool.None);
        _showUsage = true;

        // Always refetch: boulders may have changed since the tool was last opened.
        _holdUsage = null;

        if (OnRequestHoldUsage != null)
        {
            _holdUsage = await OnRequestHoldUsage();
        }
    }

    private static string UsageDotClass(HoldType type) => type switch
    {
        HoldType.Start => "start",
        HoldType.Top => "top",
        _ => "normal",
    };

    private List<HoldUsageRef> UsageFor(Guid holdId) =>
        _holdUsage != null && _holdUsage.TryGetValue(holdId, out var refs) ? refs : [];

    private int UnusedHoldCount => Holds.Count(h => UsageFor(h.Id).Count == 0);

    private async Task OnHoldClick(Hold hold)
    {
        // Tapping a hold reveals its name even when the labels are hidden.
        _revealNameHoldId = _revealNameHoldId == hold.Id ? null : hold.Id;

        // The usage toggle parks the tool while it is on, so a tap means "what uses this hold?"
        // and nothing else — the same exclusivity the old Usage mode had, without being a mode.
        if (_showUsage)
        {
            _usageHoldId = _usageHoldId == hold.Id ? null : hold.Id;
            return;
        }

        switch (_mode)
        {
            case HoldTouchupTool.Paint:
                TakeSnapshot();
                hold.Color = _paintColor;
                SyncMaterialToColor(hold);
                _updatedHoldIds.Add(hold.Id);
                return;
            case HoldTouchupTool.Pipette:
                // First tap fills the buffer; every tap after it stamps. Both go through HoldStamp, so
                // what is drawn here and what SaveChanges sends are the same payload.
                if (tools.Stamp is not { } stamp)
                {
                    tools.PickStamp(hold);
                    return;
                }

                TakeSnapshot();
                if (stamp.ApplyTo(hold))
                {
                    _updatedHoldIds.Add(hold.Id);
                }

                return;
            case HoldTouchupTool.Delete:
                TakeSnapshot();
                _deletedHoldIds.Add(hold.Id);
                Holds.RemoveAll(h => h.Id == hold.Id);
                return;
            case HoldTouchupTool.Shape:
                _shapeEditHoldId = hold.Id;
                if (hold.ShapePoints == null)
                {
                    TakeSnapshot();
                    hold.ShapePoints = ShapePoint.DefaultOctagon(hold.Radius);
                    _updatedHoldIds.Add(hold.Id);
                }
                return;
            case HoldTouchupTool.Name:
                _namingHoldId = hold.Id;
                _nameInput = hold.Name ?? string.Empty;
                return;
            case HoldTouchupTool.Move:
                _selectedHoldId = hold.Id;
                _selectedRadius = hold.Radius;
                return;
            case HoldTouchupTool.Merge:
                HandleMergeClick(hold);
                return;
            case HoldTouchupTool.MakeActual:
                HandleMakeActualClick(hold);
                return;
            case HoldTouchupTool.JoinVirtual:
                HandleJoinVirtualClick(hold);
                return;
            case HoldTouchupTool.MarkUnchanged:
                _markUnchangedHoldId = _markUnchangedHoldId == hold.Id ? null : hold.Id;
                return;
            case HoldTouchupTool.MarkChanged:
                _markChangedHoldId = _markChangedHoldId == hold.Id ? null : hold.Id;
                return;
            case HoldTouchupTool.ShapeTilt:
                _shapeTiltHoldId = hold.Id;
                CaptureShapeTiltSnapshot(hold);
                _shapeTiltAngleX = 0;
                _shapeTiltAngleY = 0;
                return;
        }
    }

    private (Guid stagedId, Guid liveId)? _pendingMerge;
    private Guid? _mergeFirstPickId;

    private void HandleMergeClick(Hold hold)
    {
        if (!IsStaging) return;

        var isStaged = IsStagedHold(hold);
        var isLive = IsLiveHold(hold);
        if (!isStaged && !isLive) return;

        if (_mergeFirstPickId == null)
        {
            // Auto-detect: is there an opposite-gen hold under this one?
            var match = FindUnderlyingOpposite(hold);
            if (match != null)
            {
                _pendingMerge = isStaged ? (hold.Id, match.Id) : (match.Id, hold.Id);
                return;
            }
            _mergeFirstPickId = hold.Id;
            return;
        }

        var first = Holds.FirstOrDefault(h => h.Id == _mergeFirstPickId);
        if (first == null) { _mergeFirstPickId = null; return; }
        if (first.Id == hold.Id) { _mergeFirstPickId = null; return; }

        var firstIsStaged = IsStagedHold(first);
        if (firstIsStaged == isStaged) { _mergeFirstPickId = hold.Id; return; }

        _pendingMerge = firstIsStaged ? (first.Id, hold.Id) : (hold.Id, first.Id);
        _mergeFirstPickId = null;
    }

    private Hold? FindUnderlyingOpposite(Hold hold)
    {
        var threshold = Math.Max(hold.Radius, 0.01) * 0.75;
        var thresholdSq = threshold * threshold;
        Hold? best = null;
        var bestDistSq = double.MaxValue;
        foreach (var other in Holds)
        {
            if (other.Id == hold.Id) continue;
            if (IsStagedHold(other) == IsStagedHold(hold)) continue;
            var dx = other.X - hold.X;
            var dy = other.Y - hold.Y;
            var d2 = dx * dx + dy * dy;
            if (d2 < thresholdSq && d2 < bestDistSq)
            {
                best = other;
                bestDistSq = d2;
            }
        }
        return best;
    }

    private async Task ConfirmMerge()
    {
        if (_pendingMerge == null) return;
        var pair = _pendingMerge.Value;
        _pendingMerge = null;
        await OnMergeHolds.InvokeAsync((pair.stagedId, pair.liveId));
    }

    private void CancelMerge()
    {
        _pendingMerge = null;
        _mergeFirstPickId = null;
    }

    // ---- Make-actual tool (non-staging): promote a virtual hold, or merge it into a detected one ----
    private Guid? _makeActualVirtualId;
    private Guid? _makeActualTargetId;

    private void HandleMakeActualClick(Hold hold)
    {
        // A fresh virtual pick always (re)selects and clears any pending merge target.
        if (hold.IsVirtual)
        {
            _makeActualVirtualId = hold.Id;
            _makeActualTargetId = null;
            return;
        }

        // A non-virtual pick only means something once a virtual hold is selected: it becomes
        // the merge target (same wall is guaranteed — all Holds belong to this wall).
        if (_makeActualVirtualId == null || _makeActualVirtualId == hold.Id)
        {
            return;
        }

        _makeActualTargetId = hold.Id;
    }

    private async Task ConfirmMakeActualMerge()
    {
        if (_makeActualVirtualId is not { } virtualId || _makeActualTargetId is not { } targetId)
        {
            return;
        }

        _makeActualVirtualId = null;
        _makeActualTargetId = null;
        await OnMergeVirtualHold.InvokeAsync((virtualId, targetId));
    }

    private async Task MakeActualAsIs()
    {
        if (_makeActualVirtualId is not { } virtualId)
        {
            return;
        }

        _makeActualVirtualId = null;
        _makeActualTargetId = null;
        await OnMakeHoldActual.InvokeAsync(virtualId);
    }

    private void CancelMakeActual()
    {
        _makeActualVirtualId = null;
        _makeActualTargetId = null;
    }

    // ---- Join tool (non-staging): absorb a duplicate VIRTUAL hold into another virtual hold ----
    private Guid? _joinSurvivorId;
    private Guid? _joinDuplicateId;

    private void HandleJoinVirtualClick(Hold hold)
    {
        // Both picks must be virtual. A non-virtual tap re-selects nothing silently: it restarts the
        // pick so the hint tells the user what the tool wants, mirroring the make-actual tool.
        if (!hold.IsVirtual)
        {
            _joinSurvivorId = null;
            _joinDuplicateId = null;
            return;
        }

        if (_joinSurvivorId == null || _joinSurvivorId == hold.Id)
        {
            _joinSurvivorId = hold.Id;
            _joinDuplicateId = null;
            return;
        }

        _joinDuplicateId = hold.Id;
    }

    private async Task ConfirmJoinVirtual()
    {
        if (_joinSurvivorId is not { } survivorId || _joinDuplicateId is not { } duplicateId)
        {
            return;
        }

        _joinSurvivorId = null;
        _joinDuplicateId = null;
        await OnJoinVirtualHolds.InvokeAsync((survivorId, duplicateId));
    }

    private void CancelJoinVirtual()
    {
        _joinSurvivorId = null;
        _joinDuplicateId = null;
    }

    private (double X, double Y) LiveCentroid()
    {
        if (_alignSnapshot != null) return _alignSnapshotPivot;
        var live = Holds.Where(IsLiveHold).ToList();
        if (live.Count == 0) return (0.5, 0.5);
        return (live.Average(h => h.X), live.Average(h => h.Y));
    }

    private async Task OnSvgMouseDown(MouseEventArgs e)
    {
        if (!CanEdit) return;
        await Task.CompletedTask;
    }

    // ---- Whole-overlay alignment gizmo (staging) ---------------------------
    private enum AlignHandle { Translate, TiltX, TiltY, RotateZ, Scale }
    private AlignHandle? _alignDragHandle;
    private double _alignDragStartX, _alignDragStartY;
    private double _alignDragStartAngleZ;
    private double _alignDragStartRadius;
    private const double AlignTiltGain = 8.0;
    private const double AlignPerspective = 0.9;

    private record LiveSnapshotEntry(Guid Id, double X, double Y, double Radius, List<ShapePoint>? Shape);
    private List<LiveSnapshotEntry>? _alignSnapshot;
    private (double X, double Y) _alignSnapshotPivot;

    /// <summary>
    /// IDs touched by a whole-overlay alignment drag. Saved with manual edits but not
    /// counted in <see cref="_pendingChanges"/>, so realigning the overlay doesn't
    /// look like the user manually moved every hold.
    /// </summary>
    private readonly HashSet<Guid> _alignmentChangedIds = [];

    private void CaptureAlignSnapshot()
    {
        var live = Holds.Where(IsLiveHold).ToList();
        if (live.Count == 0) { _alignSnapshot = null; return; }
        _alignSnapshotPivot = (live.Average(h => h.X), live.Average(h => h.Y));
        _alignSnapshot = live.Select(h => new LiveSnapshotEntry(
            h.Id, h.X, h.Y, h.Radius,
            h.ShapePoints?.Select(sp => new ShapePoint { Dx = sp.Dx, Dy = sp.Dy }).ToList()
        )).ToList();
    }

    private async Task StartAlignDrag(MouseEventArgs e, AlignHandle handle)
    {
        if (!CanEdit || !IsStaging) return;
        CaptureAlignSnapshot();
        if (_alignSnapshot == null) return;
        var pos = await JS.InvokeAsync<RelativePos>("wallEditor.getRelativePosition", _containerRef, e.ClientX, e.ClientY);
        _alignDragHandle = handle;
        _alignDragStartX = pos.X;
        _alignDragStartY = pos.Y;
        if (handle == AlignHandle.RotateZ)
        {
            var (cx, cy) = _alignSnapshotPivot;
            _alignDragStartAngleZ = Math.Atan2(pos.Y - cy, pos.X - cx);
        }
        else if (handle == AlignHandle.Scale)
        {
            var (cx, cy) = _alignSnapshotPivot;
            var sdx = pos.X - cx;
            var sdy = pos.Y - cy;
            _alignDragStartRadius = Math.Max(0.01, Math.Sqrt(sdx * sdx + sdy * sdy));
        }
        TakeSnapshot();
    }

    private void ApplyAlignDrag(double posX, double posY)
    {
        if (_alignSnapshot == null || _alignDragHandle == null) return;
        var (px, py) = _alignSnapshotPivot;
        double dxOff = 0, dyOff = 0, angleX = 0, angleY = 0, angleZ = 0, scale = 1.0;
        switch (_alignDragHandle.Value)
        {
            case AlignHandle.Translate:
                dxOff = posX - _alignDragStartX;
                dyOff = posY - _alignDragStartY;
                break;
            case AlignHandle.TiltX:
                angleX = -(posY - _alignDragStartY) * AlignTiltGain;
                break;
            case AlignHandle.TiltY:
                angleY = (posX - _alignDragStartX) * AlignTiltGain;
                break;
            case AlignHandle.RotateZ:
                angleZ = Math.Atan2(posY - py, posX - px) - _alignDragStartAngleZ;
                break;
            case AlignHandle.Scale:
                var sdx = posX - px;
                var sdy = posY - py;
                var r = Math.Sqrt(sdx * sdx + sdy * sdy);
                scale = Math.Clamp(r / _alignDragStartRadius, 0.2, 5.0);
                break;
        }

        var cax = Math.Cos(angleX); var sax = Math.Sin(angleX);
        var cay = Math.Cos(angleY); var say = Math.Sin(angleY);
        var caz = Math.Cos(angleZ); var saz = Math.Sin(angleZ);

        foreach (var snap in _alignSnapshot)
        {
            var hold = Holds.FirstOrDefault(h => h.Id == snap.Id);
            if (hold == null) continue;
            var sx = px + (snap.X - px) * scale;
            var sy = py + (snap.Y - py) * scale;
            var (nx, ny, projScale) = ApplyXyz(sx, sy, px, py, cax, sax, cay, say, caz, saz);
            hold.X = Math.Clamp(nx + dxOff, 0, 1);
            hold.Y = Math.Clamp(ny + dyOff, 0, 1);
            hold.Radius = Math.Clamp(snap.Radius * scale * projScale, 0.003, 0.2);
            if (snap.Shape != null && hold.ShapePoints != null && hold.ShapePoints.Count == snap.Shape.Count)
            {
                for (var i = 0; i < snap.Shape.Count; i++)
                {
                    var sp = snap.Shape[i];
                    var sspx = px + (snap.X + sp.Dx - px) * scale;
                    var sspy = py + (snap.Y + sp.Dy - py) * scale;
                    var (spx, spy, _) = ApplyXyz(sspx, sspy, px, py, cax, sax, cay, say, caz, saz);
                    hold.ShapePoints[i].Dx = (spx + dxOff) - hold.X;
                    hold.ShapePoints[i].Dy = (spy + dyOff) - hold.Y;
                }
            }
            _alignmentChangedIds.Add(snap.Id);
        }
    }

    private static (double X, double Y, double Scale) ApplyXyz(
        double x, double y, double px, double py,
        double cax, double sax, double cay, double say, double caz, double saz)
    {
        var dx = x - px;
        var dy = y - py;
        var dz = 0.0;
        var y1 = dy * cax - dz * sax;
        var z1 = dy * sax + dz * cax;
        var x2 = dx * cay + z1 * say;
        var z2 = -dx * say + z1 * cay;
        var x3 = x2 * caz - y1 * saz;
        var y3 = x2 * saz + y1 * caz;
        var scale = 1.0 / (1.0 + z2 * AlignPerspective);
        return (px + x3 * scale, py + y3 * scale, scale);
    }

    // ---- per-hold ShapeTilt -----------------------------------------------
    private Guid? _shapeTiltHoldId;
    private List<ShapePoint>? _shapeTiltSnapshot;
    private double _shapeTiltAngleX, _shapeTiltAngleY;
    private double _shapeTiltDragStartX, _shapeTiltDragStartY;
    private bool _shapeTiltDragging;
    private const double ShapeTiltGain = 16.0;
    private const double ShapeTiltPerspective = 0.8;

    private void CaptureShapeTiltSnapshot(Hold hold)
    {
        if (hold.ShapePoints == null)
        {
            hold.ShapePoints = ShapePoint.DefaultOctagon(hold.Radius);
        }
        _shapeTiltSnapshot = hold.ShapePoints.Select(sp => new ShapePoint { Dx = sp.Dx, Dy = sp.Dy }).ToList();
    }

    private void ClearShapeTiltSnapshot() { _shapeTiltSnapshot = null; }

    private async Task StartShapeTiltDrag(MouseEventArgs e, Hold hold)
    {
        if (!CanEdit || _mode != HoldTouchupTool.ShapeTilt) return;
        if (_shapeTiltSnapshot == null) CaptureShapeTiltSnapshot(hold);
        var pos = await JS.InvokeAsync<RelativePos>("wallEditor.getRelativePosition", _containerRef, e.ClientX, e.ClientY);
        _shapeTiltDragging = true;
        _shapeTiltDragStartX = pos.X;
        _shapeTiltDragStartY = pos.Y;
        TakeSnapshot();
    }

    private void ApplyShapeTilt()
    {
        var hold = Holds.FirstOrDefault(h => h.Id == _shapeTiltHoldId);
        if (hold == null || _shapeTiltSnapshot == null || hold.ShapePoints == null) return;
        var cax = Math.Cos(_shapeTiltAngleX); var sax = Math.Sin(_shapeTiltAngleX);
        var cay = Math.Cos(_shapeTiltAngleY); var say = Math.Sin(_shapeTiltAngleY);
        var count = Math.Min(_shapeTiltSnapshot.Count, hold.ShapePoints.Count);
        for (var i = 0; i < count; i++)
        {
            var sp = _shapeTiltSnapshot[i];
            var dx = sp.Dx;
            var dy = sp.Dy;
            var dz = 0.0;
            var y1 = dy * cax - dz * sax;
            var z1 = dy * sax + dz * cax;
            var x2 = dx * cay + z1 * say;
            var z2 = -dx * say + z1 * cay;
            var scale = 1.0 / (1.0 + z2 * ShapeTiltPerspective);
            hold.ShapePoints[i].Dx = x2 * scale;
            hold.ShapePoints[i].Dy = y1 * scale;
        }
        _updatedHoldIds.Add(hold.Id);
    }

    private void ResetShapeTilt()
    {
        var hold = Holds.FirstOrDefault(h => h.Id == _shapeTiltHoldId);
        if (hold == null || _shapeTiltSnapshot == null || hold.ShapePoints == null) return;
        for (var i = 0; i < _shapeTiltSnapshot.Count && i < hold.ShapePoints.Count; i++)
        {
            hold.ShapePoints[i].Dx = _shapeTiltSnapshot[i].Dx;
            hold.ShapePoints[i].Dy = _shapeTiltSnapshot[i].Dy;
        }
        _shapeTiltAngleX = _shapeTiltAngleY = 0;
        _updatedHoldIds.Add(hold.Id);
        StateHasChanged();
    }

    private static double RadDeg(double r) => r * 180.0 / Math.PI;
    private static string F2(double v) => v.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);

    private void ApplyName()
    {
        if (_namingHoldId == null) return;
        var hold = Holds.FirstOrDefault(h => h.Id == _namingHoldId);
        if (hold == null) return;
        TakeSnapshot();
        hold.Name = string.IsNullOrWhiteSpace(_nameInput) ? null : _nameInput.Trim();
        _updatedHoldIds.Add(hold.Id);
        _namingHoldId = null;
    }

    private void StartDrag(Hold hold)
    {
        if (!CanEdit || _mode != HoldTouchupTool.Move) return;
        _selectedHoldId = hold.Id;
        _selectedRadius = hold.Radius;
        _draggingHoldId = hold.Id;
        TakeSnapshot();
    }

    private void StartShapePointDrag(Hold hold, int idx)
    {
        TakeSnapshot();
        _draggingShapeHold = hold;
        _draggingShapePointIdx = idx;
    }

    private void StartBorderDrag(int idx)
    {
        if (!CanEditShape)
        {
            return;
        }

        _draggingBorderIdx = idx;
    }

    private async Task OnSvgClick(MouseEventArgs e)
    {
        if (!CanEdit || _mode != HoldTouchupTool.Add) return;
        var pos = await JS.InvokeAsync<RelativePos>("wallEditor.getRelativePosition", _containerRef, e.ClientX, e.ClientY);
        var radius = _selectedRadius;
        TakeSnapshot();
        var hold = new Hold
        {
            Id = Guid.NewGuid(), WallId = WallId,
            X = Math.Clamp(pos.X, 0, 1), Y = Math.Clamp(pos.Y, 0, 1),
            Radius = radius, Category = _addCategory,
            Color = _addColor == "none" ? null : _addColor,
            Material = _addMaterial,
            IsOnKickboard = _addOnKickboard, IsAutoDetected = false,
        };
        _addedHolds.Add(hold);
        Holds.Add(hold);
    }

    private async Task OnSvgMouseMove(MouseEventArgs e)
    {
        // Nothing is being dragged: don't pay a SignalR interop round-trip just to follow a hovering
        // cursor. Only once a drag is active do we resolve the pointer's wall-relative position.
        var dragging = _alignDragHandle.HasValue
            || _shapeTiltDragging
            || _draggingBorderIdx.HasValue
            || _draggingShapePointIdx.HasValue
            || _draggingHoldId != null;
        if (!dragging)
        {
            return;
        }

        var pos = await JS.InvokeAsync<RelativePos>("wallEditor.getRelativePosition", _containerRef, e.ClientX, e.ClientY);

        if (_alignDragHandle.HasValue)
        {
            ApplyAlignDrag(pos.X, pos.Y);
            StateHasChanged(); return;
        }
        if (_shapeTiltDragging && _shapeTiltSnapshot != null)
        {
            _shapeTiltAngleY = (pos.X - _shapeTiltDragStartX) * ShapeTiltGain;
            _shapeTiltAngleX = -(pos.Y - _shapeTiltDragStartY) * ShapeTiltGain;
            ApplyShapeTilt();
            StateHasChanged(); return;
        }

        if (_draggingBorderIdx.HasValue && _draggingBorderIdx.Value < BorderPoints.Count)
        {
            BorderPoints[_draggingBorderIdx.Value] = new ShapePoint { Dx = Math.Clamp(pos.X, 0, 1), Dy = Math.Clamp(pos.Y, 0, 1) };
            StateHasChanged(); return;
        }
        if (_draggingShapePointIdx.HasValue && _draggingShapeHold != null)
        {
            var sp = _draggingShapeHold.ShapePoints![_draggingShapePointIdx.Value];
            sp.Dx = pos.X - _draggingShapeHold.X;
            sp.Dy = pos.Y - _draggingShapeHold.Y;
            StateHasChanged(); return;
        }
        if (_draggingHoldId == null) return;
        var hold = Holds.FirstOrDefault(h => h.Id == _draggingHoldId);
        if (hold == null) return;
        hold.X = Math.Clamp(pos.X, 0, 1);
        hold.Y = Math.Clamp(pos.Y, 0, 1);
        StateHasChanged();
    }

    private async Task OnSvgMouseUp(EventArgs e)
    {
        if (_alignDragHandle.HasValue) { _alignDragHandle = null; _alignSnapshot = null; return; }
        if (_shapeTiltDragging) { _shapeTiltDragging = false; return; }
        if (_draggingBorderIdx.HasValue) { _draggingBorderIdx = null; await OnBorderChanged.InvokeAsync(BorderPoints); return; }
        if (_draggingShapePointIdx.HasValue && _draggingShapeHold != null)
        {
            var h = _draggingShapeHold; _draggingShapePointIdx = null; _draggingShapeHold = null;
            _updatedHoldIds.Add(h.Id); return;
        }
        if (_draggingHoldId == null) return;
        var hold = Holds.FirstOrDefault(h => h.Id == _draggingHoldId);
        _draggingHoldId = null;
        if (hold != null) _updatedHoldIds.Add(hold.Id);
    }

    private void DeleteSelected()
    {
        if (_selectedHoldId == null) return;
        TakeSnapshot();
        _deletedHoldIds.Add(_selectedHoldId.Value);
        Holds.RemoveAll(h => h.Id == _selectedHoldId.Value);
        _selectedHoldId = null;
    }

