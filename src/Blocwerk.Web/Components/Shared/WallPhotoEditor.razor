@inject IJSRuntime JS
@inject KeyboardShortcutGate KeyGate
@inject IHttpContextAccessor HttpContextAccessor
@implements IDisposable
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Routing

@* Warn before navigating away with unsaved manual-alignment drag work: all of it lives in
   client state until "Confirm & Update Wall", so an internal nav or a full page leave would
   silently discard it. *@
<NavigationLock ConfirmExternalNavigation="_hasPendingAlignmentWork" OnBeforeInternalNavigation="OnBeforeNavigateAway" />

@* The toolbar and its contextual row are one component now (UnifiedToolbar). The row used to be
   fifteen .option-bar blocks in .editor-bottom whose height changed per tool, so the image resized
   under the cursor on every mode switch; it has a fixed height here. Each tool still supplies its
   own row — the fragments below live in this component, where the state they read lives. *@
@* Both classes are emitted unconditionally from the PREFERENCE; the desktop tier is a CSS concern.
   docked-bottom in particular is emitted for either placement, because below the desktop tier the
   sidebar rules are switched off and the phone still needs its thumb-reachable docked bar. *@
<div class="editor-shell @(placement == ToolbarPlacement.Sidebar ? "with-sidebar" : string.Empty)">
<UnifiedToolbar Spec="Toolbar" State="tools" ToolChanged="OnToolPicked"
                Placement="placement" Class="@(BottomToolbar ? "docked-bottom" : null)" />
<div class="editor-stage">

@* Zoom geometry is owned by JS via the `--zoom` custom property (viewport.js); the
   markup must not emit a width or a late re-render would stomp the live transform. *@
@* The tool cursor is a CLASS, not `style="cursor: ..."`: viewport.js owns INLINE styles on this
   element (touch-action, --fit-aspect, --crop-scale, aspect-ratio) and Blazor rewrites the whole
   style attribute whenever its value changes, wiping them — the box then resizes and the browser
   clamps scrollLeft/scrollTop, i.e. the view pans by itself. Never reintroduce an inline style here. *@
<div class="photo-viewport@(_frame != null ? " bw-framed" : string.Empty) @CursorClassForMode()" @ref="_viewportRef">
<div class="photo-editor" @ref="_containerRef"
     data-hold-drag="@(CanEdit && _mode == HoldTouchupTool.Move ? "true" : null)">
    <img src="@ResponsiveImage.Initial(EffectivePhotoUrl)" data-bw-res alt="Wall" class="wall-photo" />
    @* Hold drag uses POINTER events so mouse, touch and pen share one path. PointerEventArgs
       derives from MouseEventArgs, so OnSvgMouseMove/OnSvgMouseUp bind unchanged. *@
    <svg class="hold-overlay" viewBox="0 0 100 100" preserveAspectRatio="none"
         @onclick="OnSvgClick"
         @onmousedown="OnSvgMouseDown"
         @onpointermove="OnSvgMouseMove"
         @onpointerup="OnSvgMouseUp"
         @onpointercancel="OnSvgMouseUp">

        @* Wall border *@
        @if (_showBorder && BorderPoints.Count >= 3)
        {
            <polygon points="@Pts(BorderPoints.Select(p => (p.Dx, p.Dy)))"
                     fill="none" stroke="#FF9800" stroke-width="0.3" stroke-dasharray="1 0.5"
                     style="pointer-events: none" />
        }

        @* Holds *@
        @* Destructive tools get EXACT hit targets, the same opt-out PanelImageView ships for its delete
           tool. Delete, Paint and the pipette stamp act on the tap itself with no confirmation, and
           under 5px of travel separates that tap from a pan — so the transparent half of the stroke,
           which normally makes a small hold easier to grab, must not count as a hit. `pointer-events:
           fill` restricts the target to the shape the hold actually paints (the traced polygon where
           there is one), instead of that shape plus half a stroke width all round. *@
        @{
            var exactHit = _mode is HoldTouchupTool.Delete or HoldTouchupTool.Paint or HoldTouchupTool.Pipette;
            var hitEvents = exactHit ? "fill" : null;
        }
        @foreach (var hold in Holds)
        {
            var isSelected = _selectedHoldId == hold.Id;
            var isShapeEditing = _mode == HoldTouchupTool.Shape && _shapeEditHoldId == hold.Id;
            var isNaming = _mode == HoldTouchupTool.Name && _namingHoldId == hold.Id;
            var isFoot = hold.Category == HoldCategory.Foot;
            var fillColor = GetHoldFillColor(hold, isSelected || isShapeEditing || isNaming);
            var strokeColor = (isSelected || isShapeEditing || isNaming) ? "#ffffff" : GetHoldStrokeColor(hold);
            if (ManualAlignment && !(isSelected || isShapeEditing || isNaming))
            {
                strokeColor = ManualStroke(hold);
            }
            else if (IsStaging && !(isSelected || isShapeEditing || isNaming))
            {
                strokeColor = IsStagedHold(hold) ? "#33dd66" : "#ff9933";
            }
            var isPendingMergeHold = _pendingMerge is { } pending
                && (pending.stagedId == hold.Id || pending.liveId == hold.Id);
            var isMergePick = _mode == HoldTouchupTool.Merge && (_mergeFirstPickId == hold.Id || isPendingMergeHold);
            if (isMergePick)
            {
                strokeColor = "#ffd700";
            }
            var isMakeActualPick = _mode == HoldTouchupTool.MakeActual &&
                (_makeActualVirtualId == hold.Id || _makeActualTargetId == hold.Id);
            if (isMakeActualPick)
            {
                strokeColor = "#ffd700";
            }
            // Survivor and absorbed pick read differently on purpose: green "kept", red "absorbed".
            var isJoinSurvivor = _mode == HoldTouchupTool.JoinVirtual && _joinSurvivorId == hold.Id;
            var isJoinDuplicate = _mode == HoldTouchupTool.JoinVirtual && _joinDuplicateId == hold.Id;
            if (isJoinSurvivor)
            {
                strokeColor = "#33dd66";
            }
            else if (isJoinDuplicate)
            {
                strokeColor = "#ff5566";
            }
            var isMarkUnchangedPick = _mode == HoldTouchupTool.MarkUnchanged && _markUnchangedHoldId == hold.Id;
            if (isMarkUnchangedPick)
            {
                strokeColor = "#38e1c6";
            }
            var isMarkChangedPick = _mode == HoldTouchupTool.MarkChanged && _markChangedHoldId == hold.Id;
            if (isMarkChangedPick)
            {
                strokeColor = "#ff8a3d";
            }
            var sw = (isSelected || isShapeEditing || isNaming) ? "0.4" : (IsStaging ? "0.45" : "0.25");
            var dash = "";
            if (ManualAlignment && !(isSelected || isShapeEditing || isNaming))
            {
                dash = _alignedHoldIds.Contains(hold.Id) ? "" : "0.5 0.35";
            }
            else if (IsStaging && !(isSelected || isShapeEditing || isNaming))
            {
                dash = IsStagedHold(hold) ? "0.6 0.3" : "0.3 0.3";
            }
            if (hold.IsVirtual && !(isSelected || isShapeEditing || isNaming) && !isMakeActualPick && !isMarkUnchangedPick
                && !isMarkChangedPick && !isJoinSurvivor && !isJoinDuplicate)
            {
                strokeColor = "#c86dff";
                dash = "0.6 0.4";
            }

            // The usage tool overrides every other styling: used holds light up, unused
            // ones recede, so "is this hold free?" is answerable at a glance.
            var usageRefs = _showUsage ? UsageFor(hold.Id) : [];
            if (_showUsage)
            {
                var isUsagePick = _usageHoldId == hold.Id;
                var used = usageRefs.Count > 0;
                fillColor = used ? "rgba(76,175,80,0.55)" : "rgba(120,120,120,0.15)";
                strokeColor = isUsagePick ? "#ffffff" : used ? "#4CAF50" : "rgba(255,255,255,0.35)";
                sw = isUsagePick ? "0.6" : used ? "0.4" : "0.2";
                dash = string.Empty;
            }

            var r = (isFoot ? hold.Radius * 0.7 : hold.Radius) * 100;

            @* No @key here, deliberately: this loop has never had one, and keying it on the hold id
               would change the diff's identity rules for every overlay layered below. *@
            <HoldShape X="hold.X" Y="hold.Y" Radius="hold.Radius" ShapePoints="hold.ShapePoints"
                       Foot="isFoot" Fill="@fillColor" Stroke="@strokeColor" StrokeWidth="@sw" Dash="@dash"
                       PointerEvents="@hitEvents" Style="cursor: pointer"
                       OnClick="() => OnHoldClick(hold)" OnPointerDown="() => StartDrag(hold)" />

            @if (_showUsage && usageRefs.Count > 0)
            {
                <g pointer-events="none">
                    <circle cx="@F(hold.X * 100 + r * 0.85)" cy="@F(hold.Y * 100 - r * 0.85)" r="1.4"
                            fill="#4CAF50" stroke="white" stroke-width="0.25" />
                    <text x="@F(hold.X * 100 + r * 0.85)" y="@F(hold.Y * 100 - r * 0.85)"
                          text-anchor="middle" dominant-baseline="central"
                          font-size="1.7" font-weight="700" fill="white">@usageRefs.Count</text>
                </g>
            }

            @* Changed-holds overlay: a distinct badge ring on holds the reviewer has marked as changed
               (the same set that flags boulders for review on confirm). Geometry drift is deliberately
               NOT used — on a large wall re-shot from a slightly different spot, drift is mostly parallax
               and would flag almost everything. Layered over the manual stroke, pointer-events off, and
               only while "Show changes" is on. *@
            @if (_showChanges && (ManualAlignment ? _changedHoldIds.Contains(hold.Id) : (ChangeReview && hold.NeedsReview)))
            {
                <g pointer-events="none">
                    <circle cx="@F(hold.X * 100)" cy="@F(hold.Y * 100)" r="@F(r + 1.3)"
                            fill="none" stroke="var(--status-review)" stroke-width="0.4" stroke-dasharray="0.9 0.5" opacity="0.95" />
                    <circle cx="@F(hold.X * 100 + r * 0.9)" cy="@F(hold.Y * 100 - r * 0.9)" r="1.1"
                            fill="var(--status-review)" stroke="white" stroke-width="0.2" />
                </g>
            }

            @* Missing-information overlay: a badge on holds with no colour, or hand holds with no
               sub-type. Deliberately NOT a mode — it is layered over whatever the current tool draws
               with pointer-events off, so the holds it badges stay tappable and editable in place
               (Select/Move + the selected-hold option bar). *@
            @if (HoldCompleteness.IsIncomplete(hold, _incompleteCriteria))
            {
                <g pointer-events="none">
                    <circle cx="@F(hold.X * 100)" cy="@F(hold.Y * 100)" r="@F(r + 0.8)"
                            fill="none" stroke="#ffb300" stroke-width="0.35" opacity="0.95" />
                    <circle cx="@F(hold.X * 100 - r * 0.9)" cy="@F(hold.Y * 100 + r * 0.9)" r="1.3"
                            fill="#ffb300" stroke="white" stroke-width="0.2" />
                    <text x="@F(hold.X * 100 - r * 0.9)" y="@F(hold.Y * 100 + r * 0.9)"
                          text-anchor="middle" dominant-baseline="central"
                          font-size="1.9" font-weight="700" fill="#1a1a1a">?</text>
                </g>
            }

            @if (isSelected && hold.ShapePoints == null)
            {
                <circle cx="@F(hold.X * 100)" cy="@F(hold.Y * 100)" r="@F(r + 0.5)"
                        fill="none" stroke="white" stroke-width="0.15"
                        stroke-dasharray="0.5 0.3" style="pointer-events: none" />
            }

            @if (!string.IsNullOrEmpty(hold.Name) && (_showNames || _revealNameHoldId == hold.Id || isNaming))
            {
                <foreignObject x="@F((hold.X - 0.08) * 100)" y="@F((hold.Y - hold.Radius - 0.025) * 100)"
                               width="16" height="3" style="pointer-events: none; overflow: visible;">
                    <span style="font-size: 1.8px; color: white; text-shadow: 0 0 1px #000, 0 0 1px #000;
                                 font-family: sans-serif; font-weight: 600; white-space: nowrap;
                                 display: block; text-align: center;">@hold.Name</span>
                </foreignObject>
            }
        }

        @* Draggable handles live HERE, after every hold, on purpose. SVG has no z-index: paint and
           hit-test order is document order, so a handle emitted inside the holds loop is covered by
           every hold that comes later and becomes unclickable. Do not "tidy" these back into the
           loop or next to the shapes they belong to. *@

        @if (_showBorder && BorderPoints.Count >= 3 && CanEditShape && _mode == HoldTouchupTool.Border)
        {
            @for (int i = 0; i < BorderPoints.Count; i++)
            {
                var idx = i;
                var bp = BorderPoints[idx];
                <circle cx="@F(bp.Dx * 100)" cy="@F(bp.Dy * 100)" r="@F(1.2 * HandleScale)"
                        fill="#FF9800" stroke="white" stroke-width="@F(0.3 * HandleScale)"
                        style="cursor: grab"
                        @onmousedown="() => StartBorderDrag(idx)"
                        @onmousedown:stopPropagation="true" />
            }
        }

        @if (_mode == HoldTouchupTool.Shape && _shapeEditHoldId.HasValue)
        {
            var sh = Holds.FirstOrDefault(h => h.Id == _shapeEditHoldId);
            if (sh?.ShapePoints is { Count: >= 3 })
            {
                @for (int i = 0; i < sh.ShapePoints.Count; i++)
                {
                    var cpIdx = i;
                    var sp = sh.ShapePoints[cpIdx];
                    <circle cx="@F((sh.X + sp.Dx) * 100)" cy="@F((sh.Y + sp.Dy) * 100)"
                            r="@F(_shapePointRadius * HandleScale)" fill="white" stroke="#e94560" stroke-width="@F(0.25 * HandleScale)"
                            style="cursor: grab"
                            @onmousedown="() => StartShapePointDrag(sh, cpIdx)" @onmousedown:stopPropagation="true" />
                }
            }
        }

        @if (CanEdit && IsStaging && !ManualAlignment && Holds.Any(IsLiveHold))
        {
            var (cx, cy) = LiveCentroid();
            var arm = 0.12;
            var hxR = cx + arm;
            var hyT = cy - arm;
            <circle cx="@F(cx * 100)" cy="@F(cy * 100)" r="3.0" fill="none" stroke="#4aa8ff" stroke-width="@F(0.3 * HandleScale)" stroke-dasharray="0.8 0.4" style="pointer-events: none" opacity="0.7" />
            <line x1="@F(cx * 100)" y1="@F(cy * 100)" x2="@F(hxR * 100)" y2="@F(cy * 100)" stroke="#ff4d4d" stroke-width="@F(0.35 * HandleScale)" style="pointer-events: none" opacity="0.8" />
            <line x1="@F(cx * 100)" y1="@F(cy * 100)" x2="@F(cx * 100)" y2="@F(hyT * 100)" stroke="#3ddc84" stroke-width="@F(0.35 * HandleScale)" style="pointer-events: none" opacity="0.8" />
            <circle cx="@F(hxR * 100)" cy="@F(cy * 100)" r="@F(1.6 * HandleScale)" fill="#ff4d4d" stroke="#fff" stroke-width="@F(0.3 * HandleScale)"
                    style="cursor: ns-resize"
                    @onmousedown="(e) => StartAlignDrag(e, AlignHandle.TiltX)" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" />
            <circle cx="@F(cx * 100)" cy="@F(hyT * 100)" r="@F(1.6 * HandleScale)" fill="#3ddc84" stroke="#fff" stroke-width="@F(0.3 * HandleScale)"
                    style="cursor: ew-resize"
                    @onmousedown="(e) => StartAlignDrag(e, AlignHandle.TiltY)" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" />
            var zr = 3.0 / 100.0;
            var zhx = cx + zr * 0.7071;
            var zhy = cy - zr * 0.7071;
            <circle cx="@F(zhx * 100)" cy="@F(zhy * 100)" r="@F(1.3 * HandleScale)" fill="#4aa8ff" stroke="#fff" stroke-width="@F(0.3 * HandleScale)"
                    style="cursor: grab"
                    @onmousedown="(e) => StartAlignDrag(e, AlignHandle.RotateZ)" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" />
            var shx = cx + zr * 0.7071;
            var shy = cy + zr * 0.7071;
            var sHalf = 0.012 * HandleScale;
            <rect x="@F((shx - sHalf) * 100)" y="@F((shy - sHalf) * 100)" width="@F(2.4 * HandleScale)" height="@F(2.4 * HandleScale)"
                  fill="#f5a623" stroke="#fff" stroke-width="@F(0.3 * HandleScale)"
                  style="cursor: nwse-resize"
                  @onmousedown="(e) => StartAlignDrag(e, AlignHandle.Scale)" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" />
            <circle cx="@F(cx * 100)" cy="@F(cy * 100)" r="@F(2.2 * HandleScale)" fill="rgba(255,215,0,0.85)" stroke="#000" stroke-width="@F(0.3 * HandleScale)"
                    style="cursor: move"
                    @onmousedown="(e) => StartAlignDrag(e, AlignHandle.Translate)" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" />
        }

        @if (CanEdit && _mode == HoldTouchupTool.ShapeTilt && _shapeTiltHoldId.HasValue)
        {
            var th = Holds.FirstOrDefault(h => h.Id == _shapeTiltHoldId);
            if (th != null)
            {
                var hcx = th.X + th.Radius + 0.015;
                var hcy = th.Y - th.Radius - 0.015;
                <line x1="@F(th.X * 100)" y1="@F(th.Y * 100)" x2="@F(hcx * 100)" y2="@F(hcy * 100)" stroke="#9b59ff" stroke-width="@F(0.25 * HandleScale)" stroke-dasharray="0.4 0.3" style="pointer-events: none" />
                <circle cx="@F(hcx * 100)" cy="@F(hcy * 100)" r="@F(1.4 * HandleScale)" fill="#9b59ff" stroke="#fff" stroke-width="@F(0.3 * HandleScale)"
                        style="cursor: grab" title="Drag to tilt polygon"
                        @onmousedown="(e) => StartShapeTiltDrag(e, th)" @onmousedown:stopPropagation="true" />
            }
        }
    </svg>

    @if (_isDetecting)
    {
        <div class="detecting-overlay"><span>Detecting holds...</span></div>
    }
</div>
</div>

@* Dimming the photo helps a READER pick a boulder's holds out of the wall; while editing it
   only fights the thing being edited, and the bar stole a row of vertical space right under
   the photo where the docked toolbar wants it. So it appears on the read-only arms of this
   component only — never in edit mode, never on the border/shape settings card. *@
@if (!CanEdit && !BorderOnly)
{
    <WallDimControl />
}

@* Mode-specific contextual controls — kept BELOW the viewport so the image
   never shifts under the cursor when a tool's options appear or change. *@
@* What is left down here is WALL-LIFECYCLE state, not tool state: these bars appear and disappear
   with staging / manual alignment / change review, never when you switch tool, so they cannot make
   the image jump under the cursor. Everything that DID depend on the tool now lives in the
   toolbar's fixed-height row. *@
<div class="editor-bottom">
    @if (CanEdit && IsStaging && !string.IsNullOrEmpty(_autoAlignMsg))
    {
        <div class="option-bar">
            <span class="option-hint">@_autoAlignMsg</span>
        </div>
    }
    @if (CanEdit && ManualAlignment)
    {
        <div class="option-bar">
            <span class="option-hint">Drag each hold onto its new position, then <strong>Confirm hold</strong>. @_alignedHoldIds.Count/@Holds.Count confirmed.</span>
            <span class="option-hint legend-dot"><span class="legend-swatch" style="background:var(--status-review);"></span> moved vs last photo</span>
        </div>
    }
    @if (CanEdit && IsStaging && !ManualAlignment && Holds.Any(IsLiveHold))
    {
        <div class="option-bar">
            <span class="option-hint">Align the <strong>old</strong> overlay: <strong style="color:#ffd700">yellow</strong> = move, <strong style="color:#ff4d4d">red</strong> = X tilt, <strong style="color:#3ddc84">green</strong> = Y tilt, <strong style="color:#4aa8ff">blue</strong> = spin (Z), <strong style="color:#f5a623">orange</strong> = scale.</span>
        </div>
    }
    @if (CanEdit && ManualAlignment)
    {
        <div class="batch-bar">
            <button class="batch-save" @onclick="ConfirmManualAlignment">Confirm &amp; Update Wall</button>
            <button class="batch-discard" @onclick="DiscardManualAlignment">Discard</button>
        </div>
    }
    else if (CanEdit && (_pendingChanges > 0 || _alignmentChangedIds.Count > 0))
    {
        <div class="batch-bar">
            <button class="batch-save" @onclick="SaveChanges">
                @if (_pendingChanges > 0)
                {
                    @($"Save Changes ({_pendingChanges})")
                }
                else
                {
                    @("Save Alignment")
                }
            </button>
            <button class="batch-discard" @onclick="DiscardChanges">Discard</button>
        </div>
    }
</div>
</div>
</div>

@code {

    // ================= Unified toolbar =================
    // The spec describes the controls; the rows below are the SAME markup the fifteen .option-bar
    // blocks used to be, moved verbatim into fragments that still live in this component. That is
    // what makes the extraction possible at all: a row reads this component's own fields
    // (_selectedHoldId, _paintColor, _addCategory, _pendingChanges …), so it must stay a member
    // here. The toolbar owns the TOOL — which one is picked and what that excludes — and nothing
    // else. Two earlier attempts copied the rows into the toolbar instead and had to rebuild the
    // state machine around them; that copy is what drifted.

    /// <summary>
    /// Where the toolbar sits. Resolved from the member's own cookie preference in
    /// <see cref="OnInitializedAsync"/> — deliberately NOT a parameter: every host would otherwise
    /// have to thread the same value through, and each of them would be one more place to forget it.
    /// </summary>
    private ToolbarPlacement placement = ToolbarPlacement.TopBar;

    /// <summary>
    /// The picked tool, owned by <see cref="UnifiedToolbar"/>. This component READS it (to decide
    /// what a tap on the photo means) and writes it only through <see cref="SetMode"/>, which is the
    /// same object the toolbar writes — there is no second copy.
    /// </summary>
    private readonly HoldTouchupSurface tools = new();

    private ToolbarSpec? toolbarSpec;

    // Built once: every gate is a live Func, so a cached spec still reflects the current state and a
    // drag does not re-allocate thirty records per frame.
    private ToolbarSpec Toolbar => toolbarSpec ??= BuildToolbarSpec();

    private ToolbarSpec BuildToolbarSpec() => new()
    {
        Status = StatusRow,
        IdleRow = RowIdle,
        Groups =
        [
            new ToolbarGroup
            {
                Id = "view",
                Items =
                [
                    new ToolbarItem
                    {
                        Id = "show-names", Kind = ToolbarItemKind.Toggle, Label = "Show hold names",
                        ShortcutKey = "L", Icon = IconName, IsOn = () => _showNames,
                        OnInvoke = EventCallback.Factory.Create(this, () => _showNames = !_showNames),
                    },
                    new ToolbarItem
                    {
                        Id = "show-incomplete", Kind = ToolbarItemKind.Toggle, Label = "Highlight incomplete holds",
                        Icon = IconIncomplete, Visible = () => CanEdit, IsOn = () => _showIncomplete,
                        OnInvoke = EventCallback.Factory.Create(this, CycleIncompleteCriteria),
                    },
                    new ToolbarItem
                    {
                        Id = "show-border", Kind = ToolbarItemKind.Toggle, Label = "Show wall border",
                        ShortcutKey = "O", Icon = IconEye, Visible = () => BorderToggleAvailable,
                        IsOn = () => _showBorder,
                        OnInvoke = EventCallback.Factory.Create(this, () => _showBorder = !_showBorder),
                    },
                    new ToolbarItem
                    {
                        Id = "show-changes", Kind = ToolbarItemKind.Toggle, Label = "Highlight holds marked changed",
                        Icon = IconChanges, Visible = () => CanEdit && (ManualAlignment || ChangeReview),
                        IsOn = () => _showChanges, Badge = () => ChangedBadge,
                        OnInvoke = EventCallback.Factory.Create(this, () => _showChanges = !_showChanges),
                    },
                    new ToolbarItem
                    {
                        Id = "usage", Kind = ToolbarItemKind.Toggle, Label = "Show which holds a boulder uses",
                        ShortcutKey = "U", Icon = IconUsage, Visible = () => OnRequestHoldUsage != null,
                        IsOn = () => _showUsage, Row = RowUsage,
                        OnInvoke = EventCallback.Factory.Create(this, ToggleUsageMode),
                    },
                ],
            },
            new ToolbarGroup
            {
                Id = "holds",
                Items =
                [
                    new ToolbarItem { Id = "add", Kind = ToolbarItemKind.Tool, Tool = HoldTouchupTool.Add, Label = "Add hold", ShortcutKey = "A", Icon = IconAdd, Visible = () => HoldToolsAvailable, Row = RowAdd },
                    new ToolbarItem { Id = "move", Kind = ToolbarItemKind.Tool, Tool = HoldTouchupTool.Move, Label = "Select / Move", ShortcutKey = "M", Icon = IconMove, Visible = () => HoldToolsAvailable, Row = RowMove },
                    new ToolbarItem { Id = "shape", Kind = ToolbarItemKind.Tool, Tool = HoldTouchupTool.Shape, Label = "Edit hold shape", ShortcutKey = "S", Icon = IconShape, Visible = () => HoldToolsAvailable, Row = RowShape },
                    new ToolbarItem { Id = "paint", Kind = ToolbarItemKind.Tool, Tool = HoldTouchupTool.Paint, Label = "Paint colour", ShortcutKey = "P", Icon = IconPaint, Visible = () => HoldToolsAvailable, Row = RowPaint, ActiveStyle = () => $"background: {GetCssColor(_paintColor)};" },
                    new ToolbarItem { Id = "pipette", Kind = ToolbarItemKind.Tool, Tool = HoldTouchupTool.Pipette, Label = "Pipette — copy properties between holds", ShortcutKey = "E", Icon = IconPipette, Visible = () => HoldToolsAvailable, Row = RowPipette },
                    new ToolbarItem { Id = "name", Kind = ToolbarItemKind.Tool, Tool = HoldTouchupTool.Name, Label = "Name hold", ShortcutKey = "N", Icon = IconName, Visible = () => HoldToolsAvailable, Row = RowName },
                    new ToolbarItem { Id = "delete", Kind = ToolbarItemKind.Tool, Tool = HoldTouchupTool.Delete, Label = "Delete hold", ShortcutKey = "D", Icon = IconDelete, Visible = () => HoldToolsAvailable, Danger = true, Row = RowDelete },
                    new ToolbarItem { Id = "shape-tilt", Kind = ToolbarItemKind.Tool, Tool = HoldTouchupTool.ShapeTilt, Label = "Tilt hold shape", ShortcutKey = "T", Icon = IconTilt, Visible = () => HoldToolsAvailable, Row = RowShapeTilt },
                ],
            },
            new ToolbarGroup
            {
                Id = "wall",
                Items =
                [
                    new ToolbarItem { Id = "border", Kind = ToolbarItemKind.Tool, Tool = HoldTouchupTool.Border, Label = "Edit wall border", ShortcutKey = "B", Icon = IconBorder, Visible = () => BorderToolAvailable, Row = RowBorder },
                ],
            },
            new ToolbarGroup
            {
                Id = "lifecycle",
                Items =
                [
                    new ToolbarItem { Id = "merge", Kind = ToolbarItemKind.Tool, Tool = HoldTouchupTool.Merge, Label = "Merge a new hold into the matching old one", ShortcutKey = "G", Icon = IconMerge, Visible = () => HoldToolsAvailable && IsStaging && !ManualAlignment, Row = RowMerge },
                    new ToolbarItem { Id = "make-actual", Kind = ToolbarItemKind.Tool, Tool = HoldTouchupTool.MakeActual, Label = "Make a virtual hold actual", ShortcutKey = "K", Icon = IconMakeActual, Visible = () => HoldToolsAvailable && !IsStaging, Row = RowMakeActual },
                    new ToolbarItem { Id = "join-virtual", Kind = ToolbarItemKind.Tool, Tool = HoldTouchupTool.JoinVirtual, Label = "Join duplicate virtual holds", ShortcutKey = "J", Icon = IconJoinVirtual, Visible = () => HoldToolsAvailable && !IsStaging, Row = RowJoinVirtual },
                    new ToolbarItem { Id = "mark-unchanged", Kind = ToolbarItemKind.Tool, Tool = HoldTouchupTool.MarkUnchanged, Label = "Mark a hold unchanged", ShortcutKey = "C", Icon = IconMarkUnchanged, Visible = () => HoldToolsAvailable, Row = RowMarkUnchanged },
                    new ToolbarItem { Id = "mark-changed", Kind = ToolbarItemKind.Tool, Tool = HoldTouchupTool.MarkChanged, Label = "Mark a hold changed", ShortcutKey = "X", Icon = IconMarkChanged, Visible = () => HoldToolsAvailable && !IsStaging, Row = RowMarkChanged },
                ],
            },
            new ToolbarGroup
            {
                Id = "commands",
                Items =
                [
                    new ToolbarItem
                    {
                        Id = "redetect", Kind = ToolbarItemKind.Command, Label = "Re-detect holds on this panel",
                        ShortcutKey = "R", Icon = IconRedetect,
                        Visible = () => HoldToolsAvailable && OnRedetectRequested.HasDelegate,
                        Enabled = () => !_isDetecting,
                        OnInvoke = EventCallback.Factory.Create(this, OnRedetect),
                    },
                    new ToolbarItem
                    {
                        Id = "auto-align", Kind = ToolbarItemKind.Command, Label = "Auto-align the overlay holds to the new photo",
                        Icon = IconAutoAlign, Visible = () => HoldToolsAvailable && IsStaging,
                        Enabled = () => !_autoAligning,
                        OnInvoke = EventCallback.Factory.Create(this, OnAutoAlignClick),
                    },
                    new ToolbarItem
                    {
                        Id = "link-panels", Kind = ToolbarItemKind.Command, Label = "Link the same hold across panels",
                        Icon = IconLinkPanels,
                        Visible = () => HoldToolsAvailable && HasMultiplePanels && OnLinkPanels.HasDelegate,
                        OnInvoke = EventCallback.Factory.Create(this, () => OnLinkPanels.InvokeAsync()),
                    },
                    // Bulk verdicts. They existed only inside the manual-alignment option bar, so they
                    // were reachable only once a hold was selected; as commands they are always at hand.
                    new ToolbarItem
                    {
                        Id = "mark-all-changed", Kind = ToolbarItemKind.Command, Label = "Wall completely reset — mark every hold changed",
                        Icon = IconAllChanged, Danger = true, Visible = () => CanEdit && ManualAlignment,
                        OnInvoke = EventCallback.Factory.Create(this, MarkAllChanged),
                    },
                    new ToolbarItem
                    {
                        Id = "mark-all-unchanged", Kind = ToolbarItemKind.Command, Label = "Mark every hold unchanged",
                        Icon = IconAllUnchanged, Visible = () => CanEdit && ManualAlignment,
                        OnInvoke = EventCallback.Factory.Create(this, MarkAllUnchanged),
                    },
                ],
            },
        ],
    };

    // The border pair used to be copy-pasted: once in the CanEdit branch and once again in a
    // BorderOnly branch below it. One item with the union of both gates replaces both copies.
    private bool HoldToolsAvailable => CanEdit && !BorderOnly;

    private bool BorderToolAvailable => CanEditShape && (BorderOnly || CanEdit);

    private bool BorderToggleAvailable => (CanEdit && !BorderOnly) || (BorderOnly && CanEditShape);

    private string? ChangedBadge
    {
        get
        {
            var count = ManualAlignment ? ChangedCount : ReviewChangedCount;
            return count > 0 ? count.ToString(System.Globalization.CultureInfo.InvariantCulture) : null;
        }
    }

    /// <summary>The toolbar picked a tool; drop the previous tool's working state. See <see cref="SetMode"/>.</summary>
    private void OnToolPicked(HoldTouchupTool tool) => ClearToolState(tool);

    private RenderFragment StatusRow => @<text>
        <span class="hold-count">@Holds.Count(h => h.Category == HoldCategory.Hand)H / @Holds.Count(h => h.Category == HoldCategory.Foot)F</span>
        @if (CanEdit && IncompleteCount > 0)
        {
            <span class="hold-count" title="@IncompleteHint">@IncompleteCount ?</span>
        }
    </text>;

    private RenderFragment RowIdle => @<div class="option-bar">
        @if (CanEdit && ChangeReview && !ManualAlignment)
        {
            @ChangeReviewHint
        }
        else
        {
            <span class="option-hint">Pick a tool to edit the wall — or tap a hold to see its name.</span>
        }
    </div>;

    @* Was a banner in .editor-bottom, i.e. permanently below the image, even though the controls it
       describes (Mark changed / Mark unchanged) now live on the toolbar. It follows them into their
       rows and into the idle row, and the image gets its strip of the card back. *@
    private RenderFragment ChangeReviewHint => @<text>
        <span class="option-hint"><strong>Tap a hold</strong> to mark it changed or unchanged — moving holds alone won't flag boulders. A nearer-centre panel's verdict carries to its overlap twins.</span>
        <span class="option-hint legend-dot"><span class="legend-swatch" style="background:var(--status-review);"></span> needs review</span>
    </text>;

    private RenderFragment RowUsage => @<div class="option-bar">
        @if (_holdUsage == null)
        {
            <span class="option-hint">Loading hold usage…</span>
        }
        else if (_usageHoldId is { } pickedId)
        {
            var picked = Holds.FirstOrDefault(h => h.Id == pickedId);
            var refs = UsageFor(pickedId);
            @if (refs.Count == 0)
            {
                <span class="option-hint"><strong>@(picked?.Name ?? "This hold")</strong> is not used by any boulder — safe to change or remove.</span>
            }
            else
            {
                <span class="option-hint"><strong>@(picked?.Name ?? "This hold")</strong> is used by @refs.Count boulder@(refs.Count == 1 ? "" : "s"):</span>
                <div class="usage-list">
                    @foreach (var r in refs)
                    {
                        <a class="usage-chip" href="/walls/@WallId/boulders/@r.BoulderId">
                            <span class="usage-dot @UsageDotClass(r.Type)"></span>
                            @r.Name
                            @if (!string.IsNullOrEmpty(r.Grade)) { <span class="usage-grade">@r.Grade</span> }
                            @if (r.IsDraft) { <span class="usage-flag">draft</span> }
                            @if (r.IsHistoric) { <span class="usage-flag">historic</span> }
                        </a>
                    }
                </div>
            }
        }
        else
        {
            <span class="option-hint">
                Tap a hold to see which boulders use it.
                <strong>@(Holds.Count - UnusedHoldCount)</strong> of @Holds.Count holds in use,
                <strong>@UnusedHoldCount</strong> free.
            </span>
        }
    </div>;

    private RenderFragment RowAdd => @<div class="option-bar">
        <div class="option-group"><label>Type:</label>
            <button class="opt-btn @(_addCategory == HoldCategory.Hand ? "active" : "")" @onclick="() => _addCategory = HoldCategory.Hand">Hand</button>
            <button class="opt-btn foot @(_addCategory == HoldCategory.Foot ? "active" : "")" @onclick="() => _addCategory = HoldCategory.Foot">Foot</button>
        </div>
        <div class="option-group"><label>Material:</label>
            <select class="color-select" value="@_addMaterial" @onchange="OnAddMaterialChange">
                @foreach (var m in _materials) { <option value="@m">@MaterialLabel(m)</option> }
            </select>
        </div>
        <div class="option-group"><label>Color:</label>
            <select class="color-select" value="@_addColor" @onchange="OnAddColorChange">
                <option value="none">No color</option>
                @foreach (var c in HoldPalette.ColorsFor(_addMaterial)) { <option value="@c.Key">@c.DisplayName</option> }
            </select>
            <span class="color-dot" style="background: @GetCssColor(_addColor == "none" ? null : _addColor);"></span>
        </div>
        <div class="option-group"><label class="cb-label"><input type="checkbox" @bind="_addOnKickboard" /> Kickboard</label></div>
    </div>;

    private RenderFragment RowPaint => @<div class="option-bar">
        <div class="option-group swatches"><label>Paint:</label>
            @for (var i = 0; i < HoldPalette.All.Count; i++)
            {
                var c = HoldPalette.All[i];
                @* Only the first nine are reachable by digit; the rest stay mouse-only. *@
                var swatchKey = i < 9 ? $" ({i + 1})" : string.Empty;
                <button class="color-swatch @(_paintColor == c.Key ? "active" : "")" style="background: @c.Hex;" @onclick="() => _paintColor = c.Key" title="@(c.DisplayName + swatchKey)"></button>
            }
        </div>
    </div>;

    @* Pipette: the contextual row IS the feature. Each property is an independent tick; the first tap
       fills the buffer with exactly the ticked ones and every tap after that stamps them onto the hold
       it lands on. An unticked property is never written — that is what HoldEdit's Keep exists for. *@
    private RenderFragment RowPipette => @<div class="option-bar">
        <div class="option-group"><label>Copy:</label>
            @foreach (var (property, label) in StampProperties)
            {
                <button class="opt-btn @(tools.IsStampProperty(property) ? "active" : "")"
                        title="@StampTitle(property)"
                        @onclick="() => tools.ToggleStampProperty(property)">@label</button>
            }
        </div>
        @if (tools.Stamp is { } stamp)
        {
            <span class="option-hint">
                Picked @StampSummary(stamp) — tap holds to stamp.
            </span>
            <button class="opt-btn" title="Drop the picked properties and pick from another hold."
                    @onclick="() => tools.ClearStamp()">Pick again</button>
        }
        else if (tools.StampMask == HoldStampProperty.None)
        {
            <span class="option-hint">Tick at least one property to copy.</span>
        }
        else
        {
            <span class="option-hint">Tap the hold to copy from.</span>
        }
    </div>;

    /// <summary>The picker's ticks, in the order the design names them: size · colour · material · type · sub-type · kickboard.</summary>
    private static readonly (HoldStampProperty Property, string Label)[] StampProperties =
    [
        (HoldStampProperty.Size, "Size"),
        (HoldStampProperty.Color, "Colour"),
        (HoldStampProperty.Material, "Material"),
        (HoldStampProperty.Category, "Type"),
        (HoldStampProperty.HandType, "Sub-type"),
        (HoldStampProperty.Kickboard, "Kickboard"),
    ];

    private static string StampTitle(HoldStampProperty property) => property switch
    {
        // The one rule worth spelling out on the control itself — see HoldStamp's remarks.
        HoldStampProperty.Color => "Colour. Wood and plastic have separate palettes, so stamping a colour "
            + "the target's material cannot wear brings the sampled material with it.",
        HoldStampProperty.Category => "Hand or foot.",
        HoldStampProperty.HandType => "The hand sub-type (crimp, jug, sloper …).",
        _ => property.ToString(),
    };

    private static string StampSummary(HoldStamp stamp) =>
        string.Join(", ", StampProperties.Where(p => stamp.Has(p.Property)).Select(p => p.Label.ToLowerInvariant()));

    private RenderFragment RowDelete => @<div class="option-bar">
        <span class="option-hint">Tap a hold to delete it. Nothing is written until you save.</span>
    </div>;

    private RenderFragment RowBorder => @<div class="option-bar">
        <div class="option-group"><label>Border:</label>
            @if (BorderPoints.Count == 0)
            {
                <button class="opt-btn" @onclick="InitBorder">Create</button>
            }
            else
            {
                <button class="opt-btn danger" @onclick="ClearBorder">Remove</button>
            }
        </div>
        <span class="option-hint">Drag points to define wall area.</span>
    </div>;

    private RenderFragment RowShape => @<div class="option-bar">
        <span class="option-hint">Click a hold to edit its shape. Drag the control points.</span>
        <div class="option-group"><label>Point size:</label><input type="range" min="2" max="20" value="@((int)(_shapePointRadius * 10))" @oninput="OnShapePointSizeChange" /></div>
        @{
            var shapeHold = Holds.FirstOrDefault(h => h.Id == _shapeEditHoldId);
            var shapePointCount = shapeHold?.ShapePoints?.Count ?? 0;
        }
        @if (shapeHold != null && shapePointCount >= 3)
        {
            <div class="option-group"><label>Points: @shapePointCount</label>
                <button class="opt-btn" @onclick="RemoveShapePoint" disabled="@(shapePointCount <= 3)" title="Remove a point">−</button>
                <button class="opt-btn" @onclick="AddShapePoint" title="Add a point on the longest edge">+</button>
            </div>
        }
    </div>;

    private RenderFragment RowName => @<div class="option-bar">
        <span class="option-hint">Click a hold to name it.</span>
        @if (_namingHoldId.HasValue)
        {
            <div class="option-group">
                <input type="text" class="name-input" @bind="_nameInput" @bind:event="oninput" placeholder="Hold name..." maxlength="64" />
                <button class="opt-btn active" @onclick="ApplyName">OK</button>
                <button class="opt-btn" @onclick="() => _namingHoldId = null">Cancel</button>
            </div>
        }
    </div>;

    private RenderFragment RowMove => @<div class="option-bar">
        @{
            var sel = _selectedHoldId is { } selId ? Holds.FirstOrDefault(h => h.Id == selId) : null;
        }
        @if (sel == null)
        {
            <span class="option-hint">Tap a hold to select it, then drag to move it.</span>
        }
        else
        {
            <div class="option-group"><label>Type:</label>
                <button class="opt-btn @(sel.Category == HoldCategory.Hand ? "active" : "")" @onclick="() => SetSelectedCategory(HoldCategory.Hand)">Hand</button>
                <button class="opt-btn foot @(sel.Category == HoldCategory.Foot ? "active" : "")" @onclick="() => SetSelectedCategory(HoldCategory.Foot)">Foot</button>
            </div>
            <div class="option-group"><label class="cb-label"><input type="checkbox" checked="@sel.IsOnKickboard" @onchange="() => ToggleKickboard(sel)" /> KB</label></div>
            @if (sel.Category == HoldCategory.Hand)
            {
                <div class="option-group"><label>Sub-type:</label>
                    <select class="color-select" value="@(sel.HandType?.ToString() ?? "none")" @onchange="e => OnSelectedHandTypeChange(sel, e)">
                        <option value="none">—</option>
                        @foreach (var t in _handTypes) { <option value="@t">@t</option> }
                    </select>
                </div>
            }
            <div class="option-group"><label>Material:</label>
                <select class="color-select" value="@(sel.Material?.ToString() ?? "none")" @onchange="e => OnSelectedMaterialChange(sel, e)">
                    <option value="none">—</option>
                    @foreach (var m in _materials) { <option value="@m">@MaterialLabel(m)</option> }
                </select>
            </div>
            <div class="option-group"><label>Color:</label>
                <select class="color-select" value="@(sel.Color ?? "none")" @onchange="OnSelectedColorChange">
                    <option value="none">No color</option>
                    @foreach (var c in HoldPalette.ColorsFor(sel.Material)) { <option value="@c.Key">@c.DisplayName</option> }
                </select>
                <span class="color-dot" style="background: @GetCssColor(sel.Color);"></span>
            </div>
            <div class="option-group"><label>Size:</label><input type="range" min="3" max="40" value="@((int)(_selectedRadius * 1000))" @oninput="OnRadiusChange" /></div>
            <button class="opt-btn danger" @onclick="DeleteSelected">Del</button>
            @if (ManualAlignment)
            {
                <label class="cb-label" title="Leave checked if this physical hold did not change. Uncheck if it moved/changed so boulders using it get flagged for review.">
                    <input type="checkbox" checked="@(!_changedHoldIds.Contains(sel.Id))" @onchange="() => ToggleHoldChanged(sel.Id)" /> Hold did not change
                </label>
                <button class="opt-btn active" @onclick="() => ConfirmHoldAligned(sel.Id)">@(_alignedHoldIds.Contains(sel.Id) ? "Confirmed ✓" : "Confirm hold")</button>
            }
            else if (ChangeReview)
            {
                @if (_pendingChanges > 0)
                {
                    <span class="option-hint">Save changes first to mark this hold changed / unchanged.</span>
                }
                else if (sel.NeedsReview)
                {
                    <button class="opt-btn active" title="This hold is flagged as changed — click to mark it unchanged and pull its boulders back out of review."
                            @onclick="() => MarkSelectedUnchanged(sel.Id)">Changed ✓ — mark unchanged</button>
                }
                else
                {
                    <button class="opt-btn" title="Flag this hold as changed so boulders using it are flagged for review."
                            @onclick="() => MarkSelectedModified(sel.Id)">Mark changed</button>
                }
            }
            else if (!IsStaging)
            {
                @* Moving or resizing no longer implies the physical hold changed, so this is the
                   only thing that says so — and it has to be reachable in the same breath as the
                   drag that prompted it. It drafts the verdict and the save applies it, which is
                   what lets it stay on screen while edits are pending; the old immediate-call
                   version disappeared the instant you touched the hold. *@
                <button class="opt-btn @(_markChangedHoldIds.Contains(sel.Id) ? "active" : "")"
                        title="@(_markChangedHoldIds.Contains(sel.Id)
                            ? "This hold will be marked as physically changed when you save. Click to take it back."
                            : "Say the PHYSICAL hold was swapped, turned or re-set. Boulders using it are flagged for review on save. Moving or resizing alone does not do this.")"
                        @onclick="() => ToggleMarkChanged(sel.Id)">
                    @(_markChangedHoldIds.Contains(sel.Id) ? "Changed on save ✓" : sel.NeedsReview ? "Changed ✓" : "Mark as changed")
                </button>
            }
        }
    </div>;

    private RenderFragment RowShapeTilt => @<div class="option-bar">
        <span class="option-hint">Click a hold to select, then drag the violet handle to tilt its polygon outline in X/Y.</span>
        @if (_shapeTiltHoldId.HasValue)
        {
            <button class="opt-btn" @onclick="ResetShapeTilt">Reset shape</button>
        }
    </div>;

    private RenderFragment RowMerge => @<div class="option-bar">
        @if (_pendingMerge.HasValue)
        {
            var staged = Holds.FirstOrDefault(h => h.Id == _pendingMerge.Value.stagedId);
            var live = Holds.FirstOrDefault(h => h.Id == _pendingMerge.Value.liveId);
            <span class="option-hint">Merge new <strong>@(staged?.Name ?? "hold")</strong> into old <strong>@(live?.Name ?? "hold")</strong>? Boulders using the old hold will be flagged for review.</span>
            <button class="opt-btn active" @onclick="ConfirmMerge">Confirm merge</button>
            <button class="opt-btn" @onclick="CancelMerge">Cancel</button>
        }
        else if (_mergeFirstPickId.HasValue)
        {
            <span class="option-hint">Now click the matching hold of the other generation.</span>
            <button class="opt-btn" @onclick="CancelMerge">Cancel</button>
        }
        else
        {
            <span class="option-hint">Click a hold. If a hold of the other generation lies underneath, merge will be offered immediately; otherwise click a second hold to pair them.</span>
        }
    </div>;

    private RenderFragment RowMakeActual => @<div class="option-bar">
        @if (_makeActualVirtualId is { } virtualId)
        {
            var virtualHold = Holds.FirstOrDefault(h => h.Id == virtualId);
            @if (_makeActualTargetId is { } targetId)
            {
                var target = Holds.FirstOrDefault(h => h.Id == targetId);
                <span class="option-hint">Merge virtual <strong>@(virtualHold?.Name ?? "hold")</strong> into detected <strong>@(target?.Name ?? "hold")</strong>? Boulders using it will be flagged for review.</span>
                <button class="opt-btn active" @onclick="ConfirmMakeActualMerge">Confirm merge</button>
                <button class="opt-btn" @onclick="CancelMakeActual">Cancel</button>
            }
            else
            {
                <span class="option-hint">Virtual <strong>@(virtualHold?.Name ?? "hold")</strong> selected. Tap a detected hold to merge into it, or make it actual where it is.</span>
                <button class="opt-btn active" @onclick="MakeActualAsIs">Make actual as-is</button>
                <button class="opt-btn" @onclick="CancelMakeActual">Cancel</button>
            }
        }
        else
        {
            <span class="option-hint">Tap a <strong style="color:#c86dff">virtual</strong> (dotted) hold to make it actual.</span>
        }
    </div>;

    private RenderFragment RowJoinVirtual => @<div class="option-bar">
        @if (_joinSurvivorId is { } keepId)
        {
            var keep = Holds.FirstOrDefault(h => h.Id == keepId);
            @if (_joinDuplicateId is { } dropId)
            {
                var drop = Holds.FirstOrDefault(h => h.Id == dropId);
                <span class="option-hint">
                    Keep <strong style="color:#33dd66">@(keep?.Name ?? "hold")</strong> and absorb
                    <strong style="color:#ff5566">@(drop?.Name ?? "hold")</strong> into it? Boulders on the absorbed
                    hold move over; nothing is flagged historic.
                </span>
                <button class="opt-btn active" @onclick="ConfirmJoinVirtual">Confirm join</button>
                <button class="opt-btn" @onclick="CancelJoinVirtual">Cancel</button>
            }
            else
            {
                <span class="option-hint">
                    Keeping <strong style="color:#33dd66">@(keep?.Name ?? "hold")</strong>. Tap the duplicate
                    <strong style="color:#c86dff">virtual</strong> hold to absorb into it.
                </span>
                <button class="opt-btn" @onclick="CancelJoinVirtual">Cancel</button>
            }
        }
        else
        {
            <span class="option-hint">Tap the <strong style="color:#c86dff">virtual</strong> hold to KEEP, then the duplicate virtual hold to absorb.</span>
        }
    </div>;

    private RenderFragment RowMarkUnchanged => @<div class="option-bar">
        @if (_markUnchangedHoldId is { } uid)
        {
            var uh = Holds.FirstOrDefault(h => h.Id == uid);
            var hasBaseline = _manualBaseline.ContainsKey(uid);
            <span class="option-hint"><strong>@(uh?.Name ?? "This hold")</strong> — mark as physically unchanged.</span>
            @if (ManualAlignment && hasBaseline)
            {
                <button class="opt-btn active"
                        title="Snap this staged hold back to its previous-generation position and clear its changed flag, so confirming won't flag its boulders."
                        @onclick="() => ResetHoldToUnchanged(uid)">Reset — didn't move</button>
            }
            <button class="opt-btn"
                    title="Pull boulders that went historic in a past update back out of historic state, when all their holds still exist."
                    @onclick="() => RestoreUnchangedBoulders(uid)">Restore its boulders</button>
            <button class="opt-btn" @onclick="() => _markUnchangedHoldId = null">Done</button>
        }
        else
        {
            <span class="option-hint">Tap a hold that didn't physically change. You can reset a falsely-moved staged hold and pull its boulders back out of historic state.</span>
            @if (ChangeReview && !ManualAlignment)
            {
                <span class="option-hint legend-dot"><span class="legend-swatch" style="background:var(--status-review);"></span> needs review</span>
            }
        }
    </div>;

    private RenderFragment RowMarkChanged => @<div class="option-bar">
        @if (_markChangedHoldId is { } cid)
        {
            var ch = Holds.FirstOrDefault(h => h.Id == cid);
            <span class="option-hint"><strong>@(ch?.Name ?? "This hold")</strong> &mdash; mark as physically changed.</span>
            @if (_pendingChanges > 0)
            {
                <span class="option-hint">Save your pending edits first.</span>
            }
            else
            {
                <button class="opt-btn active"
                        title="Flag this hold as changed, so every boulder still using it is flagged for review."
                        @onclick="() => ConfirmMarkChanged(cid)">@(ch?.NeedsReview == true ? "Flag again" : "Mark changed")</button>
            }
            <button class="opt-btn" @onclick="() => _markChangedHoldId = null">Done</button>
        }
        else
        {
            <span class="option-hint">Tap a hold that was physically swapped, turned or re-set. Confirming flags it and every boulder using it for review. A nearer-centre panel's verdict carries to its overlap twins.</span>
            @if (ChangeReview && !ManualAlignment)
            {
                <span class="option-hint legend-dot"><span class="legend-swatch" style="background:var(--status-review);"></span> needs review</span>
            }
        }
    </div>;

    // ---- Icons -------------------------------------------------------------------------------

    private RenderFragment IconName => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M4 7V4h16v3M9 20h6M12 4v16" /></svg>;

