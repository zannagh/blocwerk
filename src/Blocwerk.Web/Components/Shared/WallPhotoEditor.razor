@inject IJSRuntime JS
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing

@* Warn before navigating away with unsaved manual-alignment drag work: all of it lives in
   client state until "Confirm & Update Wall", so an internal nav or a full page leave would
   silently discard it. *@
<NavigationLock ConfirmExternalNavigation="_hasPendingAlignmentWork" OnBeforeInternalNavigation="OnBeforeNavigateAway" />

<div class="editor-toolbar @(BottomToolbar ? "docked-bottom" : string.Empty)">
    <div class="toolbar-left">
        <span class="hold-count">@Holds.Count(h => h.Category == HoldCategory.Hand)H / @Holds.Count(h => h.Category == HoldCategory.Foot)F</span>
    </div>
    <div class="toolbar-right">
        <button class="tool-btn @(_showNames ? "active" : "")" @onclick="() => _showNames = !_showNames"
                title="@(_showNames ? "Hide hold names" : "Show hold names")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20" opacity="@(_showNames ? "1" : "0.5")">
                <path d="M4 7V4h16v3M9 20h6M12 4v16" />
            </svg>
        </button>
        <span class="toolbar-sep"></span>
        @if (OnRequestHoldUsage != null)
        {
            <button class="tool-btn @A(EditMode.Usage)" @onclick="ToggleUsageMode"
                    title="Show which holds are used by a boulder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <circle cx="11" cy="11" r="7" /><line x1="16.5" y1="16.5" x2="21" y2="21" />
                    <path d="M8 11h6M11 8v6" />
                </svg>
            </button>
            @if (CanEdit)
            {
                <span class="toolbar-sep"></span>
            }
        }
        @if (CanEdit)
        {
            <button class="tool-btn @A(EditMode.Add)" @onclick="() => SetMode(EditMode.Add)" title="Add hold">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" />
                </svg>
            </button>
            <button class="tool-btn @A(EditMode.Move)" @onclick="() => SetMode(EditMode.Move)" title="Select / Move">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <path d="M5 9l-3 3 3 3M9 5l3-3 3 3M15 19l-3 3-3-3M19 9l3 3-3 3M2 12h20M12 2v20" />
                </svg>
            </button>
            <button class="tool-btn @A(EditMode.Shape)" @onclick="() => SetMode(EditMode.Shape)" title="Edit hold shape">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5" />
                    <circle cx="12" cy="2" r="1.5" fill="currentColor" /><circle cx="22" cy="8.5" r="1.5" fill="currentColor" />
                </svg>
            </button>
            <button class="tool-btn @A(EditMode.Paint)" @onclick="() => SetMode(EditMode.Paint)" title="Paint color"
                    style="@(_mode == EditMode.Paint ? $"background: {GetCssColor(_paintColor)};" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <path d="M19 3H5a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z" />
                    <path d="M12 11v6a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2v-1" />
                </svg>
            </button>
            <button class="tool-btn @A(EditMode.Name)" @onclick="() => SetMode(EditMode.Name)" title="Name hold">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <path d="M4 7V4h16v3M9 20h6M12 4v16" />
                </svg>
            </button>
            <button class="tool-btn @(_mode == EditMode.Delete ? "active danger" : "")" @onclick="() => SetMode(EditMode.Delete)" title="Delete hold">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                </svg>
            </button>
            <span class="toolbar-sep"></span>
            @if (CanEditShape)
            {
                <button class="tool-btn @A(EditMode.Border)" @onclick="() => SetMode(EditMode.Border)" title="Edit wall border">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                        <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2" />
                    </svg>
                </button>
            }
            <button class="tool-btn" @onclick="() => _showBorder = !_showBorder" title="@(_showBorder ? "Hide" : "Show") border &amp; segments">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="@(_showBorder ? "2" : "1")" width="20" height="20" opacity="@(_showBorder ? "1" : "0.4")">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" />
                </svg>
            </button>
            <button class="tool-btn" @onclick="OnRedetect" title="Re-detect" disabled="@_isDetecting">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <path d="M23 4v6h-6M1 20v-6h6" /><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
                </svg>
            </button>
            <button class="tool-btn @A(EditMode.ShapeTilt)" @onclick="() => SetMode(EditMode.ShapeTilt)" title="Tilt hold shape: click a hold, then drag the handle to rotate the polygon in X/Y">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <ellipse cx="12" cy="12" rx="9" ry="4" />
                    <ellipse cx="12" cy="12" rx="4" ry="9" />
                </svg>
            </button>
            @if (IsStaging)
            {
                <span class="toolbar-sep"></span>
                <button class="tool-btn" @onclick="OnAutoAlignClick" disabled="@_autoAligning"
                        title="Auto-align the overlay holds to the new photo, then fine-tune">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                        <path d="M3 12h4M17 12h4M12 3v4M12 17v4" /><circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            }
            @if (IsStaging && !ManualAlignment)
            {
                <span class="toolbar-sep"></span>
                <button class="tool-btn @A(EditMode.Merge)" @onclick="() => SetMode(EditMode.Merge)" title="Merge: click a new hold then the matching old hold">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                        <circle cx="7" cy="12" r="4" /><circle cx="17" cy="12" r="4" /><line x1="11" y1="12" x2="13" y2="12" />
                    </svg>
                </button>
            }
            @if (!IsStaging)
            {
                <span class="toolbar-sep"></span>
                <button class="tool-btn @A(EditMode.MakeActual)" @onclick="() => SetMode(EditMode.MakeActual)"
                        title="Make a virtual (placeholder) hold actual: promote it as-is or merge it into a detected hold">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                        <circle cx="12" cy="12" r="9" stroke-dasharray="2.2 1.6" /><polyline points="8.5 12 11 14.5 15.5 9.5" />
                    </svg>
                </button>
            }
            <span class="toolbar-sep"></span>
            <button class="tool-btn @A(EditMode.MarkUnchanged)" @onclick="() => SetMode(EditMode.MarkUnchanged)"
                    title="This hold didn't physically change: reset a falsely-moved staged hold, and pull its boulders back out of historic state">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><polyline points="3 3 3 8 8 8" /><polyline points="9 12 11.4 14.4 15.5 10" />
                </svg>
            </button>
        }
    </div>
</div>

@* Zoom geometry is owned by JS via the `--zoom` custom property (viewport.js); the
   markup must not emit a width or a late re-render would stomp the live transform. *@
<div class="photo-viewport@(_frame != null ? " bw-framed" : string.Empty)" @ref="_viewportRef"
     style="cursor: @CursorForMode();">
<div class="photo-editor" @ref="_containerRef">
    <img src="@EffectivePhotoUrl" alt="Wall" class="wall-photo" />
    <svg class="hold-overlay" viewBox="0 0 100 100" preserveAspectRatio="none"
         @onclick="OnSvgClick"
         @onmousedown="OnSvgMouseDown"
         @onmousemove="OnSvgMouseMove"
         @onmouseup="OnSvgMouseUp"
         @ontouchend="OnSvgMouseUp">

        @* Wall border *@
        @if (_showBorder && BorderPoints.Count >= 3)
        {
            <polygon points="@Pts(BorderPoints.Select(p => (p.Dx, p.Dy)))"
                     fill="none" stroke="#FF9800" stroke-width="0.3" stroke-dasharray="1 0.5"
                     style="pointer-events: none" />
            @if (CanEditShape && _mode == EditMode.Border)
            {
                @for (int i = 0; i < BorderPoints.Count; i++)
                {
                    var idx = i;
                    var bp = BorderPoints[idx];
                    <circle cx="@F(bp.Dx * 100)" cy="@F(bp.Dy * 100)" r="@F(1.2 * HandleScale)"
                            fill="#FF9800" stroke="white" stroke-width="@F(0.3 * HandleScale)"
                            style="cursor: grab"
                            @onmousedown="() => StartBorderDrag(idx)"
                            @onmousedown:stopPropagation="true" />
                }
            }
        }

        @* Wall segments are edited in the wall settings, so they are only drawn here as boundary
           context while actively editing — never on the everyday photo view. *@
        @if (CanEdit && _showBorder && _segmentDrafts.Count > 0)
        {
            <WallSegmentOverlay Segments="_segmentDrafts" HandleScale="HandleScale" />
        }

        @* Holds *@
        @foreach (var hold in Holds)
        {
            var isSelected = _selectedHoldId == hold.Id;
            var isShapeEditing = _mode == EditMode.Shape && _shapeEditHoldId == hold.Id;
            var isNaming = _mode == EditMode.Name && _namingHoldId == hold.Id;
            var isFoot = hold.Category == HoldCategory.Foot;
            var fillColor = GetHoldFillColor(hold, isSelected || isShapeEditing || isNaming);
            var strokeColor = (isSelected || isShapeEditing || isNaming) ? "#ffffff" : GetHoldStrokeColor(hold);
            if (ManualAlignment && !(isSelected || isShapeEditing || isNaming))
            {
                strokeColor = ManualStroke(hold);
            }
            else if (IsStaging && !(isSelected || isShapeEditing || isNaming))
            {
                strokeColor = IsStagedHold(hold) ? "#33dd66" : "#ff9933";
            }
            var isMergePick = _mode == EditMode.Merge && (
                _mergeFirstPickId == hold.Id ||
                (_pendingMerge.HasValue && (_pendingMerge.Value.stagedId == hold.Id || _pendingMerge.Value.liveId == hold.Id)));
            if (isMergePick)
            {
                strokeColor = "#ffd700";
            }
            var isMakeActualPick = _mode == EditMode.MakeActual &&
                (_makeActualVirtualId == hold.Id || _makeActualTargetId == hold.Id);
            if (isMakeActualPick)
            {
                strokeColor = "#ffd700";
            }
            var isMarkUnchangedPick = _mode == EditMode.MarkUnchanged && _markUnchangedHoldId == hold.Id;
            if (isMarkUnchangedPick)
            {
                strokeColor = "#38e1c6";
            }
            var sw = (isSelected || isShapeEditing || isNaming) ? "0.4" : (IsStaging ? "0.45" : "0.25");
            var dash = "";
            if (ManualAlignment && !(isSelected || isShapeEditing || isNaming))
            {
                dash = _alignedHoldIds.Contains(hold.Id) ? "" : "0.5 0.35";
            }
            else if (IsStaging && !(isSelected || isShapeEditing || isNaming))
            {
                dash = IsStagedHold(hold) ? "0.6 0.3" : "0.3 0.3";
            }
            if (hold.IsVirtual && !(isSelected || isShapeEditing || isNaming) && !isMakeActualPick && !isMarkUnchangedPick)
            {
                strokeColor = "#c86dff";
                dash = "0.6 0.4";
            }

            // The usage tool overrides every other styling: used holds light up, unused
            // ones recede, so "is this hold free?" is answerable at a glance.
            var usageRefs = _mode == EditMode.Usage ? UsageFor(hold.Id) : [];
            if (_mode == EditMode.Usage)
            {
                var isUsagePick = _usageHoldId == hold.Id;
                var used = usageRefs.Count > 0;
                fillColor = used ? "rgba(76,175,80,0.55)" : "rgba(120,120,120,0.15)";
                strokeColor = isUsagePick ? "#ffffff" : used ? "#4CAF50" : "rgba(255,255,255,0.35)";
                sw = isUsagePick ? "0.6" : used ? "0.4" : "0.2";
                dash = string.Empty;
            }

            var r = (isFoot ? hold.Radius * 0.7 : hold.Radius) * 100;

            @if (hold.ShapePoints is { Count: >= 3 })
            {
                <polygon points="@Pts(hold.ShapePoints.Select(sp => (hold.X + sp.Dx, hold.Y + sp.Dy)))"
                         fill="@fillColor" stroke="@strokeColor" stroke-width="@sw" stroke-dasharray="@dash"
                         style="cursor: pointer"
                         @onclick="() => OnHoldClick(hold)" @onclick:stopPropagation="true"
                         @onmousedown="() => StartDrag(hold)" @onmousedown:stopPropagation="true" />
            }
            else if (isFoot)
            {
                <rect x="@F((hold.X - r / 100.0) * 100)" y="@F((hold.Y - r / 100.0) * 100)"
                      width="@F(r * 2 / 100.0 * 100)" height="@F(r * 2 / 100.0 * 100)"
                      rx="0.3" fill="@fillColor" stroke="@strokeColor" stroke-width="@sw" stroke-dasharray="@dash"
                      style="cursor: pointer"
                      @onclick="() => OnHoldClick(hold)" @onclick:stopPropagation="true"
                      @onmousedown="() => StartDrag(hold)" @onmousedown:stopPropagation="true" />
            }
            else
            {
                <circle cx="@F(hold.X * 100)" cy="@F(hold.Y * 100)" r="@F(r)"
                        fill="@fillColor" stroke="@strokeColor" stroke-width="@sw" stroke-dasharray="@dash"
                        style="cursor: pointer"
                        @onclick="() => OnHoldClick(hold)" @onclick:stopPropagation="true"
                        @onmousedown="() => StartDrag(hold)" @onmousedown:stopPropagation="true" />
            }

            @if (_mode == EditMode.Usage && usageRefs.Count > 0)
            {
                <g pointer-events="none">
                    <circle cx="@F(hold.X * 100 + r * 0.85)" cy="@F(hold.Y * 100 - r * 0.85)" r="1.4"
                            fill="#4CAF50" stroke="white" stroke-width="0.25" />
                    <text x="@F(hold.X * 100 + r * 0.85)" y="@F(hold.Y * 100 - r * 0.85)"
                          text-anchor="middle" dominant-baseline="central"
                          font-size="1.7" font-weight="700" fill="white">@usageRefs.Count</text>
                </g>
            }

            @* Changed-holds overlay: a distinct badge ring on holds the reviewer has marked as changed
               (the same set that flags boulders for review on confirm). Geometry drift is deliberately
               NOT used — on a large wall re-shot from a slightly different spot, drift is mostly parallax
               and would flag almost everything. Layered over the manual stroke, pointer-events off, and
               only while "Show changes" is on. *@
            @if (_showChanges && (ManualAlignment ? _changedHoldIds.Contains(hold.Id) : (ChangeReview && hold.NeedsReview)))
            {
                <g pointer-events="none">
                    <circle cx="@F(hold.X * 100)" cy="@F(hold.Y * 100)" r="@F(r + 1.3)"
                            fill="none" stroke="#ff3db4" stroke-width="0.4" stroke-dasharray="0.9 0.5" opacity="0.95" />
                    <circle cx="@F(hold.X * 100 + r * 0.9)" cy="@F(hold.Y * 100 - r * 0.9)" r="1.1"
                            fill="#ff3db4" stroke="white" stroke-width="0.2" />
                </g>
            }

            @if (isShapeEditing && hold.ShapePoints is { Count: >= 3 })
            {
                @for (int i = 0; i < hold.ShapePoints.Count; i++)
                {
                    var cpIdx = i;
                    var sp = hold.ShapePoints[cpIdx];
                    <circle cx="@F((hold.X + sp.Dx) * 100)" cy="@F((hold.Y + sp.Dy) * 100)"
                            r="@F(_shapePointRadius * HandleScale)" fill="white" stroke="#e94560" stroke-width="@F(0.25 * HandleScale)"
                            style="cursor: grab"
                            @onmousedown="() => StartShapePointDrag(hold, cpIdx)" @onmousedown:stopPropagation="true" />
                }
            }

            @if (isSelected && hold.ShapePoints == null)
            {
                <circle cx="@F(hold.X * 100)" cy="@F(hold.Y * 100)" r="@F(r + 0.5)"
                        fill="none" stroke="white" stroke-width="0.15"
                        stroke-dasharray="0.5 0.3" style="pointer-events: none" />
            }

            @if (!string.IsNullOrEmpty(hold.Name) && (_showNames || _revealNameHoldId == hold.Id || isNaming))
            {
                <foreignObject x="@F((hold.X - 0.08) * 100)" y="@F((hold.Y - hold.Radius - 0.025) * 100)"
                               width="16" height="3" style="pointer-events: none; overflow: visible;">
                    <span style="font-size: 1.8px; color: white; text-shadow: 0 0 1px #000, 0 0 1px #000;
                                 font-family: sans-serif; font-weight: 600; white-space: nowrap;
                                 display: block; text-align: center;">@hold.Name</span>
                </foreignObject>
            }
        }

        @if (CanEdit && IsStaging && !ManualAlignment && Holds.Any(IsLiveHold))
        {
            var (cx, cy) = LiveCentroid();
            var arm = 0.12;
            var hxR = cx + arm;
            var hyT = cy - arm;
            <circle cx="@F(cx * 100)" cy="@F(cy * 100)" r="3.0" fill="none" stroke="#4aa8ff" stroke-width="@F(0.3 * HandleScale)" stroke-dasharray="0.8 0.4" style="pointer-events: none" opacity="0.7" />
            <line x1="@F(cx * 100)" y1="@F(cy * 100)" x2="@F(hxR * 100)" y2="@F(cy * 100)" stroke="#ff4d4d" stroke-width="@F(0.35 * HandleScale)" style="pointer-events: none" opacity="0.8" />
            <line x1="@F(cx * 100)" y1="@F(cy * 100)" x2="@F(cx * 100)" y2="@F(hyT * 100)" stroke="#3ddc84" stroke-width="@F(0.35 * HandleScale)" style="pointer-events: none" opacity="0.8" />
            <circle cx="@F(hxR * 100)" cy="@F(cy * 100)" r="@F(1.6 * HandleScale)" fill="#ff4d4d" stroke="#fff" stroke-width="@F(0.3 * HandleScale)"
                    style="cursor: ns-resize"
                    @onmousedown="(e) => StartAlignDrag(e, AlignHandle.TiltX)" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" />
            <circle cx="@F(cx * 100)" cy="@F(hyT * 100)" r="@F(1.6 * HandleScale)" fill="#3ddc84" stroke="#fff" stroke-width="@F(0.3 * HandleScale)"
                    style="cursor: ew-resize"
                    @onmousedown="(e) => StartAlignDrag(e, AlignHandle.TiltY)" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" />
            var zr = 3.0 / 100.0;
            var zhx = cx + zr * 0.7071;
            var zhy = cy - zr * 0.7071;
            <circle cx="@F(zhx * 100)" cy="@F(zhy * 100)" r="@F(1.3 * HandleScale)" fill="#4aa8ff" stroke="#fff" stroke-width="@F(0.3 * HandleScale)"
                    style="cursor: grab"
                    @onmousedown="(e) => StartAlignDrag(e, AlignHandle.RotateZ)" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" />
            var shx = cx + zr * 0.7071;
            var shy = cy + zr * 0.7071;
            var sHalf = 0.012 * HandleScale;
            <rect x="@F((shx - sHalf) * 100)" y="@F((shy - sHalf) * 100)" width="@F(2.4 * HandleScale)" height="@F(2.4 * HandleScale)"
                  fill="#f5a623" stroke="#fff" stroke-width="@F(0.3 * HandleScale)"
                  style="cursor: nwse-resize"
                  @onmousedown="(e) => StartAlignDrag(e, AlignHandle.Scale)" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" />
            <circle cx="@F(cx * 100)" cy="@F(cy * 100)" r="@F(2.2 * HandleScale)" fill="rgba(255,215,0,0.85)" stroke="#000" stroke-width="@F(0.3 * HandleScale)"
                    style="cursor: move"
                    @onmousedown="(e) => StartAlignDrag(e, AlignHandle.Translate)" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" />
        }

        @if (CanEdit && _mode == EditMode.ShapeTilt && _shapeTiltHoldId.HasValue)
        {
            var th = Holds.FirstOrDefault(h => h.Id == _shapeTiltHoldId);
            if (th != null)
            {
                var hcx = th.X + th.Radius + 0.015;
                var hcy = th.Y - th.Radius - 0.015;
                <line x1="@F(th.X * 100)" y1="@F(th.Y * 100)" x2="@F(hcx * 100)" y2="@F(hcy * 100)" stroke="#9b59ff" stroke-width="@F(0.25 * HandleScale)" stroke-dasharray="0.4 0.3" style="pointer-events: none" />
                <circle cx="@F(hcx * 100)" cy="@F(hcy * 100)" r="@F(1.4 * HandleScale)" fill="#9b59ff" stroke="#fff" stroke-width="@F(0.3 * HandleScale)"
                        style="cursor: grab" title="Drag to tilt polygon"
                        @onmousedown="(e) => StartShapeTiltDrag(e, th)" @onmousedown:stopPropagation="true" />
            }
        }
    </svg>

    @if (_isDetecting)
    {
        <div class="detecting-overlay"><span>Detecting holds...</span></div>
    }
</div>
</div>

<WallDimControl />

@* Mode-specific contextual controls — kept BELOW the viewport so the image
   never shifts under the cursor when a tool's options appear or change. *@
<div class="editor-bottom">
    @if (_mode == EditMode.Usage)
    {
        <div class="option-bar">
            @if (_holdUsage == null)
            {
                <span class="option-hint">Loading hold usage…</span>
            }
            else if (_usageHoldId is { } pickedId)
            {
                var picked = Holds.FirstOrDefault(h => h.Id == pickedId);
                var refs = UsageFor(pickedId);
                @if (refs.Count == 0)
                {
                    <span class="option-hint">
                        <strong>@(picked?.Name ?? "This hold")</strong> is not used by any boulder — safe to change or remove.
                    </span>
                }
                else
                {
                    <span class="option-hint">
                        <strong>@(picked?.Name ?? "This hold")</strong> is used by @refs.Count boulder@(refs.Count == 1 ? "" : "s"):
                    </span>
                    <div class="usage-list">
                        @foreach (var r in refs)
                        {
                            <a class="usage-chip" href="/walls/@WallId/boulders/@r.BoulderId">
                                <span class="usage-dot @UsageDotClass(r.Type)"></span>
                                @r.Name
                                @if (!string.IsNullOrEmpty(r.Grade)) { <span class="usage-grade">@r.Grade</span> }
                                @if (r.IsDraft) { <span class="usage-flag">draft</span> }
                                @if (r.IsHistoric) { <span class="usage-flag">historic</span> }
                            </a>
                        }
                    </div>
                }
            }
            else
            {
                <span class="option-hint">
                    Tap a hold to see which boulders use it.
                    <strong>@(Holds.Count - UnusedHoldCount)</strong> of @Holds.Count holds in use,
                    <strong>@UnusedHoldCount</strong> free.
                </span>
            }
        </div>
    }
    @if (CanEdit && IsStaging && !string.IsNullOrEmpty(_autoAlignMsg))
    {
        <div class="option-bar">
            <span class="option-hint">@_autoAlignMsg</span>
        </div>
    }
    @if (CanEdit && _mode == EditMode.Add)
    {
        <div class="option-bar">
            <div class="option-group"><label>Type:</label>
                <button class="opt-btn @(_addCategory == HoldCategory.Hand ? "active" : "")" @onclick="() => _addCategory = HoldCategory.Hand">Hand</button>
                <button class="opt-btn foot @(_addCategory == HoldCategory.Foot ? "active" : "")" @onclick="() => _addCategory = HoldCategory.Foot">Foot</button>
            </div>
            <div class="option-group"><label>Material:</label>
                <select class="color-select" value="@_addMaterial" @onchange="OnAddMaterialChange">
                    @foreach (var m in _materials) { <option value="@m">@MaterialLabel(m)</option> }
                </select>
            </div>
            <div class="option-group"><label>Color:</label>
                <select class="color-select" value="@_addColor" @onchange="OnAddColorChange">
                    <option value="none">No color</option>
                    @foreach (var c in HoldPalette.ColorsFor(_addMaterial)) { <option value="@c.Key">@c.DisplayName</option> }
                </select>
                <span class="color-dot" style="background: @GetCssColor(_addColor == "none" ? null : _addColor);"></span>
            </div>
            <div class="option-group"><label class="cb-label"><input type="checkbox" @bind="_addOnKickboard" /> Kickboard</label></div>
        </div>
    }
    @if (CanEdit && _mode == EditMode.Paint)
    {
        <div class="option-bar">
            <div class="option-group swatches"><label>Paint:</label>
                @foreach (var c in HoldPalette.All)
                { <button class="color-swatch @(_paintColor == c.Key ? "active" : "")" style="background: @c.Hex;" @onclick="() => _paintColor = c.Key" title="@c.DisplayName"></button> }
            </div>
        </div>
    }
    @if (CanEditShape && _mode == EditMode.Border)
    {
        <div class="option-bar">
            <div class="option-group"><label>Border:</label>
                @if (BorderPoints.Count == 0) { <button class="opt-btn" @onclick="InitBorder">Create</button> }
                else { <button class="opt-btn" @onclick="CleanArtifacts">Clean outside</button> <button class="opt-btn danger" @onclick="ClearBorder">Remove</button> }
            </div>
            <span class="option-hint">
                Drag points to define wall area.
                @if (_segmentDrafts.Count > 0)
                {
                    <text>
                        This wall has @_segmentDrafts.Count segments, so <strong>Clean outside</strong>
                        keeps every hold inside <em>any</em> segment and ignores this border.
                    </text>
                }
                else
                {
                    <text><strong>Clean outside</strong> removes holds outside this border.</text>
                }
            </span>
        </div>
    }
    @if (CanEdit && _mode == EditMode.Shape)
    {
        <div class="option-bar">
            <span class="option-hint">Click a hold to edit its shape. Drag the control points.</span>
            <div class="option-group"><label>Point size:</label><input type="range" min="2" max="20" value="@((int)(_shapePointRadius * 10))" @oninput="OnShapePointSizeChange" /></div>
            @{
                var shapeHold = Holds.FirstOrDefault(h => h.Id == _shapeEditHoldId);
                var shapePointCount = shapeHold?.ShapePoints?.Count ?? 0;
            }
            @if (shapeHold != null && shapePointCount >= 3)
            {
                <div class="option-group"><label>Points: @shapePointCount</label>
                    <button class="opt-btn" @onclick="RemoveShapePoint" disabled="@(shapePointCount <= 3)" title="Remove a point">−</button>
                    <button class="opt-btn" @onclick="AddShapePoint" title="Add a point on the longest edge">+</button>
                </div>
            }
        </div>
    }
    @if (CanEdit && _mode == EditMode.Name)
    {
        <div class="option-bar">
            <span class="option-hint">Click a hold to name it.</span>
            @if (_namingHoldId.HasValue)
            {
                <div class="option-group">
                    <input type="text" class="name-input" @bind="_nameInput" @bind:event="oninput" placeholder="Hold name..." maxlength="64" />
                    <button class="opt-btn active" @onclick="ApplyName">OK</button>
                    <button class="opt-btn" @onclick="() => _namingHoldId = null">Cancel</button>
                </div>
            }
        </div>
    }
    @if (CanEdit && _mode == EditMode.Move && _selectedHoldId.HasValue)
    {
        var sel = Holds.FirstOrDefault(h => h.Id == _selectedHoldId);
        if (sel != null)
        {
            <div class="option-bar">
                <div class="option-group"><label>Type:</label>
                    <button class="opt-btn @(sel.Category == HoldCategory.Hand ? "active" : "")" @onclick="() => SetSelectedCategory(HoldCategory.Hand)">Hand</button>
                    <button class="opt-btn foot @(sel.Category == HoldCategory.Foot ? "active" : "")" @onclick="() => SetSelectedCategory(HoldCategory.Foot)">Foot</button>
                </div>
                <div class="option-group"><label class="cb-label"><input type="checkbox" checked="@sel.IsOnKickboard" @onchange="() => ToggleKickboard(sel)" /> KB</label></div>
                @if (sel.Category == HoldCategory.Hand)
                {
                    <div class="option-group"><label>Sub-type:</label>
                        <select class="color-select" value="@(sel.HandType?.ToString() ?? "none")" @onchange="e => OnSelectedHandTypeChange(sel, e)">
                            <option value="none">—</option>
                            @foreach (var t in _handTypes) { <option value="@t">@t</option> }
                        </select>
                    </div>
                }
                <div class="option-group"><label>Material:</label>
                    <select class="color-select" value="@(sel.Material?.ToString() ?? "none")" @onchange="e => OnSelectedMaterialChange(sel, e)">
                        <option value="none">—</option>
                        @foreach (var m in _materials) { <option value="@m">@MaterialLabel(m)</option> }
                    </select>
                </div>
                <div class="option-group"><label>Color:</label>
                    <select class="color-select" value="@(sel.Color ?? "none")" @onchange="OnSelectedColorChange">
                        <option value="none">No color</option>
                        @foreach (var c in HoldPalette.ColorsFor(sel.Material)) { <option value="@c.Key">@c.DisplayName</option> }
                    </select>
                    <span class="color-dot" style="background: @GetCssColor(sel.Color);"></span>
                </div>
                <div class="option-group"><label>Size:</label><input type="range" min="3" max="40" value="@((int)(_selectedRadius * 1000))" @oninput="OnRadiusChange" /></div>
                <button class="opt-btn danger" @onclick="DeleteSelected">Del</button>
                @if (ManualAlignment)
                {
                    <label class="cb-label" title="Leave checked if this physical hold did not change. Uncheck if it moved/changed so boulders using it get flagged for review.">
                        <input type="checkbox" checked="@(!_changedHoldIds.Contains(sel.Id))" @onchange="() => ToggleHoldChanged(sel.Id)" /> Hold did not change
                    </label>
                    <button class="opt-btn active" @onclick="() => ConfirmHoldAligned(sel.Id)">@(_alignedHoldIds.Contains(sel.Id) ? "Confirmed ✓" : "Confirm hold")</button>
                }
                else if (ChangeReview)
                {
                    @if (_pendingChanges > 0)
                    {
                        <span class="option-hint">Save changes first to mark this hold changed / unchanged.</span>
                    }
                    else if (sel.NeedsReview)
                    {
                        <button class="opt-btn active" title="This hold is flagged as changed — click to mark it unchanged and pull its boulders back out of review."
                                @onclick="() => MarkSelectedUnchanged(sel.Id)">Changed ✓ — mark unchanged</button>
                    }
                    else
                    {
                        <button class="opt-btn" title="Flag this hold as changed so boulders using it are flagged for review."
                                @onclick="() => MarkSelectedModified(sel.Id)">Mark changed</button>
                    }
                }
                else if (!IsStaging && _pendingChanges == 0)
                {
                    <button class="opt-btn" title="Mark this hold as slightly modified; boulders using it will be flagged for review."
                            @onclick="() => MarkSelectedModified(sel.Id)">Mark modified@(sel.NeedsReview ? " ✓" : "")</button>
                }
            </div>
        }
    }
    @if (CanEdit && ManualAlignment)
    {
        <div class="option-bar">
            <span class="option-hint">Drag each hold onto its new position, then <strong>Confirm hold</strong>. @_alignedHoldIds.Count/@Holds.Count confirmed.</span>
            <div class="option-group">
                <button class="opt-btn @(_showChanges ? "active" : "")"
                        title="Highlight the holds you've marked as changed — the ones whose boulders get flagged for review on confirm."
                        @onclick="() => _showChanges = !_showChanges">Marked changed (@ChangedCount)</button>
                <span style="display:inline-flex;align-items:center;gap:0.3rem;font-size:0.8rem;opacity:0.85;">
                    <span style="width:0.7rem;height:0.7rem;border-radius:50%;background:#ff3db4;display:inline-block;"></span>
                    moved vs last photo
                </span>
            </div>
            <div class="option-group">
                <button class="opt-btn" title="Mark every hold as changed — all boulders will be flagged for review." @onclick="MarkAllChanged">Wall completely reset</button>
                <button class="opt-btn" title="Mark every hold as unchanged (default)." @onclick="MarkAllUnchanged">Mark all unchanged</button>
            </div>
        </div>
    }
    @if (CanEdit && ChangeReview && !ManualAlignment)
    {
        <div class="option-bar">
            <span class="option-hint"><strong>Tap a hold</strong> to mark it changed or unchanged — moving holds alone won't flag boulders. A nearer-centre panel's verdict carries to its overlap twins.</span>
            <div class="option-group">
                <button class="opt-btn @(_showChanges ? "active" : "")"
                        title="Highlight the holds marked as changed on this panel — their boulders are flagged for review."
                        @onclick="() => _showChanges = !_showChanges">Marked changed (@ReviewChangedCount)</button>
                <span style="display:inline-flex;align-items:center;gap:0.3rem;font-size:0.8rem;opacity:0.85;">
                    <span style="width:0.7rem;height:0.7rem;border-radius:50%;background:#ff3db4;display:inline-block;"></span>
                    needs review
                </span>
            </div>
        </div>
    }
    @if (CanEdit && IsStaging && !ManualAlignment && Holds.Any(IsLiveHold))
    {
        <div class="option-bar">
            <span class="option-hint">Align the <strong>old</strong> overlay: <strong style="color:#ffd700">yellow</strong> = move, <strong style="color:#ff4d4d">red</strong> = X tilt, <strong style="color:#3ddc84">green</strong> = Y tilt, <strong style="color:#4aa8ff">blue</strong> = spin (Z), <strong style="color:#f5a623">orange</strong> = scale.</span>
        </div>
    }
    @if (CanEdit && _mode == EditMode.ShapeTilt)
    {
        <div class="option-bar">
            <span class="option-hint">Click a hold to select, then drag the violet handle to tilt its polygon outline in X/Y.</span>
            @if (_shapeTiltHoldId.HasValue)
            {
                <button class="opt-btn" @onclick="ResetShapeTilt">Reset shape</button>
            }
        </div>
    }
    @if (CanEdit && _mode == EditMode.Merge)
    {
        <div class="option-bar">
            @if (_pendingMerge.HasValue)
            {
                var staged = Holds.FirstOrDefault(h => h.Id == _pendingMerge.Value.stagedId);
                var live = Holds.FirstOrDefault(h => h.Id == _pendingMerge.Value.liveId);
                <span class="option-hint">Merge new <strong>@(staged?.Name ?? "hold")</strong> into old <strong>@(live?.Name ?? "hold")</strong>? Boulders using the old hold will be flagged for review.</span>
                <button class="opt-btn active" @onclick="ConfirmMerge">Confirm merge</button>
                <button class="opt-btn" @onclick="CancelMerge">Cancel</button>
            }
            else if (_mergeFirstPickId.HasValue)
            {
                <span class="option-hint">Now click the matching hold of the other generation.</span>
                <button class="opt-btn" @onclick="CancelMerge">Cancel</button>
            }
            else
            {
                <span class="option-hint">Click a hold. If a hold of the other generation lies underneath, merge will be offered immediately; otherwise click a second hold to pair them.</span>
            }
        </div>
    }
    @if (CanEdit && _mode == EditMode.MakeActual)
    {
        <div class="option-bar">
            @if (_makeActualVirtualId is { } virtualId)
            {
                var virtualHold = Holds.FirstOrDefault(h => h.Id == virtualId);
                @if (_makeActualTargetId is { } targetId)
                {
                    var target = Holds.FirstOrDefault(h => h.Id == targetId);
                    <span class="option-hint">Merge virtual <strong>@(virtualHold?.Name ?? "hold")</strong> into detected <strong>@(target?.Name ?? "hold")</strong>? Boulders using it will be flagged for review.</span>
                    <button class="opt-btn active" @onclick="ConfirmMakeActualMerge">Confirm merge</button>
                    <button class="opt-btn" @onclick="CancelMakeActual">Cancel</button>
                }
                else
                {
                    <span class="option-hint">Virtual <strong>@(virtualHold?.Name ?? "hold")</strong> selected. Tap a detected hold to merge into it, or make it actual where it is.</span>
                    <button class="opt-btn active" @onclick="MakeActualAsIs">Make actual as-is</button>
                    <button class="opt-btn" @onclick="CancelMakeActual">Cancel</button>
                }
            }
            else
            {
                <span class="option-hint">Tap a <strong style="color:#c86dff">virtual</strong> (dotted) hold to make it actual.</span>
            }
        </div>
    }
    @if (CanEdit && _mode == EditMode.MarkUnchanged)
    {
        <div class="option-bar">
            @if (_markUnchangedHoldId is { } uid)
            {
                var uh = Holds.FirstOrDefault(h => h.Id == uid);
                var hasBaseline = _manualBaseline.ContainsKey(uid);
                <span class="option-hint">
                    <strong>@(uh?.Name ?? "This hold")</strong> — mark as physically unchanged.
                </span>
                @if (ManualAlignment && hasBaseline)
                {
                    <button class="opt-btn active"
                            title="Snap this staged hold back to its previous-generation position and clear its changed flag, so confirming won't flag its boulders."
                            @onclick="() => ResetHoldToUnchanged(uid)">Reset — didn't move</button>
                }
                <button class="opt-btn"
                        title="Pull boulders that went historic in a past update back out of historic state, when all their holds still exist."
                        @onclick="() => RestoreUnchangedBoulders(uid)">Restore its boulders</button>
                <button class="opt-btn" @onclick="() => _markUnchangedHoldId = null">Done</button>
            }
            else
            {
                <span class="option-hint">Tap a hold that didn't physically change. You can reset a falsely-moved staged hold and pull its boulders back out of historic state.</span>
            }
        </div>
    }
    @if (CanEdit && ManualAlignment)
    {
        <div class="batch-bar">
            <button class="batch-save" @onclick="ConfirmManualAlignment">Confirm &amp; Update Wall</button>
            <button class="batch-discard" @onclick="DiscardManualAlignment">Discard</button>
        </div>
    }
    else if (CanEdit && (_pendingChanges > 0 || _alignmentChangedIds.Count > 0))
    {
        <div class="batch-bar">
            <button class="batch-save" @onclick="SaveChanges">
                @if (_pendingChanges > 0)
                {
                    @($"Save Changes ({_pendingChanges})")
                }
                else
                {
                    @("Save Alignment")
                }
            </button>
            <button class="batch-discard" @onclick="DiscardChanges">Discard</button>
        </div>
    }
</div>

@code {
    [Parameter] public Guid WallId { get; set; }
    [Parameter] public List<Hold> Holds { get; set; } = [];
    [Parameter] public List<ShapePoint> BorderPoints { get; set; } = [];

    /// <summary>
    /// The wall's segments, shown read-only alongside the border. They are created and
    /// reshaped in the wall settings (<c>WallSegmentEditor</c>), not here.
    /// </summary>
    [Parameter] public List<WallSegment>? Segments { get; set; }
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>
    /// Whether the wall-border tool is available. This is a wall-settings capability (admin/owner),
    /// separate from hold editing (<see cref="CanEdit"/>, which moderators also get). Defaults false
    /// so hold-only editors never expose the border tool.
    /// </summary>
    [Parameter] public bool CanEditShape { get; set; }
    [Parameter] public string? ShareToken { get; set; }

    /// <summary>
    /// When set, overrides the computed photo URL. Big walls point the editor at a specific
    /// panel's photo endpoint; single-image callers leave this null and keep the computed URL.
    /// </summary>
    [Parameter] public string? PhotoUrlOverride { get; set; }
    [Parameter] public EventCallback<Hold> OnHoldAdded { get; set; }
    [Parameter] public EventCallback<Hold> OnHoldUpdated { get; set; }
    [Parameter] public EventCallback<Guid> OnHoldDeleted { get; set; }
    [Parameter] public EventCallback OnRedetectRequested { get; set; }
    [Parameter] public EventCallback<List<ShapePoint>> OnBorderChanged { get; set; }
    [Parameter] public EventCallback OnCleanArtifactsRequested { get; set; }
    [Parameter] public EventCallback<BatchChanges> OnBatchSave { get; set; }
    [Parameter] public EventCallback<Guid> OnMarkHoldModified { get; set; }
    [Parameter] public EventCallback<(Guid stagedHoldId, Guid liveHoldId)> OnMergeHolds { get; set; }

    /// <summary>
    /// Promotes a virtual hold to actual in place (non-staging "make actual" tool).
    /// Passes the virtual hold's id.
    /// </summary>
    [Parameter] public EventCallback<Guid> OnMakeHoldActual { get; set; }

    /// <summary>
    /// Merges a virtual hold into an existing detected hold (non-staging "make actual" tool).
    /// Passes the virtual hold id and the target actual hold id.
    /// </summary>
    [Parameter] public EventCallback<(Guid virtualHoldId, Guid actualHoldId)> OnMergeVirtualHold { get; set; }

    /// <summary>
    /// "This hold didn't physically change": restores boulders that went historic in a past update
    /// but whose holds all still exist. Passes the tapped hold's id. Works in any editor mode.
    /// </summary>
    [Parameter] public EventCallback<Guid> OnRestoreUnchangedHold { get; set; }
    [Parameter] public bool IsStaging { get; set; }
    [Parameter] public int LiveGeneration { get; set; }
    [Parameter] public bool BottomToolbar { get; set; }
    [Parameter] public bool ManualAlignment { get; set; }

    // Enables the per-panel change-review overlay + "Marked changed" toggle in the live (non-alignment)
    // editor: highlights holds flagged NeedsReview and lets the reviewer mark holds changed/unchanged.
    [Parameter] public bool ChangeReview { get; set; }
    [Parameter] public EventCallback<ManualAlignmentResult> OnConfirmManualAlignment { get; set; }
    [Parameter] public EventCallback OnDiscardManualAlignment { get; set; }
    [Parameter] public Func<Task<Homography?>>? OnRequestAutoAlign { get; set; }

    /// <summary>
    /// Changes whenever the parent re-scopes this editor to a different subject (e.g. a big wall
    /// stepping between panels). A new token clears the per-panel edit tracking so unsaved holds
    /// never bleed onto the next panel. Null for single-subject callers (a no-op).
    /// </summary>
    [Parameter] public Guid? ResetToken { get; set; }

    /// <summary>
    /// True while this editor holds unsaved hold edits (adds/updates/deletes). Lets the parent
    /// warn before it re-scopes the editor (e.g. stepping panels) and drops them.
    /// </summary>
    public bool HasUnsavedChanges => _pendingChanges > 0;

    // Any unsaved manual-alignment work: holds dragged (tracked in _pendingChanges via _updatedHoldIds),
    // confirmed-aligned, or moved by the auto-align gizmo. All of it lives only in the circuit until
    // "Confirm & Update Wall", so navigating away (internal or external) would discard it silently.
    private bool _hasPendingAlignmentWork => ManualAlignment
        && (_pendingChanges > 0 || _alignedHoldIds.Count > 0 || _alignmentChangedIds.Count > 0);

    private async Task OnBeforeNavigateAway(LocationChangingContext ctx)
    {
        if (!_hasPendingAlignmentWork)
        {
            return;
        }

        var proceed = await JS.InvokeAsync<bool>("confirm", "You have unsaved alignment changes. Leave and discard them?");
        if (!proceed)
        {
            ctx.PreventNavigation();
        }
    }

    /// <summary>
    /// Supplies the hold-to-boulders map for the usage tool. The tool button is hidden
    /// when this is not wired up.
    /// </summary>
    [Parameter] public Func<Task<Dictionary<Guid, List<HoldUsageRef>>>>? OnRequestHoldUsage { get; set; }

    private bool _autoAligning;
    private string? _autoAlignMsg;

    private async Task OnAutoAlignClick()
    {
        if (_autoAligning || OnRequestAutoAlign == null)
        {
            return;
        }

        _autoAligning = true;
        _autoAlignMsg = null;
        StateHasChanged();
        try
        {
            var h = await OnRequestAutoAlign();
            if (h == null)
            {
                _autoAlignMsg = "No reliable match found — align by hand.";
            }
            else
            {
                ApplyAutoAlign(h);
                _autoAlignMsg = $"Auto-aligned (confidence {h.Confidence:0.00}) — fine-tune, then Save.";
            }
        }
        catch (Exception ex)
        {
            _autoAlignMsg = $"Auto-align failed: {ex.Message}";
        }
        finally
        {
            _autoAligning = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Applies the estimated old->new homography to the overlay holds in-memory,
    /// hooking into the editor's change tracking so the user reviews then Saves
    /// (auto-detect mode) or Confirms (manual mode), and can Discard to revert.
    /// </summary>
    private void ApplyAutoAlign(Homography h)
    {
        TakeSnapshot();
        var targets = (ManualAlignment ? Holds.Where(IsStagedHold) : Holds.Where(IsLiveHold)).ToList();
        foreach (var hold in targets)
        {
            HoldAlignment.Apply(hold, h);
            if (ManualAlignment)
            {
                _alignedHoldIds.Add(hold.Id);
            }
            else
            {
                _alignmentChangedIds.Add(hold.Id);
            }
        }
    }

    public record ManualAlignmentResult(
        List<Hold> Holds,
        HashSet<Guid> ChangedHoldIds,
        HashSet<Guid> AddedHoldIds,
        List<Guid> DeletedHoldIds);

    private readonly HashSet<Guid> _alignedHoldIds = [];
    private readonly HashSet<Guid> _changedHoldIds = [];
    private bool _lastManualAlignment;
    private Guid? _lastResetToken;

    // ---- MarkUnchanged tool -------------------------------------------------------------------
    // Geometry each staged clone had when manual alignment began (== its previous-generation
    // source, since a clone starts at its source's position). The MarkUnchanged reset restores a
    // hold back to it; "changed" is now a manual reviewer decision (_changedHoldIds), not geometry.
    private readonly Dictionary<Guid, (double X, double Y, double Radius, List<ShapePoint>? Shape)> _manualBaseline = new();
    private bool _showChanges = true;
    private Guid? _markUnchangedHoldId;

    private ElementReference _containerRef;
    private ElementReference _viewportRef;

    // Normalized wall-region rectangle the read-only view is framed to (null = full photo / editing).
    private double[]? _frame;
    private string? _fitKey;
    private readonly ViewportZoomState _zoomState;
    private Guid? _selectedHoldId;
    private Guid? _shapeEditHoldId;
    private double _selectedRadius = 0.015;
    private EditMode _mode = EditMode.Add;
    private Guid? _draggingHoldId;
    private int? _draggingShapePointIdx;
    private Hold? _draggingShapeHold;
    private int? _draggingBorderIdx;
    private bool _isDetecting;
    private HoldCategory _addCategory = HoldCategory.Hand;
    private string _addColor = "none";
    private HoldMaterial _addMaterial = HoldMaterial.PU;
    private bool _addOnKickboard;
    private string _paintColor = "yellow";
    private double _zoom => _zoomState.Zoom;
    private bool _showBorder = true;
    private bool _showNames;
    private Guid? _revealNameHoldId;

    private Guid? _namingHoldId;
    private string _nameInput = string.Empty;

    private Dictionary<Guid, List<HoldUsageRef>>? _holdUsage;
    private Guid? _usageHoldId;
    private EditMode _modeBeforeUsage = EditMode.Add;
    private double _shapePointRadius = 0.8;

    private List<Hold> _addedHolds = [];
    private HashSet<Guid> _updatedHoldIds = [];
    private HashSet<Guid> _deletedHoldIds = [];
    private List<Hold>? _snapshotHolds;
    private int _pendingChanges => _addedHolds.Count + _updatedHoldIds.Count + _deletedHoldIds.Count;

    private string PhotoUrl => IsStaging
        ? $"/api/walls/{WallId}/staged-photo"
        : !string.IsNullOrEmpty(ShareToken)
            ? $"/api/walls/{WallId}/photo?token={ShareToken}"
            : $"/api/walls/{WallId}/photo";

    private string EffectivePhotoUrl => PhotoUrlOverride ?? PhotoUrl;

    private bool IsStagedHold(Hold h) => IsStaging && h.Generation > LiveGeneration;
    private bool IsLiveHold(Hold h) => IsStaging && h.Generation <= LiveGeneration;

    private static readonly HoldMaterial[] _materials = [HoldMaterial.PU, HoldMaterial.PE, HoldMaterial.DualTex, HoldMaterial.Wood];
    private static readonly HoldHandType[] _handTypes = [HoldHandType.Jug, HoldHandType.Pinch, HoldHandType.Crimp, HoldHandType.Pocket, HoldHandType.Sloper];
    private static string MaterialLabel(HoldMaterial m) => m == HoldMaterial.DualTex ? "DualTex" : m.ToString();

    // Handles are drawn in SVG user units, which the zoom scales up with the photo.
    // Divide their size by the zoom so they stay a constant on-screen size instead of
    // ballooning when zoomed in.
    private double HandleScale => 1.0 / Math.Clamp(_zoom, 0.5, 6.0);

    private enum EditMode { Add, Move, Shape, Paint, Delete, Border, Name, Merge, ShapeTilt, Usage, MakeActual, MarkUnchanged }

    public record BatchChanges(List<Hold> Added, List<Hold> Updated, List<Guid> Deleted);

    public WallPhotoEditor()
    {
        _zoomState = new ViewportZoomState(() => InvokeAsync(StateHasChanged));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Re-attach every render, unconditionally. setupScroll is idempotent in JS (a no-op once
        // bound to this exact node), so the common case is cheap — but attaching on firstRender
        // ONLY meant a stale ref at that moment (the reconnect / fast re-render race), or a node
        // later replaced by a structural re-render, disabled zoom permanently for this editor.
        try
        {
            await JS.InvokeVoidAsync("bwViewport.setupScroll", _viewportRef, _zoomState.Reference);

            // In the read-only view the box is framed to the wall region (_frame), so it pins that
            // region's aspect and scrolls to it once. In edit mode _frame is null: publish the full
            // photo aspect as --fit-aspect only (no inline aspect-ratio) so the box keeps its
            // flex-driven height until the .bw-fullscreen CSS opts in — exactly as before. Gated so
            // the one-time framing scroll is never re-applied on top of the user panning.
            var fitKey = EffectivePhotoUrl + "|" + (_frame == null ? string.Empty : string.Join(",", _frame));
            if (_fitKey != fitKey)
            {
                _fitKey = fitKey;
                await JS.InvokeVoidAsync("bwViewport.fitBox", _viewportRef, _frame != null, _frame);
            }
        }
        catch (JSException)
        {
            // Stale element reference after a re-render/reconnect: allow the next render to retry.
            // Never let it become an unhandled circuit error.
            _fitKey = null;
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away mid-call; nothing to attach to.
            _fitKey = null;
        }
    }

    public void Dispose() => _zoomState.Dispose();

    private List<WallSegmentDraft> _segmentDrafts = [];

    protected override void OnParametersSet()
    {
        _segmentDrafts = (Segments ?? [])
            .Where(s => s.Points.Count >= 3)
            .OrderBy(s => s.SortOrder)
            .Select(WallSegmentDraft.FromEntity)
            .ToList();

        // Frame the read-only view to the wall region (border if present, else the holds' bbox) so
        // the photo isn't mostly floor/ceiling. Editing stays uncropped: the editor needs the whole
        // canvas (adding holds outside the border, editing the border itself) and its flex/fullscreen
        // layout doesn't cleanly adopt the region aspect. A null frame renders exactly as before.
        _frame = CanEdit ? null : WallFraming.TryComputeFrame(BorderPoints, Holds);

        // Reset all editing state whenever we enter or leave manual alignment so
        // stale hold ids from a prior staging session never bleed into the next one.
        if (ManualAlignment != _lastManualAlignment)
        {
            _alignedHoldIds.Clear();
            _changedHoldIds.Clear();
            _addedHolds.Clear();
            _updatedHoldIds.Clear();
            _deletedHoldIds.Clear();
            _alignmentChangedIds.Clear();
            _snapshotHolds = null;
            _selectedHoldId = null;
            _markUnchangedHoldId = null;
            _manualBaseline.Clear();
            if (ManualAlignment)
            {
                _mode = EditMode.Move;
                CaptureManualBaseline();
            }

            _lastManualAlignment = ManualAlignment;
        }

        // Reset the per-panel edit tracking whenever the parent re-scopes this editor to a
        // different subject (a new ResetToken), so a previous panel's unsaved adds/updates/deletes
        // never carry over onto the next panel. Only outside manual alignment: the alignment sets
        // (_alignedHoldIds/_changedHoldIds/_alignmentChangedIds/_manualBaseline) are owned by the
        // ManualAlignment toggle above and must survive.
        if (ResetToken != _lastResetToken)
        {
            _lastResetToken = ResetToken;
            if (!ManualAlignment)
            {
                _addedHolds.Clear();
                _updatedHoldIds.Clear();
                _deletedHoldIds.Clear();
                _snapshotHolds = null;
                _selectedHoldId = null;
            }
        }
    }

    private string A(EditMode m) => _mode == m ? "active" : "";

    private string CursorForMode() => _mode switch
    {
        EditMode.Delete => "crosshair",
        EditMode.Add => "crosshair", EditMode.Name => "help",
        EditMode.ShapeTilt => "pointer",
        EditMode.Merge => "pointer",
        EditMode.MakeActual => "pointer",
        EditMode.MarkUnchanged => "pointer",
        EditMode.Usage => "pointer",
        _ => "default"
    };

    private void SetMode(EditMode mode)
    {
        if (mode != EditMode.ShapeTilt)
        {
            _shapeTiltHoldId = null;
            ClearShapeTiltSnapshot();
        }
        _mode = mode;
        if (mode != EditMode.Move) _selectedHoldId = null;
        if (mode != EditMode.Shape) _shapeEditHoldId = null;
        if (mode != EditMode.Name) _namingHoldId = null;
        if (mode != EditMode.Usage) _usageHoldId = null;
        if (mode != EditMode.MakeActual)
        {
            _makeActualVirtualId = null;
            _makeActualTargetId = null;
        }
        if (mode != EditMode.MarkUnchanged)
        {
            _markUnchangedHoldId = null;
        }
    }

    private void TakeSnapshot()
    {
        if (_snapshotHolds != null) return;
        _snapshotHolds = Holds.Select(h => new Hold
        {
            Id = h.Id, WallId = h.WallId, X = h.X, Y = h.Y, Radius = h.Radius,
            Color = h.Color, Material = h.Material, Category = h.Category, HandType = h.HandType, IsOnKickboard = h.IsOnKickboard,
            IsAutoDetected = h.IsAutoDetected, Confidence = h.Confidence, Generation = h.Generation,
            Name = h.Name,
            ShapePoints = h.ShapePoints?.Select(sp => new ShapePoint { Dx = sp.Dx, Dy = sp.Dy }).ToList(),
        }).ToList();
    }

    private void TrackUpdate(Hold hold)
    {
        TakeSnapshot();
        if (!_addedHolds.Contains(hold))
            _updatedHoldIds.Add(hold.Id);
    }

    /// <summary>
    /// Enters the read-only usage tool, loading the map on first use. Leaving restores
    /// whichever editing tool was active before, so it doubles as a quick peek.
    /// </summary>
    private async Task ToggleUsageMode()
    {
        if (_mode == EditMode.Usage)
        {
            SetMode(_modeBeforeUsage);
            return;
        }

        _modeBeforeUsage = _mode;
        SetMode(EditMode.Usage);

        // Always refetch: boulders may have changed since the tool was last opened.
        _holdUsage = null;

        if (OnRequestHoldUsage != null)
        {
            _holdUsage = await OnRequestHoldUsage();
        }
    }

    private static string UsageDotClass(HoldType type) => type switch
    {
        HoldType.Start => "start",
        HoldType.Top => "top",
        _ => "normal",
    };

    private List<HoldUsageRef> UsageFor(Guid holdId) =>
        _holdUsage != null && _holdUsage.TryGetValue(holdId, out var refs) ? refs : [];

    private int UnusedHoldCount => Holds.Count(h => UsageFor(h.Id).Count == 0);

    private async Task OnHoldClick(Hold hold)
    {
        // Tapping a hold reveals its name even when the labels are hidden.
        _revealNameHoldId = _revealNameHoldId == hold.Id ? null : hold.Id;

        switch (_mode)
        {
            case EditMode.Usage:
                _usageHoldId = _usageHoldId == hold.Id ? null : hold.Id;
                return;
            case EditMode.Paint:
                TakeSnapshot();
                hold.Color = _paintColor;
                SyncMaterialToColor(hold);
                _updatedHoldIds.Add(hold.Id);
                return;
            case EditMode.Delete:
                TakeSnapshot();
                _deletedHoldIds.Add(hold.Id);
                Holds.RemoveAll(h => h.Id == hold.Id);
                return;
            case EditMode.Shape:
                _shapeEditHoldId = hold.Id;
                if (hold.ShapePoints == null)
                {
                    TakeSnapshot();
                    hold.ShapePoints = ShapePoint.DefaultOctagon(hold.Radius);
                    _updatedHoldIds.Add(hold.Id);
                }
                return;
            case EditMode.Name:
                _namingHoldId = hold.Id;
                _nameInput = hold.Name ?? string.Empty;
                return;
            case EditMode.Move:
                _selectedHoldId = hold.Id;
                _selectedRadius = hold.Radius;
                return;
            case EditMode.Merge:
                HandleMergeClick(hold);
                return;
            case EditMode.MakeActual:
                HandleMakeActualClick(hold);
                return;
            case EditMode.MarkUnchanged:
                _markUnchangedHoldId = _markUnchangedHoldId == hold.Id ? null : hold.Id;
                return;
            case EditMode.ShapeTilt:
                _shapeTiltHoldId = hold.Id;
                CaptureShapeTiltSnapshot(hold);
                _shapeTiltAngleX = 0;
                _shapeTiltAngleY = 0;
                return;
        }
    }

    private (Guid stagedId, Guid liveId)? _pendingMerge;
    private Guid? _mergeFirstPickId;

    private void HandleMergeClick(Hold hold)
    {
        if (!IsStaging) return;

        var isStaged = IsStagedHold(hold);
        var isLive = IsLiveHold(hold);
        if (!isStaged && !isLive) return;

        if (_mergeFirstPickId == null)
        {
            // Auto-detect: is there an opposite-gen hold under this one?
            var match = FindUnderlyingOpposite(hold);
            if (match != null)
            {
                if (isStaged) _pendingMerge = (hold.Id, match.Id);
                else _pendingMerge = (match.Id, hold.Id);
                return;
            }
            _mergeFirstPickId = hold.Id;
            return;
        }

        var first = Holds.FirstOrDefault(h => h.Id == _mergeFirstPickId);
        if (first == null) { _mergeFirstPickId = null; return; }
        if (first.Id == hold.Id) { _mergeFirstPickId = null; return; }

        var firstIsStaged = IsStagedHold(first);
        if (firstIsStaged == isStaged) { _mergeFirstPickId = hold.Id; return; }

        _pendingMerge = firstIsStaged ? (first.Id, hold.Id) : (hold.Id, first.Id);
        _mergeFirstPickId = null;
    }

    private Hold? FindUnderlyingOpposite(Hold hold)
    {
        var threshold = Math.Max(hold.Radius, 0.01) * 0.75;
        var thresholdSq = threshold * threshold;
        Hold? best = null;
        var bestDistSq = double.MaxValue;
        foreach (var other in Holds)
        {
            if (other.Id == hold.Id) continue;
            if (IsStagedHold(other) == IsStagedHold(hold)) continue;
            var dx = other.X - hold.X;
            var dy = other.Y - hold.Y;
            var d2 = dx * dx + dy * dy;
            if (d2 < thresholdSq && d2 < bestDistSq)
            {
                best = other;
                bestDistSq = d2;
            }
        }
        return best;
    }

    private async Task ConfirmMerge()
    {
        if (_pendingMerge == null) return;
        var pair = _pendingMerge.Value;
        _pendingMerge = null;
        await OnMergeHolds.InvokeAsync((pair.stagedId, pair.liveId));
    }

    private void CancelMerge()
    {
        _pendingMerge = null;
        _mergeFirstPickId = null;
    }

    // ---- Make-actual tool (non-staging): promote a virtual hold, or merge it into a detected one ----
    private Guid? _makeActualVirtualId;
    private Guid? _makeActualTargetId;

    private void HandleMakeActualClick(Hold hold)
    {
        // A fresh virtual pick always (re)selects and clears any pending merge target.
        if (hold.IsVirtual)
        {
            _makeActualVirtualId = hold.Id;
            _makeActualTargetId = null;
            return;
        }

        // A non-virtual pick only means something once a virtual hold is selected: it becomes
        // the merge target (same wall is guaranteed — all Holds belong to this wall).
        if (_makeActualVirtualId == null || _makeActualVirtualId == hold.Id)
        {
            return;
        }

        _makeActualTargetId = hold.Id;
    }

    private async Task ConfirmMakeActualMerge()
    {
        if (_makeActualVirtualId is not { } virtualId || _makeActualTargetId is not { } targetId)
        {
            return;
        }

        _makeActualVirtualId = null;
        _makeActualTargetId = null;
        await OnMergeVirtualHold.InvokeAsync((virtualId, targetId));
    }

    private async Task MakeActualAsIs()
    {
        if (_makeActualVirtualId is not { } virtualId)
        {
            return;
        }

        _makeActualVirtualId = null;
        _makeActualTargetId = null;
        await OnMakeHoldActual.InvokeAsync(virtualId);
    }

    private void CancelMakeActual()
    {
        _makeActualVirtualId = null;
        _makeActualTargetId = null;
    }

    private (double X, double Y) LiveCentroid()
    {
        if (_alignSnapshot != null) return _alignSnapshotPivot;
        var live = Holds.Where(IsLiveHold).ToList();
        if (live.Count == 0) return (0.5, 0.5);
        return (live.Average(h => h.X), live.Average(h => h.Y));
    }

