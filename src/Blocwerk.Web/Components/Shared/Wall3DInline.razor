@* The 3D schematic inline on the wall / boulder page (the 3D side of their photo / 3D switch): plain facets
   with every hold as its real outline, the boulder highlighted (glowing outlines, with the focus lightbulb)
   when BoulderId is set. The view is built
   through IWall3DViewService, which reads the wall exactly as the host page does (members, the
   kiosk on its own wall, share tokens), so it can show nothing the page could not. A view3d.changed
   (another model activated) rebuilds it, and the new view instance remounts the stage. *@
@using Blocwerk.Contracts.Feed
@using Blocwerk.Core.Geometry.View3D
@using Blocwerk.Web.State.Live
@inject IWall3DViewService ViewService
@inject WallCacheState Cache
@implements IDisposable

<div class="wall3d-inline">
    @if (result is null)
    {
        <p class="wall3d-inline-message">Loading the 3D view…</p>
    }
    else if (result.Status != Wall3DViewStatus.Ok || result.View is null)
    {
        <p class="wall3d-inline-message">@StatusMessage</p>
    }
    else
    {
        <div class="wall3d-inline-stage">
            <Wall3DStage View="result.View" InitialMode="schematic" HintOnce="true"
                         BoulderFocus="BoulderId is not null" Tools="Tools" />
        </div>
        @if (result.View.BoulderName is not null)
        {
            <div class="wall3d-inline-foot">
                <span class="wall3d-inline-legend" aria-label="Legend">
                    <span><i style="background:@BoulderHoldColors.Start"></i>Start</span>
                    <span><i style="background:@BoulderHoldColors.Normal"></i>Hand</span>
                    <span><i style="background:@BoulderHoldColors.Foot"></i>Foot</span>
                    <span><i style="background:@BoulderHoldColors.Top"></i>Top</span>
                </span>
            </div>
        }
    }
</div>

@code {
    private Wall3DViewResult? result;
    private (Guid Wall, Guid? Boulder, string? Token)? loaded;

    [Parameter, EditorRequired] public Guid WallId { get; set; }

    /// <summary>Highlight this boulder's holds.</summary>
    [Parameter] public Guid? BoulderId { get; set; }

    /// <summary>The share token, when the host page is a share-link route.</summary>
    [Parameter] public string? ShareToken { get; set; }

    /// <summary>Round tool buttons for the viewer's tool column (the wall page's switch back to the photos).</summary>
    [Parameter] public RenderFragment? Tools { get; set; }

    private string StatusMessage => result?.Status switch
    {
        Wall3DViewStatus.NoGeometry => "This wall has no measured 3D model yet.",
        Wall3DViewStatus.InvalidGeometry => "This wall's 3D model could not be read.",
        Wall3DViewStatus.UnderMaintenance => "This wall is currently being updated.",
        _ => "The 3D view is not available.",
    };

    private static readonly IReadOnlySet<string> Kinds = new HashSet<string> { FeedKinds.View3DChanged };
    private LeafFeed? feed;

    // Parameters, not OnInitializedAsync: the host page is retained across wall/boulder navigation.
    protected override async Task OnParametersSetAsync()
    {
        var key = (WallId, BoulderId, ShareToken);
        if (loaded == key)
        {
            return;
        }

        loaded = key;
        result = null;
        if (feed?.Scope.WallId != WallId)
        {
            feed?.Dispose();
            feed = LeafFeed.Open(Cache, new LeafScope(WallId, null, Kinds), InvokeAsync, RebuildAsync);
        }

        await BuildAsync(key);
    }

    public void Dispose() => feed?.Dispose();

    private async Task BuildAsync((Guid Wall, Guid? Boulder, string? Token) key)
    {
        Wall3DViewResult built;
        try
        {
            built = await (feed?.LoadAsync(Build) ?? Build());
        }
        catch (UnauthorizedAccessException)
        {
            built = new Wall3DViewResult(Wall3DViewStatus.NotFound);
        }

        // A slow build of the previous wall must not replace the current one's.
        if (loaded == key)
        {
            result = built;
        }

        Task<Wall3DViewResult> Build() => ViewService.BuildAsync(key.Wall, key.Boulder, key.Token);
    }

    // On the dispatcher: the active model changed, so the view is rebuilt (the stage remounts on the new instance).
    private async Task RebuildAsync(LeafBatch batch)
    {
        if (loaded is { } key && result is not null)
        {
            await BuildAsync(key);
            StateHasChanged();
        }
    }
}
