@inject IJSRuntime JS
@using Blocwerk.Core.Helpers
@using Blocwerk.Core.Geometry

<div class="schematic-container">
    @* Zoom geometry is owned by JS via the `--zoom` custom property (viewport.js). *@
    <div class="schematic-viewport photo-viewport" @ref="_viewportRef"
         style="overflow: auto; cursor: default;">
        <svg viewBox="0 0 100 100" class="schematic-svg"
             xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="0" width="100" height="100" style="fill: var(--wall-bg)" rx="1" />

            <line x1="0" y1="100" x2="100" y2="100"
                  style="stroke: var(--wall-floor)" stroke-width="0.5" />

            @* The wall's planes, foreshortened by their own angle, so the schematic shows
               the shape of the wall instead of one flat plane. *@
            @if (ShowSegments && _drafts.Count > 0)
            {
                <WallSegmentOverlay Segments="_drafts" ProjectPoint="ProjectSegmentPoint" HandleScale="1.0" />
            }

            @foreach (var hold in Holds)
            {
                // Holds on the floor are off the climbable wall: the schematic trims them out.
                if (WallProjection.IsOnFloor(hold.X, hold.Y, Segments))
                {
                    continue;
                }

                var p = hold.IsOnKickboard ? new SchematicPoint(hold.X, hold.Y) : _layout.Project(hold.X, hold.Y);
                var isFoot = hold.Category == HoldCategory.Foot || FootHoldIds?.Contains(hold.Id) == true;
                var r = (isFoot ? hold.Radius * 0.7 : hold.Radius) * 100;
                var isHighlighted = HighlightedHoldIds == null || HighlightedHoldIds.Contains(hold.Id);
                var opacity = isHighlighted ? "1" : "0.15";
                var fill = GetFillColor(hold);
                var stroke = GetStrokeColor(hold);
                if (FootHoldIds?.Contains(hold.Id) == true)
                {
                    fill = BoulderHoldColors.ColorRuleFill(0.55);
                    stroke = BoulderHoldColors.Foot;
                }

                @if (hold.ShapePoints is { Count: >= 3 })
                {
                    <polygon @key="hold.Id" points="@Pts(hold.ShapePoints.Select(sp => (p.X + sp.Dx, p.Y + sp.Dy)))"
                             fill="@fill" stroke="@stroke" stroke-width="0.3" opacity="@opacity" />
                }
                else if (isFoot)
                {
                    <rect @key="hold.Id" x="@F(p.X * 100 - r)" y="@F(p.Y * 100 - r)"
                          width="@F(r * 2)" height="@F(r * 2)"
                          rx="0.3" ry="0.3"
                          fill="@fill" stroke="@stroke" stroke-width="0.3" opacity="@opacity" />
                }
                else
                {
                    <circle @key="hold.Id" cx="@F(p.X * 100)" cy="@F(p.Y * 100)"
                            r="@F(r)"
                            fill="@fill" stroke="@stroke" stroke-width="0.3" opacity="@opacity" />
                }
            }
        </svg>
    </div>

    <div class="schematic-info">
        @if (ShowSegments && _drafts.Count > 0)
        {
            <span>@_drafts.Count segments: @string.Join(", ", _drafts.Select(d => $"{d.Name} {d.Angle}°"))</span>
            <span>&middot; elsewhere @Angle&deg;</span>
        }
        else
        {
            <span>Wall angle: @Angle&deg;</span>
            @if (Angle > 0)
            {
                <span>&middot; Corrected to straight-on view</span>
            }
        }
    </div>
</div>

@code {
    [Parameter] public List<Hold> Holds { get; set; } = [];

    /// <summary>The wall's own angle, applied wherever no segment covers a hold.</summary>
    [Parameter] public int Angle { get; set; }

    [Parameter] public HashSet<Guid>? HighlightedHoldIds { get; set; }

    /// <summary>
    /// The wall's full hold set, used to decide which segments are "empty" and get trimmed. When
    /// null the drawn <see cref="Holds"/> are used; passing the whole wall's holds here keeps the
    /// trimmed shape identical across every boulder on the wall.
    /// </summary>
    [Parameter] public List<Hold>? WallHolds { get; set; }

    /// <summary>Holds a boulder marks as footholds; drawn in the foot purple.</summary>
    [Parameter] public HashSet<Guid>? FootHoldIds { get; set; }

    /// <summary>
    /// The wall's segments. Empty (or unset) keeps the original single-plane behaviour.
    /// </summary>
    [Parameter] public List<WallSegment>? Segments { get; set; }

    /// <summary>
    /// Whether the segment polygons are drawn as an overlay. Holds are always projected
    /// through the segments regardless; this only toggles the coloured plane outlines.
    /// </summary>
    [Parameter] public bool ShowSegments { get; set; } = true;

    private ElementReference _viewportRef;
    private List<WallSegmentDraft> _drafts = [];

    /// <summary>The folding layout, rebuilt whenever the segments or wall angle change.</summary>
    private WallSchematicLayout _layout = WallProjection.BuildLayout(null, 0);

    // OnParametersSet fires on every parent re-render, not only when inputs change. Building the
    // fold (SchematicSegments + BuildLayout) is not free, so skip it when the inputs that actually
    // feed it are the same references/values as last time. In the wall's own Schematic view these
    // are stable fields, so this removes the rebuild on every unrelated re-render; the segment
    // editor preview passes a fresh Entities() list each render and so still rebuilds live.
    private List<WallSegment>? _lastSegments;
    private List<Hold>? _lastHolds;
    private List<Hold>? _lastWallHolds;
    private int _lastAngle = int.MinValue;
    private bool _layoutBuilt;

    protected override void OnParametersSet()
    {
        if (_layoutBuilt
            && ReferenceEquals(_lastSegments, Segments)
            && ReferenceEquals(_lastHolds, Holds)
            && ReferenceEquals(_lastWallHolds, WallHolds)
            && _lastAngle == Angle)
        {
            return;
        }

        _lastSegments = Segments;
        _lastHolds = Holds;
        _lastWallHolds = WallHolds;
        _lastAngle = Angle;
        _layoutBuilt = true;

        // Floor panels, and wall panels no hold sits in, are trimmed out of the schematic. The
        // trimming basis is the whole wall's holds when supplied, so the shape is stable across
        // boulders; the drawn Holds are the fallback for the wall's own view.
        var included = WallProjection.SchematicSegments(Segments, WallHolds ?? Holds);
        _drafts = included.Select(WallSegmentDraft.FromEntity).ToList();

        // Build the fold once per parameter change; the render loop then queries it per hold.
        // `included` is already in sort order, so the layout's segment indices line up with the
        // overlay, which draws these same segments in order (see ProjectSegmentPoint).
        _layout = WallProjection.BuildLayout(included, Angle);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // No .NET callback: nothing here displays the zoom level, so there is
                // no reason to pay for a round-trip on every gesture.
                await JS.InvokeVoidAsync("bwViewport.setupScroll", _viewportRef, null);
            }
            catch (JSException)
            {
                // Stale element reference after a re-render/reconnect: the view still works,
                // it just isn't zoom-enabled. Never let it become an unhandled circuit error.
            }
            catch (JSDisconnectedException)
            {
                // Circuit went away mid-call; nothing to attach to.
            }
        }
    }

    private SchematicPoint ProjectSegmentPoint(int index, double x, double y) =>
        _layout.ProjectForSegment(index, x, y);

    private static string F(double v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    private static string Pts(IEnumerable<(double X, double Y)> pts) =>
        string.Join(" ", pts.Select(p => $"{F(p.X * 100)},{F(p.Y * 100)}"));

    private static string GetFillColor(Hold hold) => HoldPalette.Hex(hold.Color);

    private static string GetStrokeColor(Hold hold) => HoldPalette.StrokeHex(hold.Color);
}
