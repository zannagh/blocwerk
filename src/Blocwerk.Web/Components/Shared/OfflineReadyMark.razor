@* The offline-ready mark (design 2026-10-21 §6.8, PR 2.9): shown once every core asset of the wall is on this
   device. Whether it is ready is a fact of the device's ledger, so asset-report.js adds `data-ready` to this element
   and CSS hides it until then; Blazor never owns that attribute, so a re-render leaves it alone. Works in static
   and interactive renders alike. *@
<span class="bw-offline-ready" data-bw-offline-ready="@WallId.ToString("D")" role="img"
      aria-label="Offline ready" title="Offline ready: this wall's photos are saved on this device">
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
        <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M4.8 8.3l2.1 2.1 4.3-4.6" fill="none" stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round" />
    </svg>
</span>

@code {
    /// <summary>The wall whose core assets the mark reports.</summary>
    [Parameter]
    [EditorRequired]
    public Guid WallId { get; set; }
}
