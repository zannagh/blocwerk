@inject IWallPanelService WallPanelService
@inject IBoulderService BoulderService

@* Focused, one-at-a-time overlap confirmation for a newly staged big-wall panel. Each proposed
   hold-match is reviewed on its own: the neighbour hold (left) and the proposed new hold (right)
   are shown side by side, each on an independently zoom/pannable image, colour-and-number paired.
   Proposals about holds a live boulder is built from come first, then the matcher's confidence, so
   the consequential ones are decided while the user is still paying attention.
   See PanelImageView.razor. *@

<div class="panel-stepper" tabindex="0" @ref="_rootRef" @onkeydown="OnKeyDown">
    <div class="panel-stepper-head">
        <div>
            <h3 class="panel-overlap-title">Confirm overlapping holds</h3>
            <p class="hint">New panel at (@Col, @Row). Is the numbered hold on the left the same physical hold as the one on the right?</p>
        </div>
        <button class="btn-secondary" @onclick="Discard" title="Cancel adding this panel entirely">Discard this panel</button>
    </div>

    @if (AlignmentFailed)
    {
        <div class="bigupdate-banner" role="alert">
            <strong>Couldn't line up this photo with the neighbouring one automatically.</strong>
            <span>No overlapping holds could be suggested, so link the ones you care about by hand — or retake
                  the photo with more overlap.</span>
        </div>
    }

    @if (_loading)
    {
        <p class="loading-small">Loading holds…</p>
    }
    else if (_finishing)
    {
        <p class="loading-small">Adding panel…</p>
    }
    else if (_manualMode)
    {
        <p class="panel-stepper-hint">Tap a hold on the left (neighbour) and the same physical hold on the right (new panel), then mark them as overlapping. Repeat for as many as you need.</p>

        @if (_neighborPanels.Count > 1 && _manualNeighborId is { } curNeighbor)
        {
            <div class="panel-stepper-bar">
                <span class="panel-stepper-progress">Neighbour</span>
                @foreach (var n in _neighborPanels)
                {
                    <button class="opt-btn @(n.Id == curNeighbor ? "active" : "")" @onclick="() => SelectManualNeighbor(n.Id)">(@n.Col, @n.Row)</button>
                }
            </div>
        }

        @if (_manualNeighborId is { } neighborId)
        {
            <div class="panel-stepper-pair">
                <PanelImageView WallId="WallId" Caption="Existing neighbour — pick a hold"
                                PhotoUrl="@PhotoUrl(neighborId, staged: NeighbourStaged)"
                                Holds="NeighborHolds(neighborId)"
                                SelectedHoldId="_manualLeftId"
                                Interactive="true"
                                FocusKey="_manualFocusKey"
                                OnHoldTap="OnManualLeftTap" />

                <PanelImageView WallId="WallId" Caption="New panel — pick the same hold"
                                PhotoUrl="@PhotoUrl(PanelId, staged: true)"
                                Holds="_stagedList"
                                SelectedHoldId="_manualRightId"
                                Interactive="true"
                                FocusKey="_manualFocusKey"
                                OnHoldTap="OnManualRightTap" />
            </div>
        }
        else
        {
            <p class="staged-hint">No live neighbour panel is available to link to.</p>
        }

        @if (!string.IsNullOrEmpty(_warning))
        {
            <p class="staged-hint danger">@_warning</p>
        }

        <div class="panel-stepper-actions">
            <span class="panel-stepper-hint">@_manualLinks.Count manual link@(_manualLinks.Count == 1 ? "" : "s") added.</span>
            <button class="btn-primary" @onclick="MarkManualOverlap" disabled="@(_manualLeftId is null || _manualRightId is null)" title="Mark the two selected holds as the same physical hold (Enter)">Mark as overlapping</button>
            <button class="btn-secondary" @onclick="CancelManual" title="Back to the proposals (Esc)">Done</button>
        </div>
    }
    else if (_steps.Count == 0)
    {
        <p class="staged-hint">No overlapping holds were proposed. You can still add this panel — it just won't be linked to a neighbour yet.</p>
        <div class="staged-actions">
            <button class="btn-primary" @onclick="Finish">Add panel</button>
            @if (_neighborPanels.Count > 0)
            {
                <button class="btn-secondary" @onclick="EnterManual">Link holds manually@(_manualLinks.Count > 0 ? $" ({_manualLinks.Count})" : "")</button>
            }
            <button class="btn-secondary" @onclick="Discard">Cancel</button>
        </div>
    }
    else
    {
        var step = _steps[_index];
        var color = PairColor(_index);
        var newHold = _stagedHolds.GetValueOrDefault(step.HoldBId);
        var neighborHold = NeighborHold(step.NeighborPanelId, step.HoldAId);

        <div class="panel-stepper-bar">
            <span class="panel-stepper-progress">@(_index + 1) / @_steps.Count</span>
            <span class="panel-stepper-band @Band(step.Confidence)">@BandLabel(step.Confidence)</span>
            <span class="panel-proposal-conf">@Pct(step.Confidence)% confident</span>
            @if (_decisions[_index] is { } d)
            {
                <span class="panel-stepper-decided">@(d.Moved ? "moved ✓" : "linked ✓")</span>
            }
            else if (CurrentIsUndecidedByDelete)
            {
                @* This step HAD a confirmed match until the hold it pointed at was deleted. *@
                <span class="panel-stepper-band low">match deleted — decide again</span>
            }
        </div>

        <div class="panel-stepper-pair">
            <PanelImageView WallId="WallId" Caption="Existing neighbour"
                            PhotoUrl="@PhotoUrl(step.NeighborPanelId, staged: NeighbourStaged)"
                            Holds="NeighborHolds(step.NeighborPanelId)"
                            HighlightHoldId="step.HoldAId" BadgeNumber="_index + 1" BadgeColor="@color"
                            FocusKey="_index" FocusPoint="Point(neighborHold)" />

            @* Editable only while a touch-up tool is picked (and never inside the moved pick), so with
               no tool active the pane behaves exactly as it always has. *@
            <PanelImageView WallId="WallId" Caption="@(_movedMode ? "New panel — pick the ACTUAL hold" : "New panel")"
                            PhotoUrl="@PhotoUrl(PanelId, staged: true)"
                            Holds="_stagedList"
                            HighlightHoldId="@(_movedMode ? null : step.HoldBId)"
                            SelectedHoldId="@RightPaneSelectedId"
                            HintPoint="@(_movedMode ? Point(newHold) : null)"
                            Interactive="@(_movedMode || ToolActive)"
                            AddMode="@(_addMode || (ToolActive && _touchup.AddMode))"
                            Editable="@ToolActive"
                            ExactHitTargets="@(ToolActive && _touchup.DeleteMode)"
                            DragToMove="@(ToolActive && _touchup.MoveMode)"
                            BadgeNumber="_index + 1" BadgeColor="@color"
                            FocusKey="_index" FocusPoint="Point(newHold)"
                            OnHoldTap="OnRightHoldTapAsync" OnEmptyTap="OnRightEmptyTapAsync"
                            OnHoldGeometryChanged="MoveStagedHoldAsync" />
        </div>

        @if (!string.IsNullOrEmpty(_warning))
        {
            <p class="staged-hint danger">@_warning</p>
        }

        @if (_movedMode)
        {
            <div class="panel-stepper-actions">
                <span class="panel-stepper-hint">Tap the hold on the right that this really is, or add it if the matcher missed it.</span>
                <button class="opt-btn @(_addMode ? "active" : "")" @onclick="() => _addMode = !_addMode">＋ Add hold here</button>
                <button class="btn-primary" @onclick="UseMovedHold" disabled="@(_movedSelectedHoldId is null)">Use this hold</button>
                <button class="btn-secondary" @onclick="CancelMoved">Cancel</button>
            </div>
        }
        else
        {
            <div class="panel-stepper-actions">
                <button class="btn-secondary" @onclick="Back" disabled="@(_index == 0)" title="Previous (←)">←</button>
                <button class="btn-danger-soft" @onclick="DiscardMatch" title="Not the same hold (D)">Discard match</button>
                <button class="btn-primary" @onclick="ConfirmMatch" title="Same hold (Enter / C)">Confirm match</button>
                <button class="btn-secondary" @onclick="EnterMoved" title="Same hold, different position (M)">Moved hold</button>
                <button class="btn-danger-soft" @onclick="DeleteHold" title="This hold was removed from the wall (X / Delete)">Delete hold</button>
                <button class="btn-secondary" @onclick="Next" title="Skip (→)">→</button>
            </div>
            <div class="panel-stepper-foot">
                <span class="panel-stepper-legend"><kbd>Enter</kbd>/<kbd>C</kbd> confirm · <kbd>D</kbd> discard · <kbd>M</kbd> moved · <kbd>X</kbd> delete · <kbd>←</kbd>/<kbd>→</kbd> step</span>
                @if (_neighborPanels.Count > 0)
                {
                    <button class="btn-link" @onclick="EnterManual" title="Manually link a neighbour hold to a new-panel hold the matcher missed">
                        Link holds manually@(_manualLinks.Count > 0 ? $" ({_manualLinks.Count})" : "")
                    </button>
                }
                @* Deleting a hold on the right un-decides every step that was linked to it — possibly
                   steps long behind this one. They stay reachable here instead of disappearing behind a
                   warning on whichever step happened to be open. *@
                @if (UndecidedByDeleteCount > 0)
                {
                    <button class="btn-link" @onclick="GoToFirstUndecided" title="Go back to the first step whose confirmed match was dropped when you deleted a hold">
                        Decide again (@UndecidedByDeleteCount)
                    </button>
                }
                <button class="btn-link" @onclick="ConfirmAllHighConfidence" title="Auto-confirm every remaining match at 90% or higher, discard the rest, and finish">
                    Confirm all remaining ≥ 90% (@RemainingHighConfidence)
                </button>
            </div>

            @* Fix a wrong hold on the NEW panel without leaving the review. Deliberately buttons only:
               this stepper's letters c / d / m / x are established review actions documented on the
               help page, and re-lettering them (or binding only the two tool letters that happen to be
               free) would be worse than no tool keys at all. stopPropagation keeps the size slider's
               own keys out of the stepper's keydown handler. *@
            @if (ToolsEnabled)
            {
                <div class="bigupdate-edit-tools" @onkeydown:stopPropagation="true">
                    <span class="hint">
                        Wrong hold on the new panel? Fix it here: <strong>+</strong> adds a missed hold, the
                        <strong>bin</strong> deletes a false detection, <strong>move</strong> drags one into
                        place and the <strong>size slider</strong> resizes the selected hold. These tools have
                        no keyboard shortcuts here — <kbd>C</kbd>, <kbd>D</kbd>, <kbd>M</kbd> and <kbd>X</kbd>
                        stay the review actions above.
                    </span>
                    <HoldTouchupToolbar Tool="_touchup.Tool" ToolChanged="SetTouchupTool"
                                        Size="_touchup.Radius" SizeChanged="OnTouchupSizeChanged"
                                        OnSizeCommitted="OnTouchupSizeCommittedAsync"
                                        HasSelection="@(_touchup.SelectedHoldId is not null)" />
                </div>
            }
        }
    }
</div>
