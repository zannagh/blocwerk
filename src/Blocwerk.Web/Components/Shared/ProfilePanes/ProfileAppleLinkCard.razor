@* "Sign in with Apple" on the Account pane: whether an Apple ID is linked, and an Unlink button. Linking happens in
   the iPhone app while it is signed in (POST /api/v1/me/apple); the web only shows and removes the link. Not on a
   kiosk: the whole Account pane is replaced there. *@
@inject Blocwerk.Core.AppleSignIn.IAppleSignInService Apple

<details class="section profile-collapsible" id="apple-section">
    <summary>@(link is not null ? "Sign in with Apple (linked)" : "Sign in with Apple")</summary>
    @if (link is not null)
    {
        <div class="field-group">
            <div class="field-actions">
                <span class="field-label">
                    Apple ID linked@(link.LinkedFrom is null ? null : $" on {link.LinkedFrom}"),
                    <time datetime="@link.LinkedAt.ToString("O")">@link.LinkedAt.ToString("d MMM yyyy, HH:mm 'UTC'")</time>
                </span>
                <button class="btn-secondary" @onclick="UnlinkAsync" disabled="@busy">Unlink</button>
            </div>
        </div>
        <p class="member-since">
            The Blocwerk iPhone app can sign in to this account with your Apple ID. If you did not link it, unlink it
            and revoke the device's key under API keys. Unlinking stops new sign-ins; devices already signed in stay
            signed in until you revoke their keys. Changing your password or two-factor settings unlinks it too.
        </p>
    }
    else
    {
        <p class="member-since">
            No Apple ID is linked. Sign in to the Blocwerk iPhone app once and link your Apple ID under Profile to sign
            in with Apple from then on.
        </p>
    }
</details>

@code {
    private Blocwerk.Core.Entities.AppleLink? link;
    private bool busy;

    /// <summary>Gets or sets the signed-in user whose link is shown.</summary>
    [Parameter]
    [EditorRequired]
    public Guid UserId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        link = await Apple.FindLinkAsync(UserId);
    }

    private async Task UnlinkAsync()
    {
        busy = true;
        try
        {
            await Apple.UnlinkAsync(UserId);
            link = null;
        }
        finally
        {
            busy = false;
        }
    }
}
