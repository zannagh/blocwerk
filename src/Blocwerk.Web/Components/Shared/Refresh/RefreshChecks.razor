@using Blocwerk.Core.Refresh
@using Blocwerk.Web.Endpoints
@* The check step's cards as a list (the list view): every card, answered ones included, each with the old photo, the
   new photo and this visit's 3D texture, its two answers, and "Change" on an answered one. *@

@if (Checks.Count > 0)
{
    <section class="refresh-checks" aria-labelledby="refresh-checks-title">
        <h3 id="refresh-checks-title">@Title</h3>
        <p class="hint">@RefreshCheckCopy.LeftAlone</p>
        <ul class="refresh-check-list">
            @foreach (var check in Checks)
            {
                <li class="refresh-check @(check.Status != UpdateExceptionStatus.Pending ? "is-answered" : null)" @key="check.Id">
                    <p class="refresh-check-title"><strong>@RefreshCheckCopy.Heading(check)</strong> @RefreshCheckCopy.Detail(check)</p>
                    <div class="refresh-check-crops">
                        @if (check.HasOld)
                        {
                            <figure><img loading="lazy" src="@Crop(check, CheckCropView.Old)" alt="The old photo around this hold" /><figcaption>Old photo</figcaption></figure>
                        }
                        <figure><img loading="lazy" src="@Crop(check, CheckCropView.New)" alt="The new photo around this spot" /><figcaption>New photo</figcaption></figure>
                        @if (check.HasModel)
                        {
                            <figure><img loading="lazy" onerror="this.parentElement.style.display='none'" src="@Crop(check, CheckCropView.Model)" alt="The 3D texture around this spot" /><figcaption>3D texture</figcaption></figure>
                        }
                    </div>
                    <div class="refresh-check-actions">
                        @if (check.Status == UpdateExceptionStatus.Pending)
                        {
                            <button class="btn-secondary" disabled="@Disabled" @onclick="() => OnAnswer.InvokeAsync(new RefreshCheckAnswer(check.Id, UpdateExceptionAnswer.Keep))">@RefreshCheckCopy.KeepLabel(check)</button>
                            @if (RefreshCheckCopy.TakesRemove(check))
                            {
                                <button class="btn-secondary" disabled="@Disabled" @onclick="() => OnAnswer.InvokeAsync(new RefreshCheckAnswer(check.Id, UpdateExceptionAnswer.Remove))">@RefreshCheckCopy.RemoveLabel(check)</button>
                            }
                        }
                        else
                        {
                            <span class="refresh-badge is-user">@RefreshCheckCopy.AnsweredLabel(check)</span>
                            <button class="btn-link" disabled="@Disabled" @onclick="() => OnAnswer.InvokeAsync(new RefreshCheckAnswer(check.Id, UpdateExceptionAnswer.Undo))">Change</button>
                        }
                    </div>
                </li>
            }
        </ul>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public Guid RefreshId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<RefreshCheck> Checks { get; set; } = [];

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>An answer was picked on a card; the step writes it and shows the summary that is being made again.</summary>
    [Parameter]
    public EventCallback<RefreshCheckAnswer> OnAnswer { get; set; }

    private string Title => Checks.Count == 1 ? "1 hold needs a look" : $"{Checks.Count} holds need a look";

    private string Crop(RefreshCheck check, CheckCropView view) => WallRefreshCheckCropEndpoint.Url(RefreshId, check.Id, view);
}
