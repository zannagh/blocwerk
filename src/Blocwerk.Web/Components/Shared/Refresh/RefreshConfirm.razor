@using Blocwerk.Core.Refresh
@* The check step: what the panel update will do, before anything goes live. On one screen: the headline numbers, the
   cards that need a look one at a time on the card deck (what boulders use first; an answered card leaves the queue,
   and "Change" in the bar above the answers takes the last answer back), and at the bottom Apply, which says how
   many cards are still open and asks before it applies. "List" on the page's header shows everything as lists
   instead (RefreshSummaryLists): all cards, the holds that moved, the holds not found again, every count. *@

<div class="refresh-confirm @(ListView ? "is-list" : null)">
    @if (View.Summary is { } s)
    {
        <dl class="refresh-numbers" aria-label="What the update does">
            @foreach (var number in RefreshFlow.Numbers(s))
            {
                <div class="@(number.Attention ? "is-attention" : null)">
                    <dt>@number.Label</dt>
                    <dd>@number.Value</dd>
                </div>
            }
        </dl>
        @if (error is not null)
        {
            <p class="field-error" role="alert">@error</p>
        }

        @if (ListView)
        {
            <RefreshSummaryLists View="View" Summary="s" Checks="checks" Disabled="AnswersOff" OnAnswer="AnswerAsync" />
        }
        else
        {
            <CardDeck Count="Queue.Count" Index="cursor.Index" Label="@(Current is { } shown ? RefreshCheckCopy.Short(shown) : null)" OnStep="Step" OnKey="OnKeyAsync"
                      Note="@(LastAnswered is null ? null : LastAnswerNote)" QueueList="QueueRows">
                <ChildContent>
                    @if (Current is { } check)
                    {
                        <RefreshCheckCard @key="check.Id" @ref="card" RefreshId="View.Id" Check="check" Disabled="AnswersOff"
                                          OnAnswer="answer => AnswerAsync(new RefreshCheckAnswer(check.Id, answer))" />
                    }
                </ChildContent>
                <Empty>
                    <p class="glyph-ok" role="status">@(checks.Count == 0 ? "The update is sure about every hold: no card needs a look." : "Every card is answered.")</p>
                    <p class="hint">Apply below when you are ready, or open the list to see everything the update does.</p>
                </Empty>
            </CardDeck>
        }

        <div class="refresh-apply">
            <span class="refresh-apply-note">@ApplyNote(s)</span>
            <ConfirmAction Label="@RefreshFlow.ApplyLabel(s.ChecksOpen, s.FullRevision is not null)" Question="@RefreshFlow.ApplyQuestion(s)"
                           ConfirmLabel="@(s.FullRevision is null ? "Apply update" : "Start the wall over")"
                           TriggerClass="@(s.FullRevision is null ? "btn-primary" : "btn-danger")" ConfirmClass="@(s.FullRevision is null ? "btn-primary" : "btn-danger")"
                           Neutral="@(s.FullRevision is null)" Disabled="@(View.Check3DPending || View.SummaryUpdating)" OnConfirm="OnApply" />
        </div>
    }
</div>

@code {
    private RenderFragment LastAnswerNote => @<p class="deck-undo" role="status">
        @if (LastAnswered is { } last)
        {
            <span>@RefreshCheckCopy.AnsweredLabel(last)</span>
            <button type="button" class="btn-link" disabled="@AnswersOff" @onclick="() => ChangeLastAsync(last.Id)">Change</button>
            <button type="button" class="btn-link deck-undo-close" @onclick="() => lastId = null" aria-label="Hide this note">&times;</button>
        }
    </p>;

    private RenderFragment QueueRows => @<ol>
        @foreach (var item in Queue)
        {
            <li @key="item.Id">
                <button type="button" class="@(item.Id == Current?.Id ? "is-current" : null)" aria-current="@(item.Id == Current?.Id ? "true" : null)"
                        @onclick="() => cursor.JumpTo(item.Id)">
                    <span>@RefreshCheckCopy.Short(item)</span>
                    <small>@(item.HoldName ?? "hold")@(item.Boulders > 0 ? $" · {PlainCopy.Plural(item.Boulders, "boulder")}" : null)</small>
                </button>
            </li>
        }
    </ol>;
}
