@using Blocwerk.Core.Refresh
@using Blocwerk.Web.Endpoints
@* One screen, usually just "Start": the photo proposed for each panel, the current photo beside it, and a
   choice to change it. Every photo also goes to the 3D model. *@

<div class="refresh-sort">
    <p>
        Each panel shows the uploaded photo that matches it best. Check them, change any that is wrong, then start.
        @if (View.CaptureAvailable)
        {
            <span>All @View.Photos.Count photos@(VideoText) also go to the 3D model.</span>
        }
        else
        {
            <span>3D is not set up for this wall, so only the panel photos are used.</span>
        }
    </p>

    <div class="refresh-panels">
        @foreach (var pick in View.Picks)
        {
            var chosen = Chosen(pick);
            <div class="refresh-panel-card">
                <div class="refresh-panel-head">
                    <strong>@PanelName(pick)</strong>
                    <span class="refresh-badge @BadgeClass(pick, chosen)">@BadgeText(pick, chosen)</span>
                </div>
                <div class="refresh-panel-photos">
                    <figure>
                        @if (pick.PanelId is { } panelId)
                        {
                            <img src="/api/walls/@View.WallId/panels/@panelId/photo" alt="Current photo of @PanelName(pick)" loading="lazy" />
                        }
                        <figcaption>Now</figcaption>
                    </figure>
                    <figure>
                        @if (chosen is { } photoId && View.CaptureId is { } captureId)
                        {
                            <img src="@CapturePhotoEndpoint.Url(captureId, photoId)" alt="New photo for @PanelName(pick)" loading="lazy" />
                        }
                        else
                        {
                            <div class="refresh-keep">Keeps its photo</div>
                        }
                        <figcaption>@NewCaption(pick, chosen)</figcaption>
                    </figure>
                </div>
                <select class="form-input refresh-photo-select" aria-label="New photo for @PanelName(pick)" value="@(chosen?.ToString() ?? string.Empty)"
                        @onchange="e => Choose(pick, e.Value as string)">
                    <option value="">Keep the current photo</option>
                    @if (pick.Candidates.Count > 0)
                    {
                        <optgroup label="Matching photos (share of the panel they show)">
                            @foreach (var candidate in pick.Candidates)
                            {
                                <option value="@candidate.PhotoId">@PhotoName(candidate.PhotoId) · @Percent(candidate.Coverage)</option>
                            }
                        </optgroup>
                    }
                    @if (Others(pick) is { Count: > 0 } others)
                    {
                        <optgroup label="@(pick.Candidates.Count > 0 ? "Other photos" : "All photos")">
                            @foreach (var photo in others)
                            {
                                <option value="@photo.PhotoId">@PhotoName(photo.PhotoId)</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
        }
    </div>

    @if (View.Picks.Count == 0)
    {
        <p class="hint">This wall has no panel photos yet, so only the 3D model is updated.</p>
    }

    <button class="btn-primary" @onclick="StartAsync">@(View.CaptureAvailable ? "Start (panels + 3D)" : "Start")</button>
    @if (View.CaptureAvailable && View.HasActiveModel)
    {
        <button class="btn-secondary" @onclick="StartPanelsOnlyAsync">Update panels only (keep the 3D model)</button>
        <p class="hint">
            Panels only starts no 3D capture and needs no GPU runner. The current 3D model stays as it is; the holds are
            placed on it from the new photos in the background, and holds it cannot place stay 2D-only.
        </p>
    }
    else if (View.CaptureAvailable)
    {
        <button class="btn-secondary" @onclick="StartPanelsOnlyAsync">Update panels only (skip the 3D capture)</button>
        <p class="hint">
            This wall has no 3D model yet. Panels only starts no 3D capture, so the wall stays 2D until you capture it.
        </p>
    }

    @if (View.Revision is { } revision && View.Picks.Count > 0)
    {
        <section class="refresh-revision" aria-labelledby="refresh-revision-title">
            <h2 id="refresh-revision-title">The wall was fully reset</h2>
            <p>
                Only when every hold was taken off and the wall was set again. Starting over does not look for the old holds
                on the new photos: nothing is matched and nothing is carried over.
            </p>
            <ul class="refresh-summary">
                <li><strong>@revision.Holds</strong> @(revision.Holds == 1 ? "hold is" : "holds are") replaced by a fresh detection on the new photos</li>
                <li>
                    <strong>@revision.Boulders</strong> @(revision.Boulders == 1 ? "boulder is" : "boulders are") archived.
                    They stay in the archive with their sends and can still be opened on the old photo.
                </li>
                <li>No hold is left to look over as "not found again"</li>
            </ul>
            <p class="hint">
                You see a summary first, and nothing changes until you apply it. Once applied, it cannot be undone from the app.
            </p>
            @if (PanelsKeepingPhoto is { Count: > 0 } keeping)
            {
                <p class="refresh-revision-blocked" role="note">
                    Starting over needs a new photo for every panel. Still keeping its photo: @string.Join(", ", keeping).
                </p>
            }
            else
            {
                <div class="refresh-actions">
                    <ConfirmAction Label="@(View.CaptureAvailable ? "Start over (panels + 3D)" : "Start over")" TriggerClass="btn-danger"
                                   Question="@RevisionQuestion(revision)" RequiredText="@revision.WallName" ConfirmLabel="Start over"
                                   OnConfirm="StartOverAsync" />
                    @if (View.CaptureAvailable)
                    {
                        <ConfirmAction Label="Start over, panels only" TriggerClass="btn-secondary"
                                       Question="@RevisionQuestion(revision)" RequiredText="@revision.WallName" ConfirmLabel="Start over"
                                       OnConfirm="StartOverPanelsOnlyAsync" />
                    }
                </div>
            }
        </section>
    }
</div>
