@using Blocwerk.Core.Refresh
@using Blocwerk.Web.Endpoints
@* The second screen of the photos step, usually just "Start": one row per panel with the photo proposed for it and
   how sure the match is; "Change" opens the current photo beside it and the choice of another one. Below, the two
   ways to start as two cards: the normal update, and starting the wall over when it was fully reset. Every photo
   also goes to the 3D model. *@

<div class="refresh-sort">
    <p class="hint refresh-sort-intro">
        Each panel shows the uploaded photo that matches it best. Change any that is wrong, then start.
        @if (View.CaptureAvailable)
        {
            <span>All @View.Photos.Count photos@(VideoText) also go to the 3D model.</span>
        }
        else
        {
            <span>3D is not set up for this wall, so only the panel photos are used.</span>
        }
    </p>

    <ul class="refresh-picks">
        @foreach (var pick in View.Picks)
        {
            var chosen = Chosen(pick);
            var open = editing.Contains((pick.Col, pick.Row));
            <li class="refresh-pick" @key="(pick.Col, pick.Row)">
                <div class="refresh-pick-thumb">
                    @if (chosen is { } photoId && View.CaptureId is { } captureId)
                    {
                        <img src="@CapturePhotoEndpoint.Url(captureId, photoId)" alt="New photo for @PanelName(pick)" loading="lazy" />
                    }
                    else
                    {
                        <div class="refresh-keep">Keeps its photo</div>
                    }
                </div>
                <div class="refresh-pick-text">
                    <strong>@PanelName(pick)</strong>
                    <span class="refresh-badge @BadgeClass(pick, chosen)">@BadgeText(pick, chosen)</span>
                    <span class="hint">@(chosen is { } id ? $"{PhotoName(id)} · {NewCaption(pick, chosen)}" : "No new photo")</span>
                </div>
                <button type="button" class="btn-secondary refresh-pick-change" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleEdit(pick)">@(open ? "Done" : "Change")</button>
                @if (open)
                {
                    <div class="refresh-pick-edit">
                        <div class="refresh-panel-photos">
                            <figure>
                                @if (pick.PanelId is { } panelId)
                                {
                                    <img src="@CurrentPhotoUrl(panelId)" alt="Current photo of @PanelName(pick)" loading="lazy" />
                                }
                                <figcaption>Now</figcaption>
                            </figure>
                            <figure>
                                @if (chosen is { } newId && View.CaptureId is { } capture)
                                {
                                    <img src="@CapturePhotoEndpoint.Url(capture, newId)" alt="New photo for @PanelName(pick)" loading="lazy" />
                                }
                                else
                                {
                                    <div class="refresh-keep">Keeps its photo</div>
                                }
                                <figcaption>@NewCaption(pick, chosen)</figcaption>
                            </figure>
                        </div>
                        <select class="form-input refresh-photo-select" aria-label="New photo for @PanelName(pick)" value="@(chosen?.ToString() ?? string.Empty)"
                                @onchange="e => Choose(pick, e.Value as string)">
                            <option value="">Keep the current photo</option>
                            @if (pick.Candidates.Count > 0)
                            {
                                <optgroup label="Matching photos (share of the panel they show)">
                                    @foreach (var candidate in pick.Candidates)
                                    {
                                        <option value="@candidate.PhotoId">@PhotoName(candidate.PhotoId) · @Percent(candidate.Coverage)</option>
                                    }
                                </optgroup>
                            }
                            @if (Others(pick) is { Count: > 0 } others)
                            {
                                <optgroup label="@(pick.Candidates.Count > 0 ? "Other photos" : "All photos")">
                                    @foreach (var photo in others)
                                    {
                                        <option value="@photo.PhotoId">@PhotoName(photo.PhotoId)</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                }
            </li>
        }
    </ul>

    @if (View.Picks.Count == 0)
    {
        <p class="hint">This wall has no panel photos yet, so only the 3D model is updated.</p>
    }

    <div class="refresh-starts">
        <section class="refresh-start" aria-labelledby="refresh-start-title">
            <h2 id="refresh-start-title">Update the wall</h2>
            <p class="hint">The old holds are looked for on the new photos. You check the result before anything is live.</p>
            @if (QualityChoice)
            {
                <div class="form-group">
                    <label for="refresh-splat-quality">Photo-real view quality (3D)</label>
                    <select id="refresh-splat-quality" class="form-input" value="@Quality" @onchange="SetQualityAsync">
                        <option value="@SplatQuality.Draft">Draft: fast, soft (minutes)</option>
                        <option value="@SplatQuality.High">High: sharp (about an hour on a laptop)</option>
                        <option value="@SplatQuality.Max">Max: sharpest, needs a strong GPU</option>
                        @if (ultraAvailable)
                        {
                            <option value="@SplatQuality.Ultra">Ultra: finest detail, on a 3D runner with a 12 GB NVIDIA GPU</option>
                        }
                    </select>
                </div>
            }
            <div class="refresh-actions">
                <button class="btn-primary" @onclick="StartAsync">@(View.CaptureAvailable ? "Start (panels + 3D)" : "Start")</button>
                @if (View.CaptureAvailable)
                {
                    <button class="btn-secondary" @onclick="StartPanelsOnlyAsync">@(View.HasActiveModel ? "Update panels only (keep the 3D model)" : "Update panels only (skip the 3D capture)")</button>
                }
            </div>
            @if (View.CaptureAvailable)
            {
                <details class="refresh-start-more">
                    <summary>What panels only does</summary>
                    @if (View.HasActiveModel)
                    {
                        <p class="hint">
                            Panels only starts no 3D capture and needs no GPU runner. The current 3D model stays as it is; the holds are
                            placed on it from the new photos in the background, and holds it cannot place stay 2D-only.
                        </p>
                    }
                    else
                    {
                        <p class="hint">
                            This wall has no 3D model yet. Panels only starts no 3D capture, so the wall stays 2D until you capture it.
                        </p>
                    }
                </details>
            }
        </section>

        @if (View.Revision is { } revision && View.Picks.Count > 0)
        {
            @* Rare and destructive: one closed line under the way to start, never a card of equal weight beside it. *@
            <details class="refresh-revision-more">
            <summary>The wall was fully reset (every hold taken off)?</summary>
            <section class="refresh-start refresh-revision" aria-labelledby="refresh-revision-title">
                <h2 id="refresh-revision-title">The wall was fully reset</h2>
                <p class="hint">
                    Only when every hold was taken off and the wall was set again. Nothing is matched or carried over:
                    <strong>@revision.Holds</strong> @(revision.Holds == 1 ? "hold is" : "holds are") replaced by a fresh detection and
                    <strong>@revision.Boulders</strong> @(revision.Boulders == 1 ? "boulder is" : "boulders are") archived.
                </p>
                @if (PanelsKeepingPhoto is { Count: > 0 } keeping)
                {
                    <p class="refresh-revision-blocked" role="note">
                        Starting over needs a new photo for every panel. Still keeping its photo: @string.Join(", ", keeping).
                    </p>
                }
                else
                {
                    <div class="refresh-actions">
                        <ConfirmAction Label="@(View.CaptureAvailable ? "Start over (panels + 3D)" : "Start over")" TriggerClass="btn-danger"
                                       Question="@RevisionQuestion(revision)" RequiredText="@revision.WallName" ConfirmLabel="Start over"
                                       OnConfirm="StartOverAsync" />
                        @if (View.CaptureAvailable)
                        {
                            <ConfirmAction Label="Start over, panels only" TriggerClass="btn-secondary"
                                           Question="@RevisionQuestion(revision)" RequiredText="@revision.WallName" ConfirmLabel="Start over"
                                           OnConfirm="StartOverPanelsOnlyAsync" />
                        }
                    </div>
                }
                <details class="refresh-start-more">
                    <summary>What starting over does</summary>
                    <ul class="refresh-summary">
                        <li>Starting over does not look for the old holds on the new photos</li>
                        <li>Archived boulders stay in the archive with their sends and can still be opened on the old photo</li>
                        <li>No hold is left to look over as "not found again"</li>
                        <li>You see a summary first, and nothing changes until you apply it. Once applied, it cannot be undone from the app</li>
                    </ul>
                </details>
            </section>
            </details>
        }
    </div>
</div>
