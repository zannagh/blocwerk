@* A collapsed settings card whose body is built the first time it is opened. Every panel inside a wall's settings
   cards loads its own data, and they all used to load (twice: prerender, then interactive) on every visit to the wall,
   although the cards start closed and most visits never open one. Opening is the native <details> toggle, so a click,
   the keyboard and a script setting .open (reveal-section.js) all build it; closing keeps it built.

   Reveals: ids of anchors inside the body (space-separated), so reveal-section.js can open this card before the
   anchor exists. Eager: build the body now (a flow opened from elsewhere lives inside it). *@
<details class="@Class" id="@Id" data-reveal="@Reveals" @ontoggle="OnToggle">
    <summary class="settings-card-summary"><h2>@Title</h2></summary>
    <div class="settings-card-body">
        @if (opened || Eager)
        {
            @ChildContent
        }
    </div>
</details>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Class { get; set; } = "settings-panel settings-card";
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Reveals { get; set; }
    [Parameter] public bool Eager { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool opened;

    private void OnToggle()
    {
        opened = true;
    }
}
