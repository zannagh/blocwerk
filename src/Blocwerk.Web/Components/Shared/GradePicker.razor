@using Blocwerk.Core.Helpers

<div class="grade-picker">
    <div class="scale-toggle">
        <button class="scale-btn @(_useFont ? string.Empty : "active")" @onclick="() => SetScale(false)">V Scale</button>
        <button class="scale-btn @(_useFont ? "active" : string.Empty)" @onclick="() => SetScale(true)">Font</button>
    </div>
    <select class="grade-select" value="@Value" @onchange="OnGradeChanged">
        <option value="">No grade</option>
        @foreach (var grade in _useFont ? GradeScale.FontGrades : GradeScale.VGrades)
        {
            <option value="@grade">@grade</option>
        }
    </select>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// The scale the picker opens on when the value has none of its own (empty, or not a known grade): true
    /// seeds the Fontainebleau scale, false the V-Scale. Only the initial seed — once the user taps the V/Font
    /// toggle their choice sticks. When null (the default) the picker keeps its built-in default.
    /// </summary>
    [Parameter] public bool? DefaultUseFont { get; set; }

    private bool _useFont;

    protected override void OnInitialized()
    {
        // Seed once: the scale the current grade is written in, so an existing "6B" opens on Font with 6B
        // selected rather than on the V-Scale with nothing selected (the boulder page's inline editor passed
        // no DefaultUseFont and showed exactly that). Only an empty or unknown grade falls back to the
        // caller's preferred scale. Runs only on first init, so a later SetScale interaction is never
        // overwritten by a parent re-render.
        _useFont = GradeScale.IsFont(Value) ?? DefaultUseFont ?? _useFont;
    }

    private void SetScale(bool font)
    {
        if (_useFont == font) return;
        _useFont = font;

        if (!string.IsNullOrEmpty(Value))
        {
            var converted = font ? GradeScale.ToFont(Value) : GradeScale.ToV(Value);
            if (converted != null)
            {
                Value = converted;
                ValueChanged.InvokeAsync(Value);
            }
        }
    }

    private async Task OnGradeChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        Value = string.IsNullOrEmpty(val) ? null : val;
        await ValueChanged.InvokeAsync(Value);
    }
}

