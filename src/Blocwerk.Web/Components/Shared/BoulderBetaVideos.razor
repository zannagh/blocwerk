@inject IBetaVideoService VideoService
@inject Blocwerk.Core.Configuration.BlocwerkSettings Settings
@inject IJSRuntime JS
@implements IDisposable

@*
    The "Beta Videos" strip on the boulder page: a horizontally scrolling row of poster frames with
    the uploader's name under each, opening a full-screen player on tap. The first tile is the
    upload button, so the empty state is already the call to action and needs no separate copy.

    Uploads stream straight to the /api/beta-videos HTTP endpoint (not the SignalR circuit and not
    the offline queue): a clip has no business sitting in IndexedDB waiting for a network, and the
    circuit's message cap cannot carry a large file. Offline, the section simply cannot accept an
    upload — the rest of the page still works.
*@

<details class="beta-section" open="@(StartExpanded || _videos is { Count: > 0 })">
    <summary class="beta-summary">
        <span class="beta-title">Beta Videos</span>
        @if (_videos is { Count: > 0 })
        {
            <span class="beta-count">@_videos.Count</span>
        }
    </summary>

    <div class="beta-body">
        <div class="beta-strip">
            @if (!IsAnonymous)
            {
                @* The input is nested rather than wired up with `for`: both together makes some
                   browsers open the file picker twice. The id is still needed — beta-video.js
                   looks the element up to read the selected file for the poster frame. *@
                <label class="beta-tile beta-add @(_uploading ? "busy" : string.Empty)">
                    <span class="beta-add-mark">@(_uploading ? "…" : "+")</span>
                    <InputFile id="@_inputId" OnChange="OnVideoSelected" accept="video/*"
                               disabled="@_uploading" class="beta-file-input" />
                    <span class="beta-uploader">@UploadLabel</span>
                </label>
            }

            @foreach (var video in _videos ?? [])
            {
                @* A wrapper (not a nested button) so the uploader's delete affordance can sit over the
                   tile without producing invalid <button>-inside-<button> markup. *@
                <div class="beta-tile-wrap" style="position: relative; flex: none; scroll-snap-align: start;">
                    <button type="button" class="beta-tile" @onclick="() => OpenVideo(video)"
                            title="@($"Beta by {video.UploaderName}")">
                        <span class="beta-thumb">
                            @if (video.HasThumbnail)
                            {
                                <img src="@ThumbnailUrl(video)" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="beta-thumb-fallback" aria-hidden="true"></span>
                            }
                            <span class="beta-play" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                                    <path d="M8 5v14l11-7z" />
                                </svg>
                            </span>
                        </span>
                        <span class="beta-uploader">@video.UploaderName</span>
                    </button>
                    @if (!IsAnonymous && video.UploadedByUserId == CurrentUserId)
                    {
                        <button type="button" title="Delete beta" aria-label="Delete beta"
                                @onclick="() => ConfirmDeleteAsync(video)" @onclick:stopPropagation="true"
                                style="position: absolute; top: 6px; right: 6px; width: 24px; height: 24px;
                                       display: grid; place-items: center; padding: 0; border: none;
                                       border-radius: 50%; background: rgba(0, 0, 0, 0.55); color: #fff;
                                       font-size: 1rem; line-height: 1; cursor: pointer;">&times;</button>
                    }
                </div>
            }

            @if (_videos is { Count: 0 } && IsAnonymous)
            {
                <p class="empty-msg">No beta videos yet.</p>
            }
        </div>

        @if (_error != null)
        {
            <div class="error-msg">@_error</div>
        }
    </div>
</details>

@if (_playing != null)
{
    <div class="beta-lightbox" @onclick="Close">
        @* stopPropagation so a tap on the player itself does not count as "tap the backdrop to close" *@
        <div class="beta-lightbox-inner" @onclick:stopPropagation="true">
            <div class="beta-lightbox-bar">
                <span class="beta-lightbox-title">Beta by @_playing.UploaderName</span>
                @if (!IsAnonymous && _playing.UploadedByUserId == CurrentUserId)
                {
                    <button type="button" class="beta-lightbox-delete" @onclick="DeleteCurrentAsync">Delete</button>
                }
                <button type="button" class="beta-lightbox-close" @onclick="Close" aria-label="Close">&times;</button>
            </div>
            <video @ref="_playerRef" class="beta-player" src="@VideoUrl(_playing)" controls playsinline
                   preload="metadata"></video>
        </div>
    </div>
}

@code {
    [Parameter] public Guid BoulderId { get; set; }

    [Parameter] public Guid CurrentUserId { get; set; }

    [Parameter] public bool IsAnonymous { get; set; }

    /// <summary>The wall share token when this page is being viewed through a share link.</summary>
    [Parameter] public string? ShareToken { get; set; }

    /// <summary>Whether the section starts expanded. Collapsed by default: beta is a spoiler.</summary>
    [Parameter] public bool StartExpanded { get; set; }

    /// <summary>Raised after a successful upload so the page can refresh its activity feed.</summary>
    [Parameter] public EventCallback Uploaded { get; set; }

    private readonly string _inputId = $"bw-beta-file-{Guid.NewGuid():N}";

    private List<BetaVideoInfo>? _videos;
    private BetaVideoInfo? _playing;
    private ElementReference _playerRef;
    private DotNetObjectReference<BoulderBetaVideos>? _selfRef;
    private bool _autoplayPending;
    private bool _uploading;
    private int _uploadPercent;
    private bool _processing;
    private string? _error;

    private string UploadLabel =>
        !_uploading ? "Add beta"
        : _processing ? "Optimising…"
        : _uploadPercent > 0 ? $"Uploading {_uploadPercent}%"
        : "Uploading…";

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>Re-reads the list. Called by the boulder page after the offline queue flushed.</summary>
    public Task ReloadAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_autoplayPending)
        {
            return;
        }

        // Only once the <video> is actually in the DOM, i.e. the render after OpenVideo() ran.
        _autoplayPending = false;
        try
        {
            await JS.InvokeVoidAsync("blocwerkBetaVideo.play", _playerRef);
        }
        catch (JSException)
        {
            // The controls are right there; a refused autoplay is not worth a message.
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            // The share-token query (restricted to the wall's share token, drafts excluded) is
            // ONLY for genuinely anonymous viewers. An authenticated user must always use the
            // normal query — otherwise a stray/stale ShareToken in the URL (enhanced-nav retains
            // route params, and the last-page cookie can restore a /shared/ link) silently routes
            // the owner through the anonymous filter and returns an empty list.
            _videos = IsAnonymous && !string.IsNullOrEmpty(ShareToken)
                ? await VideoService.GetVideosByShareTokenAsync(BoulderId, ShareToken)
                : await LoadForSignedInViewerAsync();
            _error = null;
        }
        catch (Exception ex)
        {
            // Same stance as the activity feed: a section that cannot load must not take the
            // ascent buttons above it down with it.
            _error = $"Beta videos could not be loaded: {ex.Message}";
            _videos ??= [];
        }
    }

    private async Task OnVideoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _error = null;

        var opts = Settings.BetaVideo;
        if (file.Size > opts.MaxUploadBytes)
        {
            _error = $"That clip is too large (max {opts.MaxUploadBytes / (1024L * 1024 * 1024)} GB).";
            return;
        }

        _uploading = true;
        _processing = false;
        _uploadPercent = 0;
        StateHasChanged();

        try
        {
            // Stream the file straight to the upload endpoint over HTTP (not the circuit): the JS
            // side reads it off the input, attaches a poster frame, and re-encodes happen server-side.
            _selfRef ??= DotNetObjectReference.Create(this);
            var url = $"/api/beta-videos/{BoulderId}";
            // The whole upload + server-side transcode runs inside this single JS interop call. Blazor's
            // default interop timeout is 1 minute, so any clip slower than that was cancelled mid-upload
            // and surfaced as "A task was canceled". Give this call a generous budget (the browser XHR
            // carries a slightly shorter timeout so a genuine stall reports a clearer message first).
            using var cts = new System.Threading.CancellationTokenSource(TimeSpan.FromMinutes(16));
            var result = await JS.InvokeAsync<UploadResult>("blocwerkBetaVideo.upload", cts.Token, _inputId, url, _selfRef, 480);

            if (result.Ok)
            {
                await LoadAsync();
                await Uploaded.InvokeAsync();
            }
            else
            {
                _error = $"Upload failed: {result.Error}";
            }
        }
        catch (Exception ex)
        {
            _error = $"Upload failed: {ex.Message}";
        }
        finally
        {
            _uploading = false;
            _processing = false;
        }
    }

    /// <summary>Called from beta-video.js as the file streams up, then once more when the server starts transcoding.</summary>
    [JSInvokable]
    public Task OnUploadProgress(int percent, string phase)
    {
        _uploadPercent = percent;
        _processing = phase == "processing";
        StateHasChanged();
        return Task.CompletedTask;
    }

    public void Dispose() => _selfRef?.Dispose();

    private record UploadResult(bool Ok, string? Error);

    private void OpenVideo(BetaVideoInfo video)
    {
        _playing = video;
        _autoplayPending = true;
    }

    private void Close()
    {
        _playing = null;
        _autoplayPending = false;
    }

    /// <summary>Player-overlay delete: the clip is already open, so remove it without a second prompt.</summary>
    private Task DeleteCurrentAsync() =>
        _playing is { } video ? DeleteVideoAsync(video) : Task.CompletedTask;

    /// <summary>Tile delete: asks first, since the tile can be tapped without opening the clip.</summary>
    private async Task ConfirmDeleteAsync(BetaVideoInfo video)
    {
        bool confirmed;
        try
        {
            confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this beta video?");
        }
        catch (JSException)
        {
            // If confirm is unavailable for any reason, fall through — the service still gates on
            // ownership, so a mis-fire cannot delete someone else's clip.
            confirmed = true;
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        if (confirmed)
        {
            await DeleteVideoAsync(video);
        }
    }

    private async Task DeleteVideoAsync(BetaVideoInfo video)
    {
        try
        {
            await VideoService.DeleteVideoAsync(video.Id);
            if (_playing?.Id == video.Id)
            {
                Close();
            }

            // Reload rather than a local remove so a concurrently uploaded/deleted clip is reflected
            // too, then notify the parent so its count and activity feed refresh.
            await ReloadAsync();
            await Uploaded.InvokeAsync();
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"That beta video could not be deleted: {ex.Message}";
        }
    }

    /// <summary>
    /// The normal list is gated on membership of the boulder's wall. A SIGNED-IN viewer who is not
    /// a member is still a legitimate share-link visitor (they count as non-anonymous the moment
    /// they have an account), and for them that list is empty — so fall back to the share list,
    /// which is what the byte URLs below already do unconditionally when a token is present. The
    /// member path stays first so a stale token in the URL never costs a member their own list.
    /// </summary>
    private async Task<List<BetaVideoInfo>> LoadForSignedInViewerAsync()
    {
        var videos = await VideoService.GetVideosAsync(BoulderId);
        if (videos.Count > 0 || string.IsNullOrEmpty(ShareToken))
        {
            return videos;
        }

        return await VideoService.GetVideosByShareTokenAsync(BoulderId, ShareToken);
    }

    private string VideoUrl(BetaVideoInfo video) => WithToken($"/api/beta-videos/{video.Id}");

    private string ThumbnailUrl(BetaVideoInfo video) => WithToken($"/api/beta-videos/{video.Id}/thumbnail");

    private string WithToken(string url) =>
        string.IsNullOrEmpty(ShareToken) ? url : $"{url}?token={Uri.EscapeDataString(ShareToken)}";
}
