@* Wall-settings sub-section (inside the admin "Hold outlines" block): the 3D model's volumes (WallVolumeList:
   flat sides, hide, remove) and "Find holds from all photos" with its review list — accept creates the hold on its panel,
   reject is remembered. Hidden on a kiosk tablet and behind a share link; the services refuse both anyway. *@
@using Blocwerk.Core.Holds

@if (!Hidden)
{
    @* Independent of the proposals below: their list failing must not hide the volumes. *@
    <WallVolumeList WallId="WallId" ShareToken="@ShareToken" />
}

@if (!Hidden && loaded)
{
    <h4 class="glyph-subheading">Holds seen in the 3D photos</h4>
    <p class="hint">
        Looks for holds in every photo of the 3D capture and lists the ones seen from several angles that are not on
        any wall photo yet (e.g. under volumes). Nothing is added until you accept it.
    </p>
    <div class="staged-actions">
        <button class="btn-secondary" @onclick="StartSearchAsync" disabled="@(busy || Searching)">Find holds from all photos</button>
    </div>

    @if (search is { Active: true } running)
    {
        @* A background job: the proposal buttons below stay usable while it runs, and it survives leaving the page. *@
        <p class="loading-small" role="status">@SearchText(running)</p>
        @if (running.Total > 0)
        {
            <progress max="@running.Total" value="@running.Done" aria-label="Photos searched"></progress>
        }
    }
    else if (SearchOutcome(search) is { } outcome)
    {
        <p class="@(search!.State == Blocwerk.Core.Jobs.JobStates.Succeeded ? "glyph-ok" : "field-error")" role="status">@outcome</p>
    }

    @if (failure is not null)
    {
        <p class="field-error" role="alert">@failure</p>
    }
    else if (message is not null)
    {
        <p class="glyph-ok" role="status">@message</p>
    }

    @if (proposals.Count > 0)
    {
        <p class="glyph-summary" role="status">@PlainCopy.Plural(proposals.Count, "possible new hold") to review@(proposals.Count > shown ? $", showing the first {shown}" : string.Empty).</p>
        <div class="proposal-grid">
            @foreach (var p in proposals.Take(shown))
            {
                <div class="proposal-card">
                    @if (crops.TryGetValue(p.Id, out var src))
                    {
                        <img src="@src" alt="Proposed hold" width="180" height="180" loading="lazy" />
                    }
                    <p class="glyph-summary" title="Surface @p.FacetId">@ProposalText(p)</p>
                    <a class="btn-link" href="@SpotOf(p).Url(WallId)">Show on wall</a>
                    @if (p.IsStale)
                    {
                        <p class="hint">Found on a panel photo that has since been replaced. Run "Find holds from all photos" again to add it.</p>
                    }
                    else if (p.PanelId is not null)
                    {
                        <select @bind="colors[p.Id]" disabled="@busy" aria-label="Colour of the new hold">
                            <option value="">No colour</option>
                            @foreach (var c in HoldPalette.All)
                            {
                                <option value="@c.Key">@c.DisplayName</option>
                            }
                        </select>
                        <button class="btn-primary" @onclick="() => AcceptAsync(p)" disabled="@busy">Add hold</button>
                    }
                    else
                    {
                        <p class="hint">Only seen in 3D, not on a wall photo: add it by hand if it is new.</p>
                    }
                    <button class="btn-secondary" @onclick="() => RejectAsync(p)" disabled="@busy">Not a new hold</button>
                </div>
            }
        </div>
        @if (proposals.Count > shown)
        {
            <div class="staged-actions">
                <button class="btn-secondary" @onclick="() => shown += PageSize">Show more (@(proposals.Count - shown) left)</button>
            </div>
        }
    }
}
