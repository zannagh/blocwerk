@inject IJSRuntime JS

@*
    Background visibility control for surfaces that draw holds over the wall photo.

    The state lives entirely in JS + localStorage (blocwerkWallDim), written to a CSS
    custom property on <html>, so dragging the slider costs zero server round-trips
    and survives Blazor re-renders. The handlers are plain HTML attributes on purpose
    — they must not become Blazor event callbacks.
*@
<div class="wall-dim-bar" title="Dim the wall photo so the boulder stands out">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
    <input type="range" min="0" max="100" step="5" value="0"
           aria-label="Wall photo dim"
           oninput="window.blocwerkWallDim.setDim(this.value)" />
    <button type="button" class="wall-dim-focus"
            title="Focus mode: strongly dim and desaturate the photo, thicken hold outlines"
            onclick="window.blocwerkWallDim.toggleFocus()">Focus</button>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("blocwerkWallDim.hydrate");
        }
    }
}
