@* Phase 1 of the big-wall update: carrying the old curated holds onto the new centre photo.
   Colour-coded before/after overview, a live summary, focused review steppers, and direct editing
   of the new image. EVERY old hold is carried by default; the matcher only suggests mappings, so a
   matcher miss never loses a boulder. See CarryoverReview.razor.cs. *@

@if (_loading)
{
    <p class="loading-small">Loading your holds…</p>
}
else if (_reviewMode is { } mode)
{
    @* The staged add / resize / delete path is THIS component's (see CarryoverReview.Tools.cs), so the
       stepper gets it as callbacks rather than injecting IWallPanelService a second time — which also
       keeps the deliberate needsReview:true default in one place. *@
    <CarryoverStepper WallId="WallId" CenterPanelId="CenterPanelId" Mode="mode"
                      Items="ReviewItems" OldHolds="_oldHolds" NewHolds="_newHolds"
                      OnCarryDecision="ApplyCarryDecision" OnNewDecision="ApplyNewDecision"
                      ReviewedNote="ReviewedNoteFor" OnClose="CloseReview"
                      AddStagedHold="AddNewHoldAsync"
                      OnHoldGeometryChanged="OnNewHoldGeometryChanged"
                      OnDeleteHold="RemoveNewHoldAsync" />
}
else if (_crossGenOpen)
{
    <CrossGenLinkTool WallId="WallId" CenterPanelId="CenterPanelId"
                      OldHolds="_oldHolds" NewHolds="_newHolds"
                      Links="CrossGenLinks()" AttentionOldIds="_crossGenQueue"
                      OnLink="LinkCrossGen" OnUnlink="UnlinkCrossGen"
                      OnAdvance="AdvanceToChangedReview" OnClose="CloseCrossGen"
                      AddStagedHold="AddNewHoldAsync"
                      OnHoldGeometryChanged="OnNewHoldGeometryChanged"
                      OnDeleteHold="RemoveNewHoldAsync" />
}
else
{
    <div class="bigupdate-phase">
        @if (AutoMatchDegraded)
        {
            <div class="bigupdate-banner" role="status">
                <strong>Automatic matching unavailable — map changed holds manually.</strong>
                <span>Every old hold is already carried in place; edit the new image and mark
                      changed holds yourself.</span>
                @if (!string.IsNullOrWhiteSpace(Session.AutoMatchMessage))
                {
                    <span class="bigupdate-banner-detail">@Session.AutoMatchMessage</span>
                }
            </div>
        }

        @* Verdicts recorded against holds this pane cannot draw (an older build drew every panel's old
           holds on the centre photo). They were reset to "carry in place" so they cannot freeze a
           boulder unseen — said out loud, and not dismissable until the user acknowledges it. *@
        @if (ScopeResetCount > 0)
        {
            <div class="bigupdate-banner" role="alert">
                <strong>@ScopeResetCount earlier hold decision(s) were reset to "carry in place".</strong>
                <span>
                    They were recorded against holds on other re-photographed panels, which this step
                    cannot show — so you could neither see nor undo them here. Left as they were, a
                    "remove" among them would have retired real boulders to history without appearing
                    anywhere on this screen. Every one of those holds is now simply carried over.
                </span>
                @if (!_scopeResetsAcknowledged)
                {
                    <button class="btn-secondary" @onclick="AcknowledgeScopeResetsAsync">I understand</button>
                }
            </div>
        }

        @* Attention-focused headline: the matcher auto-carried nearly everything, so surface only the
           few holds that need the user's eyes and frame the rest as done. *@
        <div class="bigupdate-attention @(NeedsReviewCount == 0 ? "clear" : "")" role="status">
            @if (NeedsReviewCount == 0)
            {
                <strong class="bigupdate-attention-head">Every one of your @TotalOldCount holds carried over cleanly.</strong>
                <span class="bigupdate-attention-sub">Nothing needs review — spot-check if you like, then continue.</span>
            }
            else
            {
                <strong class="bigupdate-attention-head">@NeedsReviewCount of @TotalOldCount holds need your review.</strong>
                <span class="bigupdate-attention-sub">
                    The other @AutoCarriedCount carried over automatically (green) — leave them be.@(ReviewedCount > 0 ? $" {ReviewedCount} already reviewed." : "")
                </span>
            }
        </div>

        @* Reviewed holds leave every queue — that is what makes the counts above shrink as the work is
           done, and what stops a second admin re-reviewing the first one's decisions. The toggle LISTS
           them so a mis-click can be found; un-reviewing, not the toggle, is what puts one back in a
           queue, so neither the counts above nor an open stepper move when it flips. *@
        @if (ReviewedListCount > 0 || _showReviewed)
        {
            <div class="bigupdate-reviewed">
                <div class="bigupdate-reviewed-head">
                    <button class="btn-secondary" @onclick="ToggleShowReviewedAsync">
                        @(_showReviewed ? $"Hide reviewed holds ({ReviewedListCount})" : $"Show reviewed holds ({ReviewedListCount})")
                    </button>
                    <span class="hint">
                        Holds you (or another wall admin) have already signed off are hidden from the
                        review queues. Reviews by someone else appear when this page is loaded or
                        refreshed — they do not arrive while you work.
                    </span>
                </div>

                @if (_showReviewed)
                {
                    <ul class="bigupdate-reviewed-list">
                        @foreach (var reviewedId in ReviewedOldIds)
                        {
                            <li class="bigupdate-reviewed-row">
                                <span class="bigupdate-reviewed-hold">@HoldLabel(reviewedId)</span>
                                <span class="hint">@ReviewedLabel(reviewedId)</span>
                                <button class="btn-secondary" @onclick="() => UnReviewAsync(reviewedId)"
                                        title="Put this hold back in the review queues; its decision is unchanged">
                                    Un-review
                                </button>
                            </li>
                        }
                    </ul>
                    <p class="hint">
                        Un-reviewing puts the hold back in the queues. Its carry decision itself stays
                        exactly as it is. A row labelled "Hold on another panel" was signed off against a
                        co-updated panel this step cannot draw — un-review it here if it looks wrong.
                    </p>
                }
            </div>
        }

        <div class="bigupdate-primary-actions">
            <button class="btn-primary" @onclick="OpenCrossGen">
                Confirm matches side-by-side@(NeedsReviewCount > 0 ? $" ({NeedsReviewCount})" : "")
            </button>
            <button class="btn-secondary" @onclick="() => OpenReview(CarryReviewMode.Uncertain)" disabled="@(NeedsReviewCount == 0)">
                Review changed &amp; moved (@NeedsReviewCount)
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_saveError))
        {
            <p class="staged-hint danger">@_saveError</p>
        }

        <div class="bigupdate-summary">
            <span class="bigupdate-chip carry">Carrying @CarryingCount</span>
            <span class="bigupdate-chip changed">@ChangedCount changed</span>
            <span class="bigupdate-chip remove">@RemovingCount removing</span>
            <span class="bigupdate-chip new">@NewCount new</span>
        </div>

        <div class="panel-stepper-pair">
            <PanelImageView WallId="WallId" Caption="Old wall (before)"
                            PhotoUrl="@OldPhotoUrl"
                            Holds="_oldHolds" HoldColors="OldColors()" />
            <PanelImageView WallId="WallId" Caption="New centre (after)"
                            PhotoUrl="@($"/api/walls/{WallId}/panels/{CenterPanelId}/staged-photo")"
                            Holds="_newHolds" HoldColors="NewColors()"
                            Editable="true" AddMode="@_touchup.AddMode"
                            SelectedHoldId="_touchup.SelectedHoldId"
                            ExactHitTargets="@_touchup.DeleteMode"
                            DragToMove="@_touchup.MoveMode"
                            OnHoldTap="OnNewHoldTapAsync"
                            OnEmptyTap="OnNewEmptyTap"
                            OnHoldGeometryChanged="OnNewHoldGeometryChanged" />
        </div>

        <div class="bigupdate-edit-tools">
            <span class="hint">
                Fix the new photo: pick <strong>+</strong> to add a missed hold, the <strong>pipette</strong> to copy
                an existing hold's size onto the ones you add next, or the <strong>bin</strong> to delete a false
                detection. Pick the <strong>move</strong> tool to drag holds into place; the <strong>size slider</strong>
                resizes the selected hold.
            </span>
            <HoldTouchupToolbar Tool="_touchup.Tool" ToolChanged="SetTool"
                                Size="_touchup.Radius" SizeChanged="OnSizeChanged"
                                OnSizeCommitted="OnSizeCommittedAsync"
                                HasSelection="@(_touchup.SelectedHoldId is not null)" />
        </div>

        <div class="bigupdate-legend">
            <span><i class="bigupdate-dot" style="background:var(--status-success)"></i> carried</span>
            <span><i class="bigupdate-dot" style="background:var(--status-warning)"></i> changed / kept blind</span>
            <span><i class="bigupdate-dot" style="background:var(--status-danger)"></i> removing</span>
            <span><i class="bigupdate-dot" style="background:var(--status-info)"></i> new hold</span>
        </div>

        <p class="hint">
            The clear carries and new holds are kept automatically. Review only what needs a decision — a
            hold is never removed unless you say so.
        </p>

        <details class="bigupdate-more-review">
            <summary>More review options</summary>
            <div class="bigupdate-review-actions">
                <button class="btn-secondary" @onclick="() => OpenReview(CarryReviewMode.Carried)" disabled="@(CarriedToReview == 0)">
                    Walk every carried hold (@CarriedToReview)
                </button>
                <button class="btn-secondary" @onclick="() => OpenReview(CarryReviewMode.Removal)" disabled="@(RemovalToReview == 0)">
                    Review couldn't-re-find (@RemovalToReview)
                </button>
                <button class="btn-secondary" @onclick="() => OpenReview(CarryReviewMode.New)" disabled="@(NewToReview == 0)">
                    Spot-check new (@NewToReview)
                </button>
            </div>
        </details>

        <div class="staged-actions">
            <button class="btn-primary" @onclick="Continue" disabled="@ScopeResetsPending">Continue to overlaps →</button>
            <button class="btn-danger-soft" @onclick="() => OnDiscard.InvokeAsync()">Discard update</button>
        </div>
    </div>
}
