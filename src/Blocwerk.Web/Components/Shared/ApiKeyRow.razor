@* One personal API key in the listing, including its two-step revoke confirmation. *@

<div class="apikey-row @StateClass">
    <div class="apikey-row-main">
        <span class="apikey-name">
            @Key.Name
            @if (Key.Scope == ApiKeyScope.Kiosk)
            {
                <span class="apikey-scope kiosk">Kiosk</span>
            }
        </span>
        <code class="apikey-prefix">@Key.Prefix&hellip;</code>
        <span class="apikey-meta">
            Created <LocalTime Value="@Key.CreatedAt" Format="LocalTimeFormat.DateDmy" />
            &middot; Last used <LocalTime Value="@Key.LastUsedAt" Format="LocalTimeFormat.DateDmy" NullText="never" />
            &middot;
            @if (Key.ExpiresAt is { } expiresAt)
            {
                <text>@ExpiryWord </text>
                <LocalTime Value="@expiresAt" Format="LocalTimeFormat.DateDmy" />
            }
            else
            {
                <text>no expiry</text>
            }
        </span>
    </div>

    @if (ShowAnonymousSetting && Key.Scope == ApiKeyScope.Kiosk)
    {
        <div class="apikey-row-option">
            <label class="apikey-option-label">
                <input type="checkbox" @key="anonymousRenderNonce" disabled="@Busy"
                       checked="@Key.AllowAnonymousKioskSetting" @onchange="ToggleAnonymousSetting" />
                <span>Allow anonymous setting from this tablet</span>
            </label>
            <p class="hint">
                Has no effect unless the wall's own "anonymous setting" is switched on &mdash; this
                only narrows it, so you can exclude a single tablet.
            </p>
        </div>
    }

    <div class="apikey-row-actions">
        @if (StateLabel != null)
        {
            <span class="apikey-state">@StateLabel</span>
        }
        else if (confirming)
        {
            <span class="apikey-confirm-text">Revoke for good?</span>
            <button type="button" class="apikey-btn danger" disabled="@Busy" @onclick="Confirm">Yes, revoke</button>
            <button type="button" class="apikey-btn" disabled="@Busy" @onclick="() => confirming = false">Cancel</button>
        }
        else
        {
            <button type="button" class="apikey-btn" disabled="@Busy" @onclick="() => confirming = true">Revoke</button>
        }
    </div>
</div>

@code {
    private bool confirming;

    [Parameter]
    [EditorRequired]
    public required ApiKey Key { get; set; }

    /// <summary>Blocks the buttons while the page is talking to the service.</summary>
    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback<Guid> OnRevoke { get; set; }

    /// <summary>
    /// Shows the per-tablet anonymous-setting checkbox. Only the wall panel sets it, and only kiosk
    /// keys render it: the flag means nothing on a wall or personal key.
    /// </summary>
    [Parameter]
    public bool ShowAnonymousSetting { get; set; }

    /// <summary>Raised with the key's id and the requested state when the checkbox is flipped.</summary>
    [Parameter]
    public EventCallback<(Guid KeyId, bool Allowed)> OnAnonymousSettingChanged { get; set; }

    private bool IsRevoked => Key.RevokedAt.HasValue;

    private bool IsExpired => !IsRevoked && Key.ExpiresAt is { } e && e <= DateTimeOffset.UtcNow;

    private string? StateLabel
    {
        get
        {
            if (IsRevoked)
            {
                return "Revoked";
            }

            if (IsExpired)
            {
                return "Expired";
            }

            return null;
        }
    }

    private string StateClass
    {
        get
        {
            if (IsRevoked)
            {
                return "revoked";
            }

            if (IsExpired)
            {
                return "expired";
            }

            return "active";
        }
    }

    /// <summary>The word before the expiry date: past expiries read "Expired", future ones "Expires".
    /// Only chooses the word; the date itself is localized client-side by the LocalTime component.</summary>
    private string ExpiryWord => Key.ExpiresAt is { } expires && expires <= DateTimeOffset.UtcNow ? "Expired" : "Expires";

    /// <summary>
    /// Bumped after every toggle attempt so the checkbox is a NEW element in the next render tree.
    /// </summary>
    /// <remarks>
    /// The checkbox is bound one way, from <see cref="ApiKey.AllowAnonymousKioskSetting"/> only. When
    /// the write fails, the reloaded row still carries the old value, Blazor diffs an UNCHANGED
    /// <c>checked</c> attribute and emits no DOM update at all — so the browser would keep showing
    /// the user's click on a permission the server never granted, and in the permissive direction.
    /// Changing the element's key makes the diff discard and recreate the input from the reloaded
    /// row instead of comparing attributes, so what is rendered is always what the database says.
    /// </remarks>
    private int anonymousRenderNonce;

    private async Task ToggleAnonymousSetting(ChangeEventArgs args)
    {
        var allowed = args.Value is true;
        try
        {
            await OnAnonymousSettingChanged.InvokeAsync((Key.Id, allowed));
        }
        finally
        {
            // After the attempt, so the recreated element renders the state the parent just reloaded
            // — on the failure path that is the unchanged database value, not the click.
            anonymousRenderNonce++;
        }
    }

    private async Task Confirm()
    {
        confirming = false;
        await OnRevoke.InvokeAsync(Key.Id);
    }
}
