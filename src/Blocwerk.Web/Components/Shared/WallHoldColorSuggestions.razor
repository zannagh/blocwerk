@* Wall-settings section: "Suggest hold colours". The detector finds holds but not their colour; this proposes one for
   every live hold without a colour, from the panel photo it sits on, and leaves a hold alone when the photo does not
   say clearly. Holds that have a colour are never touched. One journal batch per run.
   Admin-only (rendered inside the admin card); hidden on a kiosk tablet and behind a share link. *@

@if (!Hidden && status is not null)
{
<div class="glyph-settings">
    <h3 class="glyph-heading">Suggest hold colours</h3>
    <p class="hint">
        Looks at each hold that has no colour on its panel photo and sets the colour when it is clear: yellow, red, pink,
        orange, blue, green, purple, white or black. Holds that are chalked over, between two colours, grey or wooden stay
        without a colour. Holds that already have a colour are not changed.
    </p>

    <p class="hint">
        @PlainCopy.Plural(status.WithoutColor, "hold") without a colour.
        @if (status.Proposed > 0)
        {
            <text> @PlainCopy.Plural(status.Proposed, "suggested colour") not confirmed yet: the hold editor marks them "Suggested".</text>
        }
    </p>

    <div class="staged-actions">
        <button class="btn-secondary" disabled="@(busy || status.WithoutColor == 0)" @onclick="SuggestAsync">@(busy ? "Working…" : "Suggest colours for holds without one")</button>
    </div>

    @if (failure is not null)
    {
        <p class="field-error" role="alert">@failure</p>
    }
    else if (message is not null)
    {
        <p class="glyph-ok" role="status">@message</p>
    }
</div>
}
