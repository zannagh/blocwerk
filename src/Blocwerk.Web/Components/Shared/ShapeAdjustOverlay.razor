@* Full-view overlay that opens the regular wall editor (WallPhotoEditor) on ONE staged hold, already in
   the shape tool and zoomed onto it, so adjusting a recognised outline uses the same editor as
   everywhere else. Save hands the outline back to the shape review; nothing is written to the hold.
   Save and Cancel live in a footer pinned to the bottom of the overlay, so they stay reachable on a
   phone however tall the editor gets (the editor's own batch bar is hidden here). The editor's toolbar
   stays on top: its phone dock is fixed to the viewport bottom and would sit over that footer.
   Its root class is on the keyboard dispatcher's takeover list (keyboard-shortcuts.js). *@

<div class="shape-adjust-overlay" role="dialog" aria-modal="true" aria-label="Adjust hold shape"
     tabindex="-1" @onkeydown="OnKeyDown">
    <div class="shape-adjust-head">
        <strong>Adjust the hold shape</strong>
        <p class="hint">Drag the white points onto the hold's edge; + and − add or remove points.</p>
    </div>
    <div class="shape-adjust-editor">
        <WallPhotoEditor WallId="WallId"
                         Holds="_holds"
                         BorderPoints="_noBorder"
                         PhotoUrlOverride="@PhotoUrl"
                         CanEdit="true"
                         BottomToolbar="false"
                         InitialShapeEditHoldId="Proposal.HoldId"
                         ResetToken="Proposal.HoldId"
                         OnBatchSave="OnBatchSave" />
    </div>
    <div class="shape-adjust-footer">
        <button class="btn-secondary shape-big-btn" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
        <button class="btn-primary shape-big-btn" @onclick="SaveAsync">Save shape</button>
    </div>
</div>

@code {
    private readonly List<ShapePoint> _noBorder = [];
    private List<Hold> _holds = [];
    private Guid? _builtFor;

    [Parameter] public Guid WallId { get; set; }

    [Parameter, EditorRequired] public ShapeProposalInfo Proposal { get; set; } = default!;

    [Parameter, EditorRequired] public string PhotoUrl { get; set; } = string.Empty;

    /// <summary>The adjusted outline, relative to the proposal's (X, Y).</summary>
    [Parameter] public EventCallback<List<ShapePoint>> OnSave { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    protected override void OnParametersSet()
    {
        if (_builtFor == Proposal.HoldId)
        {
            return;
        }

        // A detached stand-in for the staged hold, starting from the outline the reviewer is looking at.
        _builtFor = Proposal.HoldId;
        var start = Proposal.AdjustedShape ?? Proposal.Shape ?? Proposal.PreviousShape;
        _holds =
        [
            new Hold
            {
                Id = Proposal.HoldId,
                WallId = WallId,
                WallPanelId = Proposal.PanelId,
                X = Proposal.X,
                Y = Proposal.Y,
                Radius = Proposal.Radius,
                IsAutoDetected = true,
                ShapePoints = start?.Select(p => new ShapePoint { Dx = p.Dx, Dy = p.Dy }).ToList(),
            },
        ];
    }

    // The editor edits the stand-in hold in place, so its current outline is always on _holds[0].
    private Task OnBatchSave(WallPhotoEditor.BatchChanges changes) => SaveAsync();

    private async Task SaveAsync()
    {
        var hold = _holds.FirstOrDefault();
        if (hold?.ShapePoints is not { Count: >= 3 } shape)
        {
            await OnCancel.InvokeAsync();
            return;
        }

        // The editor may also have moved the hold; express the outline around the proposal's centre.
        var rebased = ShapeJson.Rebase(shape, hold.X, hold.Y, Proposal.X, Proposal.Y);
        await OnSave.InvokeAsync(rebased);
    }

    // Escape backs out without saving — it discards only this unsaved adjustment, never review work.
    private Task OnKeyDown(KeyboardEventArgs e) =>
        e.Key == "Escape" ? OnCancel.InvokeAsync() : Task.CompletedTask;
}
