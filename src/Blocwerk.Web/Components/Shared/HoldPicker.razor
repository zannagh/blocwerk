@inject IJSRuntime JS
@inject IWallService WallService
@implements IDisposable
@using Blocwerk.Core.Helpers

@* The viewport carries no zoom geometry: JS owns `--zoom` on the content element
   (see wwwroot/js/viewport.js and the `calc(var(--zoom, 1) * 100%)` CSS rules), so a
   server re-render can never stomp the transform mid-gesture. *@
@* Cursor as a CLASS, not an inline style: viewport.js writes inline styles on this element
   (touch-action, --fit-aspect, --crop-scale, aspect-ratio) and a Blazor-rendered style attribute
   is rewritten as a whole when it changes, wiping them and making the view pan on its own. *@
@* bw-stage-anchor is the positioning context for the floating full-screen button. *@
<div class="bw-stage-anchor">
<div class="picker-viewport @(_isPanning ? "bw-cursor-grab" : "bw-cursor-default")" @ref="_viewportRef"
     data-pan-mode="@(_isPanning ? "true" : "false")">

<div class="photo-picker" @ref="_photoPickerRef">
@PhotoLayers
</div>
</div>

@* The editor carries almost no chrome, which is exactly what makes it suit a full-screen takeover:
   the photo gets the whole screen and tapping holds still classifies them. Interactive="true" so a
   press that lands on a hold does not start a pan and the tap reaches Blazor. *@
<StageOpenButton OnOpen="() => _stageOpen = true" />
@if (_stageOpen)
{
    @* A SECOND render of the same fragment, not a move of the live nodes: the inline picker keeps
       its @ref and its zoom engine, and leaving the takeover leaves it exactly as it was.
       Escape only closes the takeover — the picked set is untouched by it. *@
    <StageOverlay @ref="_stage" Interactive="true" OnClose="() => _stageOpen = false"
                  Label="Pick holds in full screen"
                  ContentKey="@(PhotoUrl ?? WallId.ToString())">
        <ChildContent>
            @PhotoLayers
        </ChildContent>
        <Chrome>
            @PickerTools
        </Chrome>
    </StageOverlay>
}
</div>

@* The "+ Virtual" tool sits below the image; everything else classifies through a tap that opens
   the radial menu. *@
@PickerTools

@if (_overlayHold != null)
{
    <HoldClassifyOverlay Left="_overlayX" Top="_overlayY" Current="OverlayCurrent"
                         Chosen="OnOverlayChosen" Remove="OnOverlayRemove" Cancel="CloseOverlay" OutsideTap="OnOverlayOutsideTap" />
}

@code {
    /// <summary>Whether the full-screen landscape takeover is up over the picker.</summary>
    private bool _stageOpen;

    private StageOverlay? _stage;

    /// <summary>
    /// The wall photo and the hold overlay, as one fragment, so the inline picker and the
    /// full-screen takeover draw exactly the same thing — handlers included — from one piece of
    /// markup. Only the inline wrapper is a `.photo-picker`; the takeover's world layer is not a
    /// `.photo-editor` either, so the magnifier lens never arms in there (it reads the image rect
    /// directly and cannot survive a rotated stage).
    /// </summary>
    private RenderFragment PhotoLayers => @<text>
        <img src="@ResponsiveImage.Initial(PhotoUrl ?? $"/api/walls/{WallId}/photo")" data-bw-res
             alt="Wall" class="wall-photo" />
        <svg class="hold-overlay" viewBox="0 0 100 100" preserveAspectRatio="none"
             @onclick="OnSvgClick"
             style="cursor: @(_placingVirtual ? "crosshair" : "default");">
            @* A base before what sits on it: the upper hold is drawn last, so it is the one a tap meets first. *@
            @foreach (var hold in HoldStackOrder.BackToFront(AllHolds, h => h.Id, h => h.StackedOnHoldId))
            {
                var selection = SelectedEntryFor(hold.Id);
                var isSelected = selection != null;
                @* A hold the last update did not find cannot be chosen: it is not drawn. The boulder being edited
                   keeps the ones it already uses, faded (the server refuses adding one as well). *@
                var kept = hold.KeptUnconfirmedGeneration is not null;
                if (kept && !isSelected)
                {
                    continue;
                }

                var isColorFoot = IsColorRuleFoot(hold);
                var fillColor = isSelected
                    ? BoulderHoldColors.FillFor(selection!.Type, selection.Usage)
                    : isColorFoot ? BoulderHoldColors.ColorRuleFill(0.45) : "rgba(255,255,255,0.15)";
                var strokeColor = isSelected
                    ? BoulderHoldColors.Stroke(selection!.Type)
                    : isColorFoot ? BoulderHoldColors.Foot : "rgba(255,255,255,0.4)";
                var sw = isSelected || isColorFoot ? "0.4" : "0.2";
                var dash = hold.IsVirtual ? "0.6 0.4" : string.Empty;
                if (hold.IsVirtual && !isSelected && !isColorFoot) { strokeColor = "#c86dff"; }
                @* A pre-selection the caller could only guess (Revise: no lineage, or the hold changed): an amber
                   dashed outline until the user re-classifies it, so it never passes for a sure pick. *@
                if (isSelected && GuessedHoldIds is not null && GuessedHoldIds.Contains(selection!.HoldId))
                {
                    strokeColor = "#ffb300";
                    sw = "0.6";
                    dash = "1.2 0.6";
                }
                var isFoot = hold.Category == HoldCategory.Foot;
                @* A hold that is not part of the boulder is not drawn: it stays in the overlay, transparent, as the
                   tap target it always was, and gets its outline with the tap (the layer below). A virtual hold is
                   the exception — it is not on the photo, so without its outline there is nothing to aim at. *@
                if (!isSelected && !isColorFoot && !hold.IsVirtual)
                {
                    fillColor = "transparent";
                    strokeColor = "transparent";
                }

                <HoldShape @key="hold.Id" HoldId="hold.Id" X="hold.X" Y="hold.Y" Radius="hold.Radius" ShapePoints="hold.ShapePoints.AsDocumentRing()" ShapeHoles="hold.ShapeHoles.AsDocumentRings()"
                           Foot="isFoot" Fill="@fillColor" Stroke="@strokeColor" StrokeWidth="@sw" Dash="@dash" Kept="kept"
                           Style="cursor: pointer"
                           OnClick="(e) => OnHoldClicked(hold, e)" />
            }
        </svg>
        @if (_overlayHold is { } tapped)
        {
            @* The hold just tapped, outlined so it is plain which one the role menu next to it is about. *@
            <svg class="hold-tap-layer" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                @if (BaseOf(tapped) is { } lower)
                {
                    @* The hold it sits on, subdued: a second tap on the same spot picks that one. *@
                    <HoldShine @key="lower.Id" Look="base" X="lower.X" Y="lower.Y" Radius="lower.Radius"
                               ShapePoints="lower.ShapePoints.AsDocumentRing()" ShapeHoles="lower.ShapeHoles.AsDocumentRings()"
                               Foot="lower.Category == HoldCategory.Foot" Color="@TappedColor(lower)" />
                }
                <HoldShine @key="tapped.Id" X="tapped.X" Y="tapped.Y" Radius="tapped.Radius"
                           ShapePoints="tapped.ShapePoints.AsDocumentRing()" ShapeHoles="tapped.ShapeHoles.AsDocumentRings()"
                           Foot="tapped.Category == HoldCategory.Foot" Color="@TappedColor(tapped)" />
            </svg>
        }
    </text>;

    /// <summary>
    /// The picker's only chrome. Rendered below the image normally, and inside the takeover's
    /// rotated stage while that is up, so "+ Virtual" stays reachable in full screen.
    /// </summary>
    private RenderFragment PickerTools => @<div class="radial-controls">
        <span class="pick-count">@SelectedHolds.Count selected</span>
        <button class="mode-btn @(_placingVirtual ? "active" : string.Empty)"
                @onclick="() => _placingVirtual = !_placingVirtual"
                title="Add a virtual hold at a spot that isn't in the wall photo yet. Tap it afterwards to classify it.">
            + Virtual
        </button>
    </div>;

    [Parameter] public Guid WallId { get; set; }

    /// <summary>
    /// The background photo behind the holds. When null (the single-image default) the picker falls
    /// back to the wall's centre photo endpoint. Multi-image callers pass a specific panel's photo
    /// (<c>/api/walls/{WallId}/panels/{panelId}/photo</c>) so the holds — which are stored in that
    /// panel's own normalized image space — land in the right spot.
    /// </summary>
    [Parameter] public string? PhotoUrl { get; set; }

    /// <summary>
    /// The big-wall panel currently shown (the one <see cref="PhotoUrl"/> points at), or null on a
    /// single-image wall. A virtual hold placed here is stamped with it, so it is stored in that
    /// panel's coordinate space AND knows which photo it belongs to.
    /// </summary>
    [Parameter] public Guid? PanelId { get; set; }

    [Parameter] public List<Hold> AllHolds { get; set; } = [];
    [Parameter] public List<BoulderHoldInput> SelectedHolds { get; set; } = [];
    [Parameter] public EventCallback<List<BoulderHoldInput>> SelectedHoldsChanged { get; set; }
    [Parameter] public int WallAngle { get; set; }

    /// <summary>
    /// Cross-panel twin map for a multi-image wall: each hold id → the OTHER hold ids that are the same
    /// physical hold seen on other panels (its <see cref="Blocwerk.Core.Entities.HoldLink"/> connected
    /// component, minus itself). Null / empty on a single-image wall, where selection is a plain per-hold
    /// lookup. Used only for display and dedupe — <see cref="SelectedHolds"/> still carries at most one
    /// entry per physical hold, so the count and Publish label never inflate.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<Guid, IReadOnlyList<Guid>>? HoldTwins { get; set; }

    /// <summary>
    /// Selected holds the caller only guessed (the Revise editor's position fallback, or a hold its lineage says
    /// changed). Drawn with an amber dashed outline; null or empty draws every selection the same.
    /// </summary>
    [Parameter] public IReadOnlySet<Guid>? GuessedHoldIds { get; set; }

    /// <summary>
    /// The boulder's "hands follow feet" rule. While it is on the picker offers no
    /// foot-only tool, because the server coerces such marks away.
    /// </summary>
    [Parameter] public bool HandsFollowFeet { get; set; } = true;

    /// <summary>
    /// The boulder's "feet of one colour only" rule; every wall hold of that colour is
    /// drawn as a foothold even when it is not one of the boulder's own holds.
    /// </summary>
    [Parameter] public string? FootColorOnly { get; set; }

    private ElementReference _viewportRef;
    private ElementReference _photoPickerRef;
    private readonly ViewportZoomState _zoomState;
    private readonly HoldType _placeType = HoldType.Normal;
    private HoldUsage _placeUsage = HoldUsage.HandAndFoot;
    private bool _isPanning;
    private bool _placingVirtual;

    // Radial classify overlay state. Positioned at the tapped hold's on-screen
    // pixel via the click's client coordinates, so it lives outside the zoomed viewport and never
    // scales with pinch zoom.
    /// <summary>A tap this close (px) to the one that opened the menu is "the same spot again".</summary>
    private const double SameSpotPx = 24;

    private Hold? _overlayHold;

    // Where the tap that opened the menu landed (viewport pixels).
    private double tapX;
    private double tapY;
    private double _overlayX;
    private double _overlayY;

    public HoldPicker()
    {
        _zoomState = new ViewportZoomState(() => InvokeAsync(StateHasChanged));
    }

    protected override void OnParametersSet()
    {
        // The rules block can flip the rule while "Foot only" is the active tool.
        if (HandsFollowFeet && _placeUsage == HoldUsage.FootOnly)
        {
            _placeUsage = HoldUsage.HandAndFoot;
        }
    }

    /// <summary>The usage a tap may actually produce under the current rules.</summary>
    private HoldUsage EffectiveUsage =>
        HandsFollowFeet && _placeUsage == HoldUsage.FootOnly ? HoldUsage.HandAndFoot : _placeUsage;

    private bool IsColorRuleFoot(Hold hold) =>
        !string.IsNullOrEmpty(FootColorOnly) && hold.Color == FootColorOnly;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("bwViewport.setupScroll", _viewportRef, _zoomState.Reference);
            }
            catch (JSException)
            {
                // Stale element reference after a re-render/reconnect: the picker still works,
                // it just isn't zoom-enabled. Never let it become an unhandled circuit error.
            }
            catch (JSDisconnectedException)
            {
                // Circuit went away mid-call; nothing to attach to.
            }
        }
    }

    public void Dispose() => _zoomState.Dispose();

    private async Task OnSvgClick(MouseEventArgs e)
    {
        if (!_placingVirtual || _isPanning) return;
        // While the full-screen takeover is up, the tap landed on ITS copy of the photo, not on the
        // inline picker behind it — so the box to normalise against is the takeover's world layer.
        // getRelativePosition itself is rotation-aware (wall-editor.js): under the CSS fallback the
        // stage carries data-bw-rot="90" and it maps through the quarter turn instead of the
        // identity. Everything else on the page is unrotated and keeps the identity mapping.
        var box = _stageOpen && _stage is not null ? _stage.WorldElement : _photoPickerRef;
        var pos = await JS.InvokeAsync<RelativePos>("wallEditor.getRelativePosition", box, e.ClientX, e.ClientY);
        var usage = EffectiveUsage;
        var cat = usage == HoldUsage.FootOnly ? HoldCategory.Foot : HoldCategory.Hand;
        var hold = await WallService.AddHoldAsync(
            WallId,
            Math.Clamp(pos.X, 0, 1),
            Math.Clamp(pos.Y, 0, 1),
            0.02,
            color: null,
            category: cat,
            shapePoints: null,
            isVirtual: true,
            wallPanelId: PanelId);
        AllHolds.Add(hold);
        SelectedHolds.Add(new BoulderHoldInput(hold.Id, _placeType, usage));
        await SelectedHoldsChanged.InvokeAsync(SelectedHolds);
        StateHasChanged();
    }

    private record RelativePos(double X, double Y);

    /// <summary>
    /// A tap on a hold outlines it and opens the radial classify overlay NEXT TO it (under it when there is room),
    /// so the hold stays in view and it is plain which one was hit. Without the browser's answer the overlay falls
    /// back to the tap point.
    /// </summary>
    private Task OnHoldClicked(Hold hold, MouseEventArgs e)
    {
        (tapX, tapY) = (e.ClientX, e.ClientY);
        return OpenOverlayAsync(hold, e);
    }

    /// <summary>
    /// A tap outside the menu closes it. On the spot of the tap that opened it, and with the tapped hold sitting on
    /// another one, it goes one hold down instead: the upper hold first, then the hold under it.
    /// </summary>
    private async Task OnOverlayOutsideTap(MouseEventArgs e)
    {
        var tapped = _overlayHold;
        _overlayHold = null;
        var sameSpot = Math.Abs(e.ClientX - tapX) <= SameSpotPx && Math.Abs(e.ClientY - tapY) <= SameSpotPx;
        if (tapped is not null && sameSpot && BaseOf(tapped) is { } lower)
        {
            await OpenOverlayAsync(lower, e);
        }
    }

    /// <summary>The hold a hold sits on, when the picker shows it (one the last update did not find only on this boulder).</summary>
    private Hold? BaseOf(Hold hold) =>
        hold.StackedOnHoldId is { } id && AllHolds.FirstOrDefault(h => h.Id == id) is { } lower
        && (lower.KeptUnconfirmedGeneration is null || SelectedEntryFor(lower.Id) is not null)
            ? lower
            : null;

    private async Task OpenOverlayAsync(Hold hold, MouseEventArgs e)
    {
        var spot = new RelativePos(e.ClientX, e.ClientY);
        try
        {
            var box = _stageOpen && _stage is not null ? _stage.WorldElement : _photoPickerRef;
            spot = await JS.InvokeAsync<RelativePos>(
                "bwHoldDial.spot", box, hold.Id, SelectedEntryFor(hold.Id) is not null, e.ClientX, e.ClientY);
        }
        catch (JSException)
        {
            // Placement is a nicety; the overlay still opens, on the tap point.
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        _overlayHold = hold;
        _overlayX = spot.X;
        _overlayY = spot.Y;
    }

    /// <summary>The tapped hold's outline colour: its role colour once it is in the boulder, else its own colour.</summary>
    private string TappedColor(Hold hold)
    {
        if (SelectedEntryFor(hold.Id) is { } selection)
        {
            return BoulderHoldColors.Stroke(selection.Type);
        }

        return string.IsNullOrEmpty(hold.Color) ? "var(--accent)" : HoldPalette.Hex(hold.Color);
    }


    /// <summary>The quadrant the overlay's hold currently sits in, or null when it isn't set.</summary>
    private RadialQuadrant? OverlayCurrent
    {
        get
        {
            if (_overlayHold == null)
            {
                return null;
            }

            var sel = SelectedEntryFor(_overlayHold.Id);
            if (sel == null)
            {
                return null;
            }

            if (sel.Usage == HoldUsage.FootOnly)
            {
                return RadialQuadrant.Foot;
            }

            return sel.Type switch
            {
                HoldType.Top => RadialQuadrant.Top,
                HoldType.Start => RadialQuadrant.Start,
                _ => RadialQuadrant.Middle,
            };
        }
    }

    private void CloseOverlay()
    {
        _overlayHold = null;
    }

    /// <summary>
    /// Applies a radial choice: adds the hold with the chosen classification, or re-classifies it if
    /// it is already in the boulder, then closes. Hand holds (Top/Start/Middle) carry HandAndFoot so
    /// they implicitly serve as feet; Foot is a dedicated FootOnly foothold. Removal is a separate
    /// action (the bin ring), so a quadrant tap never removes.
    /// </summary>
    private async Task OnOverlayChosen(RadialQuadrant quadrant)
    {
        var hold = _overlayHold;
        _overlayHold = null;
        if (hold == null)
        {
            return;
        }

        // Drop any prior entry for this physical hold — its own, or a linked twin's on another panel —
        // so exactly one entry survives, carried under the TAPPED hold's id.
        RemoveEntriesFor(hold.Id);

        var (type, usage) = MapQuadrant(quadrant);
        SelectedHolds.Add(new BoulderHoldInput(hold.Id, type, usage));
        await SelectedHoldsChanged.InvokeAsync(SelectedHolds);
    }

    /// <summary>Removes the overlay's hold from the boulder (the bin ring), then closes.</summary>
    private async Task OnOverlayRemove()
    {
        var hold = _overlayHold;
        _overlayHold = null;
        if (hold == null)
        {
            return;
        }

        if (RemoveEntriesFor(hold.Id))
        {
            await SelectedHoldsChanged.InvokeAsync(SelectedHolds);
        }
    }

    /// <summary>
    /// The selection entry that makes <paramref name="holdId"/> read as selected: its own entry when
    /// present, otherwise — on a multi-image wall — the entry of any linked twin (the same physical hold
    /// seen on another panel). Twin-aware so a hold picked on one panel draws selected, with the twin's
    /// Type/Usage, on the panel its twin lives on. Null when neither the hold nor any twin is selected.
    /// On a single-image wall (<see cref="HoldTwins"/> null) this is exactly the direct lookup.
    /// </summary>
    private BoulderHoldInput? SelectedEntryFor(Guid holdId)
    {
        var direct = SelectedHolds.FirstOrDefault(s => s.HoldId == holdId);
        if (direct != null)
        {
            return direct;
        }

        if (HoldTwins != null && HoldTwins.TryGetValue(holdId, out var twins))
        {
            return twins
                .Select(twinId => SelectedHolds.FirstOrDefault(s => s.HoldId == twinId))
                .FirstOrDefault(twin => twin != null);
        }

        return null;
    }

    /// <summary>
    /// Removes the selection entry for <paramref name="holdId"/> — its own, and any linked twin's on
    /// another panel — preserving the invariant of at most one entry per physical hold. Returns whether
    /// anything was removed. On a single-image wall this removes only the direct entry.
    /// </summary>
    private bool RemoveEntriesFor(Guid holdId)
    {
        var removed = SelectedHolds.RemoveAll(s => s.HoldId == holdId) > 0;
        if (HoldTwins != null && HoldTwins.TryGetValue(holdId, out var twins))
        {
            foreach (var twinId in twins)
            {
                if (SelectedHolds.RemoveAll(s => s.HoldId == twinId) > 0)
                {
                    removed = true;
                }
            }
        }

        return removed;
    }

    private static (HoldType Type, HoldUsage Usage) MapQuadrant(RadialQuadrant quadrant) => quadrant switch
    {
        RadialQuadrant.Top => (HoldType.Top, HoldUsage.HandAndFoot),
        RadialQuadrant.Start => (HoldType.Start, HoldUsage.HandAndFoot),
        RadialQuadrant.Foot => (HoldType.Normal, HoldUsage.FootOnly),
        _ => (HoldType.Normal, HoldUsage.HandAndFoot),
    };

}

