@inject IJSRuntime JS
@inject IWallService WallService
@inject IWallSegmentService WallSegmentService
@implements IDisposable
@using Blocwerk.Core.Helpers
@using Blocwerk.Core.Geometry

<WallDimControl />

@* The viewport carries no zoom geometry: JS owns `--zoom` on the content element
   (see wwwroot/js/viewport.js and the `calc(var(--zoom, 1) * 100%)` CSS rules), so a
   server re-render can never stomp the transform mid-gesture. *@
<div class="picker-viewport" @ref="_viewportRef"
     data-pan-mode="@(_isPanning ? "true" : "false")"
     style="cursor: @(_isPanning ? "grab" : "default");">

@if (_viewMode == ViewMode.Photo)
{
    <div class="photo-picker" @ref="_photoPickerRef">
        <img src="@ResponsiveImage.Initial(PhotoUrl ?? $"/api/walls/{WallId}/photo")" data-bw-res
             alt="Wall" class="wall-photo" />
        <svg class="hold-overlay" viewBox="0 0 100 100" preserveAspectRatio="none"
             @onclick="OnSvgClick"
             style="cursor: @(_placingVirtual ? "crosshair" : "default");">
            @foreach (var hold in AllHolds)
            {
                var selection = SelectedEntryFor(hold.Id);
                var isSelected = selection != null;
                var isColorFoot = IsColorRuleFoot(hold);
                var fillColor = isSelected
                    ? BoulderHoldColors.FillFor(selection!.Type, selection.Usage)
                    : isColorFoot ? BoulderHoldColors.ColorRuleFill(0.45) : "rgba(255,255,255,0.15)";
                var strokeColor = isSelected
                    ? BoulderHoldColors.Stroke(selection!.Type)
                    : isColorFoot ? BoulderHoldColors.Foot : "rgba(255,255,255,0.4)";
                var sw = isSelected || isColorFoot ? "0.4" : "0.2";
                var dash = hold.IsVirtual ? "0.6 0.4" : string.Empty;
                if (hold.IsVirtual && !isSelected && !isColorFoot) { strokeColor = "#c86dff"; }
                var isFoot = hold.Category == HoldCategory.Foot;
                var r = (isFoot ? hold.Radius * 0.7 : hold.Radius) * 100;

                @if (hold.ShapePoints is { Count: >= 3 })
                {
                    <polygon @key="hold.Id" points="@Pts(hold.ShapePoints.Select(sp => (hold.X + sp.Dx, hold.Y + sp.Dy)))"
                             fill="@fillColor" stroke="@strokeColor" stroke-width="@sw" stroke-dasharray="@dash"
                             style="cursor: pointer"
                             @onclick="(e) => OnHoldClicked(hold, e)" @onclick:stopPropagation="true" />
                }
                else if (isFoot)
                {
                    <rect @key="hold.Id" x="@F((hold.X - r/100)*100)" y="@F((hold.Y - r/100)*100)"
                          width="@F(r*2/100*100)" height="@F(r*2/100*100)" rx="0.3"
                          fill="@fillColor" stroke="@strokeColor" stroke-width="@sw" stroke-dasharray="@dash"
                          style="cursor: pointer"
                          @onclick="(e) => OnHoldClicked(hold, e)" @onclick:stopPropagation="true" />
                }
                else
                {
                    <circle @key="hold.Id" cx="@F(hold.X * 100)" cy="@F(hold.Y * 100)" r="@F(r)"
                            fill="@fillColor" stroke="@strokeColor" stroke-width="@sw" stroke-dasharray="@dash"
                            style="cursor: pointer"
                            @onclick="(e) => OnHoldClicked(hold, e)" @onclick:stopPropagation="true" />
                }
            }
        </svg>
    </div>
}
else
{
    <div class="schematic-picker">
        <svg viewBox="0 0 100 100" class="schematic-svg" xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="0" width="100" height="100" style="fill: var(--wall-bg)" rx="1" />
            <line x1="0" y1="100" x2="100" y2="100" style="stroke: var(--wall-floor)" stroke-width="0.5" />

            @foreach (var hold in AllHolds)
            {
                var selection = SelectedEntryFor(hold.Id);
                var isSelected = selection != null;
                var isColorFoot = IsColorRuleFoot(hold);
                var fillColor = isSelected
                    ? BoulderHoldColors.FillFor(selection!.Type, selection.Usage)
                    : isColorFoot ? BoulderHoldColors.ColorRuleFill(0.5) : HoldPalette.Fill(hold.Color, 0.4);
                var strokeColor = isSelected
                    ? BoulderHoldColors.Stroke(selection!.Type)
                    : isColorFoot ? BoulderHoldColors.Foot : HoldPalette.StrokeHex(hold.Color);
                var sw = isSelected || isColorFoot ? "0.6" : "0.3";
                var dash = hold.IsVirtual ? "0.8 0.5" : string.Empty;
                if (hold.IsVirtual && !isSelected && !isColorFoot) { strokeColor = "#c86dff"; }
                var isFoot = hold.Category == HoldCategory.Foot;
                var r = (isFoot ? hold.Radius * 0.7 : hold.Radius) * 100;
                var p = hold.IsOnKickboard ? new SchematicPoint(hold.X, hold.Y) : _layout.Project(hold.X, hold.Y);

                @if (isFoot)
                {
                    <rect @key="hold.Id" x="@F(p.X * 100 - r)" y="@F(p.Y * 100 - r)" width="@F(r * 2)" height="@F(r * 2)"
                          rx="0.3" fill="@fillColor" stroke="@strokeColor" stroke-width="@sw" stroke-dasharray="@dash"
                          style="cursor: pointer" @onclick="() => ToggleHold(hold)" />
                }
                else
                {
                    <circle @key="hold.Id" cx="@F(p.X * 100)" cy="@F(p.Y * 100)" r="@F(r)"
                            fill="@fillColor" stroke="@strokeColor" stroke-width="@sw" stroke-dasharray="@dash"
                            style="cursor: pointer" @onclick="() => ToggleHold(hold)" />
                }
            }
        </svg>
    </div>
}
</div>

@* The "+ Virtual" tool sits below the image; everything else classifies through a tap that opens
   the radial menu. *@
<div class="radial-controls">
    <span class="pick-count">@SelectedHolds.Count selected</span>
    <button class="mode-btn @(_placingVirtual ? "active" : string.Empty)"
            @onclick="() => _placingVirtual = !_placingVirtual"
            title="Add a virtual hold at a spot that isn't in the wall photo yet. Tap it afterwards to classify it.">
        + Virtual
    </button>
</div>

@if (_overlayHold != null)
{
    <HoldClassifyOverlay Left="_overlayX" Top="_overlayY" Current="OverlayCurrent"
                         Chosen="OnOverlayChosen" Remove="OnOverlayRemove" Cancel="CloseOverlay" />
}

@code {
    [Parameter] public Guid WallId { get; set; }

    /// <summary>
    /// The background photo behind the holds. When null (the single-image default) the picker falls
    /// back to the wall's centre photo endpoint. Multi-image callers pass a specific panel's photo
    /// (<c>/api/walls/{WallId}/panels/{panelId}/photo</c>) so the holds — which are stored in that
    /// panel's own normalized image space — land in the right spot.
    /// </summary>
    [Parameter] public string? PhotoUrl { get; set; }

    [Parameter] public List<Hold> AllHolds { get; set; } = [];
    [Parameter] public List<BoulderHoldInput> SelectedHolds { get; set; } = [];
    [Parameter] public EventCallback<List<BoulderHoldInput>> SelectedHoldsChanged { get; set; }
    [Parameter] public int WallAngle { get; set; }

    /// <summary>
    /// Cross-panel twin map for a multi-image wall: each hold id → the OTHER hold ids that are the same
    /// physical hold seen on other panels (its <see cref="Blocwerk.Core.Entities.HoldLink"/> connected
    /// component, minus itself). Null / empty on a single-image wall, where selection is a plain per-hold
    /// lookup. Used only for display and dedupe — <see cref="SelectedHolds"/> still carries at most one
    /// entry per physical hold, so the count and Publish label never inflate.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<Guid, IReadOnlyList<Guid>>? HoldTwins { get; set; }

    /// <summary>
    /// The boulder's "hands follow feet" rule. While it is on the picker offers no
    /// foot-only tool, because the server coerces such marks away.
    /// </summary>
    [Parameter] public bool HandsFollowFeet { get; set; } = true;

    /// <summary>
    /// The boulder's "feet of one colour only" rule; every wall hold of that colour is
    /// drawn as a foothold even when it is not one of the boulder's own holds.
    /// </summary>
    [Parameter] public string? FootColorOnly { get; set; }

    /// <summary>The wall's segments; loaded from the id when the caller doesn't supply them.</summary>
    [Parameter] public List<WallSegment>? Segments { get; set; }

    private List<WallSegment>? _loaded;
    private List<WallSegment> _segments = [];
    private WallSchematicLayout _layout = WallProjection.BuildLayout(null, 0);

    private ElementReference _viewportRef;
    private ElementReference _photoPickerRef;
    private readonly ViewportZoomState _zoomState;
    private readonly HoldType _placeType = HoldType.Normal;
    private HoldUsage _placeUsage = HoldUsage.HandAndFoot;
    private readonly ViewMode _viewMode = ViewMode.Photo;
    private bool _isPanning;
    private bool _placingVirtual;

    // Radial classify overlay state. Positioned at the tapped hold's on-screen
    // pixel via the click's client coordinates, so it lives outside the zoomed viewport and never
    // scales with pinch zoom.
    private Hold? _overlayHold;
    private double _overlayX;
    private double _overlayY;

    private enum ViewMode { Photo, Schematic }

    public HoldPicker()
    {
        _zoomState = new ViewportZoomState(() => InvokeAsync(StateHasChanged));
    }

    protected override void OnParametersSet()
    {
        // The rules block can flip the rule while "Foot only" is the active tool.
        if (HandsFollowFeet && _placeUsage == HoldUsage.FootOnly)
        {
            _placeUsage = HoldUsage.HandAndFoot;
        }

        // The parent re-renders on every hold toggle (SelectedHolds is two-way bound), so this runs
        // constantly during picking. The projection only depends on the segments and wall angle, so
        // rebuild it only when those actually change (self-loaded _loaded flips from null once the
        // async segment load completes, which this picks up via the reference check).
        if (!_projectionBuilt
            || !ReferenceEquals(_lastSegments, Segments)
            || !ReferenceEquals(_lastLoaded, _loaded)
            || _lastWallAngle != WallAngle)
        {
            _lastSegments = Segments;
            _lastLoaded = _loaded;
            _lastWallAngle = WallAngle;
            _projectionBuilt = true;

            // _segments is the usable set for projection: caller-supplied, else self-loaded.
            _segments = (Segments ?? _loaded ?? [])
                .Where(s => s.Points.Count >= 3).OrderBy(s => s.SortOrder).ToList();

            // Build the fold once here; the map render loop then projects each hold through it.
            _layout = WallProjection.BuildLayout(_segments, WallAngle);
        }
    }

    private List<WallSegment>? _lastSegments;
    private List<WallSegment>? _lastLoaded;
    private int _lastWallAngle = int.MinValue;
    private bool _projectionBuilt;

    protected override async Task OnInitializedAsync()
    {
        // Failure to load segments must not break hold picking; the map then just falls
        // back to the single wall angle.
        if (Segments != null) { return; }
        try { _loaded = await WallSegmentService.GetSegmentsAsync(WallId); }
        catch (Exception) { _loaded = []; }
    }

    /// <summary>The usage a tap may actually produce under the current rules.</summary>
    private HoldUsage EffectiveUsage =>
        HandsFollowFeet && _placeUsage == HoldUsage.FootOnly ? HoldUsage.HandAndFoot : _placeUsage;

    private bool IsColorRuleFoot(Hold hold) =>
        !string.IsNullOrEmpty(FootColorOnly) && hold.Color == FootColorOnly;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("bwViewport.setupScroll", _viewportRef, _zoomState.Reference);
            }
            catch (JSException)
            {
                // Stale element reference after a re-render/reconnect: the picker still works,
                // it just isn't zoom-enabled. Never let it become an unhandled circuit error.
            }
            catch (JSDisconnectedException)
            {
                // Circuit went away mid-call; nothing to attach to.
            }
        }
    }

    public void Dispose() => _zoomState.Dispose();

    private async Task OnSvgClick(MouseEventArgs e)
    {
        if (!_placingVirtual || _isPanning) return;
        var pos = await JS.InvokeAsync<RelativePos>("wallEditor.getRelativePosition", _photoPickerRef, e.ClientX, e.ClientY);
        var usage = EffectiveUsage;
        var cat = usage == HoldUsage.FootOnly ? HoldCategory.Foot : HoldCategory.Hand;
        var hold = await WallService.AddHoldAsync(
            WallId,
            Math.Clamp(pos.X, 0, 1),
            Math.Clamp(pos.Y, 0, 1),
            0.02,
            color: null,
            category: cat,
            shapePoints: null,
            isVirtual: true);
        AllHolds.Add(hold);
        SelectedHolds.Add(new BoulderHoldInput(hold.Id, _placeType, usage));
        await SelectedHoldsChanged.InvokeAsync(SelectedHolds);
        StateHasChanged();
    }

    private record RelativePos(double X, double Y);

    /// <summary>A tap on a hold opens the radial classify overlay centred on the tap point.</summary>
    private void OnHoldClicked(Hold hold, MouseEventArgs e)
    {
        _overlayHold = hold;
        _overlayX = e.ClientX;
        _overlayY = e.ClientY;
    }

    /// <summary>The quadrant the overlay's hold currently sits in, or null when it isn't set.</summary>
    private RadialQuadrant? OverlayCurrent
    {
        get
        {
            if (_overlayHold == null)
            {
                return null;
            }

            var sel = SelectedEntryFor(_overlayHold.Id);
            if (sel == null)
            {
                return null;
            }

            if (sel.Usage == HoldUsage.FootOnly)
            {
                return RadialQuadrant.Foot;
            }

            return sel.Type switch
            {
                HoldType.Top => RadialQuadrant.Top,
                HoldType.Start => RadialQuadrant.Start,
                _ => RadialQuadrant.Middle,
            };
        }
    }

    private void CloseOverlay()
    {
        _overlayHold = null;
    }

    /// <summary>
    /// Applies a radial choice: adds the hold with the chosen classification, or re-classifies it if
    /// it is already in the boulder, then closes. Hand holds (Top/Start/Middle) carry HandAndFoot so
    /// they implicitly serve as feet; Foot is a dedicated FootOnly foothold. Removal is a separate
    /// action (the bin ring), so a quadrant tap never removes.
    /// </summary>
    private async Task OnOverlayChosen(RadialQuadrant quadrant)
    {
        var hold = _overlayHold;
        _overlayHold = null;
        if (hold == null)
        {
            return;
        }

        // Drop any prior entry for this physical hold — its own, or a linked twin's on another panel —
        // so exactly one entry survives, carried under the TAPPED hold's id.
        RemoveEntriesFor(hold.Id);

        var (type, usage) = MapQuadrant(quadrant);
        SelectedHolds.Add(new BoulderHoldInput(hold.Id, type, usage));
        await SelectedHoldsChanged.InvokeAsync(SelectedHolds);
    }

    /// <summary>Removes the overlay's hold from the boulder (the bin ring), then closes.</summary>
    private async Task OnOverlayRemove()
    {
        var hold = _overlayHold;
        _overlayHold = null;
        if (hold == null)
        {
            return;
        }

        if (RemoveEntriesFor(hold.Id))
        {
            await SelectedHoldsChanged.InvokeAsync(SelectedHolds);
        }
    }

    /// <summary>
    /// The selection entry that makes <paramref name="holdId"/> read as selected: its own entry when
    /// present, otherwise — on a multi-image wall — the entry of any linked twin (the same physical hold
    /// seen on another panel). Twin-aware so a hold picked on one panel draws selected, with the twin's
    /// Type/Usage, on the panel its twin lives on. Null when neither the hold nor any twin is selected.
    /// On a single-image wall (<see cref="HoldTwins"/> null) this is exactly the direct lookup.
    /// </summary>
    private BoulderHoldInput? SelectedEntryFor(Guid holdId)
    {
        var direct = SelectedHolds.FirstOrDefault(s => s.HoldId == holdId);
        if (direct != null)
        {
            return direct;
        }

        if (HoldTwins != null && HoldTwins.TryGetValue(holdId, out var twins))
        {
            return twins
                .Select(twinId => SelectedHolds.FirstOrDefault(s => s.HoldId == twinId))
                .FirstOrDefault(twin => twin != null);
        }

        return null;
    }

    /// <summary>
    /// Removes the selection entry for <paramref name="holdId"/> — its own, and any linked twin's on
    /// another panel — preserving the invariant of at most one entry per physical hold. Returns whether
    /// anything was removed. On a single-image wall this removes only the direct entry.
    /// </summary>
    private bool RemoveEntriesFor(Guid holdId)
    {
        var removed = SelectedHolds.RemoveAll(s => s.HoldId == holdId) > 0;
        if (HoldTwins != null && HoldTwins.TryGetValue(holdId, out var twins))
        {
            foreach (var twinId in twins)
            {
                if (SelectedHolds.RemoveAll(s => s.HoldId == twinId) > 0)
                {
                    removed = true;
                }
            }
        }

        return removed;
    }

    private static (HoldType Type, HoldUsage Usage) MapQuadrant(RadialQuadrant quadrant) => quadrant switch
    {
        RadialQuadrant.Top => (HoldType.Top, HoldUsage.HandAndFoot),
        RadialQuadrant.Start => (HoldType.Start, HoldUsage.HandAndFoot),
        RadialQuadrant.Foot => (HoldType.Normal, HoldUsage.FootOnly),
        _ => (HoldType.Normal, HoldUsage.HandAndFoot),
    };

    private void ToggleHold(Hold hold)
    {
        if (_isPanning) return;
        var usage = EffectiveUsage;
        var existing = SelectedEntryFor(hold.Id);
        if (existing != null)
        {
            // Re-tapping with the same tools deselects; with different tools it
            // reclassifies, so switching tool and tapping again changes the mark. The prior
            // entry may live under a linked twin's id, so clear the hold OR its twins first.
            RemoveEntriesFor(hold.Id);
            if (existing.Type != _placeType || existing.Usage != usage)
            {
                SelectedHolds.Add(new BoulderHoldInput(hold.Id, _placeType, usage));
            }
        }
        else { SelectedHolds.Add(new BoulderHoldInput(hold.Id, _placeType, usage)); }
        SelectedHoldsChanged.InvokeAsync(SelectedHolds);
    }

    private static string F(double v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    private static string Pts(IEnumerable<(double X, double Y)> pts) =>
        string.Join(" ", pts.Select(p => $"{F(p.X * 100)},{F(p.Y * 100)}"));
}

