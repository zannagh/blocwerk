@using Blocwerk.Core.Entities

@* The "tapped hold" outline, for a `svg.hold-tap-layer` (viewBox 0 0 100 100): the hold's own outline in
   its colour, slightly shiny — a soft glow, a dark casing, the colour and a thin light line (hold-tap.css).
   The server-rendered twin of what hold-tap.js draws on the wall view, so both look the same. Display only:
   it never takes a pointer event. *@

<g class="hold-shine" style="--hold-c: @Color" pointer-events="none">
    @foreach (var layer in Layers)
    {
        <g @key="layer" class="hold-shine-@layer">
            <HoldShape X="X" Y="Y" Radius="Radius" ShapePoints="ShapePoints" ShapeHoles="ShapeHoles"
                       Foot="Foot" FootScale="FootScale" Fill="none" PointerEvents="none" />
        </g>
    }
</g>

@code {
    private static readonly string[] Layers = ["glow", "case", "main", "light"];

    /// <summary>The hold's normalized centre X (0..1).</summary>
    [Parameter] public double X { get; set; }

    /// <summary>The hold's normalized centre Y (0..1).</summary>
    [Parameter] public double Y { get; set; }

    /// <summary>The hold's normalized radius (0..1).</summary>
    [Parameter] public double Radius { get; set; }

    /// <summary>The hold's outline as offsets from its centre, or null for the plain shape.</summary>
    [Parameter] public IReadOnlyList<ShapePoint>? ShapePoints { get; set; }

    /// <summary>The outline's holes (a pocket hold), or null.</summary>
    [Parameter] public IReadOnlyList<IReadOnlyList<ShapePoint>>? ShapeHoles { get; set; }

    /// <summary>Draw as a foothold (a rounded square), like <see cref="HoldShape.Foot"/>.</summary>
    [Parameter] public bool Foot { get; set; }

    /// <summary>The foot scale of the surface this sits on, so the outline matches the hold drawn there.</summary>
    [Parameter] public double FootScale { get; set; } = HoldShape.CompactFoot;

    /// <summary>The outline colour, any CSS colour.</summary>
    [Parameter] public string Color { get; set; } = "var(--accent)";
}
