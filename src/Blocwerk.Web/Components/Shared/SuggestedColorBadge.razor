@using System.Globalization
@using Blocwerk.Core.Entities
@using Blocwerk.Core.Holds
@* The wall editor's mark on a hold whose colour is only suggested (the detection read it from the photo and nobody
   has confirmed it): a small dot in that colour with a question mark, just outside the hold's lower right. Sized
   and placed by HoldBadgeGeometry so it shrinks with the zoom and never sits on the outline being edited;
   pointer-events off, so the hold under it stays tappable. "Keep" in the selected-hold bar confirms the colour and
   takes the mark off, and the editor's view toolbar can hide every mark at once. *@

@if (Shows(Hold))
{
    var br = HoldBadgeGeometry.Radius(Scale);
    var (dx, dy) = HoldBadgeGeometry.Offset(R, br, 1, 1);
    var cx = (Hold.X * 100) + dx;
    var cy = (Hold.Y * 100) + dy;
    <g pointer-events="none" data-hold="@Hold.Id" class="hold-suggested-color">
        <title>Suggested colour, not confirmed yet</title>
        <circle cx="@F(cx)" cy="@F(cy)" r="@F(br)" fill="@HoldPalette.StrokeHex(Hold.Color)" stroke="white" stroke-width="@F(br * 0.18)" />
        <text x="@F(cx)" y="@F(cy)" text-anchor="middle" dominant-baseline="central" font-size="@F(br * 1.45)" font-weight="700"
              fill="white" stroke="#1a1a1a" stroke-width="@F(br * 0.27)" paint-order="stroke">?</text>
    </g>
}

@code {
    [Parameter, EditorRequired]
    public Hold Hold { get; set; } = default!;

    /// <summary>The hold's radius in the overlay's 0..100 units.</summary>
    [Parameter]
    public double R { get; set; }

    /// <summary>The editor's handle scale (1 / zoom), so the mark keeps a constant on-screen size.</summary>
    [Parameter]
    public double Scale { get; set; } = 1.0;

    /// <summary>Whether a hold gets the mark: its colour is the detection's suggestion and nobody has set or confirmed it.</summary>
    /// <param name="hold">The hold.</param>
    /// <returns>True for a real hold with a suggested colour.</returns>
    public static bool Shows(Hold hold) => hold is { HasProposedColor: true, IsVirtual: false };

    private static string F(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
}
