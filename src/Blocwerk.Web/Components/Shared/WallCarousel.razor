@inject IJSRuntime JS
@inject KeyboardShortcutGate KeyGate
@implements IAsyncDisposable

<div class="wall-carousel-root @(Locked ? "editing" : string.Empty)">
    <div class="wall-carousel @(_initialized ? string.Empty : "carousel-pending")" @ref="_ref" @onscroll="OnScroll">
        @foreach (var (frag, idx) in Pages())
        {
            <div class="wall-page @(PageClass(idx))">
                @frag
            </div>
        }
    </div>
    <div class="carousel-dots">
        @for (var i = 0; i < _fragCount; i++)
        {
            var idx = i;
            <button type="button"
                    class="dot @(idx == _currentPage ? "active" : string.Empty)"
                    aria-label="@($"Page {idx + 1}")"
                    @onclick="() => GoTo(idx)"></button>
        }
    </div>
</div>

@code {
    [Parameter] public RenderFragment? Page1 { get; set; }
    [Parameter] public RenderFragment? Page2 { get; set; }
    [Parameter] public RenderFragment? Page3 { get; set; }
    [Parameter] public RenderFragment? Page4 { get; set; }
    [Parameter] public RenderFragment? Page5 { get; set; }
    [Parameter] public RenderFragment? Page6 { get; set; }
    [Parameter] public int InitialPage { get; set; } = 2;
    [Parameter] public bool Locked { get; set; }
    [Parameter] public string? PageClasses { get; set; }

    private ElementReference _ref;
    private int _currentPage;
    private bool _initialized;
    private int _fragCount;

    // The InitialPage value the carousel is actually sitting on. Only a CHANGE of the supplied value
    // repositions; ordinary re-renders (a toast, a reload, an edit) must never yank a user who has
    // swiped somewhere else back to the initial page.
    private int _appliedInitialPage;
    private bool _repositionPending;

    private KeyboardShortcutScope? _keys;

    private IEnumerable<(RenderFragment Fragment, int Index)> Pages()
    {
        var list = new List<RenderFragment?> { Page1, Page2, Page3, Page4, Page5, Page6 };
        var i = 0;
        foreach (var p in list)
        {
            if (p != null)
            {
                yield return (p, i);
                i++;
            }
        }
    }

    private string PageClass(int idx)
    {
        if (string.IsNullOrEmpty(PageClasses)) return string.Empty;
        var parts = PageClasses.Split('|');
        return idx < parts.Length ? parts[idx] : string.Empty;
    }

    protected override void OnParametersSet()
    {
        _fragCount = Pages().Count();
        if (_currentPage >= _fragCount) _currentPage = Math.Max(0, _fragCount - 1);

        // A navigation that only changes the query (?view=boulders) reuses this component instead of
        // recreating it, so the new deep-link target arrives as a changed parameter and nothing else
        // would move the scroll offset.
        if (_initialized && InitialPage != _appliedInitialPage)
        {
            _repositionPending = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _fragCount > 0)
        {
            _appliedInitialPage = InitialPage;
            _currentPage = Math.Clamp(InitialPage, 0, _fragCount - 1);
            // Position the scroll offset instantly while the carousel is still hidden
            // (.carousel-pending), so the first painted frame is already the target page — no
            // visible swipe from page 1. Revealing happens on the StateHasChanged re-render below.
            await JS.InvokeVoidAsync("wallCarousel.initPage", _ref, _currentPage);
            _initialized = true;
            // Registered after positioning so the first paint is never held up by an extra
            // round-trip. This scope lands low on the dispatcher stack: anything rendered inside a
            // pane (the panel viewer, the photo editor) registers later and therefore wins the
            // arrows while it is alive.
            await RegisterShortcutsAsync();
            StateHasChanged();
            return;
        }

        if (firstRender)
        {
            await RegisterShortcutsAsync();
        }

        if (_repositionPending)
        {
            _repositionPending = false;
            _appliedInitialPage = InitialPage;
            // Instant: this is a deep link resolving, not a swipe the user asked for.
            await GoToPageAsync(InitialPage, smooth: false);
        }
    }

    private async Task RegisterShortcutsAsync()
    {
        _keys = new KeyboardShortcutScope(JS, OnShortcutAsync, KeyGate);
        await _keys.RegisterAsync("ArrowLeft", "ArrowRight");
    }

    private async Task OnShortcutAsync(string key)
    {
        switch (key)
        {
            case "ArrowLeft":
                await PreviousAsync();
                break;
            case "ArrowRight":
                await NextAsync();
                break;
        }

        // The dispatcher callback arrives outside a Blazor UI event, so nothing would re-render the
        // dots on its own.
        StateHasChanged();
    }

    /// <summary>
    /// Moves one page forward. Mirrors the dot buttons, including their <see cref="Locked"/> guard.
    /// </summary>
    public async Task NextAsync()
    {
        await StepAsync(1);
    }

    /// <summary>
    /// Moves one page back. Mirrors the dot buttons, including their <see cref="Locked"/> guard.
    /// </summary>
    public async Task PreviousAsync()
    {
        await StepAsync(-1);
    }

    private async Task StepAsync(int delta)
    {
        // Locked is set while a pane is being edited: a stray arrow must not scroll the edit surface
        // out from under the user, exactly as a dot click must not.
        if (Locked || _fragCount == 0)
        {
            return;
        }

        var target = Math.Clamp(_currentPage + delta, 0, _fragCount - 1);
        if (target == _currentPage)
        {
            return;
        }

        await GoToPageAsync(target);
    }

    private async Task GoTo(int idx)
    {
        if (Locked)
        {
            return;
        }

        SetCurrentPage(idx);
        await JS.InvokeVoidAsync("wallCarousel.scrollToPage", _ref, idx, true);
    }

    public async Task GoToPageAsync(int idx, bool smooth = true)
    {
        var clamped = Math.Clamp(idx, 0, Math.Max(0, _fragCount - 1));
        SetCurrentPage(clamped);
        await JS.InvokeVoidAsync("wallCarousel.scrollToPage", _ref, clamped, smooth);
        StateHasChanged();
    }

    private void SetCurrentPage(int idx)
    {
        _currentPage = idx;
    }

    private bool _scrollQuerying;

    private async Task OnScroll()
    {
        // Scroll events fire dozens of times a second during a swipe, and each one here is a SignalR
        // interop round-trip. Coalesce them: while one currentPage query is in flight, drop further
        // scroll events instead of queuing a round-trip (and a re-render) per frame.
        if (!_initialized || _scrollQuerying) return;
        _scrollQuerying = true;
        try
        {
            var frag = await JS.InvokeAsync<int>("wallCarousel.currentPage", _ref);
            if (frag != _currentPage)
            {
                SetCurrentPage(frag);
                StateHasChanged();
            }
        }
        finally
        {
            _scrollQuerying = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_keys is not null)
        {
            await _keys.DisposeAsync();
            _keys = null;
        }
    }
}
