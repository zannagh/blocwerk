@inject IJSRuntime JS
@inject KeyboardShortcutGate KeyGate
@inject ILogger<WallCarousel> Logger
@implements IAsyncDisposable

<div class="wall-carousel-root @(Locked ? "editing" : string.Empty)">
    <div class="wall-carousel @(_initialized ? string.Empty : "carousel-pending")" @ref="_ref">
        @foreach (var (frag, idx) in Pages())
        {
            <div class="wall-page @(PageClass(idx))">
                @frag
            </div>
        }
    </div>
    <div class="carousel-dots">
        @for (var i = 0; i < _fragCount; i++)
        {
            var idx = i;
            <button type="button"
                    class="dot @(idx == _currentPage ? "active" : string.Empty)"
                    aria-label="@($"Page {idx + 1}")"
                    @onclick="() => GoTo(idx)"></button>
        }
    </div>
</div>

@code {
    [Parameter] public RenderFragment? Page1 { get; set; }
    [Parameter] public RenderFragment? Page2 { get; set; }
    [Parameter] public RenderFragment? Page3 { get; set; }
    [Parameter] public RenderFragment? Page4 { get; set; }
    [Parameter] public RenderFragment? Page5 { get; set; }
    [Parameter] public RenderFragment? Page6 { get; set; }
    [Parameter] public int InitialPage { get; set; } = 2;
    [Parameter] public bool Locked { get; set; }
    [Parameter] public string? PageClasses { get; set; }

    private ElementReference _ref;
    private int _currentPage;
    private bool _initialized;
    private int _fragCount;

    // The InitialPage value the carousel is actually sitting on. Only a CHANGE of the supplied value
    // repositions; ordinary re-renders (a toast, a reload, an edit) must never yank a user who has
    // swiped somewhere else back to the initial page.
    private int _appliedInitialPage;
    private bool _repositionPending;

    private KeyboardShortcutScope? _keys;
    private DotNetObjectReference<WallCarousel>? _selfRef;
    private bool _observed;
    private bool _appliedLocked;

    // The scroll container the JS listeners are actually attached to. Enhanced navigation can RETAIN
    // this component across a route change while rebuilding its DOM — the recorded footgun — and the
    // new node carries none of the listeners, leaving the carousel unobserved (no settle, no dot
    // updates) for the rest of its life. Comparing the element id each render catches that.
    private string? _observedElementId;

    private IEnumerable<(RenderFragment Fragment, int Index)> Pages()
    {
        var list = new List<RenderFragment?> { Page1, Page2, Page3, Page4, Page5, Page6 };
        var i = 0;
        foreach (var p in list)
        {
            if (p != null)
            {
                yield return (p, i);
                i++;
            }
        }
    }

    private string PageClass(int idx)
    {
        if (string.IsNullOrEmpty(PageClasses)) return string.Empty;
        var parts = PageClasses.Split('|');
        return idx < parts.Length ? parts[idx] : string.Empty;
    }

    protected override void OnParametersSet()
    {
        _fragCount = Pages().Count();
        if (_currentPage >= _fragCount) _currentPage = Math.Max(0, _fragCount - 1);

        // A navigation that only changes the query (?view=boulders) reuses this component instead of
        // recreating it, so the new deep-link target arrives as a changed parameter and nothing else
        // would move the scroll offset.
        if (_initialized && InitialPage != _appliedInitialPage)
        {
            _repositionPending = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _fragCount > 0)
        {
            _appliedInitialPage = InitialPage;
            _currentPage = Math.Clamp(InitialPage, 0, _fragCount - 1);
            // Position the scroll offset instantly while the carousel is still hidden
            // (.carousel-pending), so the first painted frame is already the target page — no
            // visible swipe from page 1. Revealing happens on the StateHasChanged re-render below.
            await JS.InvokeVoidAsync("wallCarousel.initPage", _ref, _currentPage);
            _initialized = true;
            // JS owns settling from here: it waits until the scroller is actually still, corrects the
            // offset once and reports the page back through CarouselSettled. Nothing re-renders the
            // page track while a scroll is in flight, which is what used to cancel the pending snap.
            await ObserveAsync();
            // Registered after positioning so the first paint is never held up by an extra
            // round-trip. This scope lands low on the dispatcher stack: anything rendered inside a
            // pane (the panel viewer, the photo editor) registers later and therefore wins the
            // arrows while it is alive.
            await RegisterShortcutsAsync();
            StateHasChanged();
            return;
        }

        if (firstRender)
        {
            await RegisterShortcutsAsync();
        }

        // Re-attach when the element behind _ref is a different DOM node than the one JS observes.
        // observe() is a no-op on a node it already owns, so this costs nothing on an ordinary render.
        if (_initialized && _fragCount > 0 && _ref.Id != _observedElementId)
        {
            await ObserveAsync();
            // The rebuilt node starts at offset 0; put it back on the page the component believes it
            // is on. Instant — the user did not ask for a swipe.
            await SafeInvokeAsync("wallCarousel.scrollToPage", _ref, _currentPage, false);
        }

        if (_observed && _appliedLocked != Locked)
        {
            _appliedLocked = Locked;
            await SafeInvokeAsync("wallCarousel.setLocked", _ref, Locked);
        }

        if (_repositionPending)
        {
            _repositionPending = false;
            _appliedInitialPage = InitialPage;
            // Instant: this is a deep link resolving, not a swipe the user asked for.
            await GoToPageAsync(InitialPage, smooth: false);
        }
    }

    private async Task RegisterShortcutsAsync()
    {
        _keys = new KeyboardShortcutScope(JS, OnShortcutAsync, KeyGate);
        await _keys.RegisterAsync("ArrowLeft", "ArrowRight");
    }

    private async Task OnShortcutAsync(string key)
    {
        switch (key)
        {
            case "ArrowLeft":
                await PreviousAsync();
                break;
            case "ArrowRight":
                await NextAsync();
                break;
        }

        // The dispatcher callback arrives outside a Blazor UI event, so nothing would re-render the
        // dots on its own.
        StateHasChanged();
    }

    /// <summary>
    /// Moves one page forward. Mirrors the dot buttons, including their <see cref="Locked"/> guard.
    /// </summary>
    public async Task NextAsync()
    {
        await StepAsync(1);
    }

    /// <summary>
    /// Moves one page back. Mirrors the dot buttons, including their <see cref="Locked"/> guard.
    /// </summary>
    public async Task PreviousAsync()
    {
        await StepAsync(-1);
    }

    private async Task StepAsync(int delta)
    {
        // Locked is set while a pane is being edited: a stray arrow must not scroll the edit surface
        // out from under the user, exactly as a dot click must not.
        if (Locked || _fragCount == 0)
        {
            return;
        }

        var target = Math.Clamp(_currentPage + delta, 0, _fragCount - 1);
        if (target == _currentPage)
        {
            return;
        }

        await GoToPageAsync(target);
    }

    private async Task GoTo(int idx)
    {
        if (Locked)
        {
            return;
        }

        SetCurrentPage(idx);
        await MoveAsync(idx, smooth: true);
    }

    public async Task GoToPageAsync(int idx, bool smooth = true)
    {
        var clamped = Math.Clamp(idx, 0, Math.Max(0, _fragCount - 1));
        SetCurrentPage(clamped);
        await MoveAsync(clamped, smooth);
        StateHasChanged();
    }

    // A programmatic move (dot, arrow key, deep link) already knows the target page, so tell JS it is
    // the settled one: the smooth scroll it causes then settles without echoing a redundant report
    // back into a re-render.
    private async Task MoveAsync(int idx, bool smooth)
    {
        await SafeInvokeAsync("wallCarousel.markPage", _ref, idx);
        await SafeInvokeAsync("wallCarousel.scrollToPage", _ref, idx, smooth);
    }

    private void SetCurrentPage(int idx)
    {
        _currentPage = idx;
    }

    /// <summary>
    /// Reported by wall-carousel.js once the track has come to rest (scrollend, or a 120 ms idle
    /// timer on Safari) and has been corrected onto the page boundary. One call per gesture, never
    /// while a scroll is still running.
    /// </summary>
    [JSInvokable]
    public Task CarouselSettled(int page)
    {
        if (!_initialized || _fragCount == 0)
        {
            return Task.CompletedTask;
        }

        var clamped = Math.Clamp(page, 0, _fragCount - 1);
        if (clamped != _currentPage)
        {
            SetCurrentPage(clamped);
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    private async Task ObserveAsync()
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        await SafeInvokeAsync("wallCarousel.observe", _ref, _selfRef);
        _observed = true;
        _observedElementId = _ref.Id;
        // Seed the settled page so the very first settle after the initial positioning doesn't
        // report a page .NET already knows about.
        await SafeInvokeAsync("wallCarousel.markPage", _ref, _currentPage);
        _appliedLocked = Locked;
        if (Locked)
        {
            await SafeInvokeAsync("wallCarousel.setLocked", _ref, Locked);
        }
    }

    private async Task SafeInvokeAsync(string identifier, params object?[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(identifier, args);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException or OperationCanceledException)
        {
            // The circuit (or the component) went away between the render and the interop call;
            // there is nothing left to talk to.
            Logger.LogDebug(ex, "Carousel interop skipped ({Identifier}): circuit disconnected", identifier);
        }
        catch (JSException ex)
        {
            // A plain JS-side failure, which unobserve can hit for real: DisposeAsync passes an
            // ElementReference whose node Blazor may already have detached, and the resolver then
            // throws. None of these calls is worth failing a dispose (or a render) over — the whole
            // point of this wrapper is that a settle/lock/unobserve is best-effort.
            Logger.LogDebug(ex, "Carousel interop failed ({Identifier})", identifier);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_keys is not null)
        {
            await _keys.DisposeAsync();
            _keys = null;
        }

        if (_observed)
        {
            _observed = false;
            _observedElementId = null;
            await SafeInvokeAsync("wallCarousel.unobserve", _ref);
        }

        _selfRef?.Dispose();
        _selfRef = null;
    }
}
