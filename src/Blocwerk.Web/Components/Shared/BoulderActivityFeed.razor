@inject IActivityLogService ActivityLogService

@*
    Self-contained activity feed: it owns its own paging so the boulder page does not have to
    carry three more fields for it. BoulderDetail calls ReloadAsync() through an @ref after the
    offline queue flushes, since a replayed attempt or comment shows up here.
*@

<div class="activity-feed">
    <h2>Activity</h2>
    @if (_items != null)
    {
        @foreach (var item in _items)
        {
            <div class="activity-row">
                <UserAvatar UserId="item.User.Id" Name="@item.User.Name"
                            HasAvatar="item.User.HasAvatar" CssClass="avatar-sm" />
                <span class="activity-text">@Describe(item)</span>
                <span class="activity-time"><LocalTime Value="@item.Timestamp" Format="LocalTimeFormat.Relative" /></span>
            </div>
        }
        @if (_items.Count == 0)
        {
            <p class="empty-msg">No activity yet.</p>
        }
        @if (_total > (_page + 1) * 5)
        {
            <div class="activity-pager">
                @if (_page > 0)
                {
                    <button class="pager-btn" @onclick="() => LoadAsync(_page - 1)">&larr; Newer</button>
                }
                <button class="pager-btn" @onclick="() => LoadAsync(_page + 1)">Older &rarr;</button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid BoulderId { get; set; }

    /// <summary>
    /// Set on the anonymous share-link view of a boulder. The service authorizes the read against
    /// the boulder's wall, and without a token that means wall membership — so a share viewer has
    /// to hand its token down here too, or the feed it is allowed to see would come back empty.
    /// </summary>
    [Parameter] public string? ShareToken { get; set; }

    private List<ActivityLogEntry>? _items;
    private int _total;
    private int _page;

    protected override Task OnInitializedAsync() => LoadAsync(0);

    /// <summary>Re-reads the newest page. Called after the offline queue delivered something.</summary>
    public Task ReloadAsync() => LoadAsync(0);

    private async Task LoadAsync(int page)
    {
        try
        {
            var (items, total) = await LoadPageAsync(page);
            _page = page;
            _items = items;
            _total = total;
        }
        catch (Exception)
        {
            // A feed that cannot load must not take the page down with it; the ascent buttons
            // above it are the point of this screen and keep working regardless.
            _items ??= [];
        }
    }

    /// <summary>
    /// The service gates the log on membership of the boulder's wall, so the member path goes
    /// first: a stale share token in the URL (enhanced-nav keeps route params, and the last-page
    /// cookie can restore a /shared/ link) must never cost a member their own feed. Anyone the
    /// membership gate turns away — an anonymous share viewer, or a signed-in visitor who is not a
    /// member — falls through to the token, which is the gate that was meant for them.
    /// </summary>
    private async Task<(List<ActivityLogEntry> Items, int TotalCount)> LoadPageAsync(int page)
    {
        try
        {
            return await ActivityLogService.GetBoulderActivityAsync(BoulderId, page);
        }
        catch (UnauthorizedAccessException) when (!string.IsNullOrEmpty(ShareToken))
        {
            return await ActivityLogService.GetBoulderActivityAsync(BoulderId, page, shareToken: ShareToken);
        }
    }

    private static string Describe(ActivityLogEntry item) => item.Type switch
    {
        ActivityType.AttemptLogged => $"{item.User.Name} {AttemptVerb(item.Details)} this",
        ActivityType.CommentAdded => $"{item.User.Name} commented",
        ActivityType.BoulderCreated => $"{item.User.Name} created this",
        ActivityType.BoulderRevised => $"{item.User.Name} revised this",
        ActivityType.BetaVideoUploaded => $"{item.User.Name} added a beta video",
        _ => $"{item.User.Name} made a change",
    };

    private static string AttemptVerb(string? details) => details switch
    {
        "Flash" => "flashed",
        "Send" => "sent",
        "Attempt" => "attempted",
        _ => "tried",
    };
}
