@inject IActivityLogService ActivityLogService
@inject WallCacheState Cache
@inject ILogger<BoulderActivityFeed> Logger
@using Blocwerk.Contracts.Feed
@using Blocwerk.Web.State.Live
@implements IDisposable

@*
    Self-contained activity feed: it owns its own paging so the boulder page does not have to
    carry three more fields for it. BoulderDetail calls ReloadAsync() through an @ref after the
    offline queue flushes, since a replayed attempt or comment shows up here.

    Live (design §5.5): an activity.added or activity.removed (a deleted attempt) of this boulder re-reads the newest page (the envelope
    carries the entry's type but not its details, so it cannot be drawn from the event alone).
    While an older page is open the list is held, so it never shifts under the reader; going
    back to the newest page reads fresh anyway.
*@

<div class="activity-feed">
    <h2>Activity</h2>
    @if (_items != null)
    {
        @foreach (var item in _items)
        {
            var author = LeafAuthors.Describe(item.User, _feed?.Viewer);
            <div class="activity-row" @key="item.Id">
                <UserAvatar UserId="author.Id" Name="@author.Name"
                            HasAvatar="author.HasAvatar" CssClass="avatar-sm" />
                <span class="activity-text">@Describe(item, author.Name)</span>
                <span class="activity-time"><LocalTime Value="@item.Timestamp" Format="LocalTimeFormat.Relative" /></span>
            </div>
        }
        @if (_items.Count == 0)
        {
            <p class="empty-msg">No activity yet.</p>
        }
        @if (_total > (_page + 1) * 5)
        {
            <div class="activity-pager">
                @if (_page > 0)
                {
                    <button class="pager-btn" @onclick="() => LoadAsync(_page - 1)">&larr; Newer</button>
                }
                <button class="pager-btn" @onclick="() => LoadAsync(_page + 1)">Older &rarr;</button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid BoulderId { get; set; }

    /// <summary>
    /// Set on the anonymous share-link view of a boulder. The service authorizes the read against
    /// the boulder's wall, and without a token that means wall membership — so a share viewer has
    /// to hand its token down here too, or the feed it is allowed to see would come back empty.
    /// </summary>
    [Parameter] public string? ShareToken { get; set; }

    /// <summary>The boulder's wall, whose feed keeps the list live.</summary>
    [Parameter] public Guid WallId { get; set; }

    private static readonly IReadOnlySet<string> Kinds = new HashSet<string> { FeedKinds.ActivityAdded, FeedKinds.ActivityRemoved, FeedKinds.UserProfile };
    private static readonly IReadOnlySet<string> None = new HashSet<string>();

    private List<ActivityLogEntry>? _items;
    private int _total;
    private int _page;
    private LeafFeed? _feed;
    private (Guid Wall, Guid Boulder, string? Token)? _key;

    protected override Task OnParametersSetAsync()
    {
        if (_key == (WallId, BoulderId, ShareToken))
        {
            return Task.CompletedTask;
        }

        _key = (WallId, BoulderId, ShareToken);
        _feed?.Dispose();

        // Share routes are not live, as everywhere else on the boulder page.
        _feed = WallId == Guid.Empty || !string.IsNullOrEmpty(ShareToken)
            ? null
            : LeafFeed.Open(Cache, new LeafScope(WallId, BoulderId, Kinds), InvokeAsync, ApplyAsync, () => _page > 0, Logger);
        return LoadAsync(0);
    }

    /// <summary>Re-reads the newest page. Called after the offline queue delivered something.</summary>
    public Task ReloadAsync() => LoadAsync(0);

    public void Dispose() => _feed?.Dispose();

    // On the dispatcher, only on the newest page. A profile change matters only when it names someone shown.
    private Task ApplyAsync(LeafBatch batch)
    {
        var plan = LeafPlan.Of(batch, None, None);
        var shown = _items?.Any(i => plan.Profiles.Contains(i.UserId)) ?? false;
        return plan.Reload || shown ? LoadAsync(0) : Task.CompletedTask;
    }

    // Renders itself for the same reason BoulderComments does: ReloadAsync is driven by
    // BoulderDetail's queue-flush callback, not by an event on this component.
    private async Task LoadAsync(int page)
    {
        try
        {
            // Every page goes through the feed, so only the latest load lands, and going back to the newest page
            // releases what was held while an older one was open.
            void Commit((List<ActivityLogEntry> Items, int TotalCount) read) => (_page, _items, _total) = (page, read.Items, read.TotalCount);
            if (_feed is { } feed)
            {
                await feed.LoadAsync(() => LoadPageAsync(page), Commit);
            }
            else
            {
                Commit(await LoadPageAsync(page));
            }
        }
        catch (Exception)
        {
            // A feed that cannot load must not take the page down with it; the ascent buttons
            // above it are the point of this screen and keep working regardless.
            _items ??= [];
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The service gates the log on membership of the boulder's wall, so the member path goes
    /// first: a stale share token in the URL (enhanced-nav keeps route params, and the last-page
    /// cookie can restore a /shared/ link) must never cost a member their own feed. Anyone the
    /// membership gate turns away — an anonymous share viewer, or a signed-in visitor who is not a
    /// member — falls through to the token, which is the gate that was meant for them.
    /// </summary>
    private async Task<(List<ActivityLogEntry> Items, int TotalCount)> LoadPageAsync(int page)
    {
        try
        {
            return await ActivityLogService.GetBoulderActivityAsync(BoulderId, page);
        }
        catch (UnauthorizedAccessException) when (!string.IsNullOrEmpty(ShareToken))
        {
            return await ActivityLogService.GetBoulderActivityAsync(BoulderId, page, shareToken: ShareToken);
        }
    }

    private static string Describe(ActivityLogEntry item, string name) => item.Type switch
    {
        ActivityType.AttemptLogged => $"{name} {AttemptVerb(item.Details)} this",
        ActivityType.CommentAdded => $"{name} commented",
        ActivityType.BoulderCreated => $"{name} created this",
        ActivityType.BoulderRevised => $"{name} revised this",
        ActivityType.BetaVideoUploaded => $"{name} added a beta video",
        _ => $"{name} made a change",
    };

    private static string AttemptVerb(string? details) => details switch
    {
        "Flash" => "flashed",
        "Send" => "sent",
        "Attempt" => "attempted",
        _ => "tried",
    };
}
