@* Wall-settings section: "Clean up hold shapes" — smooths jagged automatic outlines and removes overlaps between
   holds (preview counts → Apply → Undo). Hand-drawn shapes and manually placed holds are never touched.
   Preview and apply run as background work with progress and a Cancel button, so the page stays usable.
   Admin-only (rendered inside the admin card); hidden on a kiosk tablet and behind a share link. *@

@if (!Hidden)
{
<div class="glyph-settings">
    <h3 class="glyph-heading">Clean up hold shapes</h3>
    <p class="hint">
        Smooths jagged automatic hold outlines and makes sure holds do not overlap, so each one can be selected.
        Shapes you drew yourself are never changed.
    </p>

    @if (busy)
    {
        <p class="loading-small" role="status">@ProgressText</p>
        <div class="staged-actions">
            <button class="btn-secondary" @onclick="Cancel">Cancel</button>
        </div>
    }
    else if (preview is null)
    {
        <div class="staged-actions">
            <button class="btn-secondary" @onclick="PreviewAsync">Check hold shapes</button>
        </div>
    }
    else
    {
        <p class="glyph-summary" role="status">@PreviewText(preview)</p>
        @if (preview.ManualOverlapCount > 0)
        {
            <p class="hint" role="status">@ManualOverlapText(preview)</p>
            <ul class="hint">
                @foreach (var pair in preview.ManualOverlaps)
                {
                    <li>@HoldLabel(pair.NameA, pair.HoldA) overlaps @HoldLabel(pair.NameB, pair.HoldB) (near @(Math.Round(pair.X * 100))% across, @(Math.Round(pair.Y * 100))% down)</li>
                }
            </ul>
        }

        <div class="staged-actions">
            @if (preview.Changed > 0)
            {
                <button class="btn-primary" @onclick="ApplyAsync">Apply</button>
            }
            <button class="btn-secondary" @onclick="CancelPreview">Close</button>
        </div>
    }

    @if (failure is not null)
    {
        <p class="field-error" role="alert">@failure</p>
    }
    else if (message is not null)
    {
        <p class="glyph-ok" role="status">@message</p>
    }

    @if (!busy && status?.RevertableBatchId is { } batchId)
    {
        <div class="staged-actions">
            <button class="btn-secondary" @onclick="() => UndoAsync(batchId)">Undo</button>
        </div>
    }
</div>
}
