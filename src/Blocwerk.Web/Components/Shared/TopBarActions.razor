@rendermode InteractiveServer
@using System.Reflection
@inject IJSRuntime JS

<button class="theme-toggle" @onclick="ToggleTheme" title="Toggle light/dark mode">
    @if (_isDark)
    {
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
            <circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
    }
    else
    {
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
    }
</button>
<button class="header-icon-btn @(_isFullscreen ? "active" : "")" @onclick="ToggleFullscreen" title="Toggle fullscreen (use full browser width)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
        <rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" />
    </svg>
</button>
<div style="position: relative;">
    <button class="header-icon-btn" @onclick="() => _showInfoPopover = !_showInfoPopover" title="Info">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
            <circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" />
        </svg>
    </button>
    @if (_showInfoPopover)
    {
        <div class="info-popover">
            <a href="/about" @onclick="() => _showInfoPopover = false">Impressum</a>
            <a href="/privacy" @onclick="() => _showInfoPopover = false">Privacy Policy</a>
            <span class="info-version" title="Deployed image version">v@(Version)</span>
        </div>
    }
</div>

@code {
    private bool _isDark;
    private bool _isFullscreen;
    private bool _showInfoPopover;

    // The build version stamped into the assembly by GitVersion (e.g. "0.0.1-54"), matching the
    // pushed image tag. The "+<sha>" build-metadata suffix is trimmed for display.
    private static readonly string Version = ResolveVersion();

    private static string ResolveVersion()
    {
        var info = typeof(TopBarActions).Assembly
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion;
        if (string.IsNullOrWhiteSpace(info))
        {
            return "dev";
        }

        var plus = info.IndexOf('+');
        return plus > 0 ? info[..plus] : info;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDark = await JS.InvokeAsync<bool>("blocwerkTheme.isDark");
            _isFullscreen = await JS.InvokeAsync<bool>("blocwerkLayout.isFullscreen");
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        var result = await JS.InvokeAsync<string>("blocwerkTheme.toggle");
        _isDark = result == "dark";
    }

    private async Task ToggleFullscreen()
    {
        _isFullscreen = await JS.InvokeAsync<bool>("blocwerkLayout.toggle");
    }
}
