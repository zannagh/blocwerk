@using System.Globalization
@using System.Text
@using System.Text.Json
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="prog-chart">
    <div class="prog-chart-head">
        <h4 class="prog-chart-title">@Title</h4>
        @if (!string.IsNullOrEmpty(Caption))
        {
            <span class="prog-chart-caption">@Caption</span>
        }
    </div>

    @if (_plottable < 2)
    {
        <p class="prog-chart-empty">@EmptyText</p>
    }
    else
    {
        <div class="prog-chart-body" @ref="_container">
            <div class="prog-chart-yaxis">
                @foreach (var tick in YTicks)
                {
                    <span class="prog-ytick" style="top:@Pct(YFrac(tick.Value));">@tick.Label</span>
                }
            </div>
            <svg class="prog-chart-svg" viewBox="0 0 @MaxX 100" preserveAspectRatio="none">
                @foreach (var tick in YTicks)
                {
                    var gy = F(YFrac(tick.Value) * 100);
                    <line class="prog-grid" x1="0" y1="@gy" x2="@MaxX" y2="@gy" vector-effect="non-scaling-stroke" />
                }
                @foreach (var d in DataPaths())
                {
                    <path d="@d" fill="none" stroke="@Stroke" stroke-width="2.5"
                          vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round" />
                }
                @if (TrendPath() is { } trend)
                {
                    <path class="prog-trend" d="@trend" fill="none" stroke="@Stroke" vector-effect="non-scaling-stroke" />
                }
            </svg>
            <div class="prog-chart-guide"></div>
            <div class="prog-chart-dot" style="background:@Stroke;"></div>
            <div class="prog-chart-tip"></div>
        </div>
        <div class="prog-chart-xaxis">
            @foreach (var tick in XAxisTicks())
            {
                @if (LocalTimeLabels && tick.UtcMs is { } ms)
                {
                    @* localtime.js rewrites this to the viewer's local time; the text is the pre-JS fallback. *@
                    <time class="prog-xtick" style="left:@Pct(tick.Frac);"
                          datetime="@Iso(ms)" data-bw-fmt="@AxisTimeFormat">@tick.Label</time>
                }
                else
                {
                    <span class="prog-xtick" style="left:@Pct(tick.Frac);">@tick.Label</span>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Caption { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<ChartSeriesPoint> Points { get; set; } = [];
    [Parameter] public IReadOnlyList<(double Value, string Label)> YTicks { get; set; } = [];
    [Parameter] public string Stroke { get; set; } = "#e94560";
    [Parameter] public bool ShowTrendline { get; set; }
    [Parameter] public string EmptyText { get; set; } = "Not enough data yet.";

    /// <summary>Opt-in (temperature panel only): format the x-axis ticks and tooltip time on the
    /// CLIENT in the viewer's local timezone. Requires each point to carry <see cref="ChartSeriesPoint.UtcMs"/>.
    /// The date-based progression/training/volume charts leave this off and are unaffected.</summary>
    [Parameter] public bool LocalTimeLabels { get; set; }

    /// <summary>bwTime format key for the x-axis ticks when <see cref="LocalTimeLabels"/> is on (e.g. "time", "date-dmy").</summary>
    [Parameter] public string AxisTimeFormat { get; set; } = "date-dmy";

    /// <summary>bwTime format key for the tooltip time appended client-side when <see cref="LocalTimeLabels"/> is on.</summary>
    [Parameter] public string TooltipTimeFormat { get; set; } = "datetime";

    /// <summary>Explicit Y range. When both are set they override the auto data range (and enable
    /// the y-axis drag-to-rescale gesture, which reports steps via <see cref="OnYScaleStep"/>).</summary>
    [Parameter] public double? YMin { get; set; }
    [Parameter] public double? YMax { get; set; }

    /// <summary>Raised when the user drags the y-axis: +1 = drag down (show a wider range), -1 = up.</summary>
    [Parameter] public EventCallback<int> OnYScaleStep { get; set; }

    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    private ElementReference _container;
    private double _min;
    private double _max = 1;
    private int _plottable;
    private string? _boundPayload;
    private DotNetObjectReference<ProgressionChart>? _selfRef;

    private bool YDraggable => YMin.HasValue && YMax.HasValue && OnYScaleStep.HasDelegate;

    protected override void OnParametersSet()
    {
        var values = Points.Where(p => p.Value.HasValue).Select(p => p.Value!.Value).ToList();
        _plottable = values.Count;

        if (YMin.HasValue && YMax.HasValue)
        {
            _min = YMin.Value;
            _max = YMax.Value;
        }
        else
        {
            var scale = values.Concat(YTicks.Select(t => t.Value)).ToList();
            _min = scale.Count > 0 ? scale.Min() : 0;
            _max = scale.Count > 0 ? scale.Max() : 1;
        }

        if (_max <= _min)
        {
            _max = _min + 1;
        }
    }

    [JSInvokable]
    public Task YScale(int direction) => OnYScaleStep.InvokeAsync(direction);

    private int MaxX => Math.Max(1, Points.Count - 1);

    private double XFrac(int i) => Points.Count <= 1 ? 0.5 : (double)i / (Points.Count - 1);

    // 0 = top of the plot, 1 = bottom.
    private double YFrac(double v) => 1 - ((v - _min) / (_max - _min));

    private static string F(double v) => v.ToString("F2", Inv);

    private static string Pct(double frac) => (frac * 100).ToString("F1", Inv) + "%";

    // Smooth data line: one Catmull-Rom path per run of consecutive non-null points (gaps split it).
    private IEnumerable<string> DataPaths()
    {
        var run = new List<(double X, double Y)>();
        for (var i = 0; i < Points.Count; i++)
        {
            if (Points[i].Value is { } v)
            {
                run.Add((i, YFrac(v) * 100));
            }
            else if (run.Count > 0)
            {
                yield return SmoothPath(run);
                run = new List<(double X, double Y)>();
            }
        }

        if (run.Count > 0)
        {
            yield return SmoothPath(run);
        }
    }

    // Trend line: a centered moving average over a wider span than the data itself, so it shows the
    // macro direction rather than the bland start→end straight line. Null when there is too little data.
    private string? TrendPath()
    {
        if (!ShowTrendline)
        {
            return null;
        }

        var idx = new List<int>();
        var vals = new List<double>();
        for (var i = 0; i < Points.Count; i++)
        {
            if (Points[i].Value is { } v)
            {
                idx.Add(i);
                vals.Add(v);
            }
        }

        if (vals.Count < 4)
        {
            return null;
        }

        var window = Math.Clamp((int)Math.Round(vals.Count * 0.4), 3, vals.Count);
        var half = window / 2;
        var pts = new List<(double X, double Y)>();
        for (var k = 0; k < vals.Count; k++)
        {
            int lo = Math.Max(0, k - half), hi = Math.Min(vals.Count - 1, k + half);
            double avg = 0;
            for (var j = lo; j <= hi; j++)
            {
                avg += vals[j];
            }

            avg /= hi - lo + 1;
            pts.Add((idx[k], YFrac(avg) * 100));
        }

        return SmoothPath(pts);
    }

    // Monotone cubic (Fritsch–Carlson) spline → cubic-Bézier SVG path. Unlike Catmull-Rom it never
    // overshoots the data, so the curve can't bulge below the floor (e.g. into negative minutes) and
    // vanish off the chart.
    private static string SmoothPath(IReadOnlyList<(double X, double Y)> p)
    {
        var n = p.Count;
        if (n == 0)
        {
            return string.Empty;
        }

        if (n == 1)
        {
            return $"M {F(p[0].X)},{F(p[0].Y)} L {F(p[0].X)},{F(p[0].Y)}";
        }

        if (n == 2)
        {
            return $"M {F(p[0].X)},{F(p[0].Y)} L {F(p[1].X)},{F(p[1].Y)}";
        }

        var secant = new double[n - 1];
        for (var i = 0; i < n - 1; i++)
        {
            secant[i] = (p[i + 1].Y - p[i].Y) / (p[i + 1].X - p[i].X);
        }

        var tangent = new double[n];
        tangent[0] = secant[0];
        tangent[n - 1] = secant[n - 2];
        for (var i = 1; i < n - 1; i++)
        {
            tangent[i] = secant[i - 1] * secant[i] <= 0 ? 0 : (secant[i - 1] + secant[i]) / 2;
        }

        for (var i = 0; i < n - 1; i++)
        {
            if (secant[i] == 0)
            {
                tangent[i] = 0;
                tangent[i + 1] = 0;
                continue;
            }

            var a = tangent[i] / secant[i];
            var b = tangent[i + 1] / secant[i];
            var s = (a * a) + (b * b);
            if (s > 9)
            {
                var t = 3.0 / Math.Sqrt(s);
                tangent[i] = t * a * secant[i];
                tangent[i + 1] = t * b * secant[i];
            }
        }

        var sb = new StringBuilder();
        sb.Append($"M {F(p[0].X)},{F(p[0].Y)}");
        for (var i = 0; i < n - 1; i++)
        {
            var h = p[i + 1].X - p[i].X;
            var c1x = p[i].X + (h / 3.0);
            var c1y = p[i].Y + (tangent[i] * h / 3.0);
            var c2x = p[i + 1].X - (h / 3.0);
            var c2y = p[i + 1].Y - (tangent[i + 1] * h / 3.0);
            sb.Append($" C {F(c1x)},{F(c1y)} {F(c2x)},{F(c2y)} {F(p[i + 1].X)},{F(p[i + 1].Y)}");
        }

        return sb.ToString();
    }

    private IEnumerable<(string Label, long? UtcMs, double Frac)> XAxisTicks()
    {
        if (Points.Count == 0)
        {
            yield break;
        }

        var step = Math.Max(1, (int)Math.Ceiling(Points.Count / 4.0));
        for (var i = 0; i < Points.Count; i += step)
        {
            yield return (Points[i].AxisLabel, Points[i].UtcMs, XFrac(i));
        }
    }

    // Unix epoch ms → ISO 8601 UTC ("o"), the shape wwwroot/js/localtime.js parses from the datetime attribute.
    private static string Iso(long utcMs) => DateTimeOffset.FromUnixTimeMilliseconds(utcMs).UtcDateTime.ToString("o", Inv);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_plottable < 2)
        {
            _boundPayload = null;
            return;
        }

        // Serialise the points (x/y fractions + tooltip) and let the JS module own the pointer-drag
        // read-out — a Blazor Server pointermove round-trip per move would lag badly.
        // In local-time mode each point also carries its UTC instant (utc, epoch ms) and the tooltip
        // format key (tfmt); progression-chart.js appends the viewer-local time to the label on show().
        var payload = JsonSerializer.Serialize(Points.Select((p, i) => new
        {
            x = XFrac(i),
            y = p.Value.HasValue ? YFrac(p.Value.Value) : (double?)null,
            label = p.TooltipLabel,
            utc = LocalTimeLabels ? p.UtcMs : null,
            tfmt = LocalTimeLabels ? TooltipTimeFormat : null,
        }));

        if (payload == _boundPayload)
        {
            return;
        }

        _boundPayload = payload;
        _selfRef ??= DotNetObjectReference.Create(this);
        try
        {
            // Pass the .NET ref only when the y-axis is drag-rescalable, so JS wires that gesture.
            await JS.InvokeVoidAsync("blocwerkChart.bind", _container, payload, YDraggable ? _selfRef : null);
        }
        catch (JSException)
        {
            _boundPayload = null;
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("blocwerkChart.unbind", _container);
        }
        catch (Exception)
        {
            // Circuit already gone during teardown; nothing to clean up.
        }

        _selfRef?.Dispose();
    }
}
