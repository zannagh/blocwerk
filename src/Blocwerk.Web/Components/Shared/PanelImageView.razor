@inject IJSRuntime JS
@implements IDisposable

@* One zoomable/pannable panel image with its hold overlay, for the big-wall overlap stepper.
   All holds are drawn faintly; the current pair's hold is highlighted with a coloured number
   badge (HTML, positioned by normalized coords so preserveAspectRatio="none" never stretches it).
   In interactive (moved) mode taps select a detected hold, or — in add mode — an empty spot. *@

<figure class="panel-step-view">
    <figcaption class="panel-step-cap">
        <span>@Caption</span>
        <button type="button" class="panel-step-toggle @(_overlayHidden ? "off" : "")"
                @onclick="ToggleOverlay"
                title="@(_overlayHidden ? "Show the hold overlay" : "Hide the overlay to see the photo behind small holds")">
            @(_overlayHidden ? "◌ Show holds" : "● Hide holds")
        </button>
    </figcaption>
    @* Cursor as a CLASS, not an inline style: viewport.js writes inline styles on this element
       (touch-action, --fit-aspect, --crop-scale, aspect-ratio) and Blazor rewrites the whole style
       attribute when its value changes, wiping them — the box resizes and the view pans by itself. *@
    <div class="panel-step-viewport @(AddMode ? "bw-cursor-crosshair" : "bw-cursor-default")" @ref="_viewportRef">
        <div class="photo-editor" @ref="_editorRef"
             data-hold-drag="@(Editable && DragToMove ? "true" : null)">
            <img src="@ResponsiveImage.Initial(PhotoUrl)" data-bw-res alt="@Caption" class="wall-photo" />
            @{
                // The overlay body is shared verbatim between the two <svg> variants below so the
                // non-editable svg keeps EXACTLY today's attributes (no pointer handlers) while the
                // editable svg gains move-drag pointer handling. Everything gated on Editable is inert
                // for the PanelLinkTool / overlap-stepper reuse sites, which never set Editable.
                RenderFragment overlay = @<text>
                    @if (!_overlayHidden)
                    {
                        @foreach (var h in Holds)
                        {
                            var g = Geo(h);
                            var isHighlight = HighlightHoldId == h.Id;
                            var isSelected = SelectedHoldId == h.Id;
                            var custom = !isSelected && !isHighlight && HoldColors is not null
                                && HoldColors.TryGetValue(h.Id, out var cc) ? cc : null;
                            // In interactive (re-target) mode every hold is a pick target, so plain holds
                            // are drawn boldly instead of near-invisible — otherwise there is nothing to aim at.
                            var stroke = isSelected ? "var(--status-success)"
                                : isHighlight ? BadgeColor
                                : custom ?? (Interactive ? "rgba(120,190,255,0.95)" : "rgba(150,150,160,0.6)");
                            var fill = isSelected ? "rgba(51,221,102,0.25)"
                                : isHighlight ? BadgeFill
                                : custom is null && Interactive ? "rgba(120,190,255,0.15)" : "transparent";
                            // Outline widths thin out as the user magnifies (see StrokeScale) so the
                            // gaps between densely packed holds stay visible at high zoom.
                            var sw = F3((isSelected || isHighlight ? 0.9
                                : custom is not null ? 0.6
                                : Interactive ? 0.7 : 0.35) * StrokeScale);
                            // When Editable, the transparent drag proxies below own the pointer, so the drawn
                            // shapes go pointer-events:none; otherwise this is byte-for-byte today's behaviour.
                            var interact = Interactive && !Editable;
                            var isFoot = h.Category == HoldCategory.Foot;
                            @* A foot's drawn square is smaller than the circle that used to be its tap
                               target, and these interactive modes (carryover review, cross-gen link, the
                               overlap stepper's picking) are wall-update DECISION surfaces where a mis-tap
                               is expensive. So a transparent full-radius circle goes behind the square,
                               restoring byte-for-byte the target the foot had before it was drawn smaller:
                               same radius, same stroke width, same cursor and pointer-events, same
                               handlers. It exists only when the drawn shape itself is already pickable
                               (interact), so no foot becomes pickable anywhere it wasn't, and only for an
                               UNSHAPED foot — a shaped one draws its polygon and never shrank.
                               Editable mode needs none of this: its drag proxies below are already
                               full-radius circles. *@
                            @if (interact && isFoot && h.ShapePoints is not { Count: >= 3 })
                            {
                                <HoldShape @key="@($"foot-hit-{h.Id}")" X="g.X" Y="g.Y" Radius="g.Radius"
                                           Fill="transparent" Stroke="transparent" StrokeWidth="@sw"
                                           Style="cursor: pointer; pointer-events: auto;"
                                           OnClick="() => HandleHoldTap(h.Id)"
                                           OnMouseOver="() => OnHoldHover.InvokeAsync(h.Id)"
                                           OnMouseOut="() => OnHoldHoverEnd.InvokeAsync()" />
                            }

                            @* Feet draw as a smaller rounded square, matching the wall editor and the hold
                               picker. Purely visual: Style below still owns cursor and pointer-events, so
                               viewport-gestures.js hit-tests exactly as before. *@
                            <HoldShape @key="h.Id" X="g.X" Y="g.Y" Radius="g.Radius" ShapePoints="h.ShapePoints"
                                       Foot="isFoot"
                                       Fill="@fill" Stroke="@stroke" StrokeWidth="@sw"
                                       Style="@($"cursor: {(interact ? "pointer" : "inherit")}; pointer-events: {(interact ? "auto" : "none")};")"
                                       OnClick="() => HandleHoldTap(h.Id)"
                                       OnMouseOver="() => OnHoldHover.InvokeAsync(h.Id)"
                                       OnMouseOut="() => OnHoldHoverEnd.InvokeAsync()" />
                        }

                        @if (HintPoint is { } hint)
                        {
                            @* Moved-mode: the matcher's proposed position, as a hint to pick the real hold near it. *@
                            <circle cx="@F(hint.X * 100)" cy="@F(hint.Y * 100)" r="2"
                                    fill="none" stroke="var(--status-warning)" stroke-width="@F3(0.6 * StrokeScale)" stroke-dasharray="1 0.7"
                                    style="pointer-events: none" />
                        }

                        @if (Editable)
                        {
                            @* Transparent hit proxies drawn over each hold: a pointer-down here starts a move
                               drag; a plain click still selects (via HandleHoldTap). Only present in Editable
                               mode, so the reuse sites are completely unaffected.
                               Deliberately NOT Foot: the proxy stays a full-radius circle, which fully
                               contains the drawn foot square, so drawing feet smaller never shrinks a
                               drag/tap target here. *@
                            @foreach (var h in Holds)
                            {
                                var g = Geo(h);
                                @* The polygon variant ignores the radius, so the inflated hit radius can be
                                   passed unconditionally — it only ever reaches the circle. *@
                                <HoldShape @key="@($"drag-{h.Id}")" X="g.X" Y="g.Y"
                                           Radius="@(ExactHitTargets ? g.Radius : Math.Max(g.Radius, HitFloor))"
                                           ShapePoints="h.ShapePoints"
                                           Fill="transparent" Stroke="transparent" StrokeWidth="@HitStroke"
                                           Style="cursor: move; pointer-events: auto;"
                                           OnPointerDown="() => StartMove(h)"
                                           OnClick="() => HandleHoldTap(h.Id)" />
                            }
                        }
                    }
                </text>;
            }

            @if (Editable)
            {
                <svg class="hold-overlay" viewBox="0 0 100 100" preserveAspectRatio="none"
                     @onclick="OnSvgClick"
                     @onpointermove="OnEditPointerMove" @onpointerup="OnEditPointerUp" @onpointercancel="OnEditPointerUp">
                    @overlay
                </svg>
            }
            else
            {
                <svg class="hold-overlay" viewBox="0 0 100 100" preserveAspectRatio="none"
                     @onclick="OnSvgClick">
                    @overlay
                </svg>
            }

            @* Number badge on the highlighted hold — HTML so it keeps a constant size. *@
            @if (BadgeHold is { } bh && !_overlayHidden)
            {
                var bg = Geo(bh);
                <span class="panel-step-badge" style="left:@F(bg.X * 100)%;top:@F(bg.Y * 100)%;background:@BadgeColor">@BadgeNumber</span>
            }
        </div>
    </div>
</figure>

@code {
    [Parameter] public Guid WallId { get; set; }
    [Parameter] public string PhotoUrl { get; set; } = string.Empty;
    [Parameter] public string Caption { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<PanelHold> Holds { get; set; } = [];

    /// <summary>
    /// Optional per-hold ring colour (hold id → CSS colour) used to colour-code an overview, e.g. the
    /// big-wall carryover before/after. Holds not present fall back to the faint default; the
    /// highlighted/selected hold always wins. Null (the default) leaves every hold faint, so the
    /// overlap stepper is unaffected.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<Guid, string>? HoldColors { get; set; }

    /// <summary>The current pair's hold on this panel — drawn prominently with the number badge.</summary>
    [Parameter] public Guid? HighlightHoldId { get; set; }
    [Parameter] public int BadgeNumber { get; set; }
    [Parameter] public string BadgeColor { get; set; } = "var(--status-info)";

    /// <summary>Moved-mode hint (proposed position) drawn on this image, or null.</summary>
    [Parameter] public (double X, double Y)? HintPoint { get; set; }

    /// <summary>The user-chosen hold in moved-mode, highlighted green.</summary>
    [Parameter] public Guid? SelectedHoldId { get; set; }

    /// <summary>When true, taps on holds fire <see cref="OnHoldTap"/> (moved-mode selection).</summary>
    [Parameter] public bool Interactive { get; set; }

    /// <summary>When true, a tap on an empty spot fires <see cref="OnEmptyTap"/> to add a hold.</summary>
    [Parameter] public bool AddMode { get; set; }

    [Parameter] public EventCallback<Guid> OnHoldTap { get; set; }
    [Parameter] public EventCallback<(double X, double Y)> OnEmptyTap { get; set; }

    /// <summary>
    /// When true, holds can be moved by dragging; each completed drag reports the new normalized
    /// geometry through <see cref="OnHoldGeometryChanged"/>. Resizing is NOT done here — the touch-up
    /// toolbar's size slider commits through the same callback — so no handle covers a small hold.
    /// Opt-in: when false the component behaves exactly as before, so the non-editable reuse sites
    /// (PanelLinkTool, the overlap stepper) are unaffected. Add (<see cref="OnEmptyTap"/>) and select
    /// (<see cref="OnHoldTap"/>) keep working alongside it.
    /// </summary>
    [Parameter] public bool Editable { get; set; }

    /// <summary>
    /// When true the editable hit proxies are drawn at each hold's TRUE radius instead of the inflated
    /// minimum that makes a tiny hold draggable. Set it for a tool whose tap is destructive and
    /// unrecoverable — the delete tool — where the inflation turns a near-miss on a small hold into a
    /// deletion of it. Off by default, so moving and selecting keep the forgiving target.
    /// </summary>
    [Parameter] public bool ExactHitTargets { get; set; }

    /// <summary>
    /// When true (with <see cref="Editable"/>) the <c>.photo-editor</c> claims one-finger touch drags for
    /// the hold move, via the same <c>data-hold-drag</c> protocol the wall editor uses in Move mode:
    /// viewport-gestures.js then neither pans nor <c>preventDefault</c>s, so Blazor's pointer drag gets
    /// the gesture, and components.css gives the shapes <c>touch-action: none</c> so the browser does not
    /// scroll and cancel it. Set it ONLY while a one-finger drag should move a hold — i.e. the
    /// select/move tool. With Add/Delete/Pipette it must stay false: there the tap is the whole
    /// interaction and a drag has to keep panning the zoomed image.
    /// </summary>
    [Parameter] public bool DragToMove { get; set; }

    /// <summary>Fired after a move with the hold's id and its new normalized X/Y/Radius. The touch-up
    /// size slider reports a resize through the same callback, so persistence has one path.</summary>
    [Parameter] public EventCallback<HoldGeometry> OnHoldGeometryChanged { get; set; }

    /// <summary>Fired when the pointer enters a hold (interactive mode); the end callback when it leaves.</summary>
    [Parameter] public EventCallback<Guid> OnHoldHover { get; set; }
    [Parameter] public EventCallback OnHoldHoverEnd { get; set; }

    /// <summary>Bumped by the parent each step; a change re-centres the view on <see cref="FocusPoint"/>.</summary>
    [Parameter] public int FocusKey { get; set; }
    [Parameter] public (double X, double Y)? FocusPoint { get; set; }
    [Parameter] public double FocusZoom { get; set; } = 2.5;

    private ElementReference _viewportRef;
    private ElementReference _editorRef;
    private readonly ViewportZoomState _zoomState;
    private int _lastFocusKey = int.MinValue;

    // Per-image, local: temporarily hide the overlay so tiny holds under it are visible.
    private bool _overlayHidden;

    // In-place editing (Editable only). A draft holds the in-progress drag geometry so the immutable
    // PanelHold records need not be mutated; the committed value round-trips through the parent.
    private EditDrag _editDrag = EditDrag.None;
    private Guid _editHoldId;
    private bool _editMoved;
    private bool _suppressTap;
    private readonly Dictionary<Guid, (double X, double Y, double Radius)> _geometryDrafts = new();

    private void ToggleOverlay() => _overlayHidden = !_overlayHidden;

    // Effective geometry for a hold: the live drag draft if one exists, otherwise the record's values.
    // Non-editable reuse never populates a draft, so this is always the record's own X/Y/Radius there.
    private (double X, double Y, double Radius) Geo(PanelHold h) =>
        _geometryDrafts.TryGetValue(h.Id, out var g) ? g : (h.X, h.Y, h.Radius);

    private void StartMove(PanelHold h)
    {
        if (!Editable)
        {
            return;
        }

        _editDrag = EditDrag.Move;
        _editHoldId = h.Id;
        _editMoved = false;
        _geometryDrafts[h.Id] = Geo(h);
    }

    private async Task OnEditPointerMove(PointerEventArgs e)
    {
        if (_editDrag == EditDrag.None)
        {
            return;
        }

        var pos = await JS.InvokeAsync<RelativePos>("wallEditor.getRelativePosition", _editorRef, e.ClientX, e.ClientY);
        if (!_geometryDrafts.TryGetValue(_editHoldId, out var g))
        {
            return;
        }

        var px = Math.Clamp(pos.X, 0, 1);
        var py = Math.Clamp(pos.Y, 0, 1);
        _geometryDrafts[_editHoldId] = (px, py, g.Radius);

        _editMoved = true;
        StateHasChanged();
    }

    private async Task OnEditPointerUp()
    {
        // Defensive reset: never let a suppress flag from an earlier gesture — whose trailing click
        // landed off a hold and so was never consumed by HandleHoldTap — survive into this one and
        // eat a legitimate tap. It is re-armed below only when THIS gesture was a real drag.
        _suppressTap = false;

        if (_editDrag == EditDrag.None)
        {
            return;
        }

        var id = _editHoldId;
        var moved = _editMoved;
        _editDrag = EditDrag.None;
        _editMoved = false;
        if (moved && _geometryDrafts.TryGetValue(id, out var g))
        {
            // A real drag just ended: swallow the click the browser fires next so it does not also
            // re-select, then report the new geometry for the parent to persist.
            _suppressTap = true;
            await OnHoldGeometryChanged.InvokeAsync(new HoldGeometry(id, g.X, g.Y, g.Radius));
        }

        // The parent's persisted values are in the Holds param by now (the callback awaited above), so
        // drop the draft and fall back to them.
        _geometryDrafts.Remove(id);
        StateHasChanged();
    }

    private async Task HandleHoldTap(Guid id)
    {
        if (_suppressTap)
        {
            _suppressTap = false;
            return;
        }

        await OnHoldTap.InvokeAsync(id);
    }

    public PanelImageView()
    {
        _zoomState = new ViewportZoomState(() => InvokeAsync(StateHasChanged));
    }

    private PanelHold? BadgeHold =>
        HighlightHoldId is { } id ? Holds.FirstOrDefault(h => h.Id == id) : null;

    private string BadgeFill => Blend(BadgeColor);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("bwViewport.setupScroll", _viewportRef, _zoomState.Reference);
            // pinAspect: true sizes the viewport to the image's aspect ratio (inline aspect-ratio),
            // so a landscape wall photo leaves no black letterbox band and the box stays put while the
            // zoomed content scrolls inside it (matches the boulder-detail / multi-panel viewers).
            await JS.InvokeVoidAsync("bwViewport.fitBox", _viewportRef, true);

            if (FocusKey != _lastFocusKey)
            {
                _lastFocusKey = FocusKey;
                if (FocusPoint is { } fp)
                {
                    await JS.InvokeVoidAsync("bwViewport.centerOn", _viewportRef, fp.X, fp.Y, FocusZoom);
                }
                else
                {
                    await JS.InvokeVoidAsync("bwViewport.zoomTo", _viewportRef, 1.0);
                }
            }
        }
        catch (JSException)
        {
            // Stale element reference after a re-render/reconnect: the next render retries.
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away mid-call; nothing to attach to.
        }
    }

    private async Task OnSvgClick(MouseEventArgs e)
    {
        if (_suppressTap)
        {
            // The trailing click after a drag landed on the SVG background rather than on a hold, so
            // HandleHoldTap never ran to clear the flag. Consume it here (swallowing this one click)
            // so it can never persist and eat the next real hold tap or add.
            _suppressTap = false;
            return;
        }

        if (!AddMode)
        {
            return;
        }

        var pos = await JS.InvokeAsync<RelativePos>("wallEditor.getRelativePosition", _editorRef, e.ClientX, e.ClientY);
        await OnEmptyTap.InvokeAsync((Math.Clamp(pos.X, 0, 1), Math.Clamp(pos.Y, 0, 1)));
    }

    public void Dispose() => _zoomState.Dispose();

    private record RelativePos(double X, double Y);

    /// <summary>The reported new geometry of a hold after a move or resize, in normalized (0..1) space.</summary>
    public record HoldGeometry(Guid HoldId, double X, double Y, double Radius);

    private enum EditDrag
    {
        None,
        Move,
    }

    private static string F(double v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    // Stroke widths need finer quantisation than positions: at high zoom a hairline is well under 0.01
    // viewBox units and F2 would round it away.
    private static string F3(double v) => v.ToString("F3", System.Globalization.CultureInfo.InvariantCulture);

    // The JS viewport's live zoom, floored at "fit". Read-only: this is presentation sizing inside the
    // 0-100 viewBox, never written back into the transform — JS stays the sole authority for that
    // (see ViewportZoomState). At zoom 1 every expression below reduces to the former literal, so the
    // fit-zoom appearance and hit targets are byte-for-byte unchanged.
    private double EffectiveZoom => Math.Max(_zoomState.Zoom, 1.0);

    /// <summary>
    /// Outline width multiplier: <c>1 / zoom^1.25</c>. The <c>1/zoom</c> part holds the on-screen
    /// thickness constant as the image magnifies; the extra quarter power thins it further, so at the
    /// 12x ceiling an outline is roughly half its fit-zoom apparent weight — a hairline that stops the
    /// rings from occluding the very gaps the user is aiming at between densely packed holds.
    /// </summary>
    private double StrokeScale => 1.0 / Math.Pow(EffectiveZoom, 1.25);

    /// <summary>
    /// Fat-finger floor for the drag/tap proxies, shrinking as <c>0.012 / zoom</c>. At fit this is the
    /// original 1.2%-of-width minimum that makes a tiny hold grabbable; magnify and the targets converge
    /// on each hold's true size, so zooming in genuinely buys you the gap between two neighbours.
    /// <see cref="ExactHitTargets"/> still bypasses the floor entirely.
    /// </summary>
    private double HitFloor => 0.012 / EffectiveZoom;

    // The proxies' transparent stroke inflates the target by half its width all round, so it shrinks
    // with zoom too (1 viewBox unit at fit, as before).
    private string HitStroke => F3(1.0 / EffectiveZoom);

    // A translucent fill for the highlighted hold, derived from the badge colour.
    private static string Blend(string hslOrHex) =>
        hslOrHex.StartsWith("hsl(", StringComparison.OrdinalIgnoreCase)
            ? hslOrHex.Replace("hsl(", "hsla(").Replace(")", ", 0.28)")
            : "rgba(74,168,255,0.28)";
}
