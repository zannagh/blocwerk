@using Blocwerk.Contracts.Assets
@using Blocwerk.Core.Assets.Partition
@inject ICachePartitionResolver Partitions

@* The device's asset-cache partition (design §6.6), on every server-rendered page: the page modules compare it with the
   partition they last cached under and wipe on any difference, a missing meta included. Rendered in the head of BlocwerkApp,
   which every page goes through. "none" if the partition cannot be decided: that wipes, never keeps. *@
<meta name="@CachePartitions.MetaName" content="@partition" />

@code {
    private string partition = CachePartitions.None;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            partition = await Partitions.ResolveAsync();
        }
        catch (Exception)
        {
            partition = CachePartitions.None;
        }
    }
}
