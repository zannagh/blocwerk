@inherits LayoutComponentBase
@implements IDisposable
@using Blocwerk.Web.Components.Shared
@using Blocwerk.Web.State
@inject SessionState SessionState
@inject ICurrentUserService CurrentUserService

<div class="app-shell">
    <header class="bw-topbar">
        <a href="/walls" class="app-title">Blocwerk</a>
        <div class="bw-topbar-title"><SectionOutlet SectionName="TopBarTitle" /></div>
        <div class="header-actions">
            <TopBarActions />
            <AuthorizeView>
                <Authorized>
                    <a href="/account/logout" class="header-link">Logout</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/account/login" class="header-link">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="content">
        @Body
    </main>

    <nav class="bw-tabbar">
        <AuthorizeView>
            <Authorized>
                <a href="/walls" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                    </svg>
                    <span>Walls</span>
                </a>
                @if (_homeWallId is not null)
                {
                    <a href="/home" class="nav-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                            <path d="M3 10 12 3l9 7" />
                            <path d="M5 9v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9" />
                        </svg>
                        <span>Home</span>
                    </a>
                }
                @if (SessionState.HasActiveSession)
                {
                    <a href="@SessionHref" class="nav-item session">
                        <span class="session-icon">
                            <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                                <circle cx="12" cy="12" r="7" />
                            </svg>
                        </span>
                        <span>Session</span>
                    </a>
                }
                else
                {
                    <a href="/activity" class="nav-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                        </svg>
                        <span>Activity</span>
                    </a>
                }
            </Authorized>
        </AuthorizeView>
        <a href="/tools" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
            </svg>
            <span>Tools</span>
        </a>
        <AuthorizeView>
            <Authorized>
                <a href="/profile" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" />
                    </svg>
                    <span>Profile</span>
                </a>
            </Authorized>
        </AuthorizeView>
    </nav>

    <CookieConsent />
    <ConnectionStatus />
</div>

@code {
    private Guid? _homeWallId;

    protected override async Task OnInitializedAsync()
    {
        SessionState.Changed += OnSessionChanged;
        await SessionState.EnsureLoadedAsync();
        await RefreshHomeWallAsync();
    }

    // The layout instance persists across enhanced/interactive navigations, so re-read the home wall
    // on every navigation — not just once at init — so setting or clearing it in Profile is reflected
    // in the tab bar without a full reload. GetCurrentUserAsync is cached, so once SetHomeWallAsync
    // invalidates that cache the next navigation re-reads and the Home tab appears or disappears.
    protected override async Task OnParametersSetAsync()
    {
        await RefreshHomeWallAsync();
    }

    // Load the current user so the Home tab can appear when a home wall is set.
    // GetCurrentUserAsync throws for anonymous/unauthenticated callers — swallow that so the layout
    // never crashes; the tab simply stays hidden.
    private async Task RefreshHomeWallAsync()
    {
        try
        {
            var user = await CurrentUserService.GetCurrentUserAsync();
            _homeWallId = user?.HomeWallId;
        }
        catch (UnauthorizedAccessException)
        {
            _homeWallId = null;
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    // Tapping the live-session tab jumps straight to that wall's boulder list (carousel page).
    private string SessionHref =>
        SessionState.Current is { } s ? $"/walls/{s.WallId}?view=boulders" : "/activity";

    public void Dispose() => SessionState.Changed -= OnSessionChanged;
}
