@inherits LayoutComponentBase
@implements IDisposable
@using Blocwerk.Web.Components.Shared
@using Blocwerk.Web.State
@using Blocwerk.Core.Services.TopLogger
@using Microsoft.Extensions.DependencyInjection
@inject SessionState SessionState
@inject ICurrentUserService CurrentUserService
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime JS

<div class="app-shell">
    <header class="bw-topbar">
        <a href="/walls" class="app-title">Blocwerk</a>
        <div class="bw-topbar-title"><SectionOutlet SectionName="TopBarTitle" /></div>
        <div class="header-actions">
            <TopBarActions />
            <AuthorizeView>
                <Authorized>
                    <a href="/account/logout" class="header-link">Logout</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/account/login" class="header-link">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="content">
        @Body
    </main>

    <nav class="bw-tabbar @(_tabbarCollapsed ? "collapsed" : null)">
        <AuthorizeView>
            <Authorized>
                <a href="/walls" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                    </svg>
                    <span>Walls</span>
                </a>
                @if (_homeWallId is not null)
                {
                    <a href="/home" class="nav-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                            <path d="M3 10 12 3l9 7" />
                            <path d="M5 9v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9" />
                        </svg>
                        <span>Home</span>
                    </a>
                }
                @if (SessionState.HasActiveSession)
                {
                    <a href="@SessionHref" class="nav-item session">
                        <span class="session-icon">
                            <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                                <circle cx="12" cy="12" r="7" />
                            </svg>
                        </span>
                        <span>Session</span>
                    </a>
                }
                else
                {
                    <a href="/activity" class="nav-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                        </svg>
                        <span>Activity</span>
                    </a>
                }
                @if (_isAdmin)
                {
                    <a href="/administration" class="nav-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                            <path d="M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7z" />
                            <polyline points="9 12 11 14 15 10" />
                        </svg>
                        <span>Admin</span>
                    </a>
                }
            </Authorized>
        </AuthorizeView>
        <a href="/tools" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
            </svg>
            <span>Tools</span>
        </a>
        <AuthorizeView>
            <Authorized>
                <a href="/profile" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" />
                    </svg>
                    <span>Profile</span>
                </a>
            </Authorized>
        </AuthorizeView>
        <button type="button" class="tabbar-toggle" aria-label="Hide navigation bar"
                @onclick="() => _tabbarCollapsed = true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                <polyline points="6 9 12 15 18 9" />
            </svg>
        </button>
    </nav>

    @if (_tabbarCollapsed)
    {
        <button type="button" class="tabbar-restore" aria-label="Show navigation bar"
                @onclick="() => _tabbarCollapsed = false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                <polyline points="6 15 12 9 18 15" />
            </svg>
        </button>
    }

    @if (_showReauthToast && !_reauthDismissed)
    {
        <div class="toast-msg toast-reauth" role="alert">
            <a href="/profile" @onclick="() => _reauthDismissed = true">Reset TopLogger Tokens</a>
            <button type="button" class="toast-reauth-dismiss" aria-label="Dismiss"
                    @onclick="() => _reauthDismissed = true">&times;</button>
        </div>
    }

    <CookieConsent />
    <ConnectionStatus />
</div>

@code {
    // On app-open we skip the sync if we already synced within this window AND it's still the same day;
    // otherwise we sync. So repeated interactions on the same day stay quiet after one sync, but a new
    // day (or 3h+ later) syncs again. The explicit "Sync" button always works regardless.
    private static readonly TimeSpan SessionSyncMinInterval = TimeSpan.FromHours(3);

    private Guid? _homeWallId;
    private bool _isAdmin;
    private bool _startupTriggered;
    private bool _showReauthToast;
    private bool _reauthDismissed;
    private bool _tabbarCollapsed;

    protected override async Task OnInitializedAsync()
    {
        SessionState.Changed += OnSessionChanged;
        await SessionState.EnsureLoadedAsync();
        await RefreshHomeWallAsync();
    }

    // Once per circuit (first interactive render): kick the session-start TopLogger work. OnAfterRender
    // only fires when the layout is interactive, so this never runs during static SSR.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _startupTriggered)
        {
            return;
        }
        _startupTriggered = true;

        Guid userId;
        try
        {
            var user = await CurrentUserService.GetCurrentUserAsync();
            userId = user.Id;
        }
        catch (UnauthorizedAccessException)
        {
            // Anonymous page: nothing to sync.
            return;
        }

        StartSessionTopLoggerWork(userId);
    }

    // Fires the session-start sync + reauth check OFF the circuit (its own DI scope on a background
    // task) so a dispose of this circuit's scoped services can never race the work, and render is never
    // blocked. Swallows everything — a failed session-start sync must never surface to the user.
    private void StartSessionTopLoggerWork(Guid userId)
    {
        _ = Task.Run(async () =>
        {
            try
            {
                using var scope = ScopeFactory.CreateScope();
                var importService = scope.ServiceProvider.GetRequiredService<ITopLoggerImportService>();
                var status = await importService.GetStatusAsync(userId);

                if (status.NeedsReauth)
                {
                    _showReauthToast = true;
                    await InvokeAsync(StateHasChanged);
                }

                // Only an incremental catch-up on app-open: require a prior sync (LastSyncAt set) — the
                // first full import stays an explicit user action ("Sync now"). Then skip when we already
                // synced within the 3h window on the same (UTC) day; sync when it's a new day or 3h+ old.
                var now = DateTimeOffset.UtcNow;
                bool due = status.Connected
                           && !status.NeedsReauth
                           && status.LastSyncAt is { } last
                           && (now - last >= SessionSyncMinInterval
                               || last.UtcDateTime.Date != now.UtcDateTime.Date);
                if (due)
                {
                    var result = await importService.SyncAsync(userId);
                    if (result.Success && !result.NeedsReauth)
                    {
                        // Marshal back onto the circuit to surface a brief pink status-pill flash. A JS
                        // interop failure (circuit already gone) is swallowed by the outer catch.
                        await InvokeAsync(async () =>
                            await JS.InvokeVoidAsync("blocwerkStatus.flash", "TopLogger synced", "warn"));
                    }
                }
            }
            catch (Exception)
            {
                // A session-start sync failure must never surface; the next app-open retries.
            }
        });
    }

    // The layout instance persists across enhanced/interactive navigations, so re-read the home wall
    // on every navigation — not just once at init — so setting or clearing it in Profile is reflected
    // in the tab bar without a full reload. GetCurrentUserAsync is cached, so once SetHomeWallAsync
    // invalidates that cache the next navigation re-reads and the Home tab appears or disappears.
    protected override async Task OnParametersSetAsync()
    {
        await RefreshHomeWallAsync();
    }

    // Load the current user so the Home tab can appear when a home wall is set.
    // GetCurrentUserAsync throws for anonymous/unauthenticated callers — swallow that so the layout
    // never crashes; the tab simply stays hidden.
    private async Task RefreshHomeWallAsync()
    {
        try
        {
            var user = await CurrentUserService.GetCurrentUserAsync();
            _homeWallId = user?.HomeWallId;
            _isAdmin = user?.Role == IdentityRole.Admin;
        }
        catch (UnauthorizedAccessException)
        {
            _homeWallId = null;
            _isAdmin = false;
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    // Tapping the live-session tab jumps straight to that wall's boulder list (carousel page).
    private string SessionHref =>
        SessionState.Current is { } s ? $"/walls/{s.WallId}?view=boulders" : "/activity";

    public void Dispose() => SessionState.Changed -= OnSessionChanged;
}
