<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Blocwerk.Core\Blocwerk.Core.csproj" />
    <ProjectReference Include="..\..\src\Blocwerk.Authentication\Blocwerk.Authentication.csproj" />
    <!-- The API-key REST controllers are unit-tested directly, with substituted services. -->
    <ProjectReference Include="..\..\src\Blocwerk.Web\Blocwerk.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The cutting-plan PDF tests render with SkiaSharp; the base package ships native
         assets for Windows/macOS but not Linux, so the CI (Linux) test run needs this. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

</Project>
