# Example environment for docker-compose.yml. Copy to `.env` next to the compose file and fill in.
# NEVER commit the real `.env` (it is git-ignored). Values below are placeholders, not secrets.

# --- wall-geometry service (3D solve + facet textures; runs next to the app) ---
# OPTIONAL and opt-in: leave all of this empty and the app starts without it (wall capture is hidden).
# To enable: COMPOSE_PROFILES=compute (starts the service), GEOMETRYSERVICE_URL=http://wall-geometry:8000
# (tells the app where it is) and a COMPUTE_API_KEY.
# COMPUTE_API_KEY is shared by the app (GEOMETRYSERVICE__APIKEY) and the service. COMPUTE_CALLBACK_SECRET is
# the service's own (signed progress callbacks); the app polls and does not use it.
# Generate each with e.g. `openssl rand -hex 32`.
# The service refuses to listen on 0.0.0.0 without COMPUTE_API_KEY (otherwise every container on the
# compose network could submit jobs), so enabling the profile without a key leaves it stopped, never open.
# Several profiles are comma-separated, e.g. COMPOSE_PROFILES=compute,gpu.
COMPOSE_PROFILES=
GEOMETRYSERVICE_URL=
COMPUTE_API_KEY=
# Optional: empty = no progress callbacks (the app polls).
COMPUTE_CALLBACK_SECRET=

# --- splat worker (Gaussian splats; needs a GPU — often on ANOTHER machine) ---
# URL the app uses to reach the worker, e.g. https://splat.example.ts.net (keep it behind HTTPS).
# Leave empty to disable the photo-real view.
SPLATSERVICE_URL=
# SPLAT_API_KEY must match COMPUTE_API_KEY on the worker; SPLAT_CALLBACK_SECRET is the worker's own (the app polls).
# Optional: leave empty without a splat worker. The compose `splat-worker` (profile `gpu`) refuses to
# listen on 0.0.0.0 without it, so it never runs unauthenticated.
SPLAT_API_KEY=
SPLAT_CALLBACK_SECRET=
# Optional: training steps per photo-real job (empty = worker default 15000; e.g. 5000 for a quicker, softer result).
SPLAT_MAX_STEPS=
# Largest walk-along capture video the APP accepts, in MB (1-16384; default 2048). A reverse proxy in
# front of the app must allow a request body this big on /api/captures/*/video.
CAPTURE__MAXVIDEOMB=2048
# Worker-side memory caps (read by the compose `splat-worker` service; a native worker such as
# run-native.sh on a Mac takes the same names from its own environment); see
# docker/splat-worker/README.md. Each job sizes a memory budget from the machine (60 % of total, or
# what is available if less) and fits COLMAP to it (guided matching only when it fits).
# SPLAT_MAX_MEMORY_MB: hard upper bound on that budget (0 = from the machine alone).
# SPLAT_MAX_SWAP_GROWTH_MB: a big tool is stopped once system swap grew this much within 120 s.
# COLMAP_THREADS: upper bound on extraction/matching/mapper threads.
SPLAT_MAX_MEMORY_MB=0
SPLAT_MAX_SWAP_GROWTH_MB=2048
COLMAP_MAX_IMAGE_SIZE=2400
COLMAP_MAX_FEATURES=8192
COLMAP_MAX_MATCHES=8192
COLMAP_THREADS=4
