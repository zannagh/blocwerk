# Template for the production .env next to docker-compose.prod.yml (on the box: the .env next to
# docker-compose.yml). Placeholders only — NEVER commit real values. CI validates the compose file with it.

# --- Compose itself ---
# Project name compose uses for containers/networks (keep it stable or compose sees a new stack).
COMPOSE_PROJECT_NAME=blocwerk
# Profiles to start: `compute` = wall-geometry + splat-cpu.
COMPOSE_PROFILES=compute

# --- Registry (read by autodeploy.sh via grep, not by compose) ---
# GitHub user that owns the read:packages token.
GHCR_USER=zannagh
# Classic PAT with read:packages; it EXPIRES — renew before then (docker/prod/README.md).
GHCR_TOKEN=placeholder
# Installation-scoped API key (bwk_...) autodeploy uses to announce "updating" to the live app.
BLOCWERK_DEPLOY_API_KEY=placeholder

# --- Leftovers from the old webhook deploy (deploy-hook); unused by docker-compose.prod.yml ---
# HMAC secret of the retired GitHub deploy webhook.
WEBHOOK_SECRET=unused
# Absolute compose dir the retired deploy-hook container mounted.
COMPOSE_DIR=/path/to/blocwerk

# --- Loopback-only host ports (required; pick free ports on the host) ---
# Host port for Postgres (127.0.0.1 only; for backups and psql on the box).
POSTGRES_HOST_PORT=15432
# Host port for the otel dashboard web UI (127.0.0.1 only; reach it through an SSH tunnel).
OTEL_UI_HOST_PORT=18888
# Host port for OTLP ingest into the dashboard (127.0.0.1 only).
OTEL_OTLP_HOST_PORT=18889

# --- Database and app secrets (required) ---
# Postgres superuser password, shared by postgres and the app.
POSTGRES_PASSWORD=change-me
# Column encryption key; NEVER change it on a live database (encrypted columns become unreadable).
BLOCWERK__ENCRYPTIONKEY=change-me

# --- Outgoing mail ---
# SMTP server host name.
SMTP__HOST=smtp.example.com
# SMTP port (587 for StartTls, 465 for ForceTls).
SMTP__PORT=587
# SMTP login user.
SMTP__USERNAME=mailer@example.com
# SMTP login password.
SMTP__PASSWORD=change-me
# Sender address.
SMTP__FROM=noreply@example.com
# Sender display name.
SMTP__FROMNAME=Blocwerk
# StartTls | ForceTls | Off.
SMTP__SECURITY=StartTls

# --- Web Push (empty = push disabled) ---
# VAPID subject, a mailto: or https: URL.
VAPID__SUBJECT=mailto:admin@example.com
# VAPID public key (base64url).
VAPID__PUBLICKEY=placeholder
# VAPID private key (base64url).
VAPID__PRIVATEKEY=placeholder

# --- 3D / compute services ---
# Where the app reaches wall-geometry (empty = wall capture off).
GEOMETRYSERVICE_URL=http://wall-geometry:8000
# Bearer key shared by the app and wall-geometry (openssl rand -hex 32).
COMPUTE_API_KEY=change-me
# Where the app reaches the splat worker's CPU half.
SPLATSERVICE_URL=http://splat-cpu:8100
# Bearer key shared by the app and splat-cpu (openssl rand -hex 32).
SPLAT_API_KEY=change-me
# always = all photo-real training goes to a 3D runner; off = runner API not mapped.
RUNNERS_MODE=always
# Largest capture video the app accepts, in MB.
CAPTURE__MAXVIDEOMB=2048
# Photos per capture; keep it <= GEOMETRY_MAX_PHOTOS.
CAPTURE__MAXPHOTOS=200
# Video frames kept per capture.
CAPTURE__MAXVIDEOFRAMES=120
# Disk retention of retired models' 3D files, 3D runner results, abandoned capture imports and
# unreferenced photo-real scene files (.spz).
# true (the default) = only log "Capture retention (dry run) would free X GB" every sweep (6 h).
# Check that log line, then set false to let the sweep delete (docs/marker-walls.md, "Retention").
CAPTURE__RETENTIONDRYRUN=true
# Photos per wall-geometry job.
GEOMETRY_MAX_PHOTOS=200
# Largest wall-geometry request body, in MB.
GEOMETRY_MAX_REQUEST_MB=4096
# Images per splat-cpu job (photos + frames + anchors).
SPLAT_MAX_PHOTOS=600
# COLMAP threads in splat-cpu (below its 4-CPU cap).
COLMAP_THREADS=3

# --- Reverse proxy and rollout toggles ---
# IP/CIDR of Caddy on `edge`; only it may set X-Forwarded-For (empty = trust every sender).
TRUSTED_PROXY=10.0.0.0/24
# API-key browser login for rollout scripts; keep false except temporarily.
APIKEYLOGIN_ENABLED=false
# The one user id allowed to use the API-key login (empty = nobody).
APIKEYLOGIN_USER_ID=

# --- Logging (optional; the compose defaults apply) ---
# LOG_LEVEL=Information (the app's default level), LOG_LEVEL_CIRCUIT_REGISTRY=Debug (circuit evictions and
# reconnects; set Warning to silence them). Container log size limits are fixed in the compose file.

# --- Optional (not set on prod today; the compose file's defaults apply) ---
# DEPLOY__MAINTENANCEWINDOW=, COMPUTE_CALLBACK_SECRET=, SPLAT_CALLBACK_SECRET=, CAPTURE__MAXPHOTOMB=,
# TEXTURES_TIMEOUT_S=, TEXTURES_MAX_MEGAPIXELS=, TEXTURES_BLEND_MAX_BYTES=, SFM_MAX_SPARSE_MB=, SFM_TIMEOUT_S=,
# SPLAT_MAX_MEMORY_MB=, SPLAT_MAX_SWAP_GROWTH_MB=, COLMAP_MAX_IMAGE_SIZE=, COLMAP_MAX_FEATURES=, COLMAP_MAX_MATCHES=
