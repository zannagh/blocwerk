# Copy to  ../.env  (next to docker-compose.yml) and fill in. `.env` is gitignored (*.env).
# docker compose reads it automatically.

# --- REQUIRED ---

# Shared secret for the GitHub webhook HMAC. Generate one with:  openssl rand -hex 32
# Put the SAME value into the webhook's "Secret" field on GitHub
# (repo Settings -> Webhooks -> your hook). Without a matching secret every delivery is rejected.
WEBHOOK_SECRET=

# Absolute path on the HOST to the directory that holds docker-compose.yml (this stack's dir).
# It is bind-mounted into the receiver at the same path so `docker compose` inside the container
# resolves the stack's relative bind mounts to real host paths.
COMPOSE_DIR=/Volumes/RaidSSD/Services/blocwerk

# GHCR login for pulling the (private) image. The host's docker login is in the macOS keychain and
# cannot be reused inside the Linux receiver, so provide a token with the `read:packages` scope
# (github.com/settings/tokens). Leave GHCR_TOKEN empty if you instead make the package public.
GHCR_USER=zannagh
GHCR_TOKEN=

# --- OPTIONAL ---

# Compose project name of the running stack (default: blocwerk). Must match your containers'
# prefix, e.g. "blocwerk" in blocwerk-blocwerk-1.
# COMPOSE_PROJECT_NAME=blocwerk

# Host port the receiver listens on (default 9000). Point your public webhook URL at /hooks/deploy
# on this port (usually via your existing reverse proxy).
# DEPLOY_HOOK_PORT=9000

# Host docker config dir, reused so a PRIVATE GHCR package can be pulled with the host's login
# (default /root/.docker). Remove the matching volume mount in docker-compose.yml if your package
# is public.
# DOCKER_CONFIG_DIR=/root/.docker

# Installation-scoped API key (bwk_…) the deploy hook uses to announce "the server is updating" to
# the still-running container, seconds before it is recreated — so connected browsers and kiosk
# tablets show a notice instead of a reconnect spinner. OPTIONAL: leave it empty and the deploy
# simply runs without announcing (a warning is logged, nothing is blocked).
# Mint one at /administration -> "Installation API Keys". It is shown exactly once. Never commit it.
# BLOCWERK_DEPLOY_API_KEY=

# Where that announcement is posted (default https://blocwerk.app/api/v1/maintenance/announce).
# Must be the CURRENT domain: a host that 301-redirects drops the Authorization header, so the key
# would arrive as nobody.
# ANNOUNCE_URL=https://blocwerk.app/api/v1/maintenance/announce

# How long, in seconds, the notice stays up if the deploy never completes (default 600; the server
# clamps to 30 minutes), and how long the hook waits after announcing before recreating the
# container (default 5).
#
# Set ANNOUNCE_ETA LONGER than a deploy actually takes, never shorter. It is the lifetime of the
# notice a browser is staring at while the container is gone: if it runs out first the pill drops
# back to "Session ended" in the middle of the deploy. Overshooting costs nothing — clients reload
# when the instance id CHANGES, not when the notice expires, and the new container comes up with no
# announcement at all.
# ANNOUNCE_ETA=600
# ANNOUNCE_GRACE=5

# The busy gate polled before the pull (default https://blocwerk.app/health/ready-to-deploy). Keep
# it on the same host as ANNOUNCE_URL.
# HEALTH_URL=https://blocwerk.app/health/ready-to-deploy
